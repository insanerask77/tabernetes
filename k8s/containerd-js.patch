+
+package command
+
+import (
+	"context"
+	"os"
+
+	"github.com/containerd/containerd/v2/cmd/containerd/server"
+)
+
+// js/wasm has no signals: nothing can interrupt the wasm runtime, so the
+// signal loop only reacts to serverC and context cancellation.
+
+var handledSignals = []os.Signal{}
+
+func handleSignals(ctx context.Context, signals chan os.Signal, serverC chan *server.Server, cancel func()) chan struct{} {
+	done := make(chan struct{})
+	go func() {
+		var srv *server.Server
+		for {
+			select {
+			case s := <-serverC:
+				srv = s
+			case <-signals:
+				// js/wasm never delivers signals.
+			case <-ctx.Done():
+				cancel()
+				if srv != nil {
+					srv.Stop()
+				}
+				close(done)
+				return
+			}
+		}
+	}()
+	return done
+}
