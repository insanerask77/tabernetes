+type psEntry struct {
+	Id      string
+	Names   []string
+	Image   string
+	Command string
+	State   string
+	Status  string
+	Ports   []struct {
+		IP          string
+		PrivatePort int
+		PublicPort  int
+		Type        string
+	}
+}
+
+func ps(t *testing.T, base string, all bool) map[string]psEntry {
+	t.Helper()
+	url := base + "/containers/json"
+	if all {
+		url += "?all=1"
+	}
+	_, body := api(t, http.MethodGet, url, "")
+	var list []psEntry
+	if err := json.Unmarshal([]byte(body), &list); err != nil {
+		t.Fatalf("ps: %v: %s", err, body)
+	}
+	out := map[string]psEntry{}
+	for _, c := range list {
+		out[c.Names[0]] = c
+	}
+	return out
+}
