diff --git a/core/runtime/v2/v86/README.md b/core/runtime/v2/v86/README.md
new file mode 100644
index 0000000..675d573
--- /dev/null
+++ b/core/runtime/v2/v86/README.md
@@ -0,0 +1,40 @@
+# v86 Runtime v2 Shim
+
+A containerd [Runtime v2 shim](../../README.md) that runs each task in a
+[v86](https://github.com/copy/v86) virtual machine instead of a runc container.
+It is the "runc replacement" for the tabernetes control plane: containerd keeps
+managing images, snapshots and tasks unchanged, and this package translates the
+task lifecycle onto the v86 VM of the tab node.
+
+## The seam
+
+`Runtime` / `Handle` are the only parts that know about the VM:
+
+- `Runtime.Create(ctx, id, spec)` boots a VM for an OCI runtime spec but does
+  not run its entrypoint yet. On js/wasm this boots the kernel to the initramfs
+  "ready" state (stage 0 in `vm/init/init.c`), the same point where the tab
+  node waits for the pod before `go`.
+- `Handle.Start` runs the entrypoint (`go`).
+- `Handle.Wait` returns the exit code.
+- `Handle.Exec` / `Resize` / `Kill` / `State` / `Delete` map to the VM's exec
+  protocol (`k8s/tabernetes/v86exec.go`), the tty, a signal to PID 1, the state
+  and `worker.terminate()`.
+
+The js/wasm implementation of `Runtime` lives in the tabernetes repository and
+drives the VM worker over `syscall/js`; `fake/` is an in-memory implementation
+for tests.
+
+## Not supported
+
+The operations that only make sense for a real Linux process are no-ops or
+return `ErrNotImplemented`: `Pause`/`Resume` (no cgroup freezer), `Checkpoint`,
+`Update`, `Stats`, `CloseIO` (stdio streams over the VM, not fifos), `Pids`
+(no host pids). `Connect` reports PID 1, the task in its VM.
+
+## Integration
+
+On js/wasm there is no `fork` and no unix socket, so this shim is not a separate
+binary forked by containerd. It is registered in-process as a
+`plugins.TTRPCPlugin` with id `"task"` (see `core/runtime/v2/example/example.go`
+for the pattern), and its control channel runs over the in-process fake TCP
+network instead of a unix socket.
diff --git a/core/runtime/v2/v86/copied.go b/core/runtime/v2/v86/copied.go
new file mode 100644
index 0000000..0b60809
--- /dev/null
+++ b/core/runtime/v2/v86/copied.go
@@ -0,0 +1,199 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86
+
+import (
+	"archive/tar"
+	"bytes"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// The VM of a container keeps what the container writes only while it
+// runs. The files that docker cp copies into a container are kept here as
+// well, one tar per copy with absolute names, and go on top of the image
+// when the container starts again (web/src/cpfs.js addFiles). Docker keeps
+// them in the writable layer of the container. CopiedDir is under the
+// root of containerd, so the page keeps it across a reload.
+var CopiedDir = "/var/lib/v86-copied"
+
+// CopiedFile is a file, directory or symbolic link of a copy. Mode has the
+// type bits of Linux (S_IFDIR, S_IFREG, S_IFLNK).
+type CopiedFile struct {
+	Path       string // absolute
+	Mode       uint32
+	UID, GID   int
+	Mtime      int64
+	Data       []byte
+	LinkTarget string
+}
+
+// The type bits of a Linux file mode.
+const (
+	ModeDir     = 0o040000
+	ModeRegular = 0o100000
+	ModeSymlink = 0o120000
+	ModeType    = 0o170000
+)
+
+// AddCopied keeps the files of a copy into container id.
+func AddCopied(id string, files []CopiedFile) error {
+	dir := filepath.Join(CopiedDir, id)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return err
+	}
+	ents, _ := os.ReadDir(dir)
+	var b bytes.Buffer
+	if err := WriteTar(&b, files); err != nil {
+		return err
+	}
+	return os.WriteFile(filepath.Join(dir, fmt.Sprintf("%06d.tar", len(ents)+1)), b.Bytes(), 0o644)
+}
+
+// CopiedFiles returns the files copied into container id, in the order of
+// the copies.
+func CopiedFiles(id string) ([]CopiedFile, error) {
+	dir := filepath.Join(CopiedDir, id)
+	ents, err := os.ReadDir(dir)
+	if os.IsNotExist(err) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var names []string
+	for _, e := range ents {
+		names = append(names, e.Name())
+	}
+	sort.Strings(names)
+	var out []CopiedFile
+	for _, n := range names {
+		f, err := os.Open(filepath.Join(dir, n))
+		if err != nil {
+			return out, err
+		}
+		files, err := ReadTar(f)
+		f.Close()
+		if err != nil {
+			return out, err
+		}
+		out = append(out, files...)
+	}
+	return out, nil
+}
+
+// RemoveCopied forgets the copies into container id (docker rm).
+func RemoveCopied(id string) {
+	os.RemoveAll(filepath.Join(CopiedDir, id))
+}
+
+// WriteTar writes files as a tar, as docker cp sends them.
+func WriteTar(w io.Writer, files []CopiedFile) error {
+	tw := tar.NewWriter(w)
+	for _, f := range files {
+		h := &tar.Header{
+			Name: f.Path, Mode: int64(f.Mode & 0o7777), Uid: f.UID, Gid: f.GID,
+			ModTime: unixTime(f.Mtime), Format: tar.FormatPAX,
+		}
+		switch f.Mode & ModeType {
+		case ModeDir:
+			h.Typeflag = tar.TypeDir
+			if !strings.HasSuffix(h.Name, "/") {
+				h.Name += "/"
+			}
+		case ModeSymlink:
+			h.Typeflag, h.Linkname = tar.TypeSymlink, f.LinkTarget
+		case ModeRegular:
+			h.Typeflag, h.Size = tar.TypeReg, int64(len(f.Data))
+		default:
+			continue
+		}
+		if err := tw.WriteHeader(h); err != nil {
+			return err
+		}
+		if h.Typeflag == tar.TypeReg {
+			if _, err := tw.Write(f.Data); err != nil {
+				return err
+			}
+		}
+	}
+	return tw.Close()
+}
+
+// ReadTar reads the files of a tar. Names are cleaned and may not leave
+// the tar ("../x"); hard links become copies of their target; devices and
+// FIFOs are left out, as the 9p tree of the VM has none.
+func ReadTar(r io.Reader) ([]CopiedFile, error) {
+	tr := tar.NewReader(r)
+	var out []CopiedFile
+	byName := map[string]int{}
+	for {
+		h, err := tr.Next()
+		if err == io.EOF {
+			return out, nil
+		}
+		if err != nil {
+			return out, err
+		}
+		name := h.Name
+		abs := strings.HasPrefix(name, "/")
+		name = path.Clean("/" + name)
+		if !abs {
+			name = strings.TrimPrefix(name, "/")
+		}
+		if name == "" || name == "." || name == "/" {
+			name = "."
+		}
+		f := CopiedFile{Path: name, Mode: uint32(h.Mode & 0o7777), UID: h.Uid, GID: h.Gid, Mtime: h.ModTime.Unix()}
+		switch h.Typeflag {
+		case tar.TypeDir:
+			f.Mode |= ModeDir
+		case tar.TypeSymlink:
+			f.Mode |= ModeSymlink
+			f.LinkTarget = h.Linkname
+		case tar.TypeReg, tar.TypeRegA:
+			f.Mode |= ModeRegular
+			if f.Data, err = io.ReadAll(tr); err != nil {
+				return out, err
+			}
+		case tar.TypeLink:
+			i, ok := byName[path.Clean(strings.TrimPrefix(h.Linkname, "./"))]
+			if !ok {
+				continue
+			}
+			t := out[i]
+			f.Mode, f.Data = t.Mode, t.Data
+		default:
+			continue
+		}
+		byName[strings.TrimPrefix(name, "./")] = len(out)
+		out = append(out, f)
+	}
+}
+
+func unixTime(sec int64) time.Time {
+	if sec <= 0 {
+		return time.Unix(0, 0)
+	}
+	return time.Unix(sec, 0)
+}
