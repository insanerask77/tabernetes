+// imageStopSignals is a Streamer that knows the STOPSIGNAL of the images,
+// as the glue does from the VM worker.
+type imageStopSignals struct {
+	fakeStreams
+	signals map[string]string
+}
+
+func (s imageStopSignals) StopSignal(id string) string { return s.signals[id] }
+
+// TestDockerStop runs docker stop, kill and rm -f through the API: the stop
+// signal and its sources, the grace period, SIGKILL after it, and the
+// answers of dockerd for containers that do not run.
+func TestDockerStop(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	// the STOPSIGNAL of images, by containerd id (filled after create)
+	streams := imageStopSignals{signals: map[string]string{}}
+	srv := httptest.NewServer(dockerapi.NewServer(d.Client, streams))
+	defer srv.Close()
+
+	call := func(method, path, body string) (int, string) {
+		t.Helper()
+		req, _ := http.NewRequest(method, srv.URL+path, strings.NewReader(body))
+		if body != "" {
+			req.Header.Set("Content-Type", "application/json")
+		}
+		resp, err := http.DefaultClient.Do(req)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer resp.Body.Close()
+		b, _ := io.ReadAll(resp.Body)
+		return resp.StatusCode, strings.TrimSpace(string(b))
+	}
+	run := func(name, extra string) *fake.Handle {
+		t.Helper()
+		if code, msg := call("POST", "/containers/create?name="+name, `{"Image":"alpine","Cmd":["sleep","600"]`+extra+`}`); code != http.StatusCreated {
+			t.Fatalf("create %s: %d %s", name, code, msg)
+		}
+		if code, msg := call("POST", "/containers/"+name+"/start", ""); code != http.StatusNoContent {
+			t.Fatalf("start %s: %d %s", name, code, msg)
+		}
+		return testRuntime.Get(containerID(t, ctx, d, name))
+	}
+	exitCode := func(name string) (bool, int) {
+		t.Helper()
+		_, body := call("GET", "/containers/"+name+"/json", "")
+		var c struct {
+			State struct {
+				Running  bool
+				ExitCode int
+			}
+		}
+		json.Unmarshal([]byte(body), &c)
+		return c.State.Running, c.State.ExitCode
+	}
+	signals := func(h *fake.Handle, want ...uint32) {
+		t.Helper()
+		if got := h.Signals(); fmt.Sprint(got) != fmt.Sprint(want) {
+			t.Errorf("signals %v; want %v", got, want)
+		}
+	}
+
+	// docker stop: SIGTERM, the exit code of the process
+	h := run("stop-term", "")
+	if code, msg := call("POST", "/containers/stop-term/stop", ""); code != http.StatusNoContent {
+		t.Fatalf("stop: %d %s", code, msg)
+	}
+	signals(h, 15)
+	if running, code := exitCode("stop-term"); running || code != 143 {
+		t.Errorf("after stop: running %v, exit code %d; want 143", running, code)
+	}
+	if code, _ := call("POST", "/containers/stop-term/stop", ""); code != http.StatusNotModified {
+		t.Errorf("stop of a stopped container: %d; want 304", code)
+	}
+
+	// a process that ignores SIGTERM gets SIGKILL after -t
+	h = run("stop-ignore", "")
+	h.Ignore(15)
+	t0 := time.Now()
+	if code, msg := call("POST", "/containers/stop-ignore/stop?t=1", ""); code != http.StatusNoContent {
+		t.Fatalf("stop -t 1: %d %s", code, msg)
+	}
+	if d := time.Since(t0); d < time.Second || d > 5*time.Second {
+		t.Errorf("stop -t 1 took %v", d)
+	}
+	signals(h, 15, 9)
+	if _, code := exitCode("stop-ignore"); code != 137 {
+		t.Errorf("exit code %d; want 137", code)
+	}
+
+	// the signal: docker run --stop-signal, then the image, then ?signal=
+	h = run("stop-run", `,"StopSignal":"SIGQUIT","StopTimeout":1`)
+	call("POST", "/containers/stop-run/stop", "")
+	signals(h, 3)
+	h = run("stop-img", "")
+	streams.signals[containerID(t, ctx, d, "stop-img")] = "SIGUSR1"
+	call("POST", "/containers/stop-img/stop", "")
+	signals(h, 10)
+	h = run("stop-query", "")
+	call("POST", "/containers/stop-query/stop?signal=INT", "")
+	signals(h, 2)
+	if code, msg := call("POST", "/containers/create?name=bad", `{"Image":"alpine","StopSignal":"FOO"}`); code != http.StatusBadRequest || msg != "Invalid signal: FOO" {
+		t.Errorf("create with a bad stop signal: %d %q", code, msg)
+	}
+
+	// docker kill -s HUP reaches a process that handles it, which keeps
+	// running; plain docker kill is SIGKILL
+	h = run("kill", "")
+	h.Ignore(1)
+	if code, msg := call("POST", "/containers/kill/kill?signal=HUP", ""); code != http.StatusNoContent {
+		t.Fatalf("kill -s HUP: %d %s", code, msg)
+	}
+	if running, _ := exitCode("kill"); !running {
+		t.Error("the container stopped after SIGHUP")
+	}
+	if code, msg := call("POST", "/containers/kill/kill?signal=FOO", ""); code != http.StatusBadRequest || msg != "Invalid signal: FOO" {
+		t.Errorf("kill -s FOO: %d %q", code, msg)
+	}
+	if code, msg := call("POST", "/containers/kill/kill", ""); code != http.StatusNoContent {
+		t.Fatalf("kill: %d %s", code, msg)
+	}
+	signals(h, 1, 9)
+	if running, code := exitCode("kill"); running || code != 137 {
+		t.Errorf("after kill: running %v, exit code %d; want 137", running, code)
+	}
+	if code, msg := call("POST", "/containers/kill/kill", ""); code != http.StatusConflict || msg != "cannot kill container: kill: container "+containerID(t, ctx, d, "kill")+" is not running" {
+		t.Errorf("kill of a stopped container: %d %q", code, msg)
+	}
+
+	// docker rm refuses a running container, docker rm -f kills it
+	h = run("rm-f", "")
+	if code, msg := call("DELETE", "/containers/rm-f", ""); code != http.StatusConflict || !strings.Contains(msg, "or force remove") {
+		t.Errorf("rm of a running container: %d %q", code, msg)
+	}
+	if code, msg := call("DELETE", "/containers/rm-f?force=1", ""); code != http.StatusNoContent {
+		t.Fatalf("rm -f: %d %s", code, msg)
+	}
+	signals(h, 9)
+	if containerID(t, ctx, d, "rm-f") != "" {
+		t.Error("the container is still there after rm -f")
+	}
+	if code, _ := call("POST", "/containers/rm-f/stop", ""); code != http.StatusNotFound {
+		t.Errorf("stop of a removed container: %d; want 404", code)
+	}
+}
+
+// containerID is the containerd id of the container with a Docker name, or
+// "": the Docker API gives containers random ids and keeps the name in a
+// label (dockerapi.LabelName).
+func containerID(t *testing.T, ctx context.Context, d *Daemon, name string) string {
+	t.Helper()
+	cs, err := d.Client.Containers(ctx, "labels.\""+dockerapi.LabelName+"\"=="+name)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(cs) == 0 {
+		return ""
+	}
+	return cs[0].ID()
+}
