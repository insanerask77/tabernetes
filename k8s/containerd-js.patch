+// TestDockerContainers runs the life of containers through the API: ids and
+// names, ps, inspect, start of an exited container, restart, wait, --rm,
+// and the lookup by name and prefix.
+func TestDockerContainers(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	server.Images = newFakeImages()
+	server.Addresses = func(id string) (string, string, bool) { return "172.17.0.9", "172.17.0.1", true }
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+
+	// an image that is not there: the CLI pulls on this answer
+	if st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"busybox"}`); st != 404 || strings.TrimSpace(body) != "No such image: busybox:latest" {
+		t.Errorf("create of a missing image: %d %q", st, body)
+	}
+
+	// no name: a random id and a name like Docker's
+	st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"nginx"}`)
+	var created struct{ Id string }
+	json.Unmarshal([]byte(body), &created)
+	if st != 201 || !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(created.Id) {
+		t.Fatalf("create: %d %s", st, body)
+	}
+	nginx := created.Id
+	st, body = api(t, http.MethodPost, u+"/containers/create?name=web", `{"Image":"alpine","Cmd":["sh","-c","exit 3"],"Env":["A=1"]}`)
+	json.Unmarshal([]byte(body), &created)
+	web := created.Id
+	if st != 201 {
+		t.Fatalf("create web: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/create?name=web", `{"Image":"alpine"}`); st != 409 ||
+		!strings.Contains(body, `Conflict. The container name "/web" is already in use by container "`+web+`"`) {
+		t.Errorf("same name: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/create?name=a+b", `{"Image":"alpine"}`); st != 400 || !strings.Contains(body, "Invalid container name (a b)") {
+		t.Errorf("bad name: %d %s", st, body)
+	}
+
+	// ps: created containers only with all=1
+	for n, c := range ps(t, u, false) {
+		if c.Id == nginx || c.Id == web {
+			t.Errorf("ps without -a shows the created container %s", n)
+		}
+	}
+	all := ps(t, u, true)
+	if c := all["/web"]; c.State != "created" || c.Status != "Created" || c.Command != "sh -c exit 3" || c.Image != "alpine" {
+		t.Errorf("ps web: %+v", c)
+	}
+	var nginxName string
+	for n, c := range all {
+		if c.Id == nginx {
+			nginxName = n
+		}
+	}
+	if !regexp.MustCompile(`^/[a-z]+_[a-z]+$`).MatchString(nginxName) || all[nginxName].Command != "/docker-entrypoint.sh nginx -g daemon off;" {
+		t.Errorf("ps nginx: %q %+v", nginxName, all[nginxName])
+	}
+
+	// start by name, the published ports of -p (agent of -p writes the label)
+	c, err := d.Client.LoadContainer(ctx, nginx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	c.SetLabels(ctx, map[string]string{"dev.tabernetes.v86.ports": `[{"HostIp":"0.0.0.0","HostPort":"8080","ContainerPort":"80","Protocol":"tcp"}]`})
+	if st, body := api(t, http.MethodPost, u+"/containers/"+nginxName[1:]+"/start", ""); st != 204 {
+		t.Fatalf("start: %d %s", st, body)
+	}
+	if st, _ := api(t, http.MethodPost, u+"/containers/"+nginx[:6]+"/start", ""); st != 304 {
+		t.Errorf("start of a running container: %d; want 304", st)
+	}
+	running := ps(t, u, false)
+	if c := running[nginxName]; c.State != "running" || c.Status != "Up Less than a second" || len(c.Ports) != 1 ||
+		c.Ports[0].IP != "0.0.0.0" || c.Ports[0].PublicPort != 8080 || c.Ports[0].PrivatePort != 80 {
+		t.Errorf("ps running: %+v", running)
+	}
+
+	// inspect
+	_, body = api(t, http.MethodGet, u+"/containers/"+nginx[:8]+"/json", "")
+	var ins struct {
+		Id, Name, Path, Image string
+		Args                  []string
+		State                 struct {
+			Status    string
+			Running   bool
+			ExitCode  int
+			StartedAt string
+		}
+		Config struct {
+			Image string
+			Cmd   []string
+			Env   []string
+		}
+		HostConfig struct {
+			PortBindings map[string][]struct{ HostIp, HostPort string }
+		}
+		NetworkSettings struct {
+			IPAddress, Gateway string
+			Ports              map[string][]struct{ HostIp, HostPort string }
+		}
+	}
+	if err := json.Unmarshal([]byte(body), &ins); err != nil {
+		t.Fatal(err)
+	}
+	if ins.Id != nginx || ins.Name != nginxName || ins.Path != "/docker-entrypoint.sh" || strings.Join(ins.Args, ",") != "nginx,-g,daemon off;" ||
+		ins.Image != "sha256:b2b2b2b2b2b2b2b2" || !ins.State.Running || ins.State.Status != "running" || ins.State.StartedAt == "0001-01-01T00:00:00Z" ||
+		ins.Config.Image != "nginx" || strings.Join(ins.Config.Env, ",") != "PATH=/usr/bin,NGINX_VERSION=1.29" ||
+		ins.NetworkSettings.IPAddress != "172.17.0.9" || ins.NetworkSettings.Ports["80/tcp"][0].HostPort != "8080" ||
+		ins.HostConfig.PortBindings["80/tcp"][0].HostPort != "8080" {
+		t.Errorf("inspect: %s", body)
+	}
+
+	// the end of a run: wait answers, ps says Exited, the VM is gone
+	if st, _ := api(t, http.MethodPost, u+"/containers/web/start", ""); st != 204 {
+		t.Fatalf("start web: %d", st)
+	}
+	h := testRuntime.Created[web]
+	go func() { time.Sleep(50 * time.Millisecond); h.ExitCode(3) }()
+	if _, body := api(t, http.MethodPost, u+"/containers/web/wait", ""); strings.TrimSpace(body) != `{"StatusCode":3}` {
+		t.Errorf("wait: %s", body)
+	}
+	if c := ps(t, u, true)["/web"]; c.State != "exited" || c.Status != "Exited (3) Less than a second ago" {
+		t.Errorf("ps exited: %+v", c)
+	}
+	wc, _ := d.Client.LoadContainer(ctx, web)
+	if _, err := wc.Task(ctx, nil); err == nil {
+		t.Error("the task of an exited container is still there")
+	}
+	// a container that does not run: wait answers at once
+	if _, body := api(t, http.MethodPost, u+"/containers/web/wait", ""); strings.TrimSpace(body) != `{"StatusCode":3}` {
+		t.Errorf("wait of an exited container: %s", body)
+	}
+
+	// start again: a new task, the same container
+	if st, body := api(t, http.MethodPost, u+"/containers/web/start", ""); st != 204 {
+		t.Fatalf("start again: %d %s", st, body)
+	}
+	if h2 := testRuntime.Created[web]; h2 == h {
+		t.Error("start of an exited container made no new task")
+	}
+	if c := ps(t, u, false)["/web"]; c.State != "running" {
+		t.Errorf("ps after start again: %+v", c)
+	}
+
+	// restart: killed (the fake gives 137) and started again
+	h = testRuntime.Created[web]
+	if st, body := api(t, http.MethodPost, u+"/containers/web/restart?t=1", ""); st != 204 {
+		t.Fatalf("restart: %d %s", st, body)
+	}
+	if h2 := testRuntime.Created[web]; h2 == h {
+		t.Error("restart made no new task")
+	}
+	if c := ps(t, u, false)["/web"]; c.State != "running" {
+		t.Errorf("ps after restart: %+v", c)
+	}
+
+	// lookup: an ambiguous prefix, a missing name
+	if st, body := api(t, http.MethodGet, u+"/containers/nosuch/json", ""); st != 404 || strings.TrimSpace(body) != "No such container: nosuch" {
+		t.Errorf("missing: %d %s", st, body)
+	}
+
+	// --rm: the container goes when it exits, without a client
+	st, body = api(t, http.MethodPost, u+"/containers/create?name=tmp", `{"Image":"alpine","HostConfig":{"AutoRemove":true}}`)
+	json.Unmarshal([]byte(body), &created)
+	if st != 201 {
+		t.Fatalf("create --rm: %d %s", st, body)
+	}
+	api(t, http.MethodPost, u+"/containers/tmp/start", "")
+	testRuntime.Created[created.Id].ExitCode(0)
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		if _, err := d.Client.LoadContainer(ctx, created.Id); err != nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("the container of --rm is still there")
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+
+	// clean up for the other tests
+	for _, id := range []string{nginx, web} {
+		testRuntime.Created[id].ExitCode(0)
+		for range 100 {
+			if st, _ := api(t, http.MethodDelete, u+"/containers/"+id, ""); st == 204 {
+				break
+			}
+			time.Sleep(20 * time.Millisecond)
+		}
+	}
+}
+
+// TestDockerImages runs docker images, image inspect, pull and rmi over a
+// fake image store.
+func TestDockerImages(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	images := newFakeImages()
+	server.Images = images
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+
+	_, body := api(t, http.MethodGet, u+"/images/json", "")
+	var list []struct {
+		Id       string
+		RepoTags []string
+		Size     int64
+	}
+	json.Unmarshal([]byte(body), &list)
+	if len(list) != 2 || list[0].RepoTags[0] != "alpine:latest" && list[0].RepoTags[0] != "nginx:latest" {
+		t.Errorf("images: %s", body)
+	}
+
+	if st, body := api(t, http.MethodGet, u+"/images/library/nginx/json", ""); st != 200 || !strings.Contains(body, `"Id":"sha256:b2b2b2b2b2b2b2b2"`) ||
+		!strings.Contains(body, `"Architecture":"386"`) {
+		t.Errorf("image inspect: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodGet, u+"/images/nosuch/json", ""); st != 404 || strings.TrimSpace(body) != "No such image: nosuch:latest" {
+		t.Errorf("image inspect of a missing image: %d %s", st, body)
+	}
+
+	// pull: a stream of dockerd's messages
+	resp, err := http.Post(u+"/images/create?fromImage=docker.io/library/busybox&tag=latest", "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var msgs []string
+	sc := bufio.NewScanner(resp.Body)
+	for sc.Scan() {
+		msgs = append(msgs, sc.Text())
+	}
+	resp.Body.Close()
+	want := []string{
+		`{"status":"Pulling from library/busybox","id":"latest"}`,
+		`{"status":"Pulling fs layer","progressDetail":{},"id":"0123456789ab"}`,
+		`{"status":"Downloading","progressDetail":{"current":50,"total":100},"id":"0123456789ab"}`,
+		`{"status":"Verifying Checksum","progressDetail":{},"id":"0123456789ab"}`,
+		`{"status":"Download complete","progressDetail":{},"id":"0123456789ab"}`,
+		`{"status":"Pull complete","progressDetail":{},"id":"0123456789ab"}`,
+		`{"status":"Digest: sha256:dbusybox"}`,
+		`{"status":"Status: Downloaded newer image for busybox:latest"}`,
+	}
+	if strings.Join(msgs, "\n") != strings.Join(want, "\n") {
+		t.Errorf("pull:\n%s\nwant:\n%s", strings.Join(msgs, "\n"), strings.Join(want, "\n"))
+	}
+	// an error before the first step is the answer of the request
+	if st, body := api(t, http.MethodPost, u+"/images/create?fromImage=docker.io/library/nosuch&tag=latest", ""); st != 404 ||
+		strings.TrimSpace(body) != `failed to resolve reference "docker.io/library/nosuch:latest": not found` {
+		t.Errorf("pull of a missing image: %d %s", st, body)
+	}
+
+	// rmi: refused while a container uses the image, then removed
+	_, body = api(t, http.MethodPost, u+"/containers/create?name=uses-busybox", `{"Image":"busybox"}`)
+	var created struct{ Id string }
+	json.Unmarshal([]byte(body), &created)
+	if st, body := api(t, http.MethodDelete, u+"/images/busybox", ""); st != 409 ||
+		!strings.Contains(body, `conflict: unable to remove repository reference "busybox" (must force) - container `+created.Id[:12]+` is using its referenced image c3c3c3c3c3c3`) {
+		t.Errorf("rmi of a used image: %d %s", st, body)
+	}
+	// a running container: force does not help
+	api(t, http.MethodPost, u+"/containers/uses-busybox/start", "")
+	if st, body := api(t, http.MethodDelete, u+"/images/busybox?force=1", ""); st != 409 ||
+		!strings.Contains(body, "conflict: unable to delete c3c3c3c3c3c3 (cannot be forced) - image is being used by running container "+created.Id[:12]) {
+		t.Errorf("rmi -f of an image in use: %d %s", st, body)
+	}
+	testRuntime.Created[created.Id].ExitCode(0)
+	for range 100 {
+		if st, _ := api(t, http.MethodDelete, u+"/containers/"+created.Id, ""); st == 204 {
+			break
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	st, body := api(t, http.MethodDelete, u+"/images/busybox", "")
+	if st != 200 || strings.TrimSpace(body) != `[{"Untagged":"busybox:latest"},{"Untagged":"busybox@sha256:dbusybox"},{"Deleted":"sha256:c3c3c3c3c3c3c3c3"}]` {
+		t.Errorf("rmi: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodDelete, u+"/images/busybox", ""); st != 404 || strings.TrimSpace(body) != "No such image: busybox:latest" {
+		t.Errorf("rmi again: %d %s", st, body)
+	}
+}
+
+func TestDockerEvents(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	server.Images = newFakeImages()
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+	since := strconv.FormatInt(time.Now().Add(-time.Second).Unix(), 10)
+	st, body := api(t, http.MethodPost, u+"/containers/create?name=evt", `{"Image":"alpine"}`)
+	if st != 201 {
+		t.Fatalf("create: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodDelete, u+"/containers/evt", ""); st != 204 {
+		t.Fatalf("rm: %d %s", st, body)
+	}
+	until := strconv.FormatInt(time.Now().Add(time.Second).Unix(), 10)
+	st, body = api(t, http.MethodGet, u+"/events?since="+since+"&until="+until+`&filters={"container":{"evt":true}}`, "")
+	var actions []string
+	dec := json.NewDecoder(strings.NewReader(body))
+	for {
+		var m struct {
+			Action string
+			Actor  struct{ Attributes map[string]string }
+		}
+		if dec.Decode(&m) != nil {
+			break
+		}
+		if m.Actor.Attributes["name"] != "evt" || m.Actor.Attributes["image"] != "alpine" {
+			t.Errorf("attributes %v", m.Actor.Attributes)
+		}
+		actions = append(actions, m.Action)
+	}
+	if st != 200 || strings.Join(actions, ",") != "create,destroy" {
+		t.Errorf("events: %d %v %s", st, actions, body)
+	}
+}
