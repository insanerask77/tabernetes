+package inprocess
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	taskAPI "github.com/containerd/containerd/api/runtime/task/v2"
+	"github.com/containerd/containerd/api/types/task"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/fake"
+	"github.com/containerd/ttrpc"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+func TestInProcessShim(t *testing.T) {
+	ctx := context.Background()
+
+	// A minimal OCI bundle.
+	dir := t.TempDir()
+	spec := specs.Spec{Process: &specs.Process{Args: []string{"/bin/sh"}}}
+	b, err := json.Marshal(&spec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "config.json"), b, 0644); err != nil {
+		t.Fatal(err)
+	}
+
+	rt := fake.NewRuntime()
+	shim, err := New(ctx, "t1", "default", dir, rt)
+	if err != nil {
+		t.Fatalf("new shim: %v", err)
+	}
+	defer shim.Close()
+
+	c := taskAPI.NewTTRPCTaskClient(shim.Client().(*ttrpc.Client))
+
+	if _, err := c.Create(ctx, &taskAPI.CreateTaskRequest{ID: "t1", Bundle: dir}); err != nil {
+		t.Fatalf("create: %v", err)
+	}
+	if _, err := c.Start(ctx, &taskAPI.StartRequest{ID: "t1"}); err != nil {
+		t.Fatalf("start: %v", err)
+	}
+
+	st, err := c.State(ctx, &taskAPI.StateRequest{ID: "t1"})
+	if err != nil {
+		t.Fatalf("state: %v", err)
+	}
+	if st.Status != task.Status_RUNNING {
+		t.Fatalf("status = %v, want running", st.Status)
+	}
+
+	if _, err := c.Delete(ctx, &taskAPI.DeleteRequest{ID: "t1"}); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+
+	if _, err := c.State(ctx, &taskAPI.StateRequest{ID: "t1"}); err == nil {
+		t.Fatal("state after delete: expected not found, got nil")
+	}
+}
diff --git a/core/runtime/v2/v86/jsruntime/js.go b/core/runtime/v2/v86/jsruntime/js.go
new file mode 100644
index 0000000..ebc4e76
--- /dev/null
+++ b/core/runtime/v2/v86/jsruntime/js.go
@@ -0,0 +1,862 @@
+//go:build js
+
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package jsruntime
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"sync"
+	"syscall/js"
+	"time"
+
+	"github.com/containerd/containerd/api/types/task"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/errdefs"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// Runtime is the js/wasm implementation of v86.Runtime. It drives the
+// tabernetes VM worker (web/src/vm.js) through the vm object of a tab.
+type Runtime struct {
+	vm func() js.Value
+
+	// Signal sends sig to the main process of the VM behind vm (the vm.js
+	// start() handle of task id) and returns once it is sent, not when the
+	// process exits. The glue sets it (k8s/tabernetes/docker.go): only it
+	// can dial the exec port of init. Without it, Kill stops the VM.
+	Signal func(ctx context.Context, vm js.Value, id string, sig uint32) error
+	// Admit, if set, is asked before a VM boots in the tab of vm: a tab runs
+	// a limited number of VMs, its pods and containers together. It returns
+	// the function that gives the place back, which the runtime calls once
+	// the VM is gone, or why the tab cannot run one more VM.
+	Admit func(vm js.Value) (release func(), err error)
+	// VMFor, if set, returns the vm object of the tab that runs task id:
+	// the tab that asked for the container (dockerapi Server.Tab). It
+	// replaces the function of NewRuntime.
+	VMFor func(id string) js.Value
+
+	mu     sync.Mutex
+	nextIP int
+	tasks  map[string]*handle // the tasks that are not deleted, by id
+}
+
+// NewRuntime takes a function that returns the vm object of the tab that
+// runs the next container (host.vm, see k8s/tabernetes/v86.go): with several
+// tabs, the containers run in the tab that asked for them.
+func NewRuntime(vm func() js.Value) *Runtime {
+	return &Runtime{vm: vm, tasks: make(map[string]*handle)}
+}
+
+// task returns the handle of task id, if it is not deleted.
+func (r *Runtime) task(id string) (*handle, bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	h, ok := r.tasks[id]
+	return h, ok
+}
+
+// VM returns the vm.js start() handle of task id, to connect to ports of its
+// VM (its connect method), or false if the task is not running.
+func (r *Runtime) VM(id string) (js.Value, bool) {
+	h, ok := r.task(id)
+	if !ok || h.h.Type() != js.TypeObject {
+		return js.Undefined(), false
+	}
+	select {
+	case <-h.exited:
+		return js.Undefined(), false
+	default:
+		return h.h, true
+	}
+}
+
+// StopSignal returns the STOPSIGNAL of the image of task id, as the VM
+// worker read it from the image config, or "" if it has none.
+func (r *Runtime) StopSignal(id string) string {
+	h, ok := r.task(id)
+	if !ok {
+		return ""
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.stopSignal
+}
+
+// Address returns the IP address and the gateway of the VM of task id, for
+// docker inspect, or false if the task is not running.
+func (r *Runtime) Address(id string) (ip, gateway string, ok bool) {
+	h, ok := r.task(id)
+	if !ok {
+		return "", "", false
+	}
+	select {
+	case <-h.exited:
+		return "", "", false
+	default:
+		return h.ip, h.gateway, h.ip != ""
+	}
+}
+
+// Follow writes the console of task id to w: first what this run of the
+// container wrote so far (the log since the task was created), then what
+// comes, until the task exits; done is closed then, once all of it is
+// written. The log is read and the follower added under the lock that the
+// console writes under, so nothing is lost or written twice. stop ends the
+// following early.
+func (r *Runtime) Follow(id string, w io.Writer) (done <-chan struct{}, stop func(), err error) {
+	h, ok := r.task(id)
+	if !ok {
+		return nil, nil, fmt.Errorf("task %q not found", id)
+	}
+	ch := make(chan []byte, 1024)
+	h.outMu.Lock()
+	h.log.Flush()
+	recs, err := v86.ReadLog(v86.LogPath(id))
+	if err != nil {
+		h.outMu.Unlock()
+		return nil, nil, err
+	}
+	var old []byte
+	for _, rec := range recs {
+		if !rec.Time.Before(h.created) {
+			old = append(old, rec.Log...)
+		}
+	}
+	key := new(int)
+	h.followers[key] = ch
+	h.outMu.Unlock()
+
+	end, quit := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	stop = func() {
+		once.Do(func() { close(quit) })
+		h.outMu.Lock()
+		delete(h.followers, key)
+		h.outMu.Unlock()
+	}
+	go func() {
+		defer close(end)
+		w.Write(old)
+		for {
+			select {
+			case b := <-ch:
+				w.Write(b)
+			case <-h.exited:
+				// the console of the last moments is queued before the exit
+				for {
+					select {
+					case b := <-ch:
+						w.Write(b)
+					default:
+						return
+					}
+				}
+			case <-quit:
+				return
+			}
+		}
+	}()
+	return end, stop, nil
+}
+
+// FollowLog is docker logs -f of a running task: the records of its log so
+// far and those that follow, until exited is closed (the task exited, and
+// its last records are in the channel). cancel ends the following.
+func (r *Runtime) FollowLog(id string) (old []v86.LogRecord, records <-chan v86.LogRecord, exited <-chan struct{}, cancel func(), err error) {
+	h, ok := r.task(id)
+	if !ok {
+		return nil, nil, nil, nil, fmt.Errorf("task %q not found", id)
+	}
+	h.outMu.Lock()
+	defer h.outMu.Unlock()
+	old, records, cancel = h.log.Subscribe()
+	return old, records, h.exited, cancel, nil
+}
+
+// address hands out the next address of Docker's default bridge network,
+// 172.17.0.2 to 172.17.0.254, gateway 172.17.0.1. Every VM has its own
+// network card on its own virtual network, so the addresses only have to
+// look like Docker's, not be unique across tabs.
+func (r *Runtime) address() string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	ip := fmt.Sprintf("172.17.0.%d", 2+r.nextIP%253)
+	r.nextIP++
+	return ip
+}
+
+// Gone ends the tasks whose VMs ran in the tab of vm: the tab was closed or
+// reloaded, and its workers ended with it, without a word to the runtime.
+// The tasks exit as killed by SIGKILL (137), as Docker reports a process
+// that the kernel killed.
+func (r *Runtime) Gone(vm js.Value) {
+	r.mu.Lock()
+	var gone []*handle
+	for _, h := range r.tasks {
+		if h.vm.Equal(vm) {
+			gone = append(gone, h)
+		}
+	}
+	r.mu.Unlock()
+	for _, h := range gone {
+		select {
+		case <-h.exited:
+			continue
+		default:
+		}
+		h.settle(errors.New("the tab that ran the container was closed"))
+		h.exit(128 + 9)
+		h.stop()
+	}
+}
+
+func (r *Runtime) Create(ctx context.Context, id string, spec *specs.Spec) (v86.Handle, error) {
+	var vm js.Value
+	if r.VMFor != nil {
+		vm = r.VMFor(id)
+	} else {
+		vm = r.vm()
+	}
+	release := func() {}
+	if r.Admit != nil {
+		var err error
+		if release, err = r.Admit(vm); err != nil {
+			return nil, err
+		}
+	}
+	if vm.Type() != js.TypeObject {
+		release()
+		return nil, errors.New("this tab cannot run container images")
+	}
+	h := &handle{
+		release:   sync.OnceFunc(release),
+		rt:        r,
+		id:        id,
+		vm:        vm,
+		created:   time.Now(),
+		ready:     make(chan error, 1),
+		exited:    make(chan struct{}),
+		followers: make(map[*int]chan []byte),
+	}
+	req := Translate(spec)
+	if req.Hostname == "" {
+		// Docker names the host after the short container id.
+		req.Hostname = id
+		if len(id) > 12 {
+			req.Hostname = id[:12]
+		}
+	}
+	if req.IP == "" {
+		req.IP, req.Gateway = r.address(), "172.17.0.1"
+	}
+	h.ip, h.gateway = req.IP, req.Gateway
+	if err := os.MkdirAll(v86.LogDir, 0o755); err != nil {
+		h.release()
+		return nil, err
+	}
+	log, err := v86.OpenLog(v86.LogPath(id), v86.LogConfigOf(spec.Annotations))
+	if err != nil {
+		h.release()
+		return nil, err
+	}
+	h.log = log
+	r.mu.Lock()
+	r.tasks[id] = h
+	r.mu.Unlock()
+	if err := h.boot(ctx, req); err != nil {
+		h.Delete(ctx)
+		return nil, err
+	}
+	return h, nil
+}
+
+// handle is one running VM.
+type handle struct {
+	rt  *Runtime
+	id  string
+	vm  js.Value
+	h   js.Value       // the vm.js start() handle
+	log *v86.LogWriter // the console, v86.LogPath
+	// created is when the task was created: the log of this run starts
+	// there (Follow)
+	created time.Time
+
+	release     func() // gives the place of Runtime.Admit back, once
+	ip, gateway string // of the VM
+
+	outMu     sync.Mutex
+	followers map[*int]chan []byte // Follow
+
+	funcs []js.Func
+
+	// the changes of bind mounts, applied in order by applyBinds
+	bindMu    sync.Mutex
+	bindQueue []func()
+
+	mu         sync.Mutex
+	isReady    bool
+	ready      chan error
+	exited     chan struct{} // closed on exit, with code set
+	code       uint32
+	stopSignal string // of the image config
+	paused     bool   // docker pause stopped the emulator
+}
+
+func (h *handle) fn(f func(a []js.Value)) js.Func {
+	jf := js.FuncOf(func(_ js.Value, a []js.Value) any { f(a); return nil })
+	h.funcs = append(h.funcs, jf)
+	return jf
+}
+
+// settle reports the start result once; false if already reported.
+func (h *handle) settle(err error) bool {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.isReady {
+		return false
+	}
+	h.isReady = true
+	h.ready <- err
+	return true
+}
+
+// jsFiles converts a prepared rootfs into the JS value the VM worker expects
+// (web/src/vmworker.js: an array of {path, mode, data?, target?}).
+func jsFiles(files []File) []any {
+	out := make([]any, len(files))
+	for i, f := range files {
+		m := map[string]any{"path": f.Path, "mode": f.Mode}
+		if f.Target != "" {
+			m["target"] = f.Target
+		} else if f.Data != nil {
+			m["data"] = jsBytes(f.Data) // js.ValueOf takes no []byte
+		}
+		out[i] = m
+	}
+	return out
+}
+
+// JSCopied converts copied files into the JS value of web/src/cpfs.js:
+// [{path, mode, uid, gid, mtime, data?, target?}].
+func JSCopied(files []v86.CopiedFile) js.Value {
+	arr := js.Global().Get("Array").New(len(files))
+	u8 := js.Global().Get("Uint8Array")
+	for i, f := range files {
+		m := map[string]any{"path": f.Path, "mode": f.Mode, "uid": f.UID, "gid": f.GID, "mtime": f.Mtime}
+		if f.LinkTarget != "" {
+			m["target"] = f.LinkTarget
+		}
+		o := js.ValueOf(m)
+		if f.Mode&v86.ModeType == v86.ModeRegular {
+			d := u8.New(len(f.Data))
+			js.CopyBytesToJS(d, f.Data)
+			o.Set("data", d)
+		}
+		arr.SetIndex(i, o)
+	}
+	return arr
+}
+
+// jsBytes copies b into a new Uint8Array.
+func jsBytes(b []byte) js.Value {
+	a := js.Global().Get("Uint8Array").New(len(b))
+	js.CopyBytesToJS(a, b)
+	return a
+}
+
+// jsMounts turns the mounts of a container into what the VM worker
+// mounts (web/src/volumes.js, prepareMounts): a volume by its name, a bind
+// mount with a copy of its files (BindSource), a tmpfs as an empty
+// directory. A bind source that is gone fails the start, as in Docker.
+func jsMounts(mounts []v86.Mount) ([]any, error) {
+	out := make([]any, 0, len(mounts))
+	for _, m := range mounts {
+		spec := map[string]any{"type": m.Type, "destination": m.Destination, "readonly": !m.RW}
+		switch m.Type {
+		case "volume":
+			spec["name"] = m.Name
+			spec["copy"] = !m.NoCopy
+		case "tmpfs":
+			mode := m.TmpfsMode
+			if mode == 0 {
+				mode = 0o1777
+			}
+			spec["mode"] = mode
+		case "bind":
+			dir, mode, files, data, err := BindSource(m.Source)
+			if err != nil {
+				return nil, fmt.Errorf("error mounting %q to rootfs at %q: %w", m.Source, m.Destination, err)
+			}
+			spec["mode"] = mode
+			if dir {
+				spec["files"] = jsFiles(files)
+			} else {
+				spec["file"] = true
+				spec["data"] = jsBytes(data)
+			}
+		default:
+			continue
+		}
+		out = append(out, spec)
+	}
+	return out, nil
+}
+
+// bindChanges reads what the VM worker sends for a bind mount (vm.js
+// on.bind): [{path, mode, mtime, data?, target?}].
+func bindChanges(v js.Value) []BindChange {
+	n := v.Length()
+	out := make([]BindChange, 0, n)
+	for i := 0; i < n; i++ {
+		e := v.Index(i)
+		c := BindChange{Path: e.Get("path").String(), Mode: uint32(e.Get("mode").Int())}
+		if t := e.Get("mtime"); t.Type() == js.TypeNumber {
+			c.Mtime = int64(t.Float())
+		}
+		if t := e.Get("target"); t.Type() == js.TypeString {
+			c.Target = t.String()
+		}
+		if d := e.Get("data"); d.Truthy() {
+			c.Data = make([]byte, d.Length())
+			js.CopyBytesToGo(c.Data, d)
+			c.HasData = true
+		}
+		out = append(out, c)
+	}
+	return out
+}
+
+// boot boots the VM and runs the entrypoint. The current vm.js start() does
+// both (boot to "ready" and "go"); a future vm.js change can split them so
+// that Create only boots and Start runs the entrypoint. Until then Start is a
+// no-op.
+func (h *handle) boot(ctx context.Context, req VMRequest) error {
+
+	// The OCI spec's Process.Args is the full resolved argv (containerd already
+	// merged the image entrypoint/cmd with the container overrides). The VM
+	// worker's rootfs mode uses it as-is.
+	args := make([]any, len(req.Command))
+	for i, s := range req.Command {
+		args[i] = s
+	}
+	env := make([]any, len(req.Env))
+	for i, e := range req.Env {
+		env[i] = e
+	}
+	container := map[string]any{
+		"args":       args,
+		"env":        env,
+		"workingDir": req.WorkingDir,
+		"user":       req.User,
+		"stdin":      req.Stdin,
+		"stdinOnce":  req.StdinOnce,
+		"tty":        req.TTY,
+	}
+	if req.Entrypoint != nil {
+		// docker run --entrypoint: the worker drops the ENTRYPOINT and
+		// the CMD of the image (containerSpec in web/src/vmworker.js)
+		ep := make([]any, len(req.Entrypoint))
+		for i, s := range req.Entrypoint {
+			ep[i] = s
+		}
+		container["entrypoint"] = ep
+	}
+
+	opts := map[string]any{
+		"hostname":         req.Hostname,
+		"ip":               req.IP,
+		"gateway":          req.Gateway,
+		"memory":           req.Memory,
+		"ephemeralStorage": req.Storage,
+		"container":        container,
+	}
+	// the volumes and bind mounts (docker run -v, --mount)
+	var binds []v86.Mount // by the index of the mount in opts.mounts
+	if len(req.Mounts) > 0 {
+		mounts, err := jsMounts(req.Mounts)
+		if err != nil {
+			return err
+		}
+		opts["mounts"] = mounts
+		for _, m := range req.Mounts {
+			if m.Type == "volume" || m.Type == "tmpfs" || m.Type == "bind" {
+				binds = append(binds, m)
+			}
+		}
+	}
+	if req.Image != "" {
+		// Boot by pulling the ref in the VM worker (web/src/vmworker.js), the
+		// existing tab-node path: download, unpack to OPFS, serve over 9p. This
+		// sidesteps containerd's content store and snapshotter, whose prepared
+		// rootfs would otherwise be serialized here.
+		opts["image"] = req.Image
+	} else if req.Rootfs != "" {
+		// The containerd snapshot lives in the in-process file system (the
+		// Go fs of js/wasm). Serialize it so the VM worker can serve it over
+		// 9p. For a full image the snapshot should instead be served from the
+		// OPFS layers (web/src/layers.js), which is the missing piece.
+		files, err := PrepareRootfs(req.Rootfs)
+		if err != nil {
+			return err
+		}
+		opts["rootfs"] = jsFiles(files)
+	}
+
+	// what docker cp put into the container goes on top of the image
+	if files, err := v86.CopiedFiles(h.id); err == nil && len(files) > 0 {
+		opts["files"] = JSCopied(files)
+	}
+
+	on := map[string]any{
+		// vm.js calls pulling and pulled for every pull: without them, every
+		// docker run of an image threw a TypeError in the worker
+		"pulling": h.fn(func([]js.Value) {}),
+		"pulled": h.fn(func(a []js.Value) {
+			if s := a[0].Get("stopSignal"); s.Type() == js.TypeString {
+				h.mu.Lock()
+				h.stopSignal = s.String()
+				h.mu.Unlock()
+			}
+		}),
+		"started": h.fn(func([]js.Value) { h.settle(nil) }),
+		// what the container changed in a bind mount: written below its
+		// source, in the file system of the page. Not in the callback: the
+		// file system answers in the event loop of JavaScript.
+		"bind": h.fn(func(a []js.Value) {
+			n := a[0].Int()
+			if n < 0 || n >= len(binds) || binds[n].Type != "bind" {
+				return
+			}
+			src, set, del := binds[n].Source, bindChanges(a[1]), make([]string, a[2].Length())
+			for i := range del {
+				del[i] = a[2].Index(i).String()
+			}
+			h.bindMu.Lock()
+			h.bindQueue = append(h.bindQueue, func() {
+				if err := ApplyBind(src, set, del); err != nil {
+					h.output(fmt.Sprintf("error: bind mount %s: %v\n", src, err))
+				}
+			})
+			start := len(h.bindQueue) == 1
+			h.bindMu.Unlock()
+			if start {
+				go h.applyBinds()
+			}
+		}),
+		"console": h.fn(func(a []js.Value) { h.output(a[0].String()) }),
+		"exit": h.fn(func(a []js.Value) {
+			code := uint32(a[0].Int())
+			msg := fmt.Sprintf("exited with code %d", code)
+			if len(a) > 1 && a[1].Truthy() {
+				msg = a[1].String()
+			}
+			h.settle(fmt.Errorf("runc create failed: unable to start container process: %s", msg))
+			// the last line may have no newline: it belongs to this run
+			h.log.Flush()
+			h.exit(code)
+			// What is left in the VM ends with the main process, as the
+			// processes of a container end with its PID 1.
+			h.stopVM()
+		}),
+		"error": h.fn(func(a []js.Value) {
+			err := errors.New(a[0].String())
+			if !h.settle(err) {
+				// the VM failed while the container ran
+				h.output(fmt.Sprintln("error:", err))
+			}
+			h.exit(128)
+		}),
+	}
+
+	h.h = h.vm.Call("start", js.ValueOf(opts), js.ValueOf(on))
+	select {
+	case err := <-h.ready:
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// applyBinds writes the queued changes of bind mounts, one after the
+// other, until the queue is empty.
+func (h *handle) applyBinds() {
+	for {
+		h.bindMu.Lock()
+		if len(h.bindQueue) == 0 {
+			h.bindMu.Unlock()
+			return
+		}
+		f := h.bindQueue[0]
+		h.bindMu.Unlock()
+		f()
+		h.bindMu.Lock()
+		h.bindQueue = h.bindQueue[1:]
+		h.bindMu.Unlock()
+	}
+}
+
+// output writes console output to the log and to the followers. It runs in
+// a callback of the worker, so it never blocks: a follower that does not
+// read loses output, as a slow kubectl attach does (vm/init).
+func (h *handle) output(s string) {
+	h.outMu.Lock()
+	defer h.outMu.Unlock()
+	h.log.Write([]byte(s))
+	for _, ch := range h.followers {
+		select {
+		case ch <- []byte(s):
+		default:
+		}
+	}
+}
+
+// Start is a no-op: the current vm.js start() already ran the entrypoint.
+func (h *handle) Start(ctx context.Context) error {
+	return nil
+}
+
+// exit records the exit code, once: the first of exit, error and Kill wins.
+func (h *handle) exit(code uint32) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	select {
+	case <-h.exited:
+	default:
+		h.code = code
+		close(h.exited)
+		// the VM is gone: its place in the tab is free
+		go h.release()
+	}
+}
+
+func (h *handle) Wait(ctx context.Context) (uint32, error) {
+	select {
+	case <-h.exited:
+		h.mu.Lock()
+		defer h.mu.Unlock()
+		return h.code, nil
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+}
+
+// Exec is not wired yet: it needs the vm.js exec protocol (k8s/tabernetes/
+// v86exec.go) exposed through the vm object.
+func (h *handle) Exec(ctx context.Context, p *specs.Process) (io.ReadWriteCloser, error) {
+	return nil, errors.New("v86 exec is not wired to the shim yet")
+}
+
+func (h *handle) Resize(rows, cols uint32) error {
+	return errors.New("v86 resize is not wired to the shim yet")
+}
+
+// killWait is how long Kill waits for init to report the exit after
+// SIGKILL before it stops the whole VM.
+var killWait = 5 * time.Second
+
+// Kill sends signal to the main process in the VM, as runc kill does
+// (Runtime.Signal). The exit code comes from init when the process exits,
+// so it is the real one: 143 for a process that SIGTERM ended, 0 for one
+// that handled it and exited. Only SIGKILL waits for the exit; if the VM
+// does not report it in time, Kill stops the VM and records 137, the exit
+// code of a process killed by SIGKILL.
+func (h *handle) Kill(ctx context.Context, signal uint32) error {
+	select {
+	case <-h.exited:
+		// what the runc shim says
+		return fmt.Errorf("process already finished: %w", errdefs.ErrNotFound)
+	default:
+	}
+	h.mu.Lock()
+	ready, paused := h.isReady, h.paused
+	h.mu.Unlock()
+	if paused {
+		// A frozen VM cannot take the signal over its network. dockerd
+		// thaws a paused container after the kill too, so the process gets
+		// the signal at once.
+		if err := h.Resume(ctx); err != nil {
+			return err
+		}
+	}
+	err := v86.ErrNoSignals
+	if ready && h.rt.Signal != nil {
+		err = h.rt.Signal(ctx, h.h, h.id, signal)
+	}
+	if errors.Is(err, v86.ErrNoSignals) {
+		// no main process to signal (yet), or an init without signals
+		h.stopVM()
+		h.exit(128 + signal)
+		return nil
+	}
+	if signal != v86.SIGKILL {
+		return err
+	}
+	// Also after an error: the main process may have exited by itself
+	// a moment ago, and init reports it once its output is read.
+	t := time.NewTimer(killWait)
+	defer t.Stop()
+	select {
+	case <-h.exited:
+		return nil
+	case <-t.C:
+	case <-ctx.Done():
+	}
+	h.stopVM()
+	h.exit(128 + v86.SIGKILL)
+	return nil
+}
+
+func (h *handle) State(ctx context.Context) (task.Status, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if !h.isReady {
+		return task.Status_CREATED, nil
+	}
+	select {
+	case <-h.exited:
+		return task.Status_STOPPED, nil
+	default:
+		if h.paused {
+			return task.Status_PAUSED, nil
+		}
+		return task.Status_RUNNING, nil
+	}
+}
+
+var _ v86.Pauser = (*handle)(nil)
+
+// Pause stops the emulator of the VM (docker pause): its CPU, its clock and
+// so every process in it stand still, as under the cgroup freezer. The
+// worker answers once the emulator has stopped (web/src/vmworker.js).
+// Connections to the VM, such as those of published ports, wait meanwhile.
+func (h *handle) Pause(ctx context.Context) error {
+	return h.setPaused(ctx, true)
+}
+
+// Resume runs the emulator of a paused VM again (docker unpause).
+func (h *handle) Resume(ctx context.Context) error {
+	return h.setPaused(ctx, false)
+}
+
+func (h *handle) setPaused(ctx context.Context, pause bool) error {
+	h.mu.Lock()
+	running := h.isReady
+	select {
+	case <-h.exited:
+		running = false
+	default:
+	}
+	if !running {
+		h.mu.Unlock()
+		return fmt.Errorf("task %s is not running: %w", h.id, errdefs.ErrFailedPrecondition)
+	}
+	if h.paused == pause {
+		h.mu.Unlock()
+		return nil
+	}
+	h.mu.Unlock()
+	method := "resume"
+	if pause {
+		method = "pause"
+	}
+	if h.h.Type() != js.TypeObject || h.h.Get(method).Type() != js.TypeFunction {
+		return fmt.Errorf("%s: %w", method, errdefs.ErrNotImplemented)
+	}
+	if err := await(ctx, h.h.Call(method)); err != nil {
+		return err
+	}
+	h.mu.Lock()
+	h.paused = pause
+	h.mu.Unlock()
+	return nil
+}
+
+// await waits for a JavaScript promise.
+func await(ctx context.Context, p js.Value) error {
+	if p.Type() != js.TypeObject || p.Get("then").Type() != js.TypeFunction {
+		return nil
+	}
+	done := make(chan error, 1)
+	var ok, fail js.Func
+	ok = js.FuncOf(func(js.Value, []js.Value) any {
+		done <- nil
+		return nil
+	})
+	fail = js.FuncOf(func(_ js.Value, a []js.Value) any {
+		msg := "the VM worker failed"
+		if len(a) > 0 && a[0].Truthy() {
+			if m := a[0].Get("message"); m.Type() == js.TypeString {
+				msg = m.String()
+			} else {
+				msg = a[0].String()
+			}
+		}
+		done <- errors.New(msg)
+		return nil
+	})
+	p.Call("then", ok, fail)
+	select {
+	case err := <-done:
+		ok.Release()
+		fail.Release()
+		return err
+	case <-ctx.Done():
+		// the promise may still settle: the funcs stay
+		return ctx.Err()
+	}
+}
+
+func (h *handle) Delete(ctx context.Context) error {
+	h.stop()
+	h.release()
+	h.rt.mu.Lock()
+	if h.rt.tasks[h.id] == h {
+		delete(h.rt.tasks, h.id)
+	}
+	h.rt.mu.Unlock()
+	return nil
+}
+
+// stopVM ends the worker of the VM. The handle stays: the log, the exit
+// code and the callbacks are released by Delete.
+func (h *handle) stopVM() {
+	if h.h.Type() == js.TypeObject {
+		h.h.Call("stop")
+	}
+}
+
+func (h *handle) stop() {
+	h.stopVM()
+	funcs := h.funcs
+	h.funcs = nil
+	log := h.log
+	// The worker may still have sent messages that are not delivered yet
+	// (k8s/tabernetes/v86.go releases the same way); they still log.
+	time.AfterFunc(time.Minute, func() {
+		for _, f := range funcs {
+			f.Release()
+		}
+		if log != nil {
+			log.Close()
+		}
+	})
+}
diff --git a/core/runtime/v2/v86/jsruntime/kill_test.go b/core/runtime/v2/v86/jsruntime/kill_test.go
new file mode 100644
index 0000000..43d0da7
--- /dev/null
+++ b/core/runtime/v2/v86/jsruntime/kill_test.go
@@ -0,0 +1,192 @@
+//go:build js
+
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package jsruntime
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"syscall/js"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/errdefs"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// fakeVM is a vm object of a tab (web/src/vm.js) whose start() reports the
+// pull with a STOPSIGNAL and the start at once, and keeps the callbacks.
+type fakeVM struct {
+	mu      sync.Mutex
+	on      js.Value // the callbacks of the last start
+	stopped int
+	funcs   []js.Func
+}
+
+func (f *fakeVM) value() js.Value {
+	start := js.FuncOf(func(_ js.Value, a []js.Value) any {
+		on := a[1]
+		f.mu.Lock()
+		f.on = on
+		f.mu.Unlock()
+		on.Call("pulled", map[string]any{"stopSignal": "SIGQUIT"})
+		on.Call("started", map[string]any{})
+		stop := js.FuncOf(func(js.Value, []js.Value) any {
+			f.mu.Lock()
+			f.stopped++
+			f.mu.Unlock()
+			return nil
+		})
+		f.funcs = append(f.funcs, stop)
+		return map[string]any{"stop": stop}
+	})
+	f.funcs = append(f.funcs, start)
+	return js.ValueOf(map[string]any{"start": start})
+}
+
+// exit is init reporting "exit <code>" on ttyS1.
+func (f *fakeVM) exit(code int) {
+	f.mu.Lock()
+	on := f.on
+	f.mu.Unlock()
+	on.Call("exit", code, "")
+}
+
+func (f *fakeVM) stops() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.stopped
+}
+
+func newTask(t *testing.T, r *Runtime, id string) v86.Handle {
+	t.Helper()
+	v86.LogDir = t.TempDir()
+	h, err := r.Create(context.Background(), id, &specs.Spec{Process: &specs.Process{Args: []string{"sleep", "600"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { h.Delete(context.Background()) })
+	return h
+}
+
+func waitCode(t *testing.T, h v86.Handle) uint32 {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	code, err := h.Wait(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return code
+}
+
+func TestKill(t *testing.T) {
+	ctx := context.Background()
+	fvm := &fakeVM{}
+	vm := fvm.value()
+	r := NewRuntime(func() js.Value { return vm })
+	var mu sync.Mutex
+	var sent []uint32
+	// the main process: SIGTERM ends it with 143, SIGHUP is handled,
+	// SIGKILL never comes back (a VM that hangs)
+	r.Signal = func(ctx context.Context, _ js.Value, id string, sig uint32) error {
+		mu.Lock()
+		sent = append(sent, sig)
+		mu.Unlock()
+		switch sig {
+		case v86.SIGTERM:
+			go fvm.exit(143)
+		case 3:
+			return errors.New("container not running")
+		}
+		return nil
+	}
+	killWait = 200 * time.Millisecond
+
+	t.Run("the STOPSIGNAL of the image", func(t *testing.T) {
+		newTask(t, r, "sig")
+		if s := r.StopSignal("sig"); s != "SIGQUIT" {
+			t.Errorf("StopSignal %q; want SIGQUIT", s)
+		}
+	})
+
+	t.Run("SIGTERM: the exit code comes from init", func(t *testing.T) {
+		h := newTask(t, r, "term")
+		stops := fvm.stops()
+		if err := h.Kill(ctx, 1); err != nil {
+			t.Fatal(err)
+		}
+		if err := h.Kill(ctx, v86.SIGTERM); err != nil {
+			t.Fatal(err)
+		}
+		if code := waitCode(t, h); code != 143 {
+			t.Errorf("exit code %d; want 143", code)
+		}
+		// the rest of the VM ends with the main process
+		if fvm.stops() != stops+1 {
+			t.Errorf("the VM was stopped %d times; want once", fvm.stops()-stops)
+		}
+		if err := h.Kill(ctx, v86.SIGTERM); !errdefs.IsNotFound(err) {
+			t.Errorf("kill after the exit: %v; want not found", err)
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		if len(sent) < 2 || sent[len(sent)-2] != 1 || sent[len(sent)-1] != v86.SIGTERM {
+			t.Errorf("signals %v; want ... 1 15", sent)
+		}
+	})
+
+	t.Run("a signal that cannot be sent is an error", func(t *testing.T) {
+		h := newTask(t, r, "err")
+		if err := h.Kill(ctx, 3); err == nil {
+			t.Error("no error")
+		}
+		if st, _ := h.State(ctx); st.String() != "RUNNING" {
+			t.Errorf("state %v; want running", st)
+		}
+	})
+
+	t.Run("SIGKILL stops a VM that does not report the exit", func(t *testing.T) {
+		h := newTask(t, r, "kill")
+		stops := fvm.stops()
+		if err := h.Kill(ctx, v86.SIGKILL); err != nil {
+			t.Fatal(err)
+		}
+		if code := waitCode(t, h); code != 137 {
+			t.Errorf("exit code %d; want 137", code)
+		}
+		if fvm.stops() != stops+1 {
+			t.Errorf("the VM was stopped %d times; want once", fvm.stops()-stops)
+		}
+	})
+
+	t.Run("without signals the VM stops", func(t *testing.T) {
+		old := r.Signal
+		defer func() { r.Signal = old }()
+		r.Signal = func(context.Context, js.Value, string, uint32) error { return v86.ErrNoSignals }
+		h := newTask(t, r, "old")
+		if err := h.Kill(ctx, v86.SIGTERM); err != nil {
+			t.Fatal(err)
+		}
+		if code := waitCode(t, h); code != 143 {
+			t.Errorf("exit code %d; want 143", code)
+		}
+	})
+}
diff --git a/core/runtime/v2/v86/jsruntime/mounts.go b/core/runtime/v2/v86/jsruntime/mounts.go
new file mode 100644
index 0000000..77dcea2
--- /dev/null
+++ b/core/runtime/v2/v86/jsruntime/mounts.go
@@ -0,0 +1,117 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package jsruntime
+
+import (
+	"errors"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+	"time"
+)
+
+// A bind mount (docker run -v /root/site:/usr/share/nginx/html) shows the
+// files of the page, the file system of the terminal, to the container.
+// The VM worker gets a copy of them when the VM starts (BindSource) and
+// sends back what the container changed (BindChange, ApplyBind), every few
+// seconds and before the VM ends (web/src/volumes.js). So the terminal
+// sees the changes of the container a moment later; the container sees a
+// change of the terminal when it starts again.
+
+// BindSource reads the source of a bind mount: the files below a directory
+// (PrepareRootfs), or the data of a file. mode is the mode of the source.
+func BindSource(src string) (dir bool, mode uint32, files []File, data []byte, err error) {
+	fi, err := os.Stat(src)
+	if err != nil {
+		return false, 0, nil, nil, err
+	}
+	if !fi.IsDir() {
+		data, err = os.ReadFile(src)
+		return false, uint32(fi.Mode().Perm()), nil, data, err
+	}
+	files, err = PrepareRootfs(src)
+	return true, uint32(fi.Mode().Perm()), files, nil, err
+}
+
+// BindChange is a file that the container created or changed in a bind
+// mount: Path is below the source ("" is the source itself), Mode has the
+// type bits of Linux (sIFDIR, sIFREG, sIFLNK). HasData: Data is the new
+// content of a regular file; else only the mode or the time changed.
+type BindChange struct {
+	Path    string
+	Mode    uint32
+	Mtime   int64 // seconds
+	Data    []byte
+	HasData bool
+	Target  string // of a symbolic link
+}
+
+// below is the path of p below src; a path of the guest never leaves src.
+func below(src, p string) string {
+	return filepath.Join(src, filepath.Clean("/"+p))
+}
+
+// ApplyBind writes the changes of the container below src: first what it
+// removed (del), then what it made or changed, parents first.
+func ApplyBind(src string, set []BindChange, del []string) error {
+	var errs []error
+	sort.Sort(sort.Reverse(sort.StringSlice(del)))
+	for _, p := range del {
+		if filepath.Clean("/"+p) == "/" {
+			continue // the source itself stays, as on a host
+		}
+		if err := os.RemoveAll(below(src, p)); err != nil {
+			errs = append(errs, err)
+		}
+	}
+	sort.Slice(set, func(i, j int) bool { return set[i].Path < set[j].Path })
+	for _, c := range set {
+		path := below(src, c.Path)
+		perm := fs.FileMode(c.Mode & 0o7777)
+		var err error
+		switch c.Mode & 0o170000 {
+		case sIFDIR:
+			if err = os.MkdirAll(path, perm); err == nil {
+				err = os.Chmod(path, perm)
+			}
+		case sIFLNK:
+			os.RemoveAll(path)
+			err = os.Symlink(c.Target, path)
+		case sIFREG:
+			if c.HasData {
+				if fi, e := os.Lstat(path); e == nil && !fi.Mode().IsRegular() {
+					os.RemoveAll(path)
+				}
+				err = os.WriteFile(path, c.Data, perm)
+			}
+			if err == nil {
+				err = os.Chmod(path, perm)
+			}
+		default:
+			continue // devices and FIFOs stay in the VM
+		}
+		if err == nil && c.Mtime > 0 && c.Mode&0o170000 != sIFLNK {
+			t := time.Unix(c.Mtime, 0)
+			err = os.Chtimes(path, t, t)
+		}
+		if err != nil && !errors.Is(err, fs.ErrNotExist) {
+			errs = append(errs, err)
+		}
+	}
+	return errors.Join(errs...)
+}
