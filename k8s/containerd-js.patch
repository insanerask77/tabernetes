+// The ids, names and states of containers. dockerd keeps them in its own
+// store; here containerd is the only store. The containerd container id is
+// the Docker id (64 hex characters), and the labels below keep what
+// containerd has no field for. Labels live in containerd's metadata
+// database, so they stay as long as the container does.
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/big"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
