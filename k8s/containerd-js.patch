+type process struct {
+	cmd *exec.Cmd
+}
+
+// startProcess on js/wasm cannot fork a subprocess; the image verifier is not
+// used on the tab node. This keeps the package compiling and errors at run.
+func startProcess(ctx context.Context, cmd *exec.Cmd) (*process, error) {
+	cmd.Cancel = func() error { return cmd.Process.Kill() }
+	if err := cmd.Start(); err != nil {
+		return nil, err
+	}
+	return &process{cmd: cmd}, nil
+}
