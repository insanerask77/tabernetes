+package dockerapi
+
+// docker ps and docker inspect: GET /containers/json and
+// /containers/{id}/json, with the fields and the order of dockerd.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/pkg/oci"
+)
+
+// hostPort is a binding as the Docker API writes it.
+type hostPort struct {
+	HostIP   string `json:"HostIp"`
+	HostPort string `json:"HostPort"`
+}
+
+// publishedPorts are the ports of the label of docker run -p (v86.LabelPorts,
+// written by create and start, see ports.go).
+func publishedPorts(labels map[string]string) []v86.PortBinding {
+	ps, _ := v86.ParsePorts(labels)
+	for i := range ps {
+		if ps[i].Protocol == "" {
+			ps[i].Protocol = "tcp"
+		}
+	}
+	return ps
+}
+
+// portSummary is a port in docker ps (container.Port).
+type portSummary struct {
+	IP          string `json:"IP,omitempty"`
+	PrivatePort uint16
+	PublicPort  uint16 `json:",omitempty"`
+	Type        string
+}
+
+// containerSummary is an entry of GET /containers/json.
+type containerSummary struct {
+	ID      string `json:"Id"`
+	Names   []string
+	Image   string
+	ImageID string
+	Command string
+	Created int64
+	Ports   []portSummary
+	Labels  map[string]string
+	State   string
+	Status  string
+	// size=1: the writable layer and the image
+	SizeRw          int64 `json:",omitempty"`
+	SizeRootFs      int64 `json:",omitempty"`
+	HostConfig      struct{ NetworkMode string }
+	NetworkSettings struct{ Networks map[string]endpointJSON }
+	Mounts          []mountPointJSON
+}
+
+// containerInfo is what ps and inspect read of a container.
+type containerInfo struct {
+	c      client.Container
+	info   containers.Container
+	spec   oci.Spec
+	config imageConfig // of the image
+	state  containerState
+}
+
+func (s *Server) containerInfo(ctx context.Context, c client.Container) (containerInfo, error) {
+	info, err := c.Info(ctx, client.WithoutRefreshedMetadata)
+	if err != nil {
+		return containerInfo{}, err
+	}
+	ci := containerInfo{c: c, info: info}
+	if info.Spec != nil {
+		json.Unmarshal(info.Spec.GetValue(), &ci.spec)
+	}
+	if s := info.Labels[LabelConfig]; s != "" {
+		json.Unmarshal([]byte(s), &ci.config)
+	}
+	ci.state = s.state(ctx, c, info.Labels)
+	return ci, nil
+}
+
+func (ci containerInfo) process() (args []string, env []string, cwd string, tty bool) {
+	if p := ci.spec.Process; p != nil {
+		return p.Args, p.Env, p.Cwd, p.Terminal
+	}
+	return nil, nil, "", false
+}
+
+// argv is the command of the container, Path and Args of docker inspect:
+// with docker run --entrypoint, that entrypoint and the arguments only.
+func (ci containerInfo) argv() []string {
+	args, _, _, _ := ci.process()
+	if _, ep, ok := overrides(ci.spec.Annotations); ok {
+		return append(append([]string(nil), ep...), args...)
+	}
+	return command(ci.config, args)
+}
+
+// ports are the ports of docker ps: the published ones, and those the
+// image exposes. A stopped container has none, as in Docker.
+func (ci containerInfo) ports() []portSummary {
+	if !ci.state.Running || ci.state.Restarting {
+		return []portSummary{}
+	}
+	out := []portSummary{}
+	published := map[string]bool{}
+	for _, p := range publishedPorts(ci.info.Labels) {
+		priv, _ := strconv.Atoi(p.ContainerPort)
+		pub, _ := strconv.Atoi(p.HostPort)
+		ip := p.HostIp
+		if ip == "" {
+			ip = "0.0.0.0"
+		}
+		out = append(out, portSummary{IP: ip, PrivatePort: uint16(priv), PublicPort: uint16(pub), Type: p.Protocol})
+		published[p.ContainerPort+"/"+p.Protocol] = true
+	}
+	for port := range ci.config.ExposedPorts {
+		if published[port] {
+			continue
+		}
+		n, proto, _ := strings.Cut(port, "/")
+		if proto == "" {
+			proto = "tcp"
+		}
+		priv, err := strconv.Atoi(n)
+		if err != nil {
+			continue
+		}
+		out = append(out, portSummary{PrivatePort: uint16(priv), Type: proto})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].PrivatePort != out[j].PrivatePort {
+			return out[i].PrivatePort < out[j].PrivatePort
+		}
+		return out[i].PublicPort < out[j].PublicPort
+	})
+	return out
+}
+
+// userLabels are the labels of the container without those of Tabernetes.
+func userLabels(labels map[string]string) map[string]string {
+	out := map[string]string{}
+	for k, v := range labels {
+		if !strings.HasPrefix(k, labelPrefix) {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// list answers GET /containers/json: the running containers, all of them
+// with all=1, newest first; limit=n the n newest of all; size=1 adds the
+// sizes. filters= works as in dockerd (daemon/list.go): see psFilter.
+func (s *Server) list(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	all := queryBool(r, "all")
+	limit, _ := strconv.Atoi(q.Get("limit"))
+	f, err := parseFilters(q.Get("filters"))
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	cs, err := s.client.Containers(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	infos := make([]containerInfo, 0, len(cs))
+	for _, c := range cs {
+		if ci, err := s.containerInfo(ctx, c); err == nil {
+			infos = append(infos, ci)
+		}
+	}
+	sort.SliceStable(infos, func(i, j int) bool { return infos[i].info.CreatedAt.After(infos[j].info.CreatedAt) })
+	pf, err := s.psFilter(ctx, f, cs)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	if pf.all {
+		all = true // a status filter lists all containers
+	}
+	var imgs []Image
+	if queryBool(r, "size") && s.Images != nil {
+		imgs, _ = s.Images.List(ctx)
+	}
+	now := time.Now()
+	out := []containerSummary{}
+	before, since := pf.before, pf.since
+	for _, ci := range infos {
+		id := ci.c.ID()
+		if before != "" {
+			// what comes before (newer than) the container, and it
+			if id == before {
+				before = ""
+			}
+			continue
+		}
+		if since != "" && id == since {
+			break
+		}
+		if !ci.state.Running && !all && limit <= 0 {
+			continue
+		}
+		if !pf.matches(ci) {
+			continue
+		}
+		if limit > 0 && len(out) == limit {
+			break
+		}
+		if !pf.matchesState(ci) {
+			continue
+		}
+		sum := ci.summary(now)
+		if imgs != nil {
+			for _, img := range imgs {
+				if img.ID == ci.info.Labels[LabelImageID] {
+					// The files the container wrote live in its VM and go
+					// with it: there is no writable layer to measure.
+					sum.SizeRw, sum.SizeRootFs = 0, img.Size
+					break
+				}
+			}
+		}
+		out = append(out, sum)
+	}
+	writeJSON(w, out)
+}
+
+// summary is the entry of a container in GET /containers/json.
+func (ci containerInfo) summary(now time.Time) containerSummary {
+	sum := containerSummary{
+		ID:      ci.c.ID(),
+		Names:   []string{"/" + containerName(ci.c.ID(), ci.info.Labels)},
+		Image:   ci.info.Image,
+		ImageID: ci.info.Labels[LabelImageID],
+		Command: strings.Join(ci.argv(), " "),
+		Created: ci.info.CreatedAt.Unix(),
+		Ports:   ci.ports(),
+		Labels:  ci.labels(),
+		State:   ci.state.Status,
+		Status:  ci.state.String(now),
+		Mounts:  mountPoints(v86.MountsOf(ci.spec.Annotations)),
+	}
+	sum.HostConfig.NetworkMode = "bridge"
+	// A container stays on the default bridge when it stops, as in Docker.
+	sum.NetworkSettings.Networks = map[string]endpointJSON{"bridge": {NetworkID: "bridge"}}
+	return sum
+}
+
+// labels are the labels of docker inspect and docker ps: those of the image
+// and those of the container, which win, as dockerd merges them at create.
+func (ci containerInfo) labels() map[string]string {
+	out := map[string]string{}
+	for k, v := range ci.config.Labels {
+		out[k] = v
+	}
+	for k, v := range userLabels(ci.info.Labels) {
+		out[k] = v
+	}
+	return out
+}
+
+// psFilters are the filters of docker ps (acceptedPsFilterTags of dockerd).
+var psFilters = []string{"ancestor", "before", "exited", "id", "isolation", "label", "name", "status", "health",
+	"since", "volume", "network", "is-task", "publish", "expose"}
+
+// psFilter is a filter of docker ps, folded once per request (dockerd's
+// foldFilter and listContext).
+type psFilter struct {
+	f             filterArgs
+	all           bool            // status lists all containers
+	exited        []int           // exited=
+	isTask        *bool           // is-task=
+	before, since string          // container ids
+	ancestor      bool            // ancestor= given
+	images        map[string]bool // image ids of ancestor
+	ids           map[string]bool // unique id prefixes of id=
+	publish       map[string]bool // "8080/tcp"
+	expose        map[string]bool
+}
+
+// errInvalidParameter is a client error: the API answers 400.
+type errInvalidParameter struct{ error }
+
+func (errInvalidParameter) InvalidParameter() {}
+
+func (s *Server) psFilter(ctx context.Context, f filterArgs, all []client.Container) (*psFilter, error) {
+	bad := func(err error) error { return errInvalidParameter{err} }
+	if err := f.validate(psFilters...); err != nil {
+		return nil, bad(err)
+	}
+	pf := &psFilter{f: f, images: map[string]bool{}}
+	for _, v := range f.get("exited") {
+		code, err := strconv.Atoi(v)
+		if err != nil {
+			return nil, bad(fmt.Errorf("invalid filter 'exited=%s': %w", v, err))
+		}
+		pf.exited = append(pf.exited, code)
+	}
+	for _, v := range f.get("status") {
+		if !contains(validStates, v) {
+			return nil, bad(fmt.Errorf("invalid filter 'status=%s': invalid value for state (%s): must be one of %s", v, v, strings.Join(validStates, ", ")))
+		}
+		pf.all = true
+	}
+	if f.contains("is-task") {
+		t, err := f.boolOrDefault("is-task", false)
+		if err != nil {
+			return nil, bad(err)
+		}
+		pf.isTask = &t
+	}
+	for _, v := range f.get("health") {
+		if !contains(validHealths, v) {
+			return nil, bad(fmt.Errorf("invalid filter 'health=%s': invalid value for health (%s): must be one of %s", v, v, strings.Join(validHealths, ", ")))
+		}
+	}
+	names := s.names(ctx, all)
+	for _, key := range []string{"before", "since"} {
+		for _, v := range f.get(key) {
+			c, err := lookup(all, names, v)
+			if err != nil {
+				return nil, err
+			}
+			if key == "before" {
+				pf.before = c.ID()
+			} else {
+				pf.since = c.ID()
+			}
+		}
+	}
+	if f.contains("ancestor") {
+		pf.ancestor = true
+		if s.Images != nil {
+			imgs, err := s.Images.List(ctx)
+			if err != nil {
+				return nil, err
+			}
+			// An image that is not there is left out, as dockerd does. The
+			// store knows no parent images, so only the image itself counts.
+			for _, v := range f.get("ancestor") {
+				if img, ok := findImage(imgs, v); ok {
+					pf.images[img.ID] = true
+				}
+			}
+		}
+	}
+	if f.contains("id") {
+		pf.ids = map[string]bool{}
+		for _, v := range f.get("id") {
+			if c, err := lookup(all, nil, v); err == nil {
+				pf.ids[c.ID()] = true
+			}
+		}
+	}
+	var err error
+	if pf.publish, err = portFilter(f, "publish"); err != nil {
+		return nil, bad(err)
+	}
+	if pf.expose, err = portFilter(f, "expose"); err != nil {
+		return nil, bad(err)
+	}
+	return pf, nil
+}
+
+// validStates and validHealths are what dockerd accepts for status and
+// health.
+var (
+	validStates  = []string{"created", "running", "paused", "restarting", "removing", "exited", "dead"}
+	validHealths = []string{"none", "starting", "healthy", "unhealthy"}
+)
+
+// matches checks what dockerd checks before the limit: name, id, is-task,
+// label and isolation.
+func (pf *psFilter) matches(ci containerInfo) bool {
+	f, id := pf.f, ci.c.ID()
+	name := containerName(id, ci.info.Labels)
+	if pf.ids != nil && !pf.ids[id] {
+		return false
+	}
+	if !f.match("name", "/"+name) && !f.match("name", name) {
+		return false
+	}
+	if !f.match("id", id) {
+		return false
+	}
+	if pf.isTask != nil && *pf.isTask {
+		return false // no container is a swarm task
+	}
+	if !f.matchKVList("label", ci.labels()) {
+		return false
+	}
+	return f.match("isolation", "default")
+}
+
+// matchesState checks the rest, after the limit, in the order of dockerd.
+func (pf *psFilter) matchesState(ci containerInfo) bool {
+	f, st := pf.f, ci.state
+	if len(pf.exited) > 0 {
+		ok := false
+		for _, code := range pf.exited {
+			if code == st.ExitCode && !st.Running && !st.StartedAt.IsZero() {
+				ok = true
+				break
+			}
+		}
+		if !ok {
+			return false
+		}
+	}
+	if !f.match("status", st.Status) {
+		return false
+	}
+	// no container has a health check
+	if !f.exactMatch("health", "none") {
+		return false
+	}
+	if f.contains("volume") {
+		found := false
+		for _, v := range f.get("volume") {
+			for _, m := range ci.spec.Mounts {
+				if m.Destination == v || m.Source == v {
+					found = true
+				}
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	if pf.ancestor && !pf.images[ci.info.Labels[LabelImageID]] {
+		return false
+	}
+	if f.contains("network") {
+		found := false
+		for _, v := range f.get("network") {
+			if v == "bridge" || strings.HasPrefix("bridge", v) {
+				found = true
+			}
+		}
+		if !found {
+			return false
+		}
+	}
+	if len(pf.publish) > 0 || len(pf.expose) > 0 {
+		for _, p := range ci.ports() {
+			if pf.publish[fmt.Sprintf("%d/%s", p.PublicPort, p.Type)] || pf.expose[fmt.Sprintf("%d/%s", p.PrivatePort, p.Type)] {
+				return true
+			}
+		}
+		return false
+	}
+	return true
+}
+
+// The answer of docker inspect, in the order of dockerd's ContainerJSON.
+type containerJSON struct {
+	ID              string `json:"Id"`
+	Created         string
+	Path            string
+	Args            []string
+	State           stateJSON
+	Image           string
+	ResolvConfPath  string
+	HostnamePath    string
+	HostsPath       string
+	LogPath         string
+	Name            string
+	RestartCount    int
+	Driver          string
+	Platform        string
+	MountLabel      string
+	ProcessLabel    string
+	AppArmorProfile string
+	ExecIDs         []string
+	HostConfig      hostConfigJSON
+	Mounts          []mountPointJSON
+	Config          configJSON
+	NetworkSettings networkSettingsJSON
+}
+
+type stateJSON struct {
+	Status     string
+	Running    bool
+	Paused     bool
+	Restarting bool
+	OOMKilled  bool
+	Dead       bool
+	Pid        int
+	ExitCode   int
+	Error      string
+	StartedAt  string
+	FinishedAt string
+}
+
+type hostConfigJSON struct {
+	NetworkMode     string
+	PortBindings    map[string][]hostPort
+	RestartPolicy   restartPolicy
+	AutoRemove      bool
+	PublishAllPorts bool
+	LogConfig       logConfig
+	Runtime         string
+	Memory          int64
+}
+
+type configJSON struct {
+	Hostname     string
+	Domainname   string
+	User         string
+	AttachStdin  bool
+	AttachStdout bool
+	AttachStderr bool
+	ExposedPorts map[string]struct{} `json:",omitempty"`
+	Tty          bool
+	OpenStdin    bool
+	StdinOnce    bool
+	Env          []string
+	Cmd          []string
+	Image        string
+	Volumes      map[string]struct{}
+	WorkingDir   string
+	Entrypoint   []string
+	OnBuild      []string
+	Labels       map[string]string
+}
+
+type endpointJSON struct {
+	NetworkID   string
+	Gateway     string
+	IPAddress   string
+	IPPrefixLen int
+	MacAddress  string
+}
+
+type networkSettingsJSON struct {
+	Bridge      string
+	SandboxID   string
+	SandboxKey  string
+	Ports       map[string][]hostPort
+	Gateway     string
+	IPAddress   string
+	IPPrefixLen int
+	MacAddress  string
+	Networks    map[string]endpointJSON
+}
+
+// inspect answers GET /containers/{id}/json.
+func (s *Server) inspect(ctx context.Context, w http.ResponseWriter, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	ci, err := s.containerInfo(ctx, c)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, s.inspectJSON(ci))
+}
+
+func (s *Server) inspectJSON(ci containerInfo) containerJSON {
+	id := ci.c.ID()
+	labels := ci.info.Labels
+	args, env, cwd, tty := ci.process()
+	argv := ci.argv()
+	var path string
+	var rest []string
+	if len(argv) > 0 {
+		path, rest = argv[0], argv[1:]
+	}
+	if rest == nil {
+		rest = []string{}
+	}
+	cmd := args
+	entrypoint := ci.config.Entrypoint
+	user, ep, override := overrides(ci.spec.Annotations)
+	if override {
+		// dockerd drops the CMD of the image with the entrypoint
+		entrypoint = nil
+		if len(ep) > 0 {
+			entrypoint = ep
+		}
+	} else if len(cmd) == 0 {
+		cmd = ci.config.Cmd
+	}
+	if user == "" {
+		user = ci.config.User
+	}
+	if cwd == "" {
+		cwd = ci.config.WorkingDir
+	}
+	st := ci.state
+	out := containerJSON{
+		ID:           id,
+		Created:      formatTime(ci.info.CreatedAt),
+		Path:         path,
+		Args:         rest,
+		RestartCount: restartCountOf(labels),
+		State: stateJSON{
+			Status: st.Status, Running: st.Running, Paused: st.Paused, Restarting: st.Restarting, Pid: st.Pid, ExitCode: st.ExitCode,
+			StartedAt: formatTime(st.StartedAt), FinishedAt: formatTime(st.FinishedAt),
+		},
+		Image:    labels[LabelImageID],
+		LogPath:  v86.LogPath(id),
+		Name:     "/" + containerName(id, labels),
+		Driver:   "v86",
+		Platform: "linux",
+		Mounts:   mountPoints(v86.MountsOf(ci.spec.Annotations)),
+		Config: configJSON{
+			Hostname:     shortLayer(id),
+			User:         user,
+			AttachStdout: true,
+			AttachStderr: true,
+			ExposedPorts: ci.config.ExposedPorts,
+			Tty:          tty,
+			OpenStdin:    ci.spec.Annotations[v86.AnnotationStdin] == "true",
+			StdinOnce:    ci.spec.Annotations[v86.AnnotationStdinOnce] == "true",
+			Env:          mergeEnv(ci.config.Env, env),
+			Cmd:          cmd,
+			Image:        ci.info.Image,
+			WorkingDir:   cwd,
+			Entrypoint:   entrypoint,
+			Volumes:      ci.config.Volumes,
+			Labels:       ci.labels(),
+		},
+	}
+	if out.Config.Env == nil {
+		out.Config.Env = []string{}
+	}
+	if ci.spec.Hostname != "" {
+		out.Config.Hostname = ci.spec.Hostname
+	}
+	out.Config.AttachStdin = out.Config.OpenStdin
+	hc := &out.HostConfig
+	hc.NetworkMode = "bridge"
+	hc.RestartPolicy = policyOf(labels)
+	hc.PublishAllPorts = labels[LabelPublishAll] == "true"
+	hc.AutoRemove = labels[LabelAutoRemove] == "true"
+	hc.Runtime = ci.info.Runtime.Name
+	hc.LogConfig = logConfigOf(ci.spec.Annotations)
+	hc.PortBindings = map[string][]hostPort{}
+	ports := map[string][]hostPort{}
+	for _, p := range publishedPorts(labels) {
+		key := p.ContainerPort + "/" + p.Protocol
+		hostIP := p.HostIp
+		if hostIP == "0.0.0.0" {
+			hostIP = "" // what -p 8080:80 sends
+		}
+		hc.PortBindings[key] = append(hc.PortBindings[key], hostPort{HostIP: hostIP, HostPort: p.HostPort})
+		ip := p.HostIp
+		if ip == "" {
+			ip = "0.0.0.0"
+		}
+		ports[key] = append(ports[key], hostPort{HostIP: ip, HostPort: p.HostPort})
+	}
+	for port := range ci.config.ExposedPorts {
+		if _, ok := ports[port]; !ok {
+			ports[port] = nil
+		}
+	}
+	if ci.spec.Linux != nil && ci.spec.Linux.Resources != nil && ci.spec.Linux.Resources.Memory != nil && ci.spec.Linux.Resources.Memory.Limit != nil {
+		hc.Memory = *ci.spec.Linux.Resources.Memory.Limit
+	}
+	ns := &out.NetworkSettings
+	ns.Ports = map[string][]hostPort{}
+	ns.Networks = map[string]endpointJSON{}
+	if st.Running && !st.Restarting {
+		ns.Ports = ports
+		if s.Addresses != nil {
+			if ip, gw, ok := s.Addresses(id); ok {
+				ns.IPAddress, ns.Gateway, ns.IPPrefixLen = ip, gw, 16
+				ns.Networks["bridge"] = endpointJSON{NetworkID: "bridge", Gateway: gw, IPAddress: ip, IPPrefixLen: 16}
+			}
+		}
+	}
+	return out
+}
