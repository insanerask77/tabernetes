+// PathStat is the stat of a path in a container, as dockerd sends it in
+// the header X-Docker-Container-Path-Stat (container.PathStat). Mode is a
+// Go os.FileMode, as in Docker.
+type PathStat struct {
+	Name       string      `json:"name"`
+	Size       int64       `json:"size"`
+	Mode       os.FileMode `json:"mode"`
+	Mtime      time.Time   `json:"mtime"`
+	LinkTarget string      `json:"linkTarget"`
+}
+
+// ContainerFiles reads and writes the files of a container, for docker cp
+// (GET, HEAD and PUT /containers/{id}/archive). The glue sets it: a
+// running container has its files in its VM, a stopped one only its image
+// and what docker cp put into it. image is the image of the container.
+// A path that is not there gives errdefs.ErrNotFound.
+type ContainerFiles interface {
+	Stat(ctx context.Context, id, image, path string, running bool) (PathStat, error)
+	// Archive returns path as a tar, named by its base name.
+	Archive(ctx context.Context, id, image, path string, running bool) (PathStat, []byte, error)
+	// Extract puts the files of a tar into the directory dir.
+	Extract(ctx context.Context, id, image, dir string, running bool, files []v86.CopiedFile) error
+}
+
+// FileModeOf turns a Linux mode into a Go os.FileMode.
+func FileModeOf(mode uint32) os.FileMode {
+	m := os.FileMode(mode & 0o777)
+	switch mode & v86.ModeType {
+	case v86.ModeDir:
+		m |= os.ModeDir
+	case v86.ModeSymlink:
+		m |= os.ModeSymlink
+	case 0o010000:
+		m |= os.ModeNamedPipe
+	}
+	if mode&0o4000 != 0 {
+		m |= os.ModeSetuid
+	}
+	if mode&0o2000 != 0 {
+		m |= os.ModeSetgid
+	}
+	if mode&0o1000 != 0 {
+		m |= os.ModeSticky
+	}
+	return m
+}
+
+// archive serves docker cp: HEAD for the stat of ?path=, GET for a tar of
+// it, PUT to put a tar into the directory ?path=.
+func (s *Server) archive(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	if s.Files == nil {
+		http.Error(w, "copying files is not supported", http.StatusNotImplemented)
+		return
+	}
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	path := r.URL.Query().Get("path")
+	if path == "" {
+		http.Error(w, "path is required", http.StatusBadRequest)
+		return
+	}
+	image := ""
+	if spec, err := c.Spec(ctx); err == nil {
+		image = spec.Annotations[AnnotationImageName]
+	}
+	running := s.running(c.ID()) != nil
+	notFound := func() {
+		// dockerd's containerFileNotFound
+		http.Error(w, fmt.Sprintf("Could not find the file %s in container %s", path, id), http.StatusNotFound)
+	}
+	setStat := func(st PathStat) {
+		b, _ := json.Marshal(st)
+		w.Header().Set("X-Docker-Container-Path-Stat", base64.StdEncoding.EncodeToString(b))
+	}
+	switch r.Method {
+	case http.MethodHead:
+		st, err := s.Files.Stat(ctx, c.ID(), image, path, running)
+		if errdefs.IsNotFound(err) {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		if err != nil {
+			w.WriteHeader(http.StatusInternalServerError)
+			return
+		}
+		setStat(st)
+		w.WriteHeader(http.StatusOK)
+	case http.MethodGet:
+		st, tarball, err := s.Files.Archive(ctx, c.ID(), image, path, running)
+		if errdefs.IsNotFound(err) {
+			notFound()
+			return
+		}
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		setStat(st)
+		w.Header().Set("Content-Type", "application/x-tar")
+		w.Write(tarball)
+	case http.MethodPut:
+		st, err := s.Files.Stat(ctx, c.ID(), image, path, running)
+		if errdefs.IsNotFound(err) {
+			notFound()
+			return
+		}
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		if !st.Mode.IsDir() {
+			// archive.ErrExtractPointNotDirectory of moby
+			http.Error(w, "extraction point is not a directory", http.StatusBadRequest)
+			return
+		}
+		files, err := v86.ReadTar(r.Body)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+		if err := s.Files.Extract(ctx, c.ID(), image, path, running, files); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		w.WriteHeader(http.StatusOK)
+	default:
+		http.Error(w, "not implemented", http.StatusNotImplemented)
+	}
+}
