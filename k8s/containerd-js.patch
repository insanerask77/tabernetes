+
+package jsruntime
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestBindRoundTrip(t *testing.T) {
+	src := t.TempDir()
+	os.WriteFile(filepath.Join(src, "index.html"), []byte("old"), 0o644)
+	os.Mkdir(filepath.Join(src, "gone"), 0o755)
+	os.WriteFile(filepath.Join(src, "gone", "x"), []byte("x"), 0o644)
+
+	dir, mode, files, _, err := BindSource(src)
+	if err != nil || !dir || mode&0o700 != 0o700 || len(files) != 3 {
+		t.Fatalf("BindSource = %v %o %+v %v", dir, mode, files, err)
+	}
+	err = ApplyBind(src, []BindChange{
+		{Path: "index.html", Mode: sIFREG | 0o600, Data: []byte("new"), HasData: true, Mtime: 1000},
+		{Path: "a/b", Mode: sIFDIR | 0o750},
+		{Path: "a/b/c.txt", Mode: sIFREG | 0o644, Data: []byte("c"), HasData: true},
+		{Path: "link", Mode: sIFLNK | 0o777, Target: "index.html"},
+		{Path: "../../escape", Mode: sIFREG | 0o644, Data: []byte("e"), HasData: true},
+	}, []string{"gone/x", "gone"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(filepath.Join(src, "index.html")); string(b) != "new" {
+		t.Errorf("index.html = %q", b)
+	}
+	if fi, _ := os.Stat(filepath.Join(src, "index.html")); fi.Mode().Perm() != 0o600 || fi.ModTime().Unix() != 1000 {
+		t.Errorf("index.html: %v %v", fi.Mode(), fi.ModTime())
+	}
+	if b, _ := os.ReadFile(filepath.Join(src, "a/b/c.txt")); string(b) != "c" {
+		t.Errorf("c.txt = %q", b)
+	}
+	if l, _ := os.Readlink(filepath.Join(src, "link")); l != "index.html" {
+		t.Errorf("link -> %q", l)
+	}
+	if _, err := os.Stat(filepath.Join(src, "gone")); !os.IsNotExist(err) {
+		t.Errorf("gone is still there: %v", err)
+	}
+	// a path of the guest stays below the source
+	if b, _ := os.ReadFile(filepath.Join(src, "escape")); string(b) != "e" {
+		t.Errorf("escape = %q", b)
+	}
+
+	// a file
+	f := filepath.Join(src, "index.html")
+	if dir, _, _, data, err := BindSource(f); err != nil || dir || string(data) != "new" {
+		t.Errorf("BindSource(file) = %v %q %v", dir, data, err)
+	}
+	if err := ApplyBind(f, []BindChange{{Path: "", Mode: sIFREG | 0o644, Data: []byte("file"), HasData: true}}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if b, _ := os.ReadFile(f); string(b) != "file" {
+		t.Errorf("file = %q", b)
+	}
+}
diff --git a/core/runtime/v2/v86/jsruntime/prepare.go b/core/runtime/v2/v86/jsruntime/prepare.go
new file mode 100644
index 0000000..739824d
--- /dev/null
+++ b/core/runtime/v2/v86/jsruntime/prepare.go
@@ -0,0 +1,96 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package jsruntime
+
+import (
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"sort"
+)
+
+// The mode bits of the v86 file system JSON, matching web/src/rootfs.js.
+const (
+	sIFREG = 0o100000
+	sIFDIR = 0o040000
+	sIFLNK = 0o120000
+)
+
+// File is one entry of a prepared rootfs, serialized to the VM worker.
+type File struct {
+	Path   string `json:"path"`
+	Mode   uint32 `json:"mode"`
+	Data   []byte `json:"data,omitempty"`
+	Target string `json:"target,omitempty"` // symlink target
+}
+
+// PrepareRootfs walks dir and serializes it into the flat file list that the
+// v86 VM worker (web/src/vmworker.js) builds its 9p root file system from.
+// Directories and symlinks carry their metadata; regular files carry their
+// contents. Special files (device nodes, sockets, fifos) are skipped: the
+// guest's devtmpfs provides /dev.
+//
+// NOTE: this loads every regular file into memory, which is fine for a small
+// rootfs but not for a full container image. The real path serves the containerd
+// snapshot layers from OPFS (web/src/layers.js) instead of shipping the bytes.
+func PrepareRootfs(dir string) ([]File, error) {
+	var out []File
+	err := filepath.WalkDir(dir, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		rel, err := filepath.Rel(dir, path)
+		if err != nil {
+			return err
+		}
+		if rel == "." {
+			return nil
+		}
+		rel = filepath.ToSlash(rel)
+
+		info, err := d.Info()
+		if err != nil {
+			return err
+		}
+		mode := info.Mode()
+
+		switch {
+		case mode.IsDir():
+			out = append(out, File{Path: rel, Mode: sIFDIR | uint32(mode.Perm())})
+		case mode&os.ModeSymlink != 0:
+			target, err := os.Readlink(path)
+			if err != nil {
+				return err
+			}
+			out = append(out, File{Path: rel, Mode: sIFLNK | 0o777, Target: target})
+		case mode.IsRegular():
+			data, err := os.ReadFile(path)
+			if err != nil {
+				return err
+			}
+			out = append(out, File{Path: rel, Mode: sIFREG | uint32(mode.Perm()), Data: data})
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, fmt.Errorf("preparing rootfs %s: %w", dir, err)
+	}
+	// WalkDir visits parents before children; sort for a stable output anyway.
+	sort.Slice(out, func(i, j int) bool { return out[i].Path < out[j].Path })
+	return out, nil
+}
diff --git a/core/runtime/v2/v86/jsruntime/prepare_test.go b/core/runtime/v2/v86/jsruntime/prepare_test.go
