+*/
+
+package v86
+
+import "testing"
+
+func TestParseSignal(t *testing.T) {
+	for in, want := range map[string]uint32{
+		"15": 15, "SIGTERM": 15, "TERM": 15, "term": 15, "sigkill": 9, "HUP": 1,
+		"SIGWINCH": 28, "QUIT": 3, "RTMIN": 34, "RTMIN+3": 37, "SIGRTMAX-1": 63, "64": 64,
+	} {
+		if got, err := ParseSignal(in); err != nil || got != want {
+			t.Errorf("ParseSignal(%q) = %d, %v; want %d", in, got, err, want)
+		}
+	}
+	for _, in := range []string{"", "0", "65", "FOO", "SIG", "RTMIN-1", "RTMAX+1", "RTMIN+31", "RTMIN+x", "-1"} {
+		if got, err := ParseSignal(in); err == nil {
+			t.Errorf("ParseSignal(%q) = %d; want an error", in, got)
+		} else if err.Error() != "Invalid signal: "+in {
+			t.Errorf("ParseSignal(%q): %v; want dockerd's message", in, err)
+		}
+	}
+}
diff --git a/core/runtime/v2/v86/stats.go b/core/runtime/v2/v86/stats.go
new file mode 100644
index 0000000..8aae8db
--- /dev/null
+++ b/core/runtime/v2/v86/stats.go
@@ -0,0 +1,132 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86
+
+import (
+	"bufio"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Stats is what docker stats shows of a container, read in its VM: init
+// sends the cpu line of /proc/stat, /proc/meminfo, /proc/net/dev and the
+// number of processes (stats_report in vm/init/init.c). Docker reads the
+// same numbers from the cgroup of the container; here the VM is the
+// container, so its kernel has them.
+type Stats struct {
+	Read time.Time
+	// CPU time in nanoseconds: user and system time of all processes, and
+	// all time (idle too), as the cpu line of /proc/stat counts it.
+	CPUUser, CPUSystem, CPUTotal uint64
+	// memory in bytes, from /proc/meminfo
+	MemTotal, MemFree, MemAvailable uint64
+	// the network card of the VM (eth0)
+	RxBytes, RxPackets, RxErrors, RxDropped uint64
+	TxBytes, TxPackets, TxErrors, TxDropped uint64
+	// processes of the container: all but init and the kernel threads
+	Pids uint64
+}
+
+// jiffy is the unit of /proc/stat: USER_HZ is 100 on x86.
+const jiffy = uint64(10 * time.Millisecond)
+
+// ParseStats reads the report of init: sections that start with a line
+// "== <name>".
+func ParseStats(report []byte, read time.Time) (Stats, error) {
+	st := Stats{Read: read}
+	section := ""
+	seen := 0
+	sc := bufio.NewScanner(strings.NewReader(string(report)))
+	sc.Buffer(make([]byte, 64<<10), 1<<20)
+	for sc.Scan() {
+		line := sc.Text()
+		if name, ok := strings.CutPrefix(line, "== "); ok {
+			section = name
+			seen++
+			continue
+		}
+		f := strings.Fields(line)
+		switch section {
+		case "/proc/stat":
+			if len(f) < 5 || f[0] != "cpu" {
+				continue
+			}
+			var v [10]uint64
+			for i := 1; i < len(f) && i <= len(v); i++ {
+				v[i-1], _ = strconv.ParseUint(f[i], 10, 64)
+			}
+			// user nice system idle iowait irq softirq steal (guest time
+			// is in user already)
+			st.CPUUser = (v[0] + v[1]) * jiffy
+			st.CPUSystem = (v[2] + v[5] + v[6]) * jiffy
+			st.CPUTotal = (v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7]) * jiffy
+		case "/proc/meminfo":
+			if len(f) < 2 {
+				continue
+			}
+			n, _ := strconv.ParseUint(f[1], 10, 64)
+			if len(f) > 2 && f[2] == "kB" {
+				n *= 1024
+			}
+			switch f[0] {
+			case "MemTotal:":
+				st.MemTotal = n
+			case "MemFree:":
+				st.MemFree = n
+			case "MemAvailable:":
+				st.MemAvailable = n
+			}
+		case "/proc/net/dev":
+			name, rest, ok := strings.Cut(line, ":")
+			if !ok || strings.TrimSpace(name) != "eth0" {
+				continue
+			}
+			var v [16]uint64
+			for i, x := range strings.Fields(rest) {
+				if i < len(v) {
+					v[i], _ = strconv.ParseUint(x, 10, 64)
+				}
+			}
+			st.RxBytes, st.RxPackets, st.RxErrors, st.RxDropped = v[0], v[1], v[2], v[3]
+			st.TxBytes, st.TxPackets, st.TxErrors, st.TxDropped = v[8], v[9], v[10], v[11]
+		case "pids":
+			if len(f) == 1 {
+				st.Pids, _ = strconv.ParseUint(f[0], 10, 64)
+			}
+		}
+	}
+	if seen < 4 {
+		return st, fmt.Errorf("incomplete stats from the VM")
+	}
+	if st.MemAvailable == 0 {
+		st.MemAvailable = st.MemFree
+	}
+	return st, nil
+}
+
+// MemUsage is the memory that the container uses: what the kernel of the
+// VM cannot give to a new process (MemTotal - MemAvailable), as free(1)
+// counts "used". The page cache that can be dropped is not in it, as
+// docker stats leaves out inactive files.
+func (s Stats) MemUsage() uint64 {
+	if s.MemAvailable > s.MemTotal {
+		return 0
+	}
+	return s.MemTotal - s.MemAvailable
+}
