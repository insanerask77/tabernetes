+	"github.com/containerd/containerd/v2/pkg/cio"
+	"github.com/containerd/containerd/v2/pkg/oci"
+)
+
+// The daemon starts once per process: its plugins and listen addresses are
+// process wide.
+var (
+	startMu     sync.Mutex
+	testDaemon  *Daemon
+	testRuntime = fake.NewRuntime()
+)
+
+// Its directory outlives every test, unlike t.TempDir.
+func startOnce(t *testing.T, ctx context.Context) *Daemon {
+	startMu.Lock()
+	defer startMu.Unlock()
+	if testDaemon == nil {
+		dir, err := os.MkdirTemp("", "v86-daemon-")
+		if err != nil {
+			t.Fatal(err)
+		}
+		d, err := Start(ctx, dir+"/root", dir+"/state", "default", testRuntime)
+		if err != nil {
+			t.Fatal(err)
+		}
+		testDaemon = d
+	}
+	return testDaemon
+}
+
+// TestDaemon runs the daemon in-process and a task through the whole path:
+// client, grpc, tasks service, v2 runtime, in-process shim over ttrpc and the
+// runtime. On js/wasm it runs in Node.js (go_js_wasm_exec).
+func TestDaemon(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+
+	d := startOnce(t, ctx)
+
+	v, err := d.Client.Version(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Logf("containerd %s", v.Version)
+
+	c, err := d.Client.NewContainer(ctx, "c1", client.WithNewSpec(
+		oci.WithAnnotations(map[string]string{"io.containerd.image.name": "nginx"}),
+		oci.WithProcessArgs("nginx", "-g", "daemon off;"),
+	))
+	if err != nil {
+		t.Fatal(err)
+	}
+	tk, err := c.NewTask(ctx, cio.NullIO)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := testRuntime.Created["c1"]
+	if h == nil {
+		t.Fatal("the runtime got no task c1")
+	}
+	exitC, err := tk.Wait(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := tk.Start(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if st, err := tk.Status(ctx); err != nil || st.Status != client.Running {
+		t.Fatalf("status %v, %v; want running", st.Status, err)
+	}
+	if st, _ := h.State(ctx); st != task.Status_RUNNING {
+		t.Fatalf("runtime state %v; want running", st)
+	}
+
+	h.ExitCode(3)
+	select {
+	case s := <-exitC:
+		if s.ExitCode() != 3 {
+			t.Fatalf("exit code %d (%v); want 3", s.ExitCode(), s.Error())
+		}
+	case <-ctx.Done():
+		t.Fatal("no exit")
+	}
+	if _, err := tk.Delete(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.Delete(ctx); err != nil {
+		t.Fatal(err)
+	}
+	if cs, err := d.Client.Containers(ctx); err != nil || len(cs) != 0 {
+		t.Fatalf("containers %v, %v; want none", cs, err)
+	}
+}
+
+// TestDockerAPI runs the Docker API over the daemon: docker run without a
+// command keeps the CMD and working dir of the image, and docker logs sends
+// the console as a multiplexed stdout stream.
+func TestDockerAPI(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+
+	srv := httptest.NewServer(dockerapi.NewServer(d.Client, nil))
+	defer srv.Close()
+	resp, err := http.Post(srv.URL+"/containers/create?name=web", "application/json", strings.NewReader(`{"Image":"nginx"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var created struct{ Id string }
+	json.NewDecoder(resp.Body).Decode(&created)
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusCreated {
+		t.Fatalf("create: %s", resp.Status)
+	}
+	c, err := d.Client.LoadContainer(ctx, created.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	spec, err := c.Spec(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(spec.Process.Args) != 0 || spec.Process.Cwd != "" || len(spec.Process.Env) != 0 {
+		t.Errorf("process %+v; want no args, cwd or env (the image's)", spec.Process)
+	}
+	if info, _ := c.Info(ctx); info.Image != "nginx" {
+		t.Errorf("image %q; want nginx", info.Image)
+	}
+
+	if err := os.MkdirAll(v86.LogDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(v86.LogPath(created.Id), []byte("hello\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	resp, err = http.Get(srv.URL + "/containers/web/logs?stdout=1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, _ := io.ReadAll(resp.Body)
+	resp.Body.Close()
+	if want := "\x01\x00\x00\x00\x00\x00\x00\x06hello\n"; string(b) != want {
+		t.Errorf("logs %q; want %q", b, want)
+	}
+
+	// docker rm, by a prefix of the id: the container and its log are gone
+	req, _ := http.NewRequest(http.MethodDelete, srv.URL+"/containers/"+created.Id[:5], nil)
+	resp, err = http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusNoContent {
+		t.Fatalf("rm: %s", resp.Status)
+	}
+	if _, err := d.Client.LoadContainer(ctx, created.Id); err == nil {
+		t.Error("the container is still there after rm")
+	}
+	if _, err := os.Stat(v86.LogPath(created.Id)); !os.IsNotExist(err) {
+		t.Errorf("the log is still there after rm: %v", err)
+	}
+}
+
+// fakeStreams echoes stdin for attach and runs a fake command for exec.
+type fakeStreams struct {
+	resized chan v86.TerminalSize
+}
+
+func (f fakeStreams) Attach(ctx context.Context, id string, stdin io.Reader, out io.Writer, resize <-chan v86.TerminalSize) error {
+	io.WriteString(out, "started\n")
+	go func() {
+		for s := range resize {
+			f.resized <- s
+		}
+	}()
+	if stdin != nil {
+		io.Copy(out, stdin) // until the client closes its side
+	}
+	return nil
+}
+
+func (f fakeStreams) Exec(ctx context.Context, id string, cmd []string, tty bool, stdin io.Reader, stdout, stderr io.Writer, resize <-chan v86.TerminalSize) (int, error) {
+	if stdin != nil {
+		// the end of stdin must not end the exec (it did: the server
+		// canceled the request context when it read EOF)
+		b, _ := io.ReadAll(stdin)
+		fmt.Fprintf(stdout, "stdin %q, context %v\n", b, ctx.Err())
+		return 0, nil
+	}
+	fmt.Fprintf(stdout, "ran %s\n", strings.Join(cmd, " "))
+	io.WriteString(stderr, "oops\n")
+	return 3, nil
+}
+
+// upgrade sends a hijacking request and returns the stream after the
+// "101 UPGRADED" answer.
+func upgrade(t *testing.T, addr, path, body string) (net.Conn, *bufio.Reader) {
+	conn, err := net.Dial("tcp", addr)
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Fprintf(conn, "POST %s HTTP/1.1\r\nHost: docker\r\nConnection: Upgrade\r\nUpgrade: tcp\r\nContent-Type: application/json\r\nContent-Length: %d\r\n\r\n%s", path, len(body), body)
+	br := bufio.NewReader(conn)
+	resp, err := http.ReadResponse(br, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if resp.StatusCode != http.StatusSwitchingProtocols {
+		t.Fatalf("%s: %s", path, resp.Status)
+	}
+	return conn, br
+}
+
+// frames reads a multiplexed stream to its end: stream -> data.
+func frames(t *testing.T, r io.Reader) map[byte]string {
+	out := map[byte]string{}
+	for {
+		var h [8]byte
+		if _, err := io.ReadFull(r, h[:]); err != nil {
+			return out
+		}
+		b := make([]byte, binary.BigEndian.Uint32(h[4:]))
+		if _, err := io.ReadFull(r, b); err != nil {
+			t.Fatal(err)
+		}
+		out[h[0]] += string(b)
+	}
+}
+
+// TestDockerStreams runs attach, resize and exec through the API.
+func TestDockerStreams(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	d := startOnce(t, ctx)
+	fs := fakeStreams{resized: make(chan v86.TerminalSize, 1)}
+	srv := httptest.NewServer(dockerapi.NewServer(d.Client, fs))
+	defer srv.Close()
+	addr := strings.TrimPrefix(srv.URL, "http://")
+
+	resp, err := http.Post(srv.URL+"/containers/create?name=sh", "application/json",
+		strings.NewReader(`{"Image":"alpine","Cmd":["sh"],"OpenStdin":true,"StdinOnce":true}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var created struct{ Id string }
+	json.NewDecoder(resp.Body).Decode(&created)
+	resp.Body.Close()
+	c, err := d.Client.LoadContainer(ctx, created.Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	spec, _ := c.Spec(ctx)
+	if spec.Annotations[v86.AnnotationStdin] != "true" || spec.Annotations[v86.AnnotationStdinOnce] != "true" {
+		t.Errorf("annotations %v; want stdin and stdin-once", spec.Annotations)
+	}
+	resp, err = http.Post(srv.URL+"/containers/sh/start", "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+
+	// attach: the output, stdin echoed, and a resize while attached
+	conn, br := upgrade(t, addr, "/containers/sh/attach?stream=1&stdin=1&stdout=1&stderr=1", "")
+	io.WriteString(conn, "hi\n")
+	resp, err = http.Post(srv.URL+"/containers/sh/resize?h=40&w=120", "", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp.Body.Close()
+	select {
+	case s := <-fs.resized:
+		if s != (v86.TerminalSize{Rows: 40, Cols: 120}) {
+			t.Errorf("resize %+v; want 40x120", s)
+		}
+	case <-ctx.Done():
+		t.Fatal("no resize")
+	}
+	conn.(*net.TCPConn).CloseWrite()
+	if got := frames(t, br); got[1] != "started\nhi\n" {
+		t.Errorf("attach output %q; want started, hi", got)
+	}
+	conn.Close()
+
+	// exec: stdout and stderr apart, and the exit code
+	resp, err = http.Post(srv.URL+"/containers/sh/exec", "application/json",
+		strings.NewReader(`{"Cmd":["ls","-l"],"AttachStdout":true,"AttachStderr":true}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	json.NewDecoder(resp.Body).Decode(&created)
+	resp.Body.Close()
+	if resp.StatusCode != http.StatusCreated || created.Id == "" {
+		t.Fatalf("exec create: %s %q", resp.Status, created.Id)
+	}
+	conn, br = upgrade(t, addr, "/exec/"+created.Id+"/start", `{"Detach":false,"Tty":false}`)
+	got := frames(t, br)
+	conn.Close()
+	if got[1] != "ran ls -l\n" || got[2] != "oops\n" {
+		t.Errorf("exec output %q; want stdout and stderr apart", got)
+	}
+	resp, err = http.Get(srv.URL + "/exec/" + created.Id + "/json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ins struct {
+		Running  bool
+		ExitCode int
+	}
+	json.NewDecoder(resp.Body).Decode(&ins)
+	resp.Body.Close()
+	if ins.Running || ins.ExitCode != 3 {
+		t.Errorf("exec inspect %+v; want exit code 3", ins)
+	}
+
+	// exec -i with a pipe: stdin, then its end at once
+	resp, err = http.Post(srv.URL+"/containers/sh/exec", "application/json",
+		strings.NewReader(`{"Cmd":["cat"],"AttachStdin":true,"AttachStdout":true,"AttachStderr":true}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	json.NewDecoder(resp.Body).Decode(&created)
+	resp.Body.Close()
+	conn, br = upgrade(t, addr, "/exec/"+created.Id+"/start", `{"Detach":false,"Tty":false}`)
+	io.WriteString(conn, "piped\n")
+	conn.(*net.TCPConn).CloseWrite()
+	got = frames(t, br)
+	conn.Close()
+	if want := "stdin \"piped\\n\", context <nil>\n"; got[1] != want {
+		t.Errorf("exec -i output %q; want %q", got[1], want)
+	}
+}
+
+// echoDial is a fake VM network for published ports: it answers
+// "<id>:<port>" and closes.
+func echoDial(_ context.Context, id string, port int) (net.Conn, error) {
+	a, b := net.Pipe()
+	go func() {
+		fmt.Fprintf(b, "%s:%d\n", id, port)
+		b.Close()
+	}()
+	return a, nil
+}
+
+// get reads 127.0.0.1:port to its end, or fails.
+func get(port string) (string, error) {
+	c, err := net.DialTimeout("tcp", "127.0.0.1:"+port, 5*time.Second)
+	if err != nil {
+		return "", err
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(5 * time.Second))
+	b, err := io.ReadAll(c)
+	if len(b) == 0 && err == nil {
+		err = io.EOF
+	}
+	return string(b), err
+}
+
+func postJSON(t *testing.T, url, body string) (int, string) {
+	t.Helper()
+	resp, err := http.Post(url, "application/json", strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, strings.TrimSpace(string(b))
+}
+
+// TestDockerPorts runs docker run -p through the API: the bindings of the
+// create request land in the label, start opens them (and picks a free
+// port), a taken port fails the start with Docker's message before a VM
+// boots, and the ports close when the task exits on its own or stops.
+func TestDockerPorts(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	api := dockerapi.NewServer(d.Client, nil)
+	api.Ports = &v86.Ports{Dial: echoDial}
+	srv := httptest.NewServer(api)
+	defer srv.Close()
+
+	status, msg := postJSON(t, srv.URL+"/containers/create?name=pub1", `{"Image":"nginx",
+		"ExposedPorts":{"80/tcp":{},"443/tcp":{}},
+		"HostConfig":{"PortBindings":{"80/tcp":[{"HostIp":"","HostPort":"18180"}],"443/tcp":[{"HostIp":"127.0.0.1","HostPort":""}]}}}`)
+	if status != http.StatusCreated {
+		t.Fatalf("create: %d %s", status, msg)
+	}
+	c, err := d.Client.LoadContainer(ctx, containerID(t, ctx, d, "pub1"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	labels, _ := c.Labels(ctx)
+	want := `[{"HostIp":"0.0.0.0","HostPort":"18180","ContainerPort":"80","Protocol":"tcp"},{"HostIp":"127.0.0.1","HostPort":"","ContainerPort":"443","Protocol":"tcp"}]`
+	if labels[v86.LabelPorts] != want {
+		t.Errorf("label at create %s; want %s", labels[v86.LabelPorts], want)
+	}
+	if _, err := get("18180"); err == nil {
+		t.Error("18180 listens before the start")
+	}
+
+	if status, msg := postJSON(t, srv.URL+"/containers/pub1/start", ""); status != http.StatusNoContent {
+		t.Fatalf("start: %d %s", status, msg)
+	}
+	labels, _ = c.Labels(ctx)
+	ports, err := v86.ParsePorts(labels)
+	if err != nil || len(ports) != 2 || ports[1].HostPort == "" {
+		t.Fatalf("label after start %+v, %v; want the picked port", ports, err)
+	}
+	auto := ports[1].HostPort
+	// the fake VM answers with its task id and port
+	pub1 := containerID(t, ctx, d, "pub1")
+	for port, want := range map[string]string{"18180": pub1 + ":80\n", auto: pub1 + ":443\n"} {
+		if s, err := get(port); s != want {
+			t.Errorf("port %s: %q, %v; want %q", port, s, err, want)
+		}
+	}
+	resp, err := http.Get(srv.URL + "/containers/pub1/json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var ins struct {
+		NetworkSettings struct {
+			Ports map[string][]struct{ HostIp, HostPort string }
+		}
+	}
+	json.NewDecoder(resp.Body).Decode(&ins)
+	resp.Body.Close()
+	if p := ins.NetworkSettings.Ports["80/tcp"]; len(p) != 1 || p[0].HostIp != "0.0.0.0" || p[0].HostPort != "18180" {
+		t.Errorf("inspect ports %+v", ins.NetworkSettings.Ports)
+	}
+	resp, err = http.Get(srv.URL + "/containers/json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list []struct {
+		Id    string
+		Ports []struct {
+			IP                      string
+			PrivatePort, PublicPort int
+			Type                    string
+		}
+	}
+	json.NewDecoder(resp.Body).Decode(&list)
+	resp.Body.Close()
+	for _, l := range list {
+		if l.Id == "pub1" && (len(l.Ports) != 2 || l.Ports[0].PublicPort != 18180 || l.Ports[0].PrivatePort != 80 || l.Ports[0].Type != "tcp") {
+			t.Errorf("ps ports %+v", l.Ports)
+		}
+	}
+
+	// the same host port for a second container
+	if status, msg := postJSON(t, srv.URL+"/containers/create?name=pub2",
+		`{"Image":"nginx","HostConfig":{"PortBindings":{"80/tcp":[{"HostPort":"18180"}]}}}`); status != http.StatusCreated {
+		t.Fatalf("create pub2: %d %s", status, msg)
+	}
+	status, msg = postJSON(t, srv.URL+"/containers/pub2/start", "")
+	if want := "driver failed programming external connectivity on endpoint pub2 (" + containerID(t, ctx, d, "pub2") + "): Bind for 0.0.0.0:18180 failed: port is already allocated"; status != http.StatusInternalServerError || msg != want {
+		t.Errorf("start of a taken port: %d %q; want %q", status, msg, want)
+	}
+	if testRuntime.Get(containerID(t, ctx, d, "pub2")) != nil {
+		t.Error("a VM booted for a start that failed on its port")
+	}
+
+	// pub1 exits on its own: its ports close
+	testRuntime.Get(containerID(t, ctx, d, "pub1")).ExitCode(0)
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		if _, err := get("18180"); err != nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("18180 still listens after the task exited")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	// now pub2 gets it; docker stop frees it before it answers
+	if status, msg := postJSON(t, srv.URL+"/containers/pub2/start", ""); status != http.StatusNoContent {
+		t.Fatalf("start pub2: %d %s", status, msg)
+	}
+	if s, err := get("18180"); s != containerID(t, ctx, d, "pub2")+":80\n" {
+		t.Errorf("pub2: %q, %v", s, err)
+	}
+	if status, msg := postJSON(t, srv.URL+"/containers/pub2/stop", ""); status != http.StatusNoContent {
+		t.Fatalf("stop pub2: %d %s", status, msg)
+	}
+	if _, err := get("18180"); err == nil {
+		t.Error("18180 still listens after docker stop")
+	}
+
+	// UDP is refused at create, a bad port too
+	for body, want := range map[string]string{
+		`{"Image":"x","HostConfig":{"PortBindings":{"53/udp":[{"HostPort":"53"}]}}}`: "udp ports cannot be published: the network of the VM carries TCP connections only",
+		`{"Image":"x","HostConfig":{"PortBindings":{"http/tcp":[{}]}}}`:              "invalid containerPort: http",
+	} {
+		if status, msg := postJSON(t, srv.URL+"/containers/create?name=bad", body); status != http.StatusBadRequest || msg != want {
+			t.Errorf("create %s: %d %q; want %q", body, status, msg, want)
+		}
+	}
+	for _, id := range []string{"pub1", "pub2"} {
+		req, _ := http.NewRequest(http.MethodDelete, srv.URL+"/containers/"+id, nil)
+		if resp, err := http.DefaultClient.Do(req); err == nil {
+			resp.Body.Close()
+		}
+	}
+}
