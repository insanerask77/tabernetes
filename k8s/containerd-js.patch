+
+// restartInspect is what the restart tests read of docker inspect.
+type restartInspect struct {
+	RestartCount int
+	State        struct {
+		Status     string
+		Running    bool
+		Restarting bool
+		ExitCode   int
+	}
+	HostConfig struct {
+		RestartPolicy struct {
+			Name              string
+			MaximumRetryCount int
+		}
+		PublishAllPorts bool
+		Memory          int64
+		PortBindings    map[string][]struct{ HostIp, HostPort string }
+	}
+	Config struct {
+		Hostname   string
+		User       string
+		WorkingDir string
+		Entrypoint []string
+		Cmd        []string
+	}
+	Path string
+	Args []string
+}
+
+func inspectOf(t *testing.T, u, id string) restartInspect {
+	t.Helper()
+	st, body := api(t, http.MethodGet, u+"/containers/"+id+"/json", "")
+	if st != 200 {
+		t.Fatalf("inspect %s: %d %s", id, st, body)
+	}
+	var ins restartInspect
+	if err := json.Unmarshal([]byte(body), &ins); err != nil {
+		t.Fatal(err)
+	}
+	return ins
+}
+
+func createOf(t *testing.T, u, name, body string) string {
+	t.Helper()
+	st, resp := api(t, http.MethodPost, u+"/containers/create?name="+name, body)
+	if st != 201 {
+		t.Fatalf("create %s: %d %s", name, st, resp)
+	}
+	var created struct{ Id string }
+	json.Unmarshal([]byte(resp), &created)
+	return created.Id
+}
+
+// eventually polls cond for up to 10 seconds.
+func eventually(t *testing.T, what string, cond func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for !cond() {
+		if time.Now().After(deadline) {
+			t.Fatalf("timed out: %s", what)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+// nextTask waits for a task of id other than old, and returns it.
+func nextTask(t *testing.T, id string, old *fake.Handle) *fake.Handle {
+	t.Helper()
+	var h *fake.Handle
+	eventually(t, "a new task of "+id, func() bool {
+		h = testRuntime.Get(id)
+		if h == nil || h == old {
+			return false
+		}
+		st, _ := h.State(context.Background())
+		return st.String() == "RUNNING"
+	})
+	return h
+}
+
+// TestDockerRestartPolicy runs the restart policies through the API:
+// on-failure with a maximum, always and docker stop, the checks of create,
+// and the start of the containers after a restart of the daemon.
+func TestDockerRestartPolicy(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	server.Images = newFakeImages()
+	server.AutostartFile = filepath.Join(t.TempDir(), "autostart")
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+
+	// the checks of the CLI's daemon
+	if st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"alpine","HostConfig":{"AutoRemove":true,"RestartPolicy":{"Name":"always"}}}`); st != 400 ||
+		strings.TrimSpace(body) != "can't create 'AutoRemove' container with restart policy" {
+		t.Errorf("--rm with --restart: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"alpine","HostConfig":{"RestartPolicy":{"Name":"always","MaximumRetryCount":2}}}`); st != 400 ||
+		strings.TrimSpace(body) != "invalid restart policy: maximum retry count can only be used with 'on-failure'" {
+		t.Errorf("always:2: %d %s", st, body)
+	}
+	if _, err := os.Stat(server.AutostartFile); err == nil {
+		t.Error("autostart file without a restart policy")
+	}
+
+	// on-failure:2 and exit 3: two restarts, then Exited (3)
+	flaky := createOf(t, u, "flaky", `{"Image":"alpine","Cmd":["sh","-c","exit 3"],"HostConfig":{"RestartPolicy":{"Name":"on-failure","MaximumRetryCount":2}}}`)
+	if _, err := os.Stat(server.AutostartFile); err != nil {
+		t.Errorf("no autostart file with a restart policy: %v", err)
+	}
+	if ins := inspectOf(t, u, "flaky"); ins.HostConfig.RestartPolicy.Name != "on-failure" || ins.HostConfig.RestartPolicy.MaximumRetryCount != 2 || ins.RestartCount != 0 {
+		t.Errorf("inspect before the start: %+v", ins)
+	}
+	api(t, http.MethodPost, u+"/containers/flaky/start", "")
+	h := testRuntime.Get(flaky)
+	h.ExitCode(3)
+	if _, body := api(t, http.MethodPost, u+"/containers/flaky/wait", ""); strings.TrimSpace(body) != `{"StatusCode":3}` {
+		t.Errorf("wait: %s", body)
+	}
+	// it waits 100 ms before the first restart
+	if ins := inspectOf(t, u, "flaky"); !ins.State.Restarting || !ins.State.Running || ins.State.Status != "restarting" || ins.RestartCount != 1 {
+		t.Errorf("inspect while restarting: %+v", ins)
+	}
+	if c := ps(t, u, false)["/flaky"]; c.State != "restarting" || !strings.HasPrefix(c.Status, "Restarting (3) ") {
+		t.Errorf("ps while restarting: %+v", c)
+	}
+	h = nextTask(t, flaky, h)
+	h.ExitCode(3)
+	h = nextTask(t, flaky, h)
+	h.ExitCode(3)
+	eventually(t, "flaky exited", func() bool {
+		ins := inspectOf(t, u, "flaky")
+		return ins.State.Status == "exited" && ins.RestartCount == 2 && ins.State.ExitCode == 3
+	})
+	time.Sleep(300 * time.Millisecond)
+	if testRuntime.Get(flaky) != h {
+		t.Error("on-failure:2 restarted a third time")
+	}
+	if c := ps(t, u, true)["/flaky"]; !strings.HasPrefix(c.Status, "Exited (3) ") {
+		t.Errorf("ps after the retries: %+v", c)
+	}
+	// a start by the user counts from 0 again
+	api(t, http.MethodPost, u+"/containers/flaky/start", "")
+	if ins := inspectOf(t, u, "flaky"); ins.RestartCount != 0 || !ins.State.Running {
+		t.Errorf("inspect after docker start: %+v", ins)
+	}
+	testRuntime.Get(flaky).ExitCode(0) // a success: no restart
+	eventually(t, "flaky exited with 0", func() bool { return inspectOf(t, u, "flaky").State.Status == "exited" })
+
+	// always: a clean exit restarts it, docker stop does not
+	web := createOf(t, u, "always", `{"Image":"nginx","HostConfig":{"RestartPolicy":{"Name":"always"}}}`)
+	api(t, http.MethodPost, u+"/containers/always/start", "")
+	h = testRuntime.Get(web)
+	h.ExitCode(0)
+	h = nextTask(t, web, h)
+	if st, body := api(t, http.MethodPost, u+"/containers/always/stop?t=1", ""); st != 204 {
+		t.Fatalf("stop: %d %s", st, body)
+	}
+	time.Sleep(300 * time.Millisecond)
+	if ins := inspectOf(t, u, "always"); ins.State.Status != "exited" || ins.RestartCount != 1 || testRuntime.Get(web) != h {
+		t.Errorf("always after docker stop: %+v", ins)
+	}
+
+	// unless-stopped, stopped by the user
+	us := createOf(t, u, "unless", `{"Image":"nginx","HostConfig":{"RestartPolicy":{"Name":"unless-stopped"}}}`)
+	api(t, http.MethodPost, u+"/containers/unless/start", "")
+	hu := testRuntime.Get(us)
+	api(t, http.MethodPost, u+"/containers/unless/stop?t=1", "")
+
+	// a restart of the daemon: always comes back although docker stop
+	// stopped it, unless-stopped does not, on-failure after exit 0 neither
+	server.RestartContainers(ctx)
+	nextTask(t, web, h)
+	time.Sleep(300 * time.Millisecond)
+	if testRuntime.Get(us) != hu {
+		t.Error("unless-stopped started after a stop by the user")
+	}
+	if ins := inspectOf(t, u, "flaky"); ins.State.Running {
+		t.Error("on-failure started after exit 0")
+	}
+
+	// clean up: rm -f of a running container with a policy
+	for _, id := range []string{flaky, web, us} {
+		if st, body := api(t, http.MethodDelete, u+"/containers/"+id+"?force=1", ""); st != 204 {
+			t.Errorf("rm -f: %d %s", st, body)
+		}
+	}
+	if _, err := os.Stat(server.AutostartFile); err == nil {
+		t.Error("autostart file without containers")
+	}
+}
+
+// TestDockerRunOptions covers -w, -u, -h, --entrypoint, -m and -P in the
+// spec and in docker inspect.
+func TestDockerRunOptions(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	server.Images = newFakeImages()
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+
+	id := createOf(t, u, "opts", `{"Image":"nginx","Cmd":["-c","echo hi"],"Entrypoint":["sh"],"User":"nobody","Hostname":"box","WorkingDir":"/tmp",
+		"Labels":{"a":"1"},"HostConfig":{"Memory":536870912,"PublishAllPorts":true,"Init":true}}`)
+	c, err := d.Client.LoadContainer(ctx, id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	spec, err := c.Spec(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if spec.Hostname != "box" || spec.Process.Cwd != "/tmp" || spec.Annotations[v86.AnnotationUser] != "nobody" ||
+		spec.Annotations[v86.AnnotationEntrypoint] != `["sh"]` || *spec.Linux.Resources.Memory.Limit != 512<<20 {
+		t.Errorf("spec: %+v %+v", spec.Annotations, spec.Process)
+	}
+	ins := inspectOf(t, u, "opts")
+	if ins.Config.Hostname != "box" || ins.Config.User != "nobody" || ins.Config.WorkingDir != "/tmp" ||
+		strings.Join(ins.Config.Entrypoint, ",") != "sh" || strings.Join(ins.Config.Cmd, ",") != "-c,echo hi" ||
+		ins.Path != "sh" || strings.Join(ins.Args, ",") != "-c,echo hi" ||
+		ins.HostConfig.Memory != 512<<20 || !ins.HostConfig.PublishAllPorts || len(ins.HostConfig.PortBindings["80/tcp"]) != 1 {
+		t.Errorf("inspect: %+v", ins)
+	}
+
+	// --entrypoint "": no entrypoint, and the CMD of the image is gone too
+	if st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"nginx","Entrypoint":[""]}`); st != 400 || strings.TrimSpace(body) != "no command specified" {
+		t.Errorf("empty entrypoint without a command: %d %s", st, body)
+	}
+	id2 := createOf(t, u, "noentry", `{"Image":"nginx","Entrypoint":[""],"Cmd":["ls"]}`)
+	if ins := inspectOf(t, u, "noentry"); ins.Config.Entrypoint != nil || ins.Path != "ls" {
+		t.Errorf("inspect of --entrypoint \"\": %+v", ins)
+	}
+	// -m below what a VM needs
+	if st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"nginx","HostConfig":{"Memory":10485760}}`); st != 400 || !strings.HasPrefix(body, "Minimum memory limit allowed is 128MB") {
+		t.Errorf("-m 10m: %d %s", st, body)
+	}
+	for _, id := range []string{id, id2} {
+		api(t, http.MethodDelete, u+"/containers/"+id, "")
+	}
+}
