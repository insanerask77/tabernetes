+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+import (
+	"bytes"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+func TestSelectLines(t *testing.T) {
+	t0 := time.Unix(1000, 0)
+	lines := []v86.LogLine{{Text: "a\n", Time: t0}, {Text: "b\n", Time: t0.Add(time.Second)}, {Text: "c\n", Time: t0.Add(2 * time.Second)}, {Text: "d\n", Time: t0.Add(3 * time.Second)}}
+	text := func(ls []v86.LogLine) string {
+		var s string
+		for _, l := range ls {
+			s += l.Text
+		}
+		return s
+	}
+	for _, c := range []struct {
+		o    logOptions
+		want string
+	}{
+		{logOptions{tail: -1}, "a\nb\nc\nd\n"},
+		{logOptions{tail: 2}, "c\nd\n"},
+		{logOptions{tail: 0}, ""},
+		{logOptions{tail: -1, since: t0.Add(time.Second)}, "b\nc\nd\n"},
+		{logOptions{tail: -1, until: t0.Add(2 * time.Second)}, "a\nb\n"},
+		{logOptions{tail: 1, until: t0.Add(2 * time.Second)}, "b\n"},
+	} {
+		if got := text(selectLines(lines, c.o)); got != c.want {
+			t.Errorf("%+v: %q, want %q", c.o, got, c.want)
+		}
+	}
+}
+
+func TestParseTimestamp(t *testing.T) {
+	for _, c := range []struct {
+		in   string
+		want time.Time
+	}{
+		{"1700000000", time.Unix(1700000000, 0)},
+		{"1700000000.5", time.Unix(1700000000, 500000000)},
+		{"1700000000.000000001", time.Unix(1700000000, 1)},
+	} {
+		if got, err := parseTimestamp(c.in); err != nil || !got.Equal(c.want) {
+			t.Errorf("%s: %v %v", c.in, got, err)
+		}
+	}
+	if _, err := parseTimestamp("x"); err == nil {
+		t.Error("x parsed")
+	}
+}
+
+func TestLogWriterTimestamps(t *testing.T) {
+	var b bytes.Buffer
+	w := &logWriter{w: &b, tty: true, timestamps: true, lineStart: true}
+	t0 := time.Date(2026, 11, 16, 10, 0, 0, 5, time.UTC)
+	w.text("/ # ", t0)
+	w.text("ls\n", t0)
+	w.text("bin\n", t0)
+	want := "2026-11-16T10:00:00.000000005Z / # ls\n2026-11-16T10:00:00.000000005Z bin\n"
+	if b.String() != want {
+		t.Errorf("%q\nwant %q", b.String(), want)
+	}
+}
+
+func TestCheckLogConfig(t *testing.T) {
+	if err := checkLogConfig(logConfig{Type: "json-file", Config: map[string]string{"max-size": "1m"}}); err != nil {
+		t.Error(err)
+	}
+	if err := checkLogConfig(logConfig{Type: "syslog"}); err == nil || err.Error() != "logger: no log driver named 'syslog' is registered" {
+		t.Errorf("syslog: %v", err)
+	}
+	a := map[string]string{}
+	logAnnotations(a, logConfig{Config: map[string]string{"max-size": "2m", "max-file": "4"}})
+	if c := v86.LogConfigOf(a); c.MaxSize != 2<<20 || c.MaxFile != 4 {
+		t.Errorf("config %+v", c)
+	}
+}
+
+func TestFileModeOf(t *testing.T) {
+	if m := FileModeOf(v86.ModeDir | 0o755); !m.IsDir() || m.Perm() != 0o755 {
+		t.Errorf("dir %v", m)
+	}
+	if m := FileModeOf(v86.ModeSymlink | 0o777); m&os.ModeSymlink == 0 {
+		t.Errorf("link %v", m)
+	}
+	if m := FileModeOf(v86.ModeRegular | 0o4755); !m.IsRegular() || m&os.ModeSetuid == 0 {
+		t.Errorf("file %v", m)
+	}
+}
diff --git a/core/runtime/v2/v86/dockerapi/options.go b/core/runtime/v2/v86/dockerapi/options.go
new file mode 100644
index 0000000..3fa5ae1
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/options.go
@@ -0,0 +1,208 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// The options of docker run and create that need more than a field copy:
+// the checks of dockerd at create, --entrypoint, -m and -P.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"path"
+	"sort"
+	"strings"
+
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/pkg/oci"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// strSlice is Docker's strslice.StrSlice: a JSON string or an array of
+// strings. Entrypoint and Cmd may come as either.
+type strSlice []string
+
+func (s *strSlice) UnmarshalJSON(b []byte) error {
+	if len(b) == 0 || string(b) == "null" {
+		return nil
+	}
+	var one string
+	if err := json.Unmarshal(b, &one); err == nil {
+		*s = strSlice{one}
+		return nil
+	}
+	var many []string
+	if err := json.Unmarshal(b, &many); err != nil {
+		return err
+	}
+	*s = strSlice(many)
+	if *s == nil {
+		*s = strSlice{}
+	}
+	return nil
+}
+
+// The memory of a container is the RAM of its VM. The VM needs 128 MiB to
+// boot an image (MIN_MEMORY in web/src/vmworker.js), and v86 gives a VM at
+// most 2 GiB (less 128 KiB, which v86 takes off by itself). dockerd's own
+// minimum is 6 MB; a smaller limit than ours cannot be kept, so it is an
+// error, not a silent bigger VM.
+const (
+	minMemory = 128 << 20
+	maxMemory = 2 << 30
+)
+
+// checkMemory is the check of HostConfig.Memory (docker run -m), in the
+// words of dockerd ("Minimum memory limit allowed is 6MB") with the limits
+// of the VM.
+func checkMemory(m int64) error {
+	switch {
+	case m < 0:
+		return fmt.Errorf("invalid memory limit: %d", m)
+	case m == 0:
+		return nil
+	case m < minMemory:
+		return errors.New("Minimum memory limit allowed is 128MB: a container runs in a VM, and the VM needs that much to boot")
+	case m > maxMemory:
+		return errors.New("Maximum memory limit allowed is 2GB: v86 gives a VM at most 2 GiB of RAM")
+	}
+	return nil
+}
+
+// checkCreate runs the checks of dockerd on a create request
+// (verifyContainerSettings), before anything is made.
+func checkCreate(req createRequest) error {
+	if err := req.HostConfig.RestartPolicy.validate(); err != nil {
+		return err
+	}
+	if req.HostConfig.AutoRemove && !req.HostConfig.RestartPolicy.isNone() {
+		return errors.New("can't create 'AutoRemove' container with restart policy")
+	}
+	if req.WorkingDir != "" && !path.IsAbs(req.WorkingDir) {
+		return fmt.Errorf("the working directory '%s' is invalid, it needs to be an absolute path", req.WorkingDir)
+	}
+	return checkMemory(req.HostConfig.Memory)
+}
+
+// entrypoint is the entrypoint of the request: nil keeps the one of the
+// image, empty is none. dockerd resets [""] (what --entrypoint "" sends)
+// to none.
+func (req createRequest) entrypoint() []string {
+	if req.Entrypoint == nil {
+		return nil
+	}
+	ep := []string(*req.Entrypoint)
+	if len(ep) == 1 && ep[0] == "" {
+		return []string{}
+	}
+	if ep == nil {
+		return []string{}
+	}
+	return ep
+}
+
+// checkCommand is dockerd's "no command specified": the container must run
+// something, from the request or from the image. An entrypoint given with
+// docker run --entrypoint drops the CMD of the image too (daemon/commit.go
+// merge).
+func checkCommand(req createRequest, img imageConfig) error {
+	if ep := req.entrypoint(); ep != nil {
+		if len(ep) == 0 && len(req.Cmd) == 0 {
+			return errors.New("no command specified")
+		}
+		return nil
+	}
+	if len(req.Cmd) == 0 && len(img.Entrypoint) == 0 && len(img.Cmd) == 0 {
+		return errors.New("no command specified")
+	}
+	return nil
+}
+
+// entrypointAnnotation encodes an entrypoint of docker run for
+// v86.AnnotationEntrypoint.
+func entrypointAnnotation(ep []string) string {
+	b, _ := json.Marshal(ep)
+	return string(b)
+}
+
+// overrides is what docker run changed of the image config: the user
+// (-u) and the entrypoint (--entrypoint; ok false: the image's).
+func overrides(annotations map[string]string) (user string, entrypoint []string, ok bool) {
+	user = annotations[v86.AnnotationUser]
+	if e, has := annotations[v86.AnnotationEntrypoint]; has {
+		entrypoint = []string{}
+		json.Unmarshal([]byte(e), &entrypoint)
+		ok = true
+	}
+	return user, entrypoint, ok
+}
+
+// withMemory sets the memory limit, the RAM of the VM (jsruntime.Translate
+// reads it).
+func withMemory(limit int64) oci.SpecOpts {
+	return func(_ context.Context, _ oci.Client, _ *containers.Container, s *oci.Spec) error {
+		if s.Linux == nil {
+			s.Linux = &specs.Linux{}
+		}
+		if s.Linux.Resources == nil {
+			s.Linux.Resources = &specs.LinuxResources{}
+		}
+		s.Linux.Resources.Memory = &specs.LinuxMemory{Limit: &limit}
+		return nil
+	}
+}
+
+// publishAll adds the bindings of docker run -P: every exposed port, of the
+// image and of the request, that has no binding yet gets one to a free host
+// port, as dockerd does. Only TCP can be published here (portBindings), so
+// the other ports are left out with a warning.
+func publishAll(bindings portMap, exposed ...map[string]struct{}) (portMap, []string) {
+	out := portMap{}
+	for k, v := range bindings {
+		out[k] = v
+	}
+	seen := map[string]bool{}
+	var keys []string
+	for _, m := range exposed {
+		for k := range m {
+			port, proto, _ := strings.Cut(k, "/")
+			if proto == "" {
+				proto = "tcp"
+			}
+			key := port + "/" + strings.ToLower(proto)
+			if !seen[key] {
+				seen[key] = true
+				keys = append(keys, key)
+			}
+		}
+	}
+	sort.Strings(keys)
+	var warnings []string
+	for _, key := range keys {
+		if len(out[key]) > 0 || len(out[strings.TrimSuffix(key, "/tcp")]) > 0 {
+			continue
+		}
+		if !strings.HasSuffix(key, "/tcp") {
+			warnings = append(warnings, fmt.Sprintf("Published ports are discarded for %s: the network of the VM carries TCP connections only", key))
+			continue
+		}
+		out[key] = []portBinding{{}}
+	}
+	return out, warnings
+}
diff --git a/core/runtime/v2/v86/dockerapi/ports.go b/core/runtime/v2/v86/dockerapi/ports.go
new file mode 100644
index 0000000..eec5cd7
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/ports.go
@@ -0,0 +1,145 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// Published ports (docker run -p). The create request carries them in
+// HostConfig.PortBindings, as in the real API; the container keeps them in
+// the label v86.LabelPorts, and Server.Ports opens them while the task runs.
+
+import (
+	"cmp"
+	"context"
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// portBinding is a host side of a published port in the Docker API.
+type portBinding struct {
+	HostIp   string `json:"HostIp"`
+	HostPort string `json:"HostPort"`
+}
+
+// portMap is Docker's PortMap: "80/tcp" -> the host sides.
+type portMap map[string][]portBinding
+
+// hostConfig is the part of Docker's HostConfig this API reads.
+type hostConfig struct {
+	PortBindings portMap `json:"PortBindings"`
+	// AutoRemove: the daemon removes the container when it exits (--rm),
+	// also when nobody waits for it (-d).
+	AutoRemove bool `json:"AutoRemove"`
+	// docker run -P, -m and --restart (options.go, restart.go)
+	PublishAllPorts bool          `json:"PublishAllPorts"`
+	Memory          int64         `json:"Memory"`
+	RestartPolicy   restartPolicy `json:"RestartPolicy"`
+	// Init (docker run --init) is taken and ignored: init of the VM
+	// already does what docker-init (tini) does, it forwards signals to
+	// the main process and reaps orphans.
+	Init *bool `json:"Init"`
+	// docker run --log-driver and --log-opt (logs.go)
+	LogConfig logConfig `json:"LogConfig"`
+	// Binds (-v) and Mounts (--mount), volumes.go
+	mountConfig
+}
+
+// portBindings turns the PortBindings of a create request into the
+// bindings of the label, sorted by container port. Only TCP can be
+// published: the network of the VM (v86's fetch network) relays TCP
+// connections and answers DNS, nothing else.
+func portBindings(m portMap) ([]v86.PortBinding, error) {
+	var out []v86.PortBinding
+	for key, hosts := range m {
+		port, proto, _ := strings.Cut(key, "/")
+		proto = strings.ToLower(cmp.Or(proto, "tcp"))
+		if n, err := strconv.Atoi(port); err != nil || n < 1 || n > 65535 {
+			return nil, fmt.Errorf("invalid containerPort: %s", port)
+		}
+		switch proto {
+		case "tcp":
+		case "udp", "sctp":
+			return nil, fmt.Errorf("%s ports cannot be published: the network of the VM carries TCP connections only", proto)
+		default:
+			return nil, fmt.Errorf("invalid proto: %s", proto)
+		}
+		for _, h := range hosts {
+			out = append(out, v86.PortBinding{
+				HostIp: cmp.Or(h.HostIp, "0.0.0.0"), HostPort: h.HostPort,
+				ContainerPort: port, Protocol: proto,
+			})
+		}
+	}
+	sortPorts(out)
+	return out, nil
+}
+
+func sortPorts(ports []v86.PortBinding) {
+	slices.SortStableFunc(ports, func(a, b v86.PortBinding) int {
+		an, _ := strconv.Atoi(a.ContainerPort)
+		bn, _ := strconv.Atoi(b.ContainerPort)
+		return cmp.Or(cmp.Compare(an, bn), cmp.Compare(a.Protocol, b.Protocol),
+			cmp.Compare(a.HostIp, b.HostIp), cmp.Compare(a.HostPort, b.HostPort))
+	})
+}
+
+// publish opens the published ports of c before its task starts, as Docker
+// sets up the port mapping before it starts the process, so a port that is
+// taken fails the start before a VM boots. It writes the host ports it
+// picked into the label. undo closes the ports again if the start fails.
+func (s *Server) publish(ctx context.Context, c client.Container) (undo func(), err error) {
+	undo = func() {}
+	if s.Ports == nil || s.Ports.Published(c.ID()) {
+		return undo, nil
+	}
+	labels, err := c.Labels(ctx)
+	if err != nil {
+		return undo, err
+	}
+	ports, err := v86.ParsePorts(labels)
+	if err != nil || len(ports) == 0 {
+		return undo, err
+	}
+	name := labels[LabelName]
+	if name == "" {
+		name = c.ID()
+	}
+	bound, err := s.Ports.Publish(c.ID(), name, ports)
+	if err != nil {
+		// dockerd's words: the endpoint is named after the container, and
+		// its id is that of the container here
+		return undo, fmt.Errorf("driver failed programming external connectivity on endpoint %s (%s): %w", name, c.ID(), err)
+	}
+	undo = func() { s.Ports.Unpublish(c.ID()) }
+	if _, err := c.SetLabels(ctx, map[string]string{v86.LabelPorts: v86.PortsLabel(bound)}); err != nil {
+		undo()
+		return func() {}, err
+	}
+	return undo, nil
+}
+
+// unpublish closes the ports of a container at once, before a stop or rm
+// answers: a docker run -p of the same port right after must not find it
+// taken.
+func (s *Server) unpublish(id string) {
+	if s.Ports != nil {
+		s.Ports.Unpublish(id)
+	}
+}
diff --git a/core/runtime/v2/v86/dockerapi/restart.go b/core/runtime/v2/v86/dockerapi/restart.go
new file mode 100644
index 0000000..cbc52b6
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/restart.go
@@ -0,0 +1,457 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// Restart policies (docker run --restart), as dockerd's restartmanager and
+// monitor do them: no, on-failure[:max-retries], always and unless-stopped.
+// The policy, the restart count and whether the user stopped the container
+// are labels, so they survive a reload of the page; the backoff and a
+// pending restart live in memory, like in dockerd.
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log"
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+)
+
+const (
+	// LabelRestartPolicy is the restart policy: "always", "on-failure:3".
+	LabelRestartPolicy = "dev.tabernetes.docker.restart-policy"
+	// LabelRestartCount is RestartCount of docker inspect: the restarts by
+	// the policy since the last start by the user.
+	LabelRestartCount = "dev.tabernetes.docker.restart-count"
+	// LabelManuallyStopped marks a container that docker stop or kill
+	// ended: unless-stopped does not start it again, not even after a
+	// reload (dockerd's HasBeenManuallyStopped).
+	LabelManuallyStopped = "dev.tabernetes.docker.manually-stopped"
+	// LabelPublishAll marks a container of docker run -P.
+	LabelPublishAll = "dev.tabernetes.docker.publish-all"
+)
+
+// The backoff of dockerd (restartmanager): 100 ms before the first
+// restart, doubled for every next one up to a minute, and back to 100 ms
+// after a run of 10 seconds or more.
+const (
+	restartBackoffStart = 100 * time.Millisecond
+	restartBackoffMax   = time.Minute
+	restartBackoffReset = 10 * time.Second
+)
+
+// restartPolicy is Docker's RestartPolicy.
+type restartPolicy struct {
+	Name              string `json:"Name"`
+	MaximumRetryCount int    `json:"MaximumRetryCount"`
+}
+
+func (p restartPolicy) isNone() bool { return p.Name == "" || p.Name == "no" }
+
+// validate is dockerd's ValidateRestartPolicy, with its messages.
+func (p restartPolicy) validate() error {
+	switch p.Name {
+	case "always", "unless-stopped", "no":
+		if p.MaximumRetryCount != 0 {
+			msg := "invalid restart policy: maximum retry count can only be used with 'on-failure'"
+			if p.MaximumRetryCount < 0 {
+				msg += " and cannot be negative"
+			}
+			return errors.New(msg)
+		}
+	case "on-failure":
+		if p.MaximumRetryCount < 0 {
+			return errors.New("invalid restart policy: maximum retry count cannot be negative")
+		}
+	case "":
+		// an empty name is "no" for old clients, as in dockerd
+	default:
+		return fmt.Errorf("invalid restart policy: unknown policy '%s'; use one of 'no', 'always', 'on-failure', or 'unless-stopped'", p.Name)
+	}
+	return nil
+}
+
+// label is the policy for LabelRestartPolicy.
+func (p restartPolicy) label() string {
+	if p.Name == "on-failure" && p.MaximumRetryCount > 0 {
+		return p.Name + ":" + strconv.Itoa(p.MaximumRetryCount)
+	}
+	return p.Name
+}
+
+// policyOf reads the policy of a container from its labels; "no" if none.
+func policyOf(labels map[string]string) restartPolicy {
+	s := labels[LabelRestartPolicy]
+	if s == "" {
+		return restartPolicy{Name: "no"}
+	}
+	name, n, _ := strings.Cut(s, ":")
+	max, _ := strconv.Atoi(n)
+	return restartPolicy{Name: name, MaximumRetryCount: max}
+}
+
+func restartCountOf(labels map[string]string) int {
+	n, _ := strconv.Atoi(labels[LabelRestartCount])
+	return n
+}
+
+// restarter is dockerd's restart manager of one container: the backoff,
+// whether the user canceled the restarts (docker stop), and a restart
+// that waits (the container shows Restarting).
+type restarter struct {
+	timeout  time.Duration
+	canceled bool
+	waiting  bool
+	cancel   chan struct{} // closed by a cancel while waiting
+}
+
+// shouldRestart is RestartManager.ShouldRestart: whether the policy starts
+// the container again after an exit, and it moves the backoff on.
+// count is the number of restarts so far, ran how long the run lasted.
+func (rm *restarter) shouldRestart(p restartPolicy, count, exitCode int, manuallyStopped bool, ran time.Duration) bool {
+	if p.isNone() || rm.canceled {
+		return false
+	}
+	if ran >= restartBackoffReset {
+		rm.timeout = 0
+	}
+	switch {
+	case rm.timeout == 0:
+		rm.timeout = restartBackoffStart
+	case rm.timeout < restartBackoffMax:
+		rm.timeout *= 2
+	}
+	if rm.timeout > restartBackoffMax {
+		rm.timeout = restartBackoffMax
+	}
+	switch p.Name {
+	case "always":
+		return true
+	case "unless-stopped":
+		return !manuallyStopped
+	case "on-failure":
+		// 0 is no limit
+		if p.MaximumRetryCount == 0 || count < p.MaximumRetryCount {
+			return exitCode != 0
+		}
+	}
+	return false
+}
+
+// restarterOf returns the restart manager of a container; s.mu is held.
+func (s *Server) restarterOf(id string) *restarter {
+	if s.restarts == nil {
+		s.restarts = map[string]*restarter{}
+	}
+	rm := s.restarts[id]
+	if rm == nil {
+		rm = &restarter{}
+		s.restarts[id] = rm
+	}
+	return rm
+}
+
+// restarting reports whether a restart of the container waits.
+func (s *Server) restarting(id string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	rm := s.restarts[id]
+	return rm != nil && rm.waiting
+}
+
+// cancelRestart stops the restarts of a container until the user starts
+// it again, as docker stop does (ExitOnNext). It reports whether a restart
+// was waiting.
+func (s *Server) cancelRestart(id string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	rm := s.restarterOf(id)
+	rm.canceled = true
+	return rm.endWait()
+}
+
+// endWait ends a waiting restart; s.mu is held. It reports whether one
+// waited.
+func (rm *restarter) endWait() bool {
+	if !rm.waiting {
+		return false
+	}
+	rm.waiting = false
+	close(rm.cancel)
+	return true
+}
+
+// forgetRestart drops the restart manager of a removed container.
+func (s *Server) forgetRestart(id string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if rm := s.restarts[id]; rm != nil {
+		rm.canceled = true
+		rm.endWait()
+	}
+	delete(s.restarts, id)
+}
+
+// userStart prepares a start by the user (docker start, restart, run, and
+// the start after a reload): like dockerd's ResetRestartManager(true), the
+// backoff and the count start again, and the container is no longer
+// stopped by the user.
+func (s *Server) userStart(ctx context.Context, c client.Container) {
+	s.mu.Lock()
+	// a waiting restart is replaced by this start, not canceled: if its
+	// VM boots already, the start of the user gets that one
+	s.restarterOf(c.ID()).endWait()
+	s.restarts[c.ID()] = &restarter{}
+	s.mu.Unlock()
+	labels, err := c.Labels(ctx)
+	if err != nil {
+		return
+	}
+	set := map[string]string{}
+	if labels[LabelRestartCount] != "" && labels[LabelRestartCount] != "0" {
+		set[LabelRestartCount] = "0"
+	}
+	if labels[LabelManuallyStopped] == "true" {
+		set[LabelManuallyStopped] = "false"
+	}
+	if len(set) > 0 {
+		c.SetLabels(ctx, set)
+	}
+}
+
+// startByUser is startContainer for a start by the user.
+func (s *Server) startByUser(ctx context.Context, c client.Container) error {
+	s.userStart(ctx, c)
+	return s.startContainer(ctx, c)
+}
+
+// userStop records docker stop or kill with signal sig: the container is
+// stopped by the user (unless-stopped keeps it stopped), and its restarts
+// end, unless sig is neither SIGKILL nor its stop signal (dockerd's
+// killWithSignal: docker kill -s HUP does not cancel them). It reports
+// whether a restart was waiting, which the signal then only cancels.
+func (s *Server) userStop(ctx context.Context, c client.Container, sig syscall.Signal) bool {
+	c.SetLabels(ctx, map[string]string{LabelManuallyStopped: "true"})
+	if sig != sigKILL {
+		stop := ""
+		if spec, err := c.Spec(ctx); err == nil {
+			stop = spec.Annotations[AnnotationStopSignal]
+		}
+		if ss, ok := s.streams.(stopSignaler); ok && stop == "" {
+			stop = ss.StopSignal(c.ID())
+		}
+		if stop != "" {
+			if n, err := v86.ParseSignal(stop); err == nil && syscall.Signal(n) != sig {
+				return s.restarting(c.ID())
+			}
+		}
+	}
+	return s.cancelRestart(c.ID())
+}
+
+// afterExit applies the restart policy once watch recorded an exit: if the
+// policy says so, the container shows Restarting, and starts again after
+// the backoff, in a new VM.
+func (s *Server) afterExit(ctx context.Context, c client.Container, labels map[string]string, code int, ran time.Duration) {
+	p := policyOf(labels)
+	if p.isNone() {
+		return
+	}
+	count := restartCountOf(labels)
+	s.mu.Lock()
+	rm := s.restarterOf(c.ID())
+	if rm.waiting || !rm.shouldRestart(p, count, code, labels[LabelManuallyStopped] == "true", ran) {
+		s.mu.Unlock()
+		return
+	}
+	rm.waiting = true
+	rm.cancel = make(chan struct{})
+	cancel, timeout := rm.cancel, rm.timeout
+	s.mu.Unlock()
+	// dockerd counts the restart when it decides it, before the wait
+	c.SetLabels(ctx, map[string]string{LabelRestartCount: strconv.Itoa(count + 1)})
+	go s.restartAfter(ctx, c, rm, cancel, timeout, count)
+}
+
+// restartAfter starts the container once the backoff is over, unless the
+// restart is canceled first. The container shows Restarting until its new
+// VM runs. A start that fails gives the count back (count is the one
+// before): it fails when no tab can run the VM, and RetryRestarts tries
+// again later.
+func (s *Server) restartAfter(ctx context.Context, c client.Container, rm *restarter, cancel chan struct{}, timeout time.Duration, count int) {
+	t := time.NewTimer(timeout)
+	defer t.Stop()
+	select {
+	case <-cancel:
+		return
+	case <-t.C:
+	}
+	err := s.startContainer(ctx, c)
+	s.mu.Lock()
+	canceled := rm.canceled // docker stop came while the VM booted
+	if rm.waiting {
+		rm.waiting = false
+		close(rm.cancel)
+	}
+	s.mu.Unlock()
+	if err != nil && err != errAlreadyStarted {
+		log.Printf("dockerapi: restart of container %s failed: %v", c.ID(), err)
+		c.SetLabels(ctx, map[string]string{LabelRestartCount: strconv.Itoa(count)})
+		return
+	}
+	if canceled && err == nil {
+		// dockerd would not have started it: the stop wins
+		if task, err := c.Task(ctx, nil); err == nil {
+			stopTask(ctx, task, sigKILL, 0)
+		}
+	}
+}
+
+// RestartContainers starts the containers whose policy wants them running
+// after a restart of the daemon, as dockerd does when it starts: always,
+// unless-stopped if the user did not stop it, on-failure after a failed
+// run (also the run that ended with the page, 255 or 137) below its
+// maximum. The glue calls it once the API serves; the VMs boot in the tab
+// that runs new containers.
+func (s *Server) RestartContainers(ctx context.Context) {
+	ctx = namespaces.WithNamespace(ctx, s.ns)
+	all, err := s.client.Containers(ctx)
+	if err != nil {
+		log.Printf("dockerapi: restart containers: %v", err)
+		return
+	}
+	found := false
+	for _, c := range all {
+		labels, err := c.Labels(ctx)
+		if err != nil {
+			continue
+		}
+		p := policyOf(labels)
+		if p.isNone() {
+			continue
+		}
+		found = true
+		if labels[LabelStartedAt] == "" {
+			continue // never started: dockerd's HasBeenStartedBefore
+		}
+		st := s.state(ctx, c, labels)
+		if st.Running {
+			continue
+		}
+		rm := &restarter{}
+		if !rm.shouldRestart(p, restartCountOf(labels), st.ExitCode, labels[LabelManuallyStopped] == "true", st.FinishedAt.Sub(st.StartedAt)) {
+			continue
+		}
+		go func(c client.Container) {
+			if err := s.startByUser(ctx, c); err != nil && err != errAlreadyStarted {
+				log.Printf("dockerapi: restart of container %s failed: %v", c.ID(), err)
+			}
+		}(c)
+	}
+	s.markAutostart(found)
+}
+
+// RetryRestarts starts the containers whose restart failed, for example
+// because no tab was left to run their VM (the last tab reloaded). It
+// follows the restart managers of this server: a container that docker
+// stop stopped, or that ended before this server ran, stays as it is. The
+// glue calls it when a tab opens and takes the containers.
+func (s *Server) RetryRestarts(ctx context.Context) {
+	ctx = namespaces.WithNamespace(ctx, s.ns)
+	all, err := s.client.Containers(ctx)
+	if err != nil {
+		return
+	}
+	for _, c := range all {
+		labels, err := c.Labels(ctx)
+		if err != nil {
+			continue
+		}
+		p := policyOf(labels)
+		if p.isNone() {
+			continue
+		}
+		s.mu.Lock()
+		rm := s.restarts[c.ID()]
+		var try restarter
+		if rm != nil {
+			try = *rm
+		}
+		s.mu.Unlock()
+		if rm == nil || try.canceled || try.waiting {
+			continue
+		}
+		st := s.state(ctx, c, labels)
+		if st.Running {
+			continue
+		}
+		count := restartCountOf(labels)
+		if !try.shouldRestart(p, count, st.ExitCode, labels[LabelManuallyStopped] == "true", st.FinishedAt.Sub(st.StartedAt)) {
+			continue
+		}
+		c.SetLabels(ctx, map[string]string{LabelRestartCount: strconv.Itoa(count + 1)})
+		go func(c client.Container) {
+			if err := s.startContainer(ctx, c); err != nil && err != errAlreadyStarted {
+				log.Printf("dockerapi: restart of container %s failed: %v", c.ID(), err)
+				c.SetLabels(ctx, map[string]string{LabelRestartCount: strconv.Itoa(count)})
+			}
+		}(c)
+	}
+}
+
+// AutostartFile, if set, exists while a container has a restart policy:
+// the glue starts the daemon when the page loads if it is there, as a
+// system starts dockerd at boot, so such containers come back without a
+// docker command.
+func (s *Server) markAutostart(on bool) {
+	if s.AutostartFile == "" {
+		return
+	}
+	if on {
+		if f, err := os.OpenFile(s.AutostartFile, os.O_CREATE|os.O_WRONLY, 0o644); err == nil {
+			f.Close()
+		}
+		return
+	}
+	os.Remove(s.AutostartFile)
+}
+
+// updateAutostart checks again whether a container has a restart policy,
+// after a create or a remove.
+func (s *Server) updateAutostart(ctx context.Context) {
+	if s.AutostartFile == "" {
+		return
+	}
+	all, err := s.client.Containers(ctx)
+	if err != nil {
+		return
+	}
+	for _, c := range all {
+		if labels, err := c.Labels(ctx); err == nil && !policyOf(labels).isNone() {
+			s.markAutostart(true)
+			return
+		}
+	}
+	s.markAutostart(false)
+}
diff --git a/core/runtime/v2/v86/dockerapi/restart_test.go b/core/runtime/v2/v86/dockerapi/restart_test.go
new file mode 100644
index 0000000..2f30b2a
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/restart_test.go
@@ -0,0 +1,216 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestRestartPolicyValidate(t *testing.T) {
+	for _, tc := range []struct {
+		p   restartPolicy
+		err string
+	}{
+		{p: restartPolicy{}},
+		{p: restartPolicy{Name: "no"}},
+		{p: restartPolicy{Name: "always"}},
+		{p: restartPolicy{Name: "unless-stopped"}},
+		{p: restartPolicy{Name: "on-failure"}},
+		{p: restartPolicy{Name: "on-failure", MaximumRetryCount: 3}},
+		// dockerd's messages
+		{p: restartPolicy{Name: "always", MaximumRetryCount: 1}, err: "invalid restart policy: maximum retry count can only be used with 'on-failure'"},
+		{p: restartPolicy{Name: "no", MaximumRetryCount: -1}, err: "invalid restart policy: maximum retry count can only be used with 'on-failure' and cannot be negative"},
+		{p: restartPolicy{Name: "on-failure", MaximumRetryCount: -1}, err: "invalid restart policy: maximum retry count cannot be negative"},
+		{p: restartPolicy{Name: "sometimes"}, err: "invalid restart policy: unknown policy 'sometimes'; use one of 'no', 'always', 'on-failure', or 'unless-stopped'"},
+	} {
+		err := tc.p.validate()
+		if got := ""; err != nil {
+			got = err.Error()
+			if got != tc.err {
+				t.Errorf("%+v: %q, want %q", tc.p, got, tc.err)
+			}
+		} else if tc.err != "" {
+			t.Errorf("%+v: no error, want %q", tc.p, tc.err)
+		}
+	}
+}
+
+func TestRestartPolicyLabel(t *testing.T) {
+	for _, p := range []restartPolicy{{Name: "always"}, {Name: "unless-stopped"}, {Name: "on-failure"}, {Name: "on-failure", MaximumRetryCount: 5}} {
+		if got := policyOf(map[string]string{LabelRestartPolicy: p.label()}); got != p {
+			t.Errorf("%+v: label %q reads as %+v", p, p.label(), got)
+		}
+	}
+	if got := policyOf(nil); got != (restartPolicy{Name: "no"}) || !got.isNone() {
+		t.Errorf("no label: %+v", got)
+	}
+}
+
+// TestShouldRestart follows dockerd's restartmanager: the policies, the
+// maximum of on-failure, and the backoff of 100 ms that doubles up to a
+// minute and starts again after a run of 10 seconds.
+func TestShouldRestart(t *testing.T) {
+	short := time.Second
+	for _, tc := range []struct {
+		name    string
+		p       restartPolicy
+		count   int
+		code    int
+		stopped bool
+		want    bool
+	}{
+		{"no", restartPolicy{Name: "no"}, 0, 1, false, false},
+		{"always after 0", restartPolicy{Name: "always"}, 0, 0, false, true},
+		{"always after a stop", restartPolicy{Name: "always"}, 0, 143, true, true},
+		{"unless-stopped", restartPolicy{Name: "unless-stopped"}, 0, 0, false, true},
+		{"unless-stopped after a stop", restartPolicy{Name: "unless-stopped"}, 0, 143, true, false},
+		{"on-failure after 0", restartPolicy{Name: "on-failure"}, 0, 0, false, false},
+		{"on-failure after 3", restartPolicy{Name: "on-failure"}, 7, 3, false, true},
+		{"on-failure:2 first", restartPolicy{Name: "on-failure", MaximumRetryCount: 2}, 0, 3, false, true},
+		{"on-failure:2 second", restartPolicy{Name: "on-failure", MaximumRetryCount: 2}, 1, 3, false, true},
+		{"on-failure:2 third", restartPolicy{Name: "on-failure", MaximumRetryCount: 2}, 2, 3, false, false},
+	} {
+		rm := &restarter{}
+		if got := rm.shouldRestart(tc.p, tc.count, tc.code, tc.stopped, short); got != tc.want {
+			t.Errorf("%s: %v, want %v", tc.name, got, tc.want)
+		}
+	}
+
+	rm := &restarter{}
+	always := restartPolicy{Name: "always"}
+	var waits []time.Duration
+	for range 12 {
+		rm.shouldRestart(always, 0, 1, false, short)
+		waits = append(waits, rm.timeout)
+	}
+	want := []time.Duration{100, 200, 400, 800, 1600, 3200, 6400, 12800, 25600, 51200, 60000, 60000}
+	for i := range want {
+		want[i] *= time.Millisecond
+	}
+	if !reflect.DeepEqual(waits, want) {
+		t.Errorf("backoff %v, want %v", waits, want)
+	}
+	rm.shouldRestart(always, 0, 1, false, 10*time.Second)
+	if rm.timeout != 100*time.Millisecond {
+		t.Errorf("backoff after a long run: %v", rm.timeout)
+	}
+	rm.canceled = true
+	if rm.shouldRestart(always, 0, 1, false, short) {
+		t.Error("a canceled restart manager restarts")
+	}
+}
+
+func TestStateStringRestarting(t *testing.T) {
+	now := time.Date(2026, 1, 1, 0, 0, 10, 0, time.UTC)
+	st := containerState{Running: true, Restarting: true, ExitCode: 3, FinishedAt: now.Add(-5 * time.Second), StartedAt: now.Add(-6 * time.Second)}
+	if got := st.String(now); got != "Restarting (3) 5 seconds ago" {
+		t.Errorf("status %q", got)
+	}
+}
+
+func TestCheckCreate(t *testing.T) {
+	for _, tc := range []struct {
+		req string
+		err string
+	}{
+		{req: `{"Image":"alpine"}`},
+		{req: `{"Image":"alpine","WorkingDir":"/tmp","HostConfig":{"Memory":536870912,"RestartPolicy":{"Name":"on-failure","MaximumRetryCount":2}}}`},
+		{req: `{"Image":"alpine","WorkingDir":"tmp"}`, err: "the working directory 'tmp' is invalid, it needs to be an absolute path"},
+		{req: `{"Image":"alpine","HostConfig":{"AutoRemove":true,"RestartPolicy":{"Name":"always"}}}`, err: "can't create 'AutoRemove' container with restart policy"},
+		{req: `{"Image":"alpine","HostConfig":{"AutoRemove":true,"RestartPolicy":{"Name":"no"}}}`},
+		{req: `{"Image":"alpine","HostConfig":{"RestartPolicy":{"Name":"never"}}}`, err: "invalid restart policy: unknown policy 'never'; use one of 'no', 'always', 'on-failure', or 'unless-stopped'"},
+		{req: `{"Image":"alpine","HostConfig":{"Memory":67108864}}`, err: "Minimum memory limit allowed is 128MB: a container runs in a VM, and the VM needs that much to boot"},
+		{req: `{"Image":"alpine","HostConfig":{"Memory":134217728}}`},
+		{req: `{"Image":"alpine","HostConfig":{"Memory":2147483648}}`},
+		{req: `{"Image":"alpine","HostConfig":{"Memory":2147483649}}`, err: "Maximum memory limit allowed is 2GB: v86 gives a VM at most 2 GiB of RAM"},
+	} {
+		var req createRequest
+		if err := json.Unmarshal([]byte(tc.req), &req); err != nil {
+			t.Fatal(err)
+		}
+		err := checkCreate(req)
+		got := ""
+		if err != nil {
+			got = err.Error()
+		}
+		if got != tc.err {
+			t.Errorf("%s: %q, want %q", tc.req, got, tc.err)
+		}
+	}
+}
+
+// TestEntrypoint covers --entrypoint: a string or an array, [""] for none,
+// and dockerd's "no command specified".
+func TestEntrypoint(t *testing.T) {
+	img := imageConfig{Entrypoint: []string{"/docker-entrypoint.sh"}, Cmd: []string{"nginx"}}
+	for _, tc := range []struct {
+		req  string
+		ep   []string // nil: the image's
+		cmd  error
+		none bool
+	}{
+		{req: `{}`},
+		{req: `{"Entrypoint":null}`},
+		{req: `{"Entrypoint":"sh"}`, ep: []string{"sh"}},
+		{req: `{"Entrypoint":["sh","-c"],"Cmd":"echo hi"}`, ep: []string{"sh", "-c"}},
+		{req: `{"Entrypoint":[""],"Cmd":["ls"]}`, ep: []string{}},
+		{req: `{"Entrypoint":[]}`, ep: []string{}, none: true},
+		{req: `{"Entrypoint":[""]}`, ep: []string{}, none: true},
+	} {
+		var req createRequest
+		if err := json.Unmarshal([]byte(tc.req), &req); err != nil {
+			t.Fatalf("%s: %v", tc.req, err)
+		}
+		ep := req.entrypoint()
+		if (ep == nil) != (tc.ep == nil) || !reflect.DeepEqual([]string(ep), tc.ep) && len(ep)+len(tc.ep) > 0 {
+			t.Errorf("%s: entrypoint %#v, want %#v", tc.req, ep, tc.ep)
+		}
+		if err := checkCommand(req, img); (err != nil) != tc.none {
+			t.Errorf("%s: checkCommand %v", tc.req, err)
+		}
+		if ep != nil {
+			a := annotations(req)
+			_, got, ok := overrides(a)
+			if !ok || !reflect.DeepEqual(got, []string(ep)) {
+				t.Errorf("%s: annotation %q reads as %q", tc.req, a, got)
+			}
+		}
+	}
+	if err := checkCommand(createRequest{}, imageConfig{}); err == nil || err.Error() != "no command specified" {
+		t.Errorf("an image without a command: %v", err)
+	}
+}
+
+func TestPublishAll(t *testing.T) {
+	got, warnings := publishAll(portMap{"443/tcp": {{HostPort: "8443"}}},
+		map[string]struct{}{"80/tcp": {}, "443/tcp": {}, "53/udp": {}},
+		map[string]struct{}{"8080": {}})
+	want := portMap{"80/tcp": {{}}, "443/tcp": {{HostPort: "8443"}}, "8080/tcp": {{}}}
+	if !reflect.DeepEqual(got, want) {
+		t.Errorf("bindings %v, want %v", got, want)
+	}
+	if len(warnings) != 1 || warnings[0] != "Published ports are discarded for 53/udp: the network of the VM carries TCP connections only" {
+		t.Errorf("warnings %q", warnings)
+	}
+	ports, err := portBindings(got)
+	if err != nil || len(ports) != 3 || ports[0].ContainerPort != "80" || ports[0].HostPort != "" || ports[0].HostIp != "0.0.0.0" {
+		t.Errorf("label bindings %+v %v", ports, err)
+	}
+}
