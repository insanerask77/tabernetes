+   limitations under the License.
+*/
+
+package v86
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// The signals of Linux on x86, which the VM runs. The process that parses a
+// signal name runs on js/wasm, whose syscall package knows only a few of
+// them, so they are listed here, with the names that Docker accepts
+// (github.com/moby/sys/signal).
+const (
+	SIGKILL = 9
+	SIGTERM = 15
+)
+
+var signals = map[string]uint32{
+	"HUP": 1, "INT": 2, "QUIT": 3, "ILL": 4, "TRAP": 5, "ABRT": 6, "IOT": 6,
+	"BUS": 7, "FPE": 8, "KILL": 9, "USR1": 10, "SEGV": 11, "USR2": 12,
+	"PIPE": 13, "ALRM": 14, "TERM": 15, "STKFLT": 16, "CHLD": 17, "CLD": 17,
+	"CONT": 18, "STOP": 19, "TSTP": 20, "TTIN": 21, "TTOU": 22, "URG": 23,
+	"XCPU": 24, "XFSZ": 25, "VTALRM": 26, "PROF": 27, "WINCH": 28, "IO": 29,
+	"POLL": 29, "PWR": 30, "SYS": 31,
+}
+
+// The real-time signals: RTMIN is 34 for programs with glibc and musl
+// (both keep 32 and 33 for themselves), RTMAX is 64.
+const (
+	sigRTMin = 34
+	sigRTMax = 64
+)
+
+// ParseSignal reads a signal as Docker and the kubelet write it: a number
+// ("15"), a name with or without SIG ("SIGTERM", "term"), or a real-time
+// signal ("RTMIN+3", "SIGRTMAX-1"). The error is the one of dockerd.
+func ParseSignal(s string) (uint32, error) {
+	invalid := fmt.Errorf("Invalid signal: %s", s)
+	if n, err := strconv.ParseUint(s, 10, 32); err == nil {
+		if n == 0 || n > sigRTMax {
+			return 0, invalid
+		}
+		return uint32(n), nil
+	}
+	name := strings.TrimPrefix(strings.ToUpper(s), "SIG")
+	if n, ok := signals[name]; ok {
+		return n, nil
+	}
+	for _, rt := range []struct {
+		name string
+		base int
+		sign int
+	}{{"RTMIN", sigRTMin, 1}, {"RTMAX", sigRTMax, -1}} {
+		rest, ok := strings.CutPrefix(name, rt.name)
+		if !ok {
+			continue
+		}
+		off := 0
+		if rest != "" {
+			if (rt.sign > 0 && rest[0] != '+') || (rt.sign < 0 && rest[0] != '-') {
+				return 0, invalid
+			}
+			n, err := strconv.Atoi(rest[1:])
+			if err != nil {
+				return 0, invalid
+			}
+			off = rt.sign * n
+		}
+		if n := rt.base + off; n >= sigRTMin && n <= sigRTMax {
+			return uint32(n), nil
+		}
+		return 0, invalid
+	}
+	return 0, invalid
+}
+
+// ErrNoSignals is what a Runtime's signal path returns when the VM cannot
+// take signals (an init older than the signal request): the caller then
+// stops the whole VM, as before signals.
+var ErrNoSignals = errors.New("the VM cannot send signals to its processes")
