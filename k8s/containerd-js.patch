+
+package v86
+
+import "testing"
+
+func TestParseSignal(t *testing.T) {
+	for in, want := range map[string]uint32{
+		"15": 15, "SIGTERM": 15, "TERM": 15, "term": 15, "sigkill": 9, "HUP": 1,
+		"SIGWINCH": 28, "QUIT": 3, "RTMIN": 34, "RTMIN+3": 37, "SIGRTMAX-1": 63, "64": 64,
+	} {
+		if got, err := ParseSignal(in); err != nil || got != want {
+			t.Errorf("ParseSignal(%q) = %d, %v; want %d", in, got, err, want)
+		}
+	}
+	for _, in := range []string{"", "0", "65", "FOO", "SIG", "RTMIN-1", "RTMAX+1", "RTMIN+31", "RTMIN+x", "-1"} {
+		if got, err := ParseSignal(in); err == nil {
+			t.Errorf("ParseSignal(%q) = %d; want an error", in, got)
+		} else if err.Error() != "Invalid signal: "+in {
+			t.Errorf("ParseSignal(%q): %v; want dockerd's message", in, err)
+		}
+	}
+}
diff --git a/core/runtime/v2/v86/v86.go b/core/runtime/v2/v86/v86.go
new file mode 100644
index 0000000..af890b3
--- /dev/null
+++ b/core/runtime/v2/v86/v86.go
@@ -0,0 +1,489 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+// Package v86 is a containerd Runtime v2 shim that runs each task in a v86
+// virtual machine instead of a runc container. It is the "runc replacement"
+// for the tabernetes control plane: containerd manages images, snapshots and
+// tasks unchanged, and this package translates the task lifecycle onto the
+// v86 VM of the tab node.
+//
+// The Runtime interface is the seam. The js/wasm implementation drives the VM
+// worker in the tab (k8s/tabernetes/v86.go + vm/init/init.c); the fake
+// implementation (fake/) exists for tests.
+package v86
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	taskAPI "github.com/containerd/containerd/api/runtime/task/v2"
+	"github.com/containerd/containerd/api/types/task"
+	ptypes "github.com/containerd/containerd/v2/pkg/protobuf/types"
+	"github.com/containerd/errdefs"
+	"github.com/containerd/errdefs/pkg/errgrpc"
+	"github.com/containerd/ttrpc"
+	"github.com/containerd/typeurl/v2"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+	"google.golang.org/protobuf/types/known/timestamppb"
+)
+
+// Runtime boots a v86 VM for a single containerd task. Create must not run the
+// task's entrypoint yet: the VM boots to the initramfs "ready" state (stage 0
+// in vm/init/init.c) and waits for Start, exactly like the tab node waits for
+// the pod before "go".
+type Runtime interface {
+	Create(ctx context.Context, id string, spec *specs.Spec) (Handle, error)
+}
+
+// Handle is one running VM, created by Runtime.Create.
+type Handle interface {
+	// Start runs the task's entrypoint (v86: "go").
+	Start(ctx context.Context) error
+	// Wait blocks until the task exits and returns its exit code.
+	Wait(ctx context.Context) (uint32, error)
+	// Exec starts an additional process in the running task and returns its
+	// stdio. The v86 implementation streams over the VM's exec protocol
+	// (k8s/tabernetes/v86exec.go), not over fifos.
+	Exec(ctx context.Context, p *specs.Process) (io.ReadWriteCloser, error)
+	// Resize resizes the task's terminal.
+	Resize(rows, cols uint32) error
+	// Kill sends a signal to the task's entrypoint. It returns once the
+	// signal is sent; the exit, if any, comes through Wait. A task that has
+	// exited already gives errdefs.ErrNotFound, as with runc.
+	Kill(ctx context.Context, signal uint32) error
+	// State returns the current task status.
+	State(ctx context.Context) (task.Status, error)
+	// Delete stops the VM and releases its resources (v86: worker.terminate).
+	Delete(ctx context.Context) error
+}
+
+// NewService wraps a Runtime in a ttrpc TTRPCTaskService.
+// LogDir holds the console of every task, one file per task (LogPath), like
+// Docker's json-file log driver but as plain text. The runtime writes it, the
+// Docker API reads it for docker logs and deletes it with the container.
+var LogDir = "/var/log/v86"
+
+// LogPath is the console log of the task id.
+func LogPath(id string) string {
+	return filepath.Join(LogDir, id+".log")
+}
+
+// The OCI spec has no field for an open stdin: these annotations ask the VM
+// to give the main process a stdin ("true"), and to close it when the first
+// attach ends (stdinOnce), like docker run -i.
+const (
+	AnnotationStdin     = "dev.tabernetes.v86.stdin"
+	AnnotationStdinOnce = "dev.tabernetes.v86.stdin-once"
+)
+
+// TerminalSize is the size of a terminal, for a tty.
+type TerminalSize struct{ Rows, Cols uint16 }
+
+// Streamer gives the Docker API the stdio of tasks. The VM has its own exec
+// protocol (vm/init), not containerd's fifos, so attach and exec go to the
+// VM directly; containerd still runs the lifecycle.
+type Streamer interface {
+	// Attach writes the output of the main process of task id to out, from
+	// its start (the log) until it exits, so a fast process is not missed.
+	// With stdin, it also sends stdin to the process; resize sets the size
+	// of its tty.
+	Attach(ctx context.Context, id string, stdin io.Reader, out io.Writer, resize <-chan TerminalSize) error
+	// Exec runs cmd in task id and returns its exit code.
+	Exec(ctx context.Context, id string, cmd []string, tty bool, stdin io.Reader, stdout, stderr io.Writer, resize <-chan TerminalSize) (int, error)
+}
+
+func NewService(r Runtime) taskAPI.TTRPCTaskService {
+	return &service{runtime: r, tasks: make(map[string]Handle), exits: make(map[string]exitRecord)}
+}
+
+// NewBundleService is NewService for the shim of task id in bundle. It keeps
+// the exit of the task in the bundle (StateFile), so that the shim that a
+// restarted containerd loads for the bundle still knows the task: as
+// stopped, with its exit code. The VM itself does not survive a restart (it
+// ran in a tab), so a task that was still running when containerd went away
+// is stopped with exit code 255, the code containerd reports for a task whose
+// shim died (cleanupAfterDeadShim) and Docker shows after a crash.
+func NewBundleService(r Runtime, id, bundle string) taskAPI.TTRPCTaskService {
+	s := NewService(r).(*service)
+	s.id, s.bundle = id, bundle
+	return s
+}
+
+// StateFile is the file in the bundle of a task where the shim keeps that
+// the task was created, and later its exit (NewBundleService).
+const StateFile = "v86-state.json"
+
+// UnknownExitCode is the exit code of a task whose end nobody saw.
+const UnknownExitCode = 255
+
+type service struct {
+	mu      sync.Mutex
+	runtime Runtime
+	tasks   map[string]Handle
+	exits   map[string]exitRecord // of the tasks that ended, for State
+
+	id, bundle string // NewBundleService
+	done       bool   // the task of the bundle was created or restored
+}
+
+// exitRecord is the content of StateFile.
+type exitRecord struct {
+	Created    bool      `json:"created"`
+	Exited     bool      `json:"exited,omitempty"`
+	ExitStatus uint32    `json:"exitStatus,omitempty"`
+	ExitedAt   time.Time `json:"exitedAt,omitzero"`
+}
+
+var _ taskAPI.TTRPCTaskService = (*service)(nil)
+
+// RegisterTTRPC allows TTRPC services to be registered with the underlying
+// server.
+func (s *service) RegisterTTRPC(server *ttrpc.Server) error {
+	taskAPI.RegisterTTRPCTaskService(server, s)
+	return nil
+}
+
+func (s *service) get(id string) (Handle, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	h, ok := s.tasks[id]
+	if !ok {
+		h, ok = s.restore(id)
+	}
+	if !ok {
+		// as a grpc status: ttrpc sends other errors as Unknown
+		return nil, errgrpc.ToGRPC(fmt.Errorf("task %q not found: %w", id, errdefs.ErrNotFound))
+	}
+	return h, nil
+}
+
+// restore gives the shim of a restarted containerd the task of its bundle
+// back, as a stopped task: its VM is gone. A bundle without StateFile had no
+// task created; containerd removes such a shim. s.mu is held.
+func (s *service) restore(id string) (Handle, bool) {
+	if s.bundle == "" || id != s.id || s.done {
+		return nil, false
+	}
+	s.done = true // once: a task created or deleted here is not restored
+	b, err := os.ReadFile(filepath.Join(s.bundle, StateFile))
+	if err != nil {
+		return nil, false
+	}
+	var rec exitRecord
+	if err := json.Unmarshal(b, &rec); err != nil || !rec.Created {
+		return nil, false
+	}
+	if !rec.Exited {
+		rec.Exited, rec.ExitStatus = true, UnknownExitCode
+		// the last output of the task is the best guess of its end
+		rec.ExitedAt = time.Now()
+		if fi, err := os.Stat(LogPath(id)); err == nil {
+			rec.ExitedAt = fi.ModTime()
+		}
+		s.save(rec)
+	}
+	h := exitedHandle(rec.ExitStatus)
+	s.tasks[id] = h
+	s.exits[id] = rec
+	return h, true
+}
+
+// save writes the state of the task of a bundle service.
+func (s *service) save(rec exitRecord) {
+	if s.bundle == "" {
+		return
+	}
+	b, _ := json.Marshal(rec)
+	if err := os.WriteFile(filepath.Join(s.bundle, StateFile), b, 0o600); err != nil && !os.IsNotExist(err) {
+		fmt.Fprintf(os.Stderr, "v86: task %s: %v\n", s.id, err)
+	}
+}
+
+// watch records the exit of task id, for State and for the bundle.
+func (s *service) watch(id string, h Handle) {
+	code, err := h.Wait(context.Background())
+	if err != nil {
+		return
+	}
+	rec := exitRecord{Created: true, Exited: true, ExitStatus: code, ExitedAt: time.Now()}
+	s.mu.Lock()
+	if s.tasks[id] != h {
+		s.mu.Unlock() // deleted meanwhile
+		return
+	}
+	s.exits[id] = rec
+	if id == s.id {
+		s.save(rec)
+	}
+	s.mu.Unlock()
+}
+
+// exitedHandle is a task that ended before containerd restarted.
+type exitedHandle uint32
+
+func (exitedHandle) Start(context.Context) error {
+	return errgrpc.ToGRPC(fmt.Errorf("the VM of the task is gone: %w", errdefs.ErrFailedPrecondition))
+}
+func (h exitedHandle) Wait(context.Context) (uint32, error) { return uint32(h), nil }
+func (exitedHandle) Exec(context.Context, *specs.Process) (io.ReadWriteCloser, error) {
+	return nil, errgrpc.ToGRPC(fmt.Errorf("container is not running: %w", errdefs.ErrFailedPrecondition))
+}
+func (exitedHandle) Resize(rows, cols uint32) error {
+	return errgrpc.ToGRPC(fmt.Errorf("container is not running: %w", errdefs.ErrFailedPrecondition))
+}
+
+// Kill of an ended task gets the error of runc's shim.
+func (exitedHandle) Kill(context.Context, uint32) error {
+	return errgrpc.ToGRPC(fmt.Errorf("process already finished: %w", errdefs.ErrNotFound))
+}
+func (exitedHandle) State(context.Context) (task.Status, error) { return task.Status_STOPPED, nil }
+func (exitedHandle) Delete(context.Context) error               { return nil }
+
+// readSpec loads the OCI runtime spec that containerd wrote into the bundle.
+func readSpec(bundle string) (*specs.Spec, error) {
+	f, err := os.Open(filepath.Join(bundle, "config.json"))
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	var spec specs.Spec
+	if err := json.NewDecoder(f).Decode(&spec); err != nil {
+		return nil, err
+	}
+	return &spec, nil
+}
+
+// Create boots a VM for a new task. The VM waits in the initramfs until Start.
+func (s *service) Create(ctx context.Context, r *taskAPI.CreateTaskRequest) (*taskAPI.CreateTaskResponse, error) {
+	spec, err := readSpec(r.Bundle)
+	if err != nil {
+		return nil, err
+	}
+	// containerd writes the rootfs (the mounted snapshot) under the bundle;
+	// the spec's root.path is relative to it. Make it absolute so the js/wasm
+	// Runtime can read the snapshot.
+	if spec.Root != nil && spec.Root.Path != "" && !filepath.IsAbs(spec.Root.Path) {
+		spec.Root.Path = filepath.Join(r.Bundle, spec.Root.Path)
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.tasks[r.ID]; ok {
+		return nil, fmt.Errorf("task %q already exists: %w", r.ID, errdefs.ErrAlreadyExists)
+	}
+
+	h, err := s.runtime.Create(ctx, r.ID, spec)
+	if err != nil {
+		return nil, err
+	}
+	s.tasks[r.ID] = h
+	delete(s.exits, r.ID)
+	if r.ID == s.id {
+		s.done = true
+		s.save(exitRecord{Created: true})
+	}
+	go s.watch(r.ID, h)
+	return &taskAPI.CreateTaskResponse{Pid: 1}, nil
+}
+
+// Start runs the task's entrypoint.
+func (s *service) Start(ctx context.Context, r *taskAPI.StartRequest) (*taskAPI.StartResponse, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, err
+	}
+	if err := h.Start(ctx); err != nil {
+		return nil, err
+	}
+	return &taskAPI.StartResponse{Pid: 1}, nil
+}
+
+// Delete stops the task's VM and removes it.
+func (s *service) Delete(ctx context.Context, r *taskAPI.DeleteRequest) (*taskAPI.DeleteResponse, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, err
+	}
+	if err := h.Delete(ctx); err != nil {
+		return nil, err
+	}
+	s.mu.Lock()
+	rec := s.exits[r.ID]
+	delete(s.tasks, r.ID)
+	delete(s.exits, r.ID)
+	if r.ID == s.id {
+		os.Remove(filepath.Join(s.bundle, StateFile))
+	}
+	s.mu.Unlock()
+	resp := &taskAPI.DeleteResponse{Pid: 1, ExitStatus: rec.ExitStatus}
+	if rec.Exited {
+		resp.ExitedAt = timestamppb.New(rec.ExitedAt)
+	}
+	return resp, nil
+}
+
+// Exec starts an additional process in the running task.
+func (s *service) Exec(ctx context.Context, r *taskAPI.ExecProcessRequest) (*ptypes.Empty, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, err
+	}
+
+	var p specs.Process
+	if r.Spec != nil {
+		if err := typeurl.UnmarshalTo(r.Spec, &p); err != nil {
+			return nil, err
+		}
+	}
+
+	_, err = h.Exec(ctx, &p)
+	return &ptypes.Empty{}, err
+}
+
+// ResizePty resizes the task's terminal.
+func (s *service) ResizePty(ctx context.Context, r *taskAPI.ResizePtyRequest) (*ptypes.Empty, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, err
+	}
+	if err := h.Resize(r.Height, r.Width); err != nil {
+		return nil, err
+	}
+	return &ptypes.Empty{}, nil
+}
+
+// State returns the task's status.
+func (s *service) State(ctx context.Context, r *taskAPI.StateRequest) (*taskAPI.StateResponse, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, err
+	}
+	st, err := h.State(ctx)
+	if err != nil {
+		return nil, err
+	}
+	resp := &taskAPI.StateResponse{ID: r.ID, Bundle: s.bundle, Pid: 1, Status: st}
+	if st == task.Status_STOPPED {
+		s.mu.Lock()
+		rec, ok := s.exits[r.ID]
+		s.mu.Unlock()
+		if !ok {
+			// watch records the exit a moment after the handle stopped
+			wctx, cancel := context.WithTimeout(ctx, 100*time.Millisecond)
+			code, err := h.Wait(wctx)
+			cancel()
+			rec = exitRecord{ExitStatus: code, ExitedAt: time.Now()}
+			ok = err == nil
+		}
+		if ok {
+			resp.ExitStatus, resp.ExitedAt = rec.ExitStatus, timestamppb.New(rec.ExitedAt)
+		}
+	}
+	return resp, nil
+}
+
+// Kill sends a signal to the task's entrypoint. The error crosses ttrpc
+// as a status, so that containerd and the Docker API see "not found" for a
+// task that has exited, as from the runc shim.
+func (s *service) Kill(ctx context.Context, r *taskAPI.KillRequest) (*ptypes.Empty, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, errgrpc.ToGRPC(err)
+	}
+	if err := h.Kill(ctx, r.Signal); err != nil {
+		return nil, errgrpc.ToGRPC(err)
+	}
+	return &ptypes.Empty{}, nil
+}
+
+// Wait blocks until the task exits.
+func (s *service) Wait(ctx context.Context, r *taskAPI.WaitRequest) (*taskAPI.WaitResponse, error) {
+	h, err := s.get(r.ID)
+	if err != nil {
+		return nil, err
+	}
+	code, err := h.Wait(ctx)
+	if err != nil {
+		return nil, err
+	}
+	at := timestamppb.Now()
+	s.mu.Lock()
+	if rec, ok := s.exits[r.ID]; ok {
+		at = timestamppb.New(rec.ExitedAt)
+	}
+	s.mu.Unlock()
+	return &taskAPI.WaitResponse{ExitStatus: code, ExitedAt: at}, nil
+}
+
+// Pids returns the pids inside the task. A v86 VM has no host pids.
+func (s *service) Pids(ctx context.Context, r *taskAPI.PidsRequest) (*taskAPI.PidsResponse, error) {
+	if _, err := s.get(r.ID); err != nil {
+		return nil, err
+	}
+	return &taskAPI.PidsResponse{}, nil
+}
+
+// Pause is not supported: v86 has no cgroup freezer. It is a no-op so that
+// `docker pause` on the tab node behaves like a running task.
+func (s *service) Pause(ctx context.Context, r *taskAPI.PauseRequest) (*ptypes.Empty, error) {
+	return &ptypes.Empty{}, nil
+}
+
+// Resume is not supported: v86 has no cgroup freezer.
+func (s *service) Resume(ctx context.Context, r *taskAPI.ResumeRequest) (*ptypes.Empty, error) {
+	return &ptypes.Empty{}, nil
+}
+
+// Checkpoint is not supported by v86.
+func (s *service) Checkpoint(ctx context.Context, r *taskAPI.CheckpointTaskRequest) (*ptypes.Empty, error) {
+	return nil, errdefs.ErrNotImplemented
+}
+
+// CloseIO is not supported: stdio streams over the VM, not over fifos.
+func (s *service) CloseIO(ctx context.Context, r *taskAPI.CloseIORequest) (*ptypes.Empty, error) {
+	return nil, errdefs.ErrNotImplemented
+}
+
+// Update is not supported: the v86 VM's memory limit is set at Create.
+func (s *service) Update(ctx context.Context, r *taskAPI.UpdateTaskRequest) (*ptypes.Empty, error) {
+	return nil, errdefs.ErrNotImplemented
+}
+
+// Stats is not supported: v86 does not expose cgroup counters.
+func (s *service) Stats(ctx context.Context, r *taskAPI.StatsRequest) (*taskAPI.StatsResponse, error) {
+	return nil, errdefs.ErrNotImplemented
+}
+
+// Connect reports the pids. containerd asks for them after Create (the task
+// pid of the tasks service). The shim has no host pid; the task is PID 1 of
+// its VM, as Create and Start report.
+func (s *service) Connect(ctx context.Context, r *taskAPI.ConnectRequest) (*taskAPI.ConnectResponse, error) {
+	if _, err := s.get(r.ID); err != nil {
+		return nil, err
+	}
+	return &taskAPI.ConnectResponse{TaskPid: 1}, nil
+}
+
+// Shutdown is a no-op: the shim runs in-process, there is no process to exit.
+func (s *service) Shutdown(ctx context.Context, r *taskAPI.ShutdownRequest) (*ptypes.Empty, error) {
+	return &ptypes.Empty{}, nil
+}
