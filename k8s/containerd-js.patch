+// Package restart tests a restart of the in-process daemon on the same
+// directories, as after a reload of the page in tabernetes. It is a package
+// of its own: a test binary runs the daemon twice here, and the tests of
+// the daemon package start it once for all of them.
+package restart
+
+import (
+	"context"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/daemon"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/fake"
+	"github.com/containerd/containerd/v2/pkg/cio"
+	"github.com/containerd/containerd/v2/pkg/oci"
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+// TestRestart runs containers, stops the daemon and starts a new one on the
+// same root and state: the containers are there, their tasks stopped with
+// the exit code they had (255 for one that still ran: its VM is gone), and
+// they can be deleted and started again.
+func TestRestart(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	dir := t.TempDir()
+	v86.LogDir = dir + "/log"
+	root, state := dir+"/root", dir+"/state"
+
+	rt := fake.NewRuntime()
+	d, err := daemon.Start(ctx, root, state, "default", rt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	run := func(id string) client.Task {
+		c, err := d.Client.NewContainer(ctx, id, client.WithNewSpec(oci.WithProcessArgs("sh")))
+		if err != nil {
+			t.Fatal(err)
+		}
+		tk, err := c.NewTask(ctx, cio.NullIO)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := tk.Start(ctx); err != nil {
+			t.Fatal(err)
+		}
+		return tk
+	}
+	ended := run("ended")
+	exitC, err := ended.Wait(ctx)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rt.Created["ended"].ExitCode(3)
+	if s := <-exitC; s.ExitCode() != 3 {
+		t.Fatalf("exit %d; want 3", s.ExitCode())
+	}
+	run("running")
+	if c, err := d.Client.NewContainer(ctx, "created", client.WithNewSpec(oci.WithProcessArgs("sh"))); err != nil {
+		t.Fatal(err)
+	} else if _, err := os.Stat(state); err != nil {
+		t.Fatal(c, err)
+	}
+	// watch writes the exit to the bundle in the background
+	time.Sleep(100 * time.Millisecond)
+	d.Stop()
+
+	// The plugins register their metrics once per process; the browser
+	// starts a new process after a reload.
+	prometheus.DefaultRegisterer = prometheus.NewRegistry()
+	rt2 := fake.NewRuntime()
+	d, err = daemon.Start(ctx, root, state, "default", rt2)
+	if err != nil {
+		t.Fatalf("restart: %v", err)
+	}
+	defer d.Stop()
+	cs, err := d.Client.Containers(ctx)
+	if err != nil || len(cs) != 3 {
+		t.Fatalf("containers %v, %v; want 3", cs, err)
+	}
+	for id, want := range map[string]uint32{"ended": 3, "running": v86.UnknownExitCode} {
+		c, err := d.Client.LoadContainer(ctx, id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		tk, err := c.Task(ctx, nil)
+		if err != nil {
+			t.Fatalf("%s: task after the restart: %v", id, err)
+		}
+		st, err := tk.Status(ctx)
+		if err != nil || st.Status != client.Stopped || st.ExitStatus != want {
+			t.Fatalf("%s: status %+v, %v; want stopped with %d", id, st, err, want)
+		}
+		// docker wait of an ended container returns at once
+		exitC, err := tk.Wait(ctx)
+		if err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case s := <-exitC:
+			if s.ExitCode() != want {
+				t.Errorf("%s: wait %d; want %d", id, s.ExitCode(), want)
+			}
+		case <-time.After(10 * time.Second):
+			t.Fatalf("%s: wait hangs", id)
+		}
+		// docker start: the old task goes, a new one runs in a new VM
+		if _, err := tk.Delete(ctx); err != nil {
+			t.Fatalf("%s: delete: %v", id, err)
+		}
+		tk, err = c.NewTask(ctx, cio.NullIO)
+		if err != nil {
+			t.Fatalf("%s: a new task: %v", id, err)
+		}
+		if err := tk.Start(ctx); err != nil {
+			t.Fatal(err)
+		}
+		if rt2.Created[id] == nil {
+			t.Fatalf("%s: the new runtime got no task", id)
+		}
+	}
+	c, err := d.Client.LoadContainer(ctx, "created")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.Task(ctx, nil); err == nil {
+		t.Error("a container without a task has a task after the restart")
+	}
+}
