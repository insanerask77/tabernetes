+package dockerapi
+
+// attach and exec. The Docker API takes over the HTTP connection for them
+// (hijack): the client asks for "Upgrade: tcp", the server answers
+// "101 UPGRADED" and both sides then use the connection as a stream. With a
+// tty the stream is raw; without one every frame of output starts with 8
+// bytes, the stream (1 stdout, 2 stderr) and the size.
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strconv"
+	"sync"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// execInstance is a docker exec: created by POST /containers/{id}/exec, run
+// by POST /exec/{id}/start.
+type execInstance struct {
+	ID          string
+	ContainerID string
+	Cmd         []string
+	Tty         bool
+	AttachStdin bool
+
+	mu       sync.Mutex
+	running  bool
+	exitCode int
+	resize   chan v86.TerminalSize
+}
+
+type execCreateRequest struct {
+	AttachStdin  bool     `json:"AttachStdin"`
+	AttachStdout bool     `json:"AttachStdout"`
+	AttachStderr bool     `json:"AttachStderr"`
+	Tty          bool     `json:"Tty"`
+	Cmd          []string `json:"Cmd"`
+}
+
+type execStartRequest struct {
+	Detach bool `json:"Detach"`
+	Tty    bool `json:"Tty"`
+}
+
+// hijack takes over the connection of r. It answers "101 UPGRADED" if the
+// client asked for an upgrade, else "200 OK", as dockerd does. The returned
+// reader is what the client sends next (stdin): the bytes the server has
+// buffered, then the connection itself. The buffered reader of Hijack still
+// reads through the server, which cancels the context of the request when it
+// reads EOF, that is when the client ends its stdin (docker exec -i < file).
+func hijack(w http.ResponseWriter, r *http.Request, tty bool) (net.Conn, io.Reader, error) {
+	hj, ok := w.(http.Hijacker)
+	if !ok {
+		return nil, nil, fmt.Errorf("the connection cannot be hijacked")
+	}
+	conn, rw, err := hj.Hijack()
+	if err != nil {
+		return nil, nil, err
+	}
+	ct := "application/vnd.docker.multiplexed-stream"
+	if tty {
+		ct = "application/vnd.docker.raw-stream"
+	}
+	if r.Header.Get("Upgrade") == "tcp" {
+		fmt.Fprintf(rw, "HTTP/1.1 101 UPGRADED\r\nContent-Type: %s\r\nConnection: Upgrade\r\nUpgrade: tcp\r\n\r\n", ct)
+	} else {
+		fmt.Fprintf(rw, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\n\r\n", ct)
+	}
+	if err := rw.Flush(); err != nil {
+		conn.Close()
+		return nil, nil, err
+	}
+	buffered, _ := rw.Reader.Peek(rw.Reader.Buffered())
+	return conn, io.MultiReader(bytes.NewReader(bytes.Clone(buffered)), conn), nil
+}
+
+// muxWriter writes one stream of a multiplexed stream.
+type muxWriter struct {
+	mu     *sync.Mutex
+	w      io.Writer
+	stream byte
+}
+
+func (m muxWriter) Write(b []byte) (int, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for off := 0; off < len(b); {
+		n := min(len(b)-off, 1<<16)
+		hdr := [8]byte{m.stream}
+		binary.BigEndian.PutUint32(hdr[4:], uint32(n))
+		if _, err := m.w.Write(hdr[:]); err != nil {
+			return off, err
+		}
+		if _, err := m.w.Write(b[off : off+n]); err != nil {
+			return off, err
+		}
+		off += n
+	}
+	return len(b), nil
+}
+
+// outputs returns stdout and stderr on conn, raw with a tty.
+func outputs(conn io.Writer, tty bool) (stdout, stderr io.Writer) {
+	if tty {
+		return conn, conn
+	}
+	mu := new(sync.Mutex)
+	return muxWriter{mu, conn, 1}, muxWriter{mu, conn, 2}
+}
+
+// cancelWriter cancels the stream when the client went away: writing to its
+// connection fails.
+type cancelWriter struct {
+	w      io.Writer
+	cancel context.CancelFunc
+}
+
+func (c cancelWriter) Write(b []byte) (int, error) {
+	n, err := c.w.Write(b)
+	if err != nil {
+		c.cancel()
+	}
+	return n, err
+}
+
+func queryBool(r *http.Request, key string) bool {
+	v, _ := strconv.ParseBool(r.URL.Query().Get(key))
+	return v
+}
+
+// attach streams the main process of a container: POST
+// /containers/{id}/attach?stream=1&stdin=1&stdout=1&stderr=1. The VM starts
+// the process at once, so docker run and docker start -a attach after the
+// start: with logs=1 the output starts at the start of the current run (in
+// dockerd, logs=1 sends the whole log). Without it, as docker attach does,
+// only what comes from now on.
+func (s *Server) attach(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	if s.streams == nil {
+		http.Error(w, "attach is not supported", http.StatusNotImplemented)
+		return
+	}
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	tty, openStdin := false, false
+	if spec, err := c.Spec(ctx); err == nil {
+		tty = spec.Process != nil && spec.Process.Terminal
+		openStdin = spec.Annotations[v86.AnnotationStdin] == "true"
+	}
+	// skip is the part of the log not to send.
+	var skip int64
+	if queryBool(r, "logs") {
+		if run := s.running(c.ID()); run != nil {
+			skip = run.logStart
+		}
+	} else if fi, err := os.Stat(v86.LogPath(c.ID())); err == nil {
+		skip = fi.Size()
+	}
+	conn, br, err := hijack(w, r, tty)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	defer conn.Close()
+	// The stream ends with its connection (cancelWriter), not with the
+	// request, see hijack.
+	ctx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	defer cancel()
+	stdout, _ := outputs(conn, tty)
+	stdout = &skipWriter{w: cancelWriter{stdout, cancel}, n: skip}
+	var stdin io.Reader
+	// a container without -i has no stdin to attach to
+	if queryBool(r, "stdin") && openStdin {
+		stdin = br
+	}
+	resize := s.addResize(c.ID())
+	defer s.removeResize(c.ID(), resize)
+	if err := s.streams.Attach(ctx, c.ID(), stdin, stdout, resize); err != nil {
+		// no task (never started, or deleted): what the log has
+		if b, err := os.ReadFile(v86.LogPath(c.ID())); err == nil {
+			stdout.Write(b)
+		}
+	}
+}
+
+// skipWriter drops the first n bytes written to it.
+type skipWriter struct {
+	w io.Writer
+	n int64
+}
+
+func (s *skipWriter) Write(b []byte) (int, error) {
+	if s.n >= int64(len(b)) {
+		s.n -= int64(len(b))
+		return len(b), nil
+	}
+	n := len(b)
+	b = b[s.n:]
+	s.n = 0
+	if _, err := s.w.Write(b); err != nil {
+		return 0, err
+	}
+	return n, nil
+}
+
+// addResize registers a channel for the terminal sizes that POST
+// /containers/{id}/resize sends to the attaches of the container.
+func (s *Server) addResize(id string) chan v86.TerminalSize {
+	ch := make(chan v86.TerminalSize, 4)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.resizes[id] == nil {
+		s.resizes[id] = make(map[chan v86.TerminalSize]bool)
+	}
+	s.resizes[id][ch] = true
+	return ch
+}
+
+func (s *Server) removeResize(id string, ch chan v86.TerminalSize) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	delete(s.resizes[id], ch)
+	if len(s.resizes[id]) == 0 {
+		delete(s.resizes, id)
+	}
+}
+
+// terminalSize reads ?h=&w= of a resize request.
+func terminalSize(r *http.Request) (v86.TerminalSize, error) {
+	h, err := strconv.ParseUint(r.URL.Query().Get("h"), 10, 16)
+	if err != nil {
+		return v86.TerminalSize{}, fmt.Errorf("bad height: %w", err)
+	}
+	wd, err := strconv.ParseUint(r.URL.Query().Get("w"), 10, 16)
+	if err != nil {
+		return v86.TerminalSize{}, fmt.Errorf("bad width: %w", err)
+	}
+	return v86.TerminalSize{Rows: uint16(h), Cols: uint16(wd)}, nil
+}
+
+// sendSize sends a size without blocking; a full channel keeps its sizes.
+func sendSize(ch chan v86.TerminalSize, size v86.TerminalSize) {
+	select {
+	case ch <- size:
+	default:
+	}
+}
+
+// resize sets the tty size of a container: POST /containers/{id}/resize.
+func (s *Server) resize(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	size, err := terminalSize(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	s.mu.Lock()
+	for ch := range s.resizes[c.ID()] {
+		sendSize(ch, size)
+	}
+	s.mu.Unlock()
+	w.WriteHeader(http.StatusOK)
+}
+
+// execCreate makes an exec instance: POST /containers/{id}/exec.
+func (s *Server) execCreate(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	var req execCreateRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	if len(req.Cmd) == 0 {
+		http.Error(w, "No exec command specified", http.StatusBadRequest)
+		return
+	}
+	if t, err := c.Task(ctx, nil); err != nil {
+		http.Error(w, fmt.Sprintf("container %s is not running", c.ID()), http.StatusConflict)
+		return
+	} else if st, err := t.Status(ctx); err != nil || st.Status != client.Running {
+		http.Error(w, fmt.Sprintf("container %s is not running", c.ID()), http.StatusConflict)
+		return
+	}
+	b := make([]byte, 32)
+	rand.Read(b)
+	e := &execInstance{
+		ID: hex.EncodeToString(b), ContainerID: c.ID(), Cmd: req.Cmd, Tty: req.Tty,
+		AttachStdin: req.AttachStdin, resize: make(chan v86.TerminalSize, 4),
+	}
+	s.mu.Lock()
+	s.execs[e.ID] = e
+	s.mu.Unlock()
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	json.NewEncoder(w).Encode(map[string]string{"Id": e.ID})
+}
+
+func (s *Server) exec(id string) (*execInstance, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.execs[id]
+	return e, ok
+}
+
+// execStart runs an exec instance: POST /exec/{id}/start.
+func (s *Server) execStart(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	if s.streams == nil {
+		http.Error(w, "exec is not supported", http.StatusNotImplemented)
+		return
+	}
+	e, ok := s.exec(id)
+	if !ok {
+		http.Error(w, "No such exec instance: "+id, http.StatusNotFound)
+		return
+	}
+	var req execStartRequest
+	if r.ContentLength != 0 {
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+	e.mu.Lock()
+	if e.running {
+		e.mu.Unlock()
+		http.Error(w, "exec "+id+" is already running", http.StatusConflict)
+		return
+	}
+	e.running = true
+	e.mu.Unlock()
+	run := func(ctx context.Context, stdin io.Reader, stdout, stderr io.Writer) {
+		code, err := s.streams.Exec(ctx, e.ContainerID, e.Cmd, e.Tty, stdin, stdout, stderr, e.resize)
+		if err != nil {
+			fmt.Fprintln(stderr, err)
+			if code == 0 {
+				code = 126 // what docker exec reports when the command cannot run
+			}
+		}
+		e.mu.Lock()
+		e.running, e.exitCode = false, code
+		e.mu.Unlock()
+	}
+	if req.Detach {
+		go run(context.WithoutCancel(ctx), nil, io.Discard, io.Discard)
+		w.WriteHeader(http.StatusOK)
+		return
+	}
+	conn, br, err := hijack(w, r, e.Tty)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	defer conn.Close()
+	// The stream ends with its connection (cancelWriter), not with the
+	// request, see hijack.
+	ctx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	defer cancel()
+	stdout, stderr := outputs(conn, e.Tty)
+	var stdin io.Reader
+	if e.AttachStdin {
+		stdin = br
+	}
+	run(ctx, stdin, cancelWriter{stdout, cancel}, cancelWriter{stderr, cancel})
+}
+
+// execResize sets the tty size of an exec: POST /exec/{id}/resize.
+func (s *Server) execResize(w http.ResponseWriter, r *http.Request, id string) {
+	e, ok := s.exec(id)
+	if !ok {
+		http.Error(w, "No such exec instance: "+id, http.StatusNotFound)
+		return
+	}
+	size, err := terminalSize(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	sendSize(e.resize, size)
+	w.WriteHeader(http.StatusOK)
+}
+
+// execInspect reports an exec instance: GET /exec/{id}/json.
+func (s *Server) execInspect(w http.ResponseWriter, id string) {
+	e, ok := s.exec(id)
+	if !ok {
+		http.Error(w, "No such exec instance: "+id, http.StatusNotFound)
+		return
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	writeJSON(w, map[string]any{
+		"ID": e.ID, "ContainerID": e.ContainerID, "Running": e.running, "ExitCode": e.exitCode,
+		"ProcessConfig": map[string]any{"tty": e.Tty, "entrypoint": e.Cmd[0], "arguments": e.Cmd[1:]},
+	})
+}
