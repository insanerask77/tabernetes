+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86_test
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	taskAPI "github.com/containerd/containerd/api/runtime/task/v2"
+	"github.com/containerd/containerd/api/types/task"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/fake"
+	"github.com/containerd/errdefs"
+	"github.com/containerd/errdefs/pkg/errgrpc"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// writeBundle writes a minimal OCI bundle (config.json) for a test task.
+func writeBundle(t *testing.T, args ...string) string {
+	t.Helper()
+	dir := t.TempDir()
+	spec := specs.Spec{
+		Process: &specs.Process{
+			Args: args,
+			Cwd:  "/",
+		},
+	}
+	b, err := json.Marshal(&spec)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "config.json"), b, 0644); err != nil {
+		t.Fatal(err)
+	}
+	return dir
+}
+
+func TestCreateStartWaitDelete(t *testing.T) {
+	rt := fake.NewRuntime()
+	s := v86.NewService(rt)
+
+	bundle := writeBundle(t, "/bin/sh", "-c", "exit 0")
+	ctx := context.Background()
+
+	if _, err := s.Create(ctx, &taskAPI.CreateTaskRequest{ID: "t1", Bundle: bundle}); err != nil {
+		t.Fatalf("create: %v", err)
+	}
+
+	if _, err := s.Start(ctx, &taskAPI.StartRequest{ID: "t1"}); err != nil {
+		t.Fatalf("start: %v", err)
+	}
+
+	st, err := s.State(ctx, &taskAPI.StateRequest{ID: "t1"})
+	if err != nil {
+		t.Fatalf("state: %v", err)
+	}
+	if st.Status != task.Status_RUNNING {
+		t.Fatalf("status = %v, want running", st.Status)
+	}
+
+	go rt.Created["t1"].ExitCode(0)
+
+	wait, err := s.Wait(ctx, &taskAPI.WaitRequest{ID: "t1"})
+	if err != nil {
+		t.Fatalf("wait: %v", err)
+	}
+	if wait.ExitStatus != 0 {
+		t.Fatalf("exit status = %d, want 0", wait.ExitStatus)
+	}
+
+	if _, err := s.Delete(ctx, &taskAPI.DeleteRequest{ID: "t1"}); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+
+	if _, err := s.State(ctx, &taskAPI.StateRequest{ID: "t1"}); err == nil {
+		t.Fatal("state after delete: expected not found, got nil")
+	}
+}
+
+// Kill of a task that has exited is "not found" across ttrpc, as from the
+// runc shim; the Docker API takes that as "not running".
+func TestKillAfterExit(t *testing.T) {
+	rt := fake.NewRuntime()
+	s := v86.NewService(rt)
+	ctx := context.Background()
+	if _, err := s.Create(ctx, &taskAPI.CreateTaskRequest{ID: "t1", Bundle: writeBundle(t, "sleep", "600")}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Start(ctx, &taskAPI.StartRequest{ID: "t1"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Kill(ctx, &taskAPI.KillRequest{ID: "t1", Signal: 15}); err != nil {
+		t.Fatal(err)
+	}
+	if w, err := s.Wait(ctx, &taskAPI.WaitRequest{ID: "t1"}); err != nil || w.ExitStatus != 143 {
+		t.Fatalf("wait: %v, %v; want 143", w, err)
+	}
+	_, err := s.Kill(ctx, &taskAPI.KillRequest{ID: "t1", Signal: 15})
+	if !errdefs.IsNotFound(errgrpc.ToNative(err)) {
+		t.Fatalf("kill after the exit: %v; want not found", err)
+	}
+}
+
+// TestBundleServiceRestart: the shim of a restarted containerd knows the
+// task of its bundle as stopped, with the exit code it had, or 255 when it
+// still ran (its VM is gone), and no task if none was created.
+func TestBundleServiceRestart(t *testing.T) {
+	ctx := context.Background()
+	v86.LogDir = t.TempDir()
+	rt := fake.NewRuntime()
+
+	exited := writeBundle(t, "/bin/true")
+	s := v86.NewBundleService(rt, "t1", exited)
+	if _, err := s.Create(ctx, &taskAPI.CreateTaskRequest{ID: "t1", Bundle: exited}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.Start(ctx, &taskAPI.StartRequest{ID: "t1"}); err != nil {
+		t.Fatal(err)
+	}
+	rt.Created["t1"].ExitCode(3)
+	if w, err := s.Wait(ctx, &taskAPI.WaitRequest{ID: "t1"}); err != nil || w.ExitStatus != 3 {
+		t.Fatalf("wait %v, %v; want 3", w, err)
+	}
+	// the exit is in the bundle a moment after
+	for i := 0; ; i++ {
+		b, _ := os.ReadFile(filepath.Join(exited, v86.StateFile))
+		if strings.Contains(string(b), `"exitStatus":3`) {
+			break
+		}
+		if i == 100 {
+			t.Fatalf("state file %q; want exit status 3", b)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	st, err := s.State(ctx, &taskAPI.StateRequest{ID: "t1"})
+	if err != nil || st.Status != task.Status_STOPPED || st.ExitStatus != 3 {
+		t.Fatalf("state %v, %v; want stopped with 3", st, err)
+	}
+
+	running := writeBundle(t, "/bin/sleep", "1d")
+	s2 := v86.NewBundleService(rt, "t2", running)
+	if _, err := s2.Create(ctx, &taskAPI.CreateTaskRequest{ID: "t2", Bundle: running}); err != nil {
+		t.Fatal(err)
+	}
+	none := writeBundle(t, "/bin/true")
+
+	// a new containerd: new shims for the same bundles, no Create
+	after := v86.NewBundleService(rt, "t1", exited)
+	if _, err := after.Connect(ctx, &taskAPI.ConnectRequest{ID: "t1"}); err != nil {
+		t.Fatalf("connect: %v", err)
+	}
+	st, err = after.State(ctx, &taskAPI.StateRequest{ID: "t1"})
+	if err != nil || st.Status != task.Status_STOPPED || st.ExitStatus != 3 || st.ExitedAt == nil {
+		t.Fatalf("state after the restart %v, %v; want stopped with 3", st, err)
+	}
+	if _, err := after.Kill(ctx, &taskAPI.KillRequest{ID: "t1", Signal: 9}); !errdefs.IsNotFound(errgrpc.ToNative(err)) {
+		t.Errorf("kill of an ended task: %v; want not found", err)
+	}
+	if _, err := after.Start(ctx, &taskAPI.StartRequest{ID: "t1"}); err == nil {
+		t.Error("start of a task whose VM is gone: no error")
+	}
+	if _, err := after.Delete(ctx, &taskAPI.DeleteRequest{ID: "t1"}); err != nil {
+		t.Fatalf("delete: %v", err)
+	}
+	if _, err := after.State(ctx, &taskAPI.StateRequest{ID: "t1"}); !errdefs.IsNotFound(errgrpc.ToNative(err)) {
+		t.Errorf("state after delete: %v; want not found", err)
+	}
+
+	after2 := v86.NewBundleService(rt, "t2", running)
+	st, err = after2.State(ctx, &taskAPI.StateRequest{ID: "t2"})
+	if err != nil || st.Status != task.Status_STOPPED || st.ExitStatus != v86.UnknownExitCode {
+		t.Fatalf("state of a task that ran: %v, %v; want stopped with 255", st, err)
+	}
+
+	after3 := v86.NewBundleService(rt, "t3", none)
+	if _, err := after3.Connect(ctx, &taskAPI.ConnectRequest{ID: "t3"}); !errdefs.IsNotFound(errgrpc.ToNative(err)) {
+		t.Errorf("connect to a shim without a task: %v; want not found", err)
+	}
+}
