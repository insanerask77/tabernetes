diff --git a/vendor/go.etcd.io/bbolt/bolt_js.go b/vendor/go.etcd.io/bbolt/bolt_js.go
new file mode 100644
index 0000000..48fc421
--- /dev/null
+++ b/vendor/go.etcd.io/bbolt/bolt_js.go
@@ -0,0 +1,56 @@
+//go:build js
+
+package bbolt
+
+import (
+	"io"
+	"time"
+	"unsafe"
+
+	"go.etcd.io/bbolt/internal/common"
+)
+
+// js/wasm has no advisory file locks and no mmap. bbolt's mmap is read-only
+// (PROT_READ) and writes go through db.ops.writeAt, so we emulate it with a
+// copy of the file. A real mapping is shared: a page that a commit writes is
+// visible in it at once, and bbolt reads it back from there (the meta page,
+// the pages of the next transaction). So every write goes to the copy too,
+// else the next transaction reads stale pages ("misplaced bucket header").
+
+func flock(db *DB, exclusive bool, timeout time.Duration) error {
+	return nil
+}
+
+func funlock(db *DB) error {
+	return nil
+}
+
+func mmap(db *DB, sz int) error {
+	b := make([]byte, sz)
+	if _, err := db.file.ReadAt(b, 0); err != nil && err != io.EOF {
+		return err
+	}
+	db.dataref = b
+	db.data = (*[common.MaxMapSize]byte)(unsafe.Pointer(&b[0]))
+	db.datasz = sz
+	if db.ops.writeAt != nil && !db.readOnly {
+		db.ops.writeAt = func(p []byte, off int64) (int, error) {
+			n, err := db.file.WriteAt(p, off)
+			if d := db.dataref; off < int64(len(d)) {
+				copy(d[off:], p[:n])
+			}
+			return n, err
+		}
+	}
+	return nil
+}
+
+func munmap(db *DB) error {
+	if db.dataref == nil {
+		return nil
+	}
+	db.dataref = nil
+	db.data = nil
+	db.datasz = 0
+	return nil
+}
