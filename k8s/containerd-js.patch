+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package defaults
+
+import "strings"
+
+// js/wasm has no unix sockets. containerd's control sockets (grpc, ttrpc and
+// debug) map onto fixed ports of the in-process fake TCP network. MapAddress is
+// the single place that maps a socket address to host:port, so the daemon
+// (pkg/sys) and the client (pkg/dialer) agree on the ports.
+
+const (
+	DefaultAddress      = "127.0.0.1:10000" // grpc
+	DefaultDebugAddress = "127.0.0.1:10002" // pprof
+	DefaultFIFODir      = ""
+	DefaultRuntime      = "io.containerd.runc.v2"
+	DefaultSnapshotter  = "native"
+	DefaultStateDir     = "/tmp/containerd"
+	DefaultDiffer       = "walking"
+	DefaultConfigDir    = "/etc/containerd"
+	DefaultRootDir      = "/var/lib/containerd"
+
+	DefaultConfigIncludePattern = "/etc/containerd/conf.d/*.toml"
+)
+
+// MapAddress maps a socket address (a unix path, "tcp://host:port", or a plain
+// "host:port") to a host:port on the in-process fake network.
+func MapAddress(address string) string {
+	s := strings.TrimPrefix(address, "tcp://")
+	s = strings.TrimPrefix(s, "unix://")
+	switch {
+	case strings.HasSuffix(s, ".ttrpc"):
+		return "127.0.0.1:10001" // the ttrpc server appends ".ttrpc"
+	case strings.HasSuffix(s, ".debug"):
+		return "127.0.0.1:10002"
+	case strings.Contains(s, ":") && !strings.Contains(s, "/"):
+		return s // already host:port
+	default:
+		return "127.0.0.1:10000" // a unix path: the grpc endpoint
+	}
+}
