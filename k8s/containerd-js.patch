+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLogWriterLines(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "c.log")
+	l, err := OpenLog(path, LogConfig{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	clock := time.Date(2026, 11, 16, 10, 0, 0, 0, time.UTC)
+	l.now = func() time.Time { clock = clock.Add(time.Second); return clock }
+	l.Write([]byte("one\ntw"))
+	l.Write([]byte("o\nthree"))
+	recs, _ := ReadLog(path)
+	if len(recs) != 2 || recs[0].Log != "one\n" || recs[1].Log != "two\n" {
+		t.Fatalf("records %+v", recs)
+	}
+	// "two" started with the first write
+	if !recs[1].Time.Equal(recs[0].Time) {
+		t.Errorf("time of a joined line: %v, want %v", recs[1].Time, recs[0].Time)
+	}
+	l.Flush()
+	recs, _ = ReadLog(path)
+	if len(recs) != 3 || recs[2].Log != "three" {
+		t.Fatalf("after flush %+v", recs)
+	}
+	l.Write([]byte(" more\n"))
+	recs, _ = ReadLog(path)
+	lines := LogLines(recs)
+	if len(lines) != 3 || lines[2].Text != "three more\n" {
+		t.Fatalf("lines %+v", lines)
+	}
+	if string(LogText(recs)) != "one\ntwo\nthree more\n" {
+		t.Errorf("text %q", LogText(recs))
+	}
+	l.Close()
+}
+
+func TestLogWriterPartialWait(t *testing.T) {
+	old := partialWait
+	partialWait = 10 * time.Millisecond
+	defer func() { partialWait = old }()
+	path := filepath.Join(t.TempDir(), "c.log")
+	l, _ := OpenLog(path, LogConfig{})
+	defer l.Close()
+	l.Write([]byte("/ # "))
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if recs, _ := ReadLog(path); len(recs) == 1 && recs[0].Log == "/ # " {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("the prompt was not written")
+}
+
+func TestLogWriterRotate(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "c.log")
+	l, _ := OpenLog(path, LogConfig{MaxSize: 1000, MaxFile: 3})
+	line := strings.Repeat("x", 99) + "\n"
+	for i := 0; i < 200; i++ {
+		l.Write([]byte(line))
+	}
+	l.Close()
+	files := LogFiles(path)
+	if len(files) != 3 || files[0] != path+".2" || files[2] != path {
+		t.Fatalf("files %v", files)
+	}
+	for _, f := range files {
+		fi, _ := os.Stat(f)
+		if fi.Size() > 1000 {
+			t.Errorf("%s has %d bytes", f, fi.Size())
+		}
+	}
+	recs, _ := ReadLog(path)
+	if len(recs) == 0 || len(recs) > 30 {
+		t.Errorf("%d records kept", len(recs))
+	}
+
+	// max-file 1 starts the file again
+	path = filepath.Join(t.TempDir(), "d.log")
+	l, _ = OpenLog(path, LogConfig{MaxSize: 1000, MaxFile: 1})
+	for i := 0; i < 50; i++ {
+		l.Write([]byte(line))
+	}
+	l.Close()
+	if files := LogFiles(path); len(files) != 1 {
+		t.Errorf("files %v", files)
+	}
+	RemoveLog(path)
+	if _, err := os.Stat(path); !os.IsNotExist(err) {
+		t.Errorf("not removed: %v", err)
+	}
+}
+
+func TestLogSubscribe(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "c.log")
+	l, _ := OpenLog(path, LogConfig{})
+	defer l.Close()
+	l.Write([]byte("a\nb"))
+	old, ch, cancel := l.Subscribe()
+	defer cancel()
+	if len(old) != 2 || old[1].Log != "b" {
+		t.Fatalf("old %+v", old)
+	}
+	l.Write([]byte("c\n"))
+	if r := <-ch; r.Log != "c\n" {
+		t.Errorf("followed %q", r.Log)
+	}
+}
+
+func TestReadLogPlainText(t *testing.T) {
+	// a log of an older version: plain console text
+	path := filepath.Join(t.TempDir(), "c.log")
+	os.WriteFile(path, []byte("hello\nworld"), 0o644)
+	recs, _ := ReadLog(path)
+	if string(LogText(recs)) != "hello\nworld" || !recs[0].Time.IsZero() {
+		t.Errorf("records %+v", recs)
+	}
+}
+
+func TestParseLogConfig(t *testing.T) {
+	for _, c := range []struct {
+		opts map[string]string
+		want LogConfig
+		err  bool
+	}{
+		{nil, DefaultLogConfig, false},
+		{map[string]string{"max-size": "10m"}, LogConfig{10 << 20, 3}, false},
+		{map[string]string{"max-size": "512k", "max-file": "5"}, LogConfig{512 << 10, 5}, false},
+		{map[string]string{"max-size": "-1"}, LogConfig{0, 3}, false},
+		{map[string]string{"max-size": "1g"}, LogConfig{1 << 30, 3}, false},
+		{map[string]string{"max-file": "0"}, LogConfig{}, true},
+		{map[string]string{"max-size": "big"}, LogConfig{}, true},
+		{map[string]string{"color": "red"}, LogConfig{}, true},
+	} {
+		got, err := ParseLogConfig(c.opts)
+		if (err != nil) != c.err || !c.err && got != c.want {
+			t.Errorf("%v: %+v, %v", c.opts, got, err)
+		}
+	}
+}
