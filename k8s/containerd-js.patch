+package dockerapi
+
+import (
+	"bytes"
+	"reflect"
+	"regexp"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestParseImageRef(t *testing.T) {
+	for _, tc := range []struct{ in, full, familiar string }{
+		{"nginx", "docker.io/library/nginx:latest", "nginx:latest"},
+		{"nginx:1.27", "docker.io/library/nginx:1.27", "nginx:1.27"},
+		{"bitnami/redis", "docker.io/bitnami/redis:latest", "bitnami/redis:latest"},
+		{"docker.io/library/alpine:3", "docker.io/library/alpine:3", "alpine:3"},
+		{"index.docker.io/library/alpine", "docker.io/library/alpine:latest", "alpine:latest"},
+		{"ghcr.io/a/b:v1", "ghcr.io/a/b:v1", "ghcr.io/a/b:v1"},
+		{"localhost:5000/x", "localhost:5000/x:latest", "localhost:5000/x:latest"},
+		{"alpine@sha256:abc", "docker.io/library/alpine@sha256:abc", "alpine@sha256:abc"},
+	} {
+		r := parseImageRef(tc.in)
+		if r.String() != tc.full || r.Familiar() != tc.familiar {
+			t.Errorf("%s: %s %s; want %s %s", tc.in, r, r.Familiar(), tc.full, tc.familiar)
+		}
+	}
+}
+
+func TestIDsAndNames(t *testing.T) {
+	seen := map[string]bool{}
+	for range 100 {
+		id := newID()
+		if !regexp.MustCompile(`^[0-9a-f]{64}$`).MatchString(id) || seen[id] {
+			t.Fatalf("id %q", id)
+		}
+		seen[id] = true
+		if n := randomName(0); !regexp.MustCompile(`^[a-z]+_[a-z]+$`).MatchString(n) || n == "boring_wozniak" {
+			t.Fatalf("name %q", n)
+		}
+		if n := randomName(1); !regexp.MustCompile(`^[a-z]+_[a-z]+[0-9]$`).MatchString(n) {
+			t.Fatalf("name with retry %q", n)
+		}
+	}
+	for _, n := range []string{"web", "my-app.1", "a_b", "/web"} {
+		if !validName.MatchString(n) {
+			t.Errorf("%q is a valid name", n)
+		}
+	}
+	for _, n := range []string{"a", "-web", "we b", "web/1", ""} {
+		if validName.MatchString(n) {
+			t.Errorf("%q is not a valid name", n)
+		}
+	}
+}
+
+func TestStateString(t *testing.T) {
+	now := time.Date(2026, 11, 13, 12, 0, 0, 0, time.UTC)
+	for _, tc := range []struct {
+		st   containerState
+		want string
+	}{
+		{containerState{}, "Created"},
+		{containerState{Running: true, StartedAt: now.Add(-2 * time.Minute)}, "Up 2 minutes"},
+		{containerState{Running: true, StartedAt: now.Add(-90 * time.Second)}, "Up About a minute"},
+		{containerState{Running: true, StartedAt: now}, "Up Less than a second"},
+		{containerState{ExitCode: 3, StartedAt: now.Add(-time.Hour), FinishedAt: now.Add(-5 * time.Second)}, "Exited (3) 5 seconds ago"},
+		{containerState{ExitCode: 0, StartedAt: now.Add(-time.Hour), FinishedAt: now.Add(-49 * time.Hour)}, "Exited (0) 2 days ago"},
+	} {
+		if got := tc.st.String(now); got != tc.want {
+			t.Errorf("%+v: %q; want %q", tc.st, got, tc.want)
+		}
+	}
+}
+
+func TestCommandAndEnv(t *testing.T) {
+	cfg := imageConfig{Entrypoint: []string{"/docker-entrypoint.sh"}, Cmd: []string{"nginx", "-g", "daemon off;"}, Env: []string{"PATH=/bin", "A=1"}}
+	if got := command(cfg, nil); !reflect.DeepEqual(got, []string{"/docker-entrypoint.sh", "nginx", "-g", "daemon off;"}) {
+		t.Errorf("command %q", got)
+	}
+	if got := command(cfg, []string{"sh"}); !reflect.DeepEqual(got, []string{"/docker-entrypoint.sh", "sh"}) {
+		t.Errorf("command with cmd %q", got)
+	}
+	if got := mergeEnv(cfg.Env, []string{"A=2", "B=3"}); !reflect.DeepEqual(got, []string{"PATH=/bin", "A=2", "B=3"}) {
+		t.Errorf("env %q", got)
+	}
+	// too big for a label: the env goes, the command stays
+	big := cfg
+	big.Env = []string{"X=" + strings.Repeat("x", 5000)}
+	if l := configLabel(big); l == "" || strings.Contains(l, "xxx") || !strings.Contains(l, "daemon off;") {
+		t.Errorf("label of a big config %q", l)
+	}
+}
+
+func TestSummaries(t *testing.T) {
+	t0 := time.Unix(1700000000, 0)
+	imgs := []Image{
+		{Name: "docker.io/library/nginx:latest", ID: "sha256:aaa", Digest: "sha256:d1", Created: t0, Size: 10},
+		{Name: "docker.io/library/nginx:1.27", ID: "sha256:aaa", Digest: "sha256:d2", Created: t0, Size: 10},
+		{Name: "docker.io/library/alpine:latest", ID: "sha256:bbb", Digest: "sha256:d3", Created: t0.Add(time.Hour), Size: 5},
+	}
+	s := summaries(imgs)
+	if len(s) != 2 || s[0].ID != "sha256:bbb" {
+		t.Fatalf("summaries %+v; want alpine first, nginx once", s)
+	}
+	if !reflect.DeepEqual(s[1].RepoTags, []string{"nginx:1.27", "nginx:latest"}) || len(s[1].RepoDigests) != 2 {
+		t.Errorf("nginx %+v", s[1])
+	}
+	if img, ok := findImage(imgs, "nginx"); !ok || img.Name != "docker.io/library/nginx:latest" {
+		t.Errorf("find nginx: %v %v", img, ok)
+	}
+	if img, ok := findImage(imgs, "bbb"[:3]+""); ok {
+		t.Errorf("a 3 character id prefix found %v", img)
+	}
+	if _, ok := findImage(imgs, "nginx:2"); ok {
+		t.Error("found nginx:2")
+	}
+}
+
+func TestSkipWriter(t *testing.T) {
+	var b bytes.Buffer
+	w := &skipWriter{w: &b, n: 5}
+	for _, s := range []string{"abc", "defg", "hij"} {
+		if n, err := w.Write([]byte(s)); n != len(s) || err != nil {
+			t.Fatalf("write %q: %d %v", s, n, err)
+		}
+	}
+	if b.String() != "fghij" {
+		t.Errorf("got %q; want fghij", b.String())
+	}
+}
