+// fakeImages is an image store with alpine and nginx; Pull adds busybox.
+type fakeImages struct {
+	mu      sync.Mutex
+	imgs    []dockerapi.Image
+	removed []string
+}
+
+func newFakeImages() *fakeImages {
+	t0 := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	img := func(name, id string, cfg string) dockerapi.Image {
+		i := dockerapi.Image{Name: name, ID: id, Digest: "sha256:d" + id[8:], Created: t0, Size: 1000, Architecture: "386", Os: "linux",
+			Layers: []string{"sha256:l" + id[8:]}}
+		json.Unmarshal([]byte(cfg), &i.Config)
+		return i
+	}
+	return &fakeImages{imgs: []dockerapi.Image{
+		img("docker.io/library/alpine:latest", "sha256:a1a1a1a1a1a1a1a1", `{"Cmd":["/bin/sh"],"Env":["PATH=/usr/bin"]}`),
+		img("docker.io/library/nginx:latest", "sha256:b2b2b2b2b2b2b2b2", `{"Entrypoint":["/docker-entrypoint.sh"],"Cmd":["nginx","-g","daemon off;"],"Env":["PATH=/usr/bin","NGINX_VERSION=1.29"],"ExposedPorts":{"80/tcp":{}}}`),
+	}}
+}
+
+func (f *fakeImages) List(ctx context.Context) ([]dockerapi.Image, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return append([]dockerapi.Image(nil), f.imgs...), nil
+}
+
+func (f *fakeImages) Pull(ctx context.Context, ref string, progress func(dockerapi.PullProgress)) (dockerapi.Image, bool, error) {
+	if ref != "docker.io/library/busybox:latest" {
+		return dockerapi.Image{}, false, fmt.Errorf("failed to resolve reference %q: not found", ref)
+	}
+	l := "sha256:0123456789abcdef0123"
+	for _, p := range []dockerapi.PullProgress{
+		{Layer: l, Status: dockerapi.PullFsLayer},
+		{Layer: l, Status: dockerapi.PullDownloading, Current: 50, Total: 100},
+		{Layer: l, Status: dockerapi.PullVerifying},
+		{Layer: l, Status: dockerapi.PullDownloaded},
+		{Layer: l, Status: dockerapi.PullComplete},
+	} {
+		progress(p)
+	}
+	img := dockerapi.Image{Name: ref, ID: "sha256:c3c3c3c3c3c3c3c3", Digest: "sha256:dbusybox", Created: time.Now(), Layers: []string{l}}
+	img.Config.Cmd = []string{"sh"} // else create says "no command specified"
+	f.mu.Lock()
+	f.imgs = append(f.imgs, img)
+	f.mu.Unlock()
+	return img, true, nil
+}
+
+func (f *fakeImages) Remove(ctx context.Context, name string) ([]string, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for i, img := range f.imgs {
+		if img.Name == name {
+			f.imgs = append(f.imgs[:i], f.imgs[i+1:]...)
+			f.removed = append(f.removed, name)
+			// the config goes with the last reference (docker tag)
+			for _, other := range f.imgs {
+				if other.ID == img.ID {
+					return []string{}, nil
+				}
+			}
+			return []string{img.ID}, nil
+		}
+	}
+	return nil, fmt.Errorf("No such image: %s", name)
+}
+
+// api sends a request and returns the status and body.
+func api(t *testing.T, method, url, body string) (int, string) {
+	t.Helper()
+	req, _ := http.NewRequest(method, url, strings.NewReader(body))
+	if body != "" {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	b, _ := io.ReadAll(resp.Body)
+	return resp.StatusCode, string(b)
+}
