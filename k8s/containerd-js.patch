+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+// Package fake is an in-memory v86.Runtime for tests. It is the js/wasm
+// equivalent of the tabernetes v86 VM (k8s/tabernetes/v86.go).
+package fake
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"sync"
+
+	"github.com/containerd/containerd/api/types/task"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/errdefs"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// Runtime creates an in-memory Handle per task.
+type Runtime struct {
+	mu      sync.Mutex
+	Created map[string]*Handle
+}
+
+func NewRuntime() *Runtime {
+	return &Runtime{Created: make(map[string]*Handle)}
+}
+
+func (r *Runtime) Create(ctx context.Context, id string, spec *specs.Spec) (v86.Handle, error) {
+	h := &Handle{
+		id:     id,
+		spec:   spec,
+		status: task.Status_CREATED,
+		exited: make(chan struct{}),
+		ignore: make(map[uint32]bool),
+	}
+	r.mu.Lock()
+	r.Created[id] = h
+	r.mu.Unlock()
+	return h, nil
+}
+
+// Get returns the handle of task id, or nil.
+func (r *Runtime) Get(id string) *Handle {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.Created[id]
+}
+
+// Handle is a fake VM. Start marks it running, ExitCode feeds the exit code.
+// Its main process ends on every signal with 128 + the signal, as a program
+// without handlers does, except for the signals it ignores (Ignore).
+type Handle struct {
+	mu      sync.Mutex
+	id      string
+	spec    *specs.Spec
+	status  task.Status
+	exited  chan struct{} // closed on exit, with code set: every Wait sees it
+	code    uint32
+	ignore  map[uint32]bool
+	signals []uint32
+}
+
+func (h *Handle) Start(ctx context.Context) error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.status != task.Status_CREATED {
+		return nil
+	}
+	h.status = task.Status_RUNNING
+	return nil
+}
+
+// ExitCode records the exit code and unblocks Wait, once.
+func (h *Handle) ExitCode(code uint32) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.status == task.Status_STOPPED {
+		return
+	}
+	h.status = task.Status_STOPPED
+	h.code = code
+	// closed, not sent: every Wait sees the exit, as in jsruntime
+	close(h.exited)
+}
+
+func (h *Handle) Wait(ctx context.Context) (uint32, error) {
+	select {
+	case <-h.exited:
+		h.mu.Lock()
+		defer h.mu.Unlock()
+		return h.code, nil
+	case <-ctx.Done():
+		return 0, ctx.Err()
+	}
+}
+
+func (h *Handle) Exec(ctx context.Context, p *specs.Process) (io.ReadWriteCloser, error) {
+	return nopRWC{}, nil
+}
+
+func (h *Handle) Resize(rows, cols uint32) error { return nil }
+
+// Ignore makes the main process live on after these signals, as one that
+// handles or ignores them. SIGKILL cannot be ignored.
+func (h *Handle) Ignore(sigs ...uint32) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	for _, s := range sigs {
+		h.ignore[s] = true
+	}
+}
+
+// Signals returns the signals that Kill got, in order.
+func (h *Handle) Signals() []uint32 {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return append([]uint32(nil), h.signals...)
+}
+
+func (h *Handle) Kill(ctx context.Context, signal uint32) error {
+	h.mu.Lock()
+	if h.status == task.Status_STOPPED {
+		h.mu.Unlock()
+		return fmt.Errorf("process already finished: %w", errdefs.ErrNotFound)
+	}
+	h.signals = append(h.signals, signal)
+	ignored := h.ignore[signal] && signal != v86.SIGKILL
+	h.mu.Unlock()
+	if !ignored {
+		h.ExitCode(128 + signal)
+	}
+	return nil
+}
+
+func (h *Handle) State(ctx context.Context) (task.Status, error) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.status, nil
+}
+
+func (h *Handle) Delete(ctx context.Context) error {
+	h.ExitCode(0)
+	return nil
+}
+
+type nopRWC struct{}
+
+func (nopRWC) Read([]byte) (int, error)    { return 0, io.EOF }
+func (nopRWC) Write(p []byte) (int, error) { return len(p), nil }
+func (nopRWC) Close() error                { return nil }
diff --git a/core/runtime/v2/v86/inprocess/shim.go b/core/runtime/v2/v86/inprocess/shim.go
new file mode 100644
index 0000000..962071b
--- /dev/null
+++ b/core/runtime/v2/v86/inprocess/shim.go
@@ -0,0 +1,107 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+// Package inprocess runs the v86 shim in the same process as containerd,
+// instead of forking a shim binary (wasm has no fork). It starts the v86 task
+// service over a ttrpc server on the in-process fake TCP network and returns a
+// ShimInstance that talks to it, exactly as the fork-based shim manager would
+// talk to a forked shim over a unix socket.
+package inprocess
+
+import (
+	"context"
+	"net"
+	"sync"
+
+	taskAPI "github.com/containerd/containerd/api/runtime/task/v2"
+	v2 "github.com/containerd/containerd/v2/core/runtime/v2"
+	v86 "github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/ttrpc"
+)
+
+// Shim is a ShimInstance backed by the v86 task service running in-process.
+type Shim struct {
+	id      string
+	ns      string
+	bundle  string
+	client  *ttrpc.Client
+	server  *ttrpc.Server
+	listen  net.Listener
+	closeMu sync.Once
+}
+
+// New starts the v86 task service in-process and returns a ShimInstance that
+// talks to it. runtime is the js/wasm v86 runtime (jsruntime.NewRuntime). The
+// task service version is 2, which matches the v2 TTRPCTaskService the shim
+// implements.
+func New(ctx context.Context, id, namespace, bundle string, runtime v86.Runtime) (v2.ShimInstance, error) {
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	srv, err := ttrpc.NewServer()
+	if err != nil {
+		l.Close()
+		return nil, err
+	}
+	// The service keeps the exit of the task in the bundle: after a restart
+	// of containerd, the shim it loads for the bundle reports the task as
+	// stopped, with its exit code.
+	taskAPI.RegisterTTRPCTaskService(srv, v86.NewBundleService(runtime, id, bundle))
+	// ctx is the request that creates the task: the shim outlives it, else
+	// every later call (Wait, Kill, Delete) gets "context canceled".
+	go func() { _ = srv.Serve(context.WithoutCancel(ctx), l) }()
+
+	conn, err := net.Dial("tcp", l.Addr().String())
+	if err != nil {
+		srv.Shutdown(ctx)
+		l.Close()
+		return nil, err
+	}
+
+	return &Shim{
+		id:     id,
+		ns:     namespace,
+		bundle: bundle,
+		client: ttrpc.NewClient(conn),
+		server: srv,
+		listen: l,
+	}, nil
+}
+
+func (s *Shim) ID() string              { return s.id }
+func (s *Shim) Namespace() string       { return s.ns }
+func (s *Shim) Bundle() string          { return s.bundle }
+func (s *Shim) Client() any             { return s.client }
+func (s *Shim) Endpoint() (string, int) { return s.listen.Addr().String(), 2 }
+
+func (s *Shim) Close() error {
+	var err error
+	s.closeMu.Do(func() {
+		if s.client != nil {
+			err = s.client.Close()
+		}
+		_ = s.listen.Close()
+		_ = s.server.Shutdown(context.Background())
+	})
+	return err
+}
+
+// Delete closes the shim. Bundle cleanup is the caller's job, as with a forked
+// shim (the shim manager removes the bundle directory).
+func (s *Shim) Delete(ctx context.Context) error {
+	return s.Close()
+}
