+*/
+
+package jsruntime
+
+import (
+	"testing"
+
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+func TestTranslate(t *testing.T) {
+	mem := int64(256 << 20)
+	spec := &specs.Spec{
+		Root: &specs.Root{Path: "/var/lib/containerd/snapshots/1/fs"},
+		Process: &specs.Process{
+			Args: []string{"/usr/sbin/nginx", "-g", "daemon off;"},
+			Env:  []string{"PATH=/usr/sbin:/usr/bin", "HOME=/root"},
+			Cwd:  "/",
+		},
+		Linux: &specs.Linux{
+			Resources: &specs.LinuxResources{
+				Memory: &specs.LinuxMemory{Limit: &mem},
+			},
+		},
+	}
+
+	req := Translate(spec)
+
+	if req.Rootfs != "/var/lib/containerd/snapshots/1/fs" {
+		t.Errorf("rootfs = %q", req.Rootfs)
+	}
+	if len(req.Command) != 3 || req.Command[0] != "/usr/sbin/nginx" {
+		t.Errorf("command = %v", req.Command)
+	}
+	if len(req.Env) != 2 || req.Env[1] != "HOME=/root" {
+		t.Errorf("env = %v", req.Env)
+	}
+	if req.WorkingDir != "/" {
+		t.Errorf("workingDir = %q", req.WorkingDir)
+	}
+	if req.Memory != 256<<20 {
+		t.Errorf("memory = %d", req.Memory)
+	}
+	if req.TTY {
+		t.Error("tty should be false")
+	}
+}
+
+func TestTranslateEmpty(t *testing.T) {
+	req := Translate(&specs.Spec{})
+	if req.Rootfs != "" || len(req.Command) != 0 || req.Memory != 0 {
+		t.Errorf("empty spec should produce an empty request: %+v", req)
+	}
+}
+
+func TestTranslateImageAnnotation(t *testing.T) {
+	spec := &specs.Spec{
+		Annotations: map[string]string{AnnotationImageName: "docker.io/library/nginx:latest"},
+		Process:     &specs.Process{Args: []string{"/docker-entrypoint.sh"}},
+	}
+	req := Translate(spec)
+	if req.Image != "docker.io/library/nginx:latest" {
+		t.Errorf("image = %q", req.Image)
+	}
+}
diff --git a/core/runtime/v2/v86/ports.go b/core/runtime/v2/v86/ports.go
new file mode 100644
index 0000000..5568b84
--- /dev/null
+++ b/core/runtime/v2/v86/ports.go
@@ -0,0 +1,387 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+// LabelPorts is the container label with the published ports of a container
+// (docker run -p), as a JSON array of PortBinding. The Docker API writes it
+// at create, with an empty HostPort where Docker picks a free one, and again
+// at start with the host ports it picked. The ports listen only while the
+// task runs, so readers (docker ps, inspect) show them only then, as Docker
+// does.
+const LabelPorts = "dev.tabernetes.v86.ports"
+
+// PortBinding is one published port. The fields are strings, like Docker's
+// PortBinding (HostIp, HostPort) plus the port and protocol of the
+// container, so the label reads like the Docker API.
+type PortBinding struct {
+	HostIp        string `json:"HostIp"`        // as given; "0.0.0.0" by default
+	HostPort      string `json:"HostPort"`      // "8080", "" or "8000-8010" before start
+	ContainerPort string `json:"ContainerPort"` // "80"
+	Protocol      string `json:"Protocol"`      // "tcp"
+}
+
+// Port is the key of the binding in the Docker API: "80/tcp".
+func (b PortBinding) Port() string { return b.ContainerPort + "/" + b.Protocol }
+
+// ParsePorts reads the published ports from the labels of a container. No
+// label means no ports.
+func ParsePorts(labels map[string]string) ([]PortBinding, error) {
+	s, ok := labels[LabelPorts]
+	if !ok || s == "" {
+		return nil, nil
+	}
+	var ports []PortBinding
+	if err := json.Unmarshal([]byte(s), &ports); err != nil {
+		return nil, fmt.Errorf("label %s: %w", LabelPorts, err)
+	}
+	return ports, nil
+}
+
+// PortsLabel is the value of LabelPorts for ports.
+func PortsLabel(ports []PortBinding) string {
+	b, _ := json.Marshal(ports)
+	return string(b)
+}
+
+// PortPublisher makes the published ports of a task reachable, as Docker's
+// port mapping does. The Docker API calls Publish before the task starts and
+// Unpublish when it stops, exits or is removed.
+type PortPublisher interface {
+	// Publish listens on the host ports of task id and returns the bindings
+	// with the host ports it picked. It publishes all or nothing.
+	// name is the container as the user knows it (--name, or a generated
+	// one), for the messages and the links of the ports.
+	Publish(id, name string, ports []PortBinding) ([]PortBinding, error)
+	// Unpublish closes the ports of task id. It is safe to call twice.
+	Unpublish(id string)
+	// Published tells whether task id has its ports open.
+	Published(id string) bool
+}
+
+// The range of host ports that Docker picks from when -p gives none: the
+// ip_local_port_range of Linux.
+const (
+	EphemeralFirst = 32768
+	EphemeralLast  = 60999
+)
+
+// Ports is a PortPublisher like docker-proxy, the userland proxy of Docker:
+// it listens on 127.0.0.1 of the in-process network of the wasm and copies
+// every connection to a new connection to the container port of the VM.
+// It always binds 127.0.0.1, never 0.0.0.0, even when -p asks for 0.0.0.0:
+// on js/wasm that is the only address the shell and the page dial.
+type Ports struct {
+	// Dial connects to port of task id, through the network card of its VM.
+	Dial func(ctx context.Context, id string, port int) (net.Conn, error)
+	// Changed is called after the ports of task id (container name) open
+	// (with the bindings) or close (with none). It must not block.
+	Changed func(id, name string, ports []PortBinding)
+
+	mu    sync.Mutex
+	open  map[string][]*listener // by task id
+	names map[string]string      // container names, by task id
+	used  map[int]string         // host port -> task id
+	next  int                    // the next host port to try in the ephemeral range
+}
+
+type listener struct {
+	net.Listener
+	port      int // the host port
+	container int // the port of the VM
+
+	mu    sync.Mutex
+	conns map[net.Conn]bool // both ends of the open connections
+}
+
+// track adds a connection to close with the listener; false if it is
+// closed already.
+func (l *listener) track(c net.Conn) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.conns == nil {
+		c.Close()
+		return false
+	}
+	l.conns[c] = true
+	return true
+}
+
+func (l *listener) untrack(c net.Conn) {
+	l.mu.Lock()
+	delete(l.conns, c)
+	l.mu.Unlock()
+	c.Close()
+}
+
+// Close stops listening and ends the open connections, as Docker does when
+// it stops the userland proxy of a container.
+func (l *listener) Close() error {
+	err := l.Listener.Close()
+	l.mu.Lock()
+	conns := l.conns
+	l.conns = nil
+	l.mu.Unlock()
+	for c := range conns {
+		c.Close()
+	}
+	return err
+}
+
+var _ PortPublisher = (*Ports)(nil)
+
+// listen is net.Listen; a test may replace it.
+var listen = net.Listen
+
+func (p *Ports) Publish(id, name string, ports []PortBinding) ([]PortBinding, error) {
+	out, err := p.publish(id, ports)
+	if err != nil {
+		return out, err
+	}
+	p.mu.Lock()
+	if p.names == nil {
+		p.names = make(map[string]string)
+	}
+	p.names[id] = name
+	p.mu.Unlock()
+	if p.Changed != nil {
+		p.Changed(id, name, slices.Clone(out))
+	}
+	return out, nil
+}
+
+func (p *Ports) publish(id string, ports []PortBinding) ([]PortBinding, error) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.open == nil {
+		p.open, p.used = map[string][]*listener{}, map[int]string{}
+	}
+	if _, ok := p.open[id]; ok {
+		return nil, fmt.Errorf("the ports of %s are published already", id)
+	}
+	var mine []*listener
+	fail := func(err error) ([]PortBinding, error) {
+		for _, l := range mine {
+			l.Close()
+			delete(p.used, l.port)
+		}
+		return nil, err
+	}
+	out := make([]PortBinding, 0, len(ports))
+	for _, b := range ports {
+		if b.HostIp == "" {
+			b.HostIp = "0.0.0.0"
+		}
+		if b.Protocol == "" {
+			b.Protocol = "tcp"
+		}
+		if b.Protocol != "tcp" {
+			return fail(fmt.Errorf("%s ports cannot be published: the network of the VM carries TCP connections only", b.Protocol))
+		}
+		cport, err := strconv.Atoi(b.ContainerPort)
+		if err != nil || cport < 1 || cport > 65535 {
+			return fail(fmt.Errorf("invalid containerPort: %s", b.ContainerPort))
+		}
+		if !localIP(b.HostIp) {
+			// what docker-proxy says for an address the host does not have
+			return fail(fmt.Errorf("Error starting userland proxy: listen tcp4 %s: bind: cannot assign requested address",
+				net.JoinHostPort(b.HostIp, b.HostPort)))
+		}
+		first, last, err := portRange(b.HostPort)
+		if err != nil {
+			return fail(err)
+		}
+		l, err := p.bind(b.HostIp, first, last, first != 0 && first == last)
+		if err != nil {
+			return fail(err)
+		}
+		l.container = cport
+		mine = append(mine, l)
+		p.used[l.port] = id
+		b.HostPort = strconv.Itoa(l.port)
+		out = append(out, b)
+	}
+	p.open[id] = mine
+	for _, l := range mine {
+		go p.serve(id, l)
+	}
+	return out, nil
+}
+
+// bind listens on a port from first to last (0, 0: the ephemeral range).
+// Docker's messages: a port another container holds is "already
+// allocated"; one that something else listens on (kubectl port-forward)
+// fails in the userland proxy.
+func (p *Ports) bind(ip string, first, last int, fixed bool) (*listener, error) {
+	try := func(port int) (*listener, error) {
+		if owner, ok := p.used[port]; ok && owner != "" {
+			return nil, fmt.Errorf("Bind for %s failed: port is already allocated", net.JoinHostPort(ip, strconv.Itoa(port)))
+		}
+		l, err := listen("tcp", net.JoinHostPort("127.0.0.1", strconv.Itoa(port)))
+		if err != nil {
+			if errors.Is(err, syscall.EADDRINUSE) {
+				err = errors.New("bind: address already in use")
+			} else if op := (*net.OpError)(nil); errors.As(err, &op) {
+				err = op.Err
+			}
+			return nil, fmt.Errorf("Error starting userland proxy: listen tcp4 %s: %v", net.JoinHostPort(ip, strconv.Itoa(port)), err)
+		}
+		return &listener{Listener: l, port: port, conns: map[net.Conn]bool{}}, nil
+	}
+	if fixed {
+		return try(first)
+	}
+	if first == 0 {
+		first, last = EphemeralFirst, EphemeralLast
+	}
+	// Like Docker's port allocator, go on after the port picked last, so a
+	// port that was just freed is not handed out again at once.
+	n := last - first + 1
+	start := 0
+	if p.next >= first && p.next <= last {
+		start = p.next - first
+	}
+	for i := range n {
+		port := first + (start+i)%n
+		if l, err := try(port); err == nil {
+			p.next = port + 1
+			return l, nil
+		}
+	}
+	if first == EphemeralFirst && last == EphemeralLast {
+		return nil, errors.New("all ports are allocated")
+	}
+	return nil, fmt.Errorf("Bind for %s failed: port is already allocated", net.JoinHostPort(ip, fmt.Sprintf("%d-%d", first, last)))
+}
+
+func (p *Ports) Unpublish(id string) {
+	p.mu.Lock()
+	mine, ok := p.open[id]
+	name := p.names[id]
+	delete(p.open, id)
+	delete(p.names, id)
+	for _, l := range mine {
+		l.Close()
+		delete(p.used, l.port)
+	}
+	p.mu.Unlock()
+	if ok && p.Changed != nil {
+		p.Changed(id, name, nil)
+	}
+}
+
+func (p *Ports) Published(id string) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	_, ok := p.open[id]
+	return ok
+}
+
+// serve accepts connections until the listener closes.
+func (p *Ports) serve(id string, l *listener) {
+	for {
+		c, err := l.Accept()
+		if err != nil {
+			return
+		}
+		go p.forward(id, l, c)
+	}
+}
+
+// dialTimeout bounds the connect to the VM; dialVM gives up after 10 s too.
+const dialTimeout = 15 * time.Second
+
+// forward copies one connection to the container port and back. If the
+// container does not listen (a fresh nginx refuses connections for a few
+// seconds), the connection closes, as with docker-proxy.
+func (p *Ports) forward(id string, l *listener, c net.Conn) {
+	if !l.track(c) {
+		return
+	}
+	defer l.untrack(c)
+	ctx, cancel := context.WithTimeout(context.Background(), dialTimeout)
+	vm, err := p.Dial(ctx, id, l.container)
+	cancel()
+	if err != nil || !l.track(vm) {
+		return
+	}
+	defer l.untrack(vm)
+	back := make(chan struct{})
+	go func() {
+		defer close(back)
+		io.Copy(c, vm)
+		closeWrite(c)
+	}()
+	io.Copy(vm, c)
+	// The client sent all it has. A VM connection that can half-close gets
+	// the end of input; one that cannot (dialVM gives a net.Pipe) stays open
+	// until the answer is complete, else a client that half-closes would
+	// lose the answer.
+	closeWrite(vm)
+	<-back
+}
+
+// closeWrite half-closes c if it can.
+func closeWrite(c net.Conn) {
+	if cw, ok := c.(interface{ CloseWrite() error }); ok {
+		cw.CloseWrite()
+	}
+}
+
+// localIP tells whether -p may bind ip: the host has only its loopback and
+// the wildcard addresses, and all of them end up on 127.0.0.1.
+func localIP(ip string) bool {
+	a := net.ParseIP(ip)
+	return a != nil && (a.IsUnspecified() || a.IsLoopback())
+}
+
+// portRange parses a host port: "" (any), "8080" or "8000-8010".
+func portRange(s string) (first, last int, err error) {
+	if s == "" {
+		return 0, 0, nil
+	}
+	a, b, isRange := strings.Cut(s, "-")
+	first, err1 := strconv.Atoi(a)
+	last, err2 := first, error(nil)
+	if isRange {
+		last, err2 = strconv.Atoi(b)
+	}
+	if err1 != nil || err2 != nil || first < 0 || last > 65535 || last < first {
+		return 0, 0, fmt.Errorf("invalid hostPort: %s", s)
+	}
+	if first == 0 && last == 0 {
+		return 0, 0, nil // -p 0:80 is any port, as in Docker
+	}
+	if first == 0 {
+		first = 1
+	}
+	return first, last, nil
+}
