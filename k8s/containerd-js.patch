+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+)
+
+// eventMessage is an event of GET /events, as dockerd sends it
+// (events.Message).
+type eventMessage struct {
+	Status   string     `json:"status,omitempty"`
+	ID       string     `json:"id,omitempty"`
+	From     string     `json:"from,omitempty"`
+	Type     string     `json:"Type"`
+	Action   string     `json:"Action"`
+	Actor    eventActor `json:"Actor"`
+	Scope    string     `json:"scope"`
+	Time     int64      `json:"time"`
+	TimeNano int64      `json:"timeNano"`
+}
+
+type eventActor struct {
+	ID         string            `json:"ID"`
+	Attributes map[string]string `json:"Attributes"`
+}
+
+// eventBus keeps the last events, for --since, and the subscribers of
+// docker events.
+type eventBus struct {
+	mu   sync.Mutex
+	last []eventMessage
+	subs map[chan eventMessage]bool
+}
+
+const keptEvents = 256
+
+func (b *eventBus) publish(m eventMessage) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.last = append(b.last, m)
+	if len(b.last) > keptEvents {
+		b.last = b.last[len(b.last)-keptEvents:]
+	}
+	for ch := range b.subs {
+		select {
+		case ch <- m:
+		default:
+		}
+	}
+}
+
+func (b *eventBus) subscribe() ([]eventMessage, chan eventMessage, func()) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.subs == nil {
+		b.subs = map[chan eventMessage]bool{}
+	}
+	ch := make(chan eventMessage, 256)
+	b.subs[ch] = true
+	old := append([]eventMessage(nil), b.last...)
+	return old, ch, func() {
+		b.mu.Lock()
+		delete(b.subs, ch)
+		b.mu.Unlock()
+	}
+}
+
+// containerEvent publishes an event of container c: create, start, kill,
+// die, stop, destroy, with the attributes dockerd gives (image, name, and
+// extra such as exitCode or signal).
+func (s *Server) containerEvent(ctx context.Context, c client.Container, action string, extra map[string]string) {
+	attrs := map[string]string{}
+	image := ""
+	if info, err := c.Info(ctx, client.WithoutRefreshedMetadata); err == nil {
+		image = info.Image
+		for k, v := range userLabels(info.Labels) {
+			attrs[k] = v
+		}
+		attrs["name"] = containerName(c.ID(), info.Labels)
+	}
+	attrs["image"] = image
+	for k, v := range extra {
+		attrs[k] = v
+	}
+	now := time.Now()
+	s.events.publish(eventMessage{
+		Status: action, ID: c.ID(), From: image, Type: "container", Action: action,
+		Actor: eventActor{ID: c.ID(), Attributes: attrs}, Scope: "local",
+		Time: now.Unix(), TimeNano: now.UnixNano(),
+	})
+}
+
+// eventsHandler is docker events: GET /events?since=&until=&filters=. The
+// events kept since `since` come first; without until it streams until the
+// client goes. Filters: container, event, type, image (as dockerd).
+func (s *Server) eventsHandler(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	var since, until time.Time
+	var err error
+	if v := q.Get("since"); v != "" {
+		if since, err = parseTimestamp(v); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+	if v := q.Get("until"); v != "" {
+		if until, err = parseTimestamp(v); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+	filters := map[string]map[string]bool{}
+	if v := q.Get("filters"); v != "" {
+		if err := json.Unmarshal([]byte(v), &filters); err != nil {
+			var list map[string][]string // the older form of the filters
+			if json.Unmarshal([]byte(v), &list) != nil {
+				http.Error(w, "invalid filter: "+err.Error(), http.StatusBadRequest)
+				return
+			}
+			for k, vs := range list {
+				filters[k] = map[string]bool{}
+				for _, x := range vs {
+					filters[k][x] = true
+				}
+			}
+		}
+	}
+	match := func(m eventMessage) bool {
+		t := time.Unix(0, m.TimeNano)
+		if !since.IsZero() && t.Before(since) || !until.IsZero() && t.After(until) {
+			return false
+		}
+		test := func(key string, vals ...string) bool {
+			f, ok := filters[key]
+			if !ok || len(f) == 0 {
+				return true
+			}
+			for _, v := range vals {
+				if f[v] {
+					return true
+				}
+			}
+			return false
+		}
+		return test("type", m.Type) && test("event", m.Action) &&
+			test("container", m.ID, m.Actor.Attributes["name"], shortLayer(m.ID)) &&
+			test("image", m.From)
+	}
+	old, ch, cancel := s.events.subscribe()
+	defer cancel()
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+	enc := json.NewEncoder(w)
+	flush := func() {
+		if f, ok := w.(http.Flusher); ok {
+			f.Flush()
+		}
+	}
+	if !since.IsZero() || !until.IsZero() {
+		for _, m := range old {
+			if match(m) {
+				enc.Encode(m)
+			}
+		}
+	}
+	flush()
+	if !until.IsZero() && !until.After(time.Now()) {
+		return
+	}
+	var end <-chan time.Time
+	if !until.IsZero() {
+		end = time.After(time.Until(until))
+	}
+	for {
+		select {
+		case m := <-ch:
+			if match(m) {
+				enc.Encode(m)
+				flush()
+			}
+		case <-end:
+			return
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// exitAttrs is the attribute of a die event.
+func exitAttrs(code int) map[string]string {
+	return map[string]string{"exitCode": strconv.Itoa(code)}
+}
diff --git a/core/runtime/v2/v86/dockerapi/filters.go b/core/runtime/v2/v86/dockerapi/filters.go
new file mode 100644
index 0000000..ba32dbe
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/filters.go
@@ -0,0 +1,218 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// The filters of the Docker API (?filters= of docker ps, docker container
+// prune and docker image prune), with the semantics of moby's
+// api/types/filters: a value matches exactly or as a regular expression,
+// "key" and "key=value" match labels, and an unknown filter is an error.
+
+import (
+	"encoding/json"
+	"errors"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// filterArgs are the filters of a request: the values of each key.
+type filterArgs map[string]map[string]bool
+
+// invalidFilter is moby's error for a filter it does not know, or a value
+// it cannot use.
+type invalidFilter struct {
+	key   string
+	value []string
+}
+
+func (e invalidFilter) Error() string {
+	msg := "invalid filter"
+	if e.key != "" {
+		msg += " '" + e.key
+		if e.value != nil {
+			msg += "=" + strings.Join(e.value, ",")
+		}
+		msg += "'"
+	}
+	return msg
+}
+
+// parseFilters reads ?filters=: {"name":{"web":true}}, as the docker CLI
+// sends it, or the older {"name":["web"]}.
+func parseFilters(s string) (filterArgs, error) {
+	f := filterArgs{}
+	if s == "" {
+		return f, nil
+	}
+	if err := json.Unmarshal([]byte(s), (*map[string]map[string]bool)(&f)); err == nil {
+		return f, nil
+	}
+	var old map[string][]string
+	if err := json.Unmarshal([]byte(s), &old); err != nil {
+		return nil, invalidFilter{}
+	}
+	for k, vs := range old {
+		f[k] = map[string]bool{}
+		for _, v := range vs {
+			f[k][v] = true
+		}
+	}
+	return f, nil
+}
+
+// validate fails on a key that is not accepted.
+func (f filterArgs) validate(accepted ...string) error {
+	for k := range f {
+		if !contains(accepted, k) {
+			return invalidFilter{key: k}
+		}
+	}
+	return nil
+}
+
+func (f filterArgs) contains(key string) bool {
+	_, ok := f[key]
+	return ok
+}
+
+// get returns the values of key, sorted.
+func (f filterArgs) get(key string) []string {
+	var out []string
+	for v := range f[key] {
+		out = append(out, v)
+	}
+	sort.Strings(out)
+	return out
+}
+
+// exactMatch: no values for key, or source is one of them.
+func (f filterArgs) exactMatch(key, source string) bool {
+	vs := f[key]
+	return len(vs) == 0 || vs[source]
+}
+
+// match: exactMatch, or a value matches source as a regular expression
+// (unanchored: name=web matches "webapp" too, as in Docker).
+func (f filterArgs) match(key, source string) bool {
+	if f.exactMatch(key, source) {
+		return true
+	}
+	for v := range f[key] {
+		if ok, err := regexp.MatchString(v, source); err == nil && ok {
+			return true
+		}
+	}
+	return false
+}
+
+// matchKVList: every value of key ("label" or "label=value") is in labels.
+func (f filterArgs) matchKVList(key string, labels map[string]string) bool {
+	vs := f[key]
+	if len(vs) == 0 {
+		return true
+	}
+	if len(labels) == 0 {
+		return false
+	}
+	for v := range vs {
+		k, want, hasValue := strings.Cut(v, "=")
+		got, ok := labels[k]
+		if !ok || hasValue && got != want {
+			return false
+		}
+	}
+	return true
+}
+
+// boolOrDefault reads a filter that is true or false (dangling, is-task).
+func (f filterArgs) boolOrDefault(key string, def bool) (bool, error) {
+	vs, ok := f[key]
+	if !ok {
+		return def, nil
+	}
+	if len(vs) == 0 {
+		return def, invalidFilter{key: key}
+	}
+	isFalse, isTrue := vs["0"] || vs["false"], vs["1"] || vs["true"]
+	if isFalse == isTrue {
+		return def, invalidFilter{key, f.get(key)}
+	}
+	return isTrue, nil
+}
+
+// matchLabels is the label and label! filter of prune (moby matchLabels).
+func (f filterArgs) matchLabels(labels map[string]string) bool {
+	if !f.matchKVList("label", labels) {
+		return false
+	}
+	return !f.contains("label!") || !f.matchKVList("label!", labels)
+}
+
+// until is the until filter of prune: a duration ("24h") before now, an
+// RFC 3339 time or a Unix timestamp. Zero without the filter.
+func (f filterArgs) until(now time.Time) (time.Time, error) {
+	vs := f.get("until")
+	if len(vs) == 0 {
+		return time.Time{}, nil
+	}
+	if len(vs) > 1 {
+		return time.Time{}, errors.New("more than one until filter specified")
+	}
+	ts, err := getTimestamp(vs[0], now)
+	if err != nil {
+		return time.Time{}, err
+	}
+	sec, nsec, err := parseTimestamps(ts, 0)
+	if err != nil {
+		return time.Time{}, err
+	}
+	return time.Unix(sec, nsec), nil
+}
+
+// portFilter reads the values of publish or expose: "80", "80/tcp" or a
+// range "8000-8080/tcp", as "port/proto" keys.
+func portFilter(f filterArgs, key string) (map[string]bool, error) {
+	out := map[string]bool{}
+	for _, v := range f.get(key) {
+		if strings.Contains(v, ":") {
+			return nil, errors.New("filter for '" + key + "' should not contain ':': " + v)
+		}
+		port, proto, ok := strings.Cut(v, "/")
+		if !ok || proto == "" {
+			proto = "tcp"
+		}
+		first, last, isRange := strings.Cut(port, "-")
+		if !isRange {
+			last = first
+		}
+		start, err1 := strconv.ParseUint(first, 10, 16)
+		end, err2 := strconv.ParseUint(last, 10, 16)
+		if err1 != nil || err2 != nil || end < start {
+			msg := "invalid start port '" + first + "'"
+			if err1 == nil {
+				msg = "invalid end port '" + last + "'"
+			}
+			return nil, errors.New("error while looking up for " + key + " " + v + ": " + msg)
+		}
+		for p := start; p <= end; p++ {
+			out[strconv.FormatUint(p, 10)+"/"+strings.ToLower(proto)] = true
+		}
+	}
+	return out, nil
+}
