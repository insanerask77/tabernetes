+// Package dockerapi is a thin Docker Engine API over containerd. It speaks the
+// REST API of the docker CLI and translates it to containerd's gRPC client, so
+// `docker run`, `docker ps` and friends work in the tab without compiling
+// dockerd. The actual container runs in the v86 shim (core/runtime/v2/v86).
+//
+// The Docker id of a container is its containerd id; names, the config of
+// the image and the state of the last run are labels (state.go). Images are
+// in the image store of the tab (images.go, Server.Images).
+package dockerapi
+
+import (
+	"context"
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/containerd/v2/pkg/oci"
+	"github.com/containerd/errdefs"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// AnnotationImageName is where the shim reads the image ref from (it matches
+// the constant in core/runtime/v2/v86/jsruntime).
+const AnnotationImageName = "io.containerd.image.name"
+
+// Server serves the Docker Engine API on top of a containerd client.
+type Server struct {
+	client  *client.Client
+	streams v86.Streamer // attach and exec; nil: not supported
+	ns      string
+
+	// Ports opens the published ports (docker run -p) while a task runs;
+	// nil: they are kept in the label but nothing listens. The glue sets it
+	// after NewServer.
+	Ports v86.PortPublisher
+	// Images is the image store of the tab: docker images, pull, rmi, and
+	// the image check of create. nil: no images, and create takes any
+	// image (the VM pulls it).
+	Images ImageStore
+	// Addresses returns the IP address and the gateway of the VM of a
+	// running container, for docker inspect. nil: none.
+	Addresses func(id string) (ip, gateway string, ok bool)
+
+	createMu sync.Mutex // a name is checked and taken at once
+
+	mu       sync.Mutex
+	resizes  map[string]map[chan v86.TerminalSize]bool // of the attaches, by container
+	execs    map[string]*execInstance
+	runs     map[string]*run // the last run of each container, see watch
+	starting map[string]bool // containers whose VM boots
+}
+
+// NewServer wraps a containerd client and the stdio of the tasks. The
+// namespace defaults to "default".
+func NewServer(c *client.Client, streams v86.Streamer) *Server {
+	return &Server{
+		client: c, streams: streams, ns: namespaces.Default,
+		resizes:  make(map[string]map[chan v86.TerminalSize]bool),
+		execs:    make(map[string]*execInstance),
+		runs:     make(map[string]*run),
+		starting: make(map[string]bool),
+	}
+}
+
+// createRequest is the subset of the Docker ContainerCreateRequest this
+// minimal API understands.
+type createRequest struct {
+	Image      string            `json:"Image"`
+	Cmd        []string          `json:"Cmd"`
+	Env        []string          `json:"Env"`
+	WorkingDir string            `json:"WorkingDir"`
+	Tty        bool              `json:"Tty"`
+	OpenStdin  bool              `json:"OpenStdin"`
+	StdinOnce  bool              `json:"StdinOnce"`
+	Labels     map[string]string `json:"Labels"`
+	// ExposedPorts says which ports the container listens on; only
+	// HostConfig.PortBindings publishes them, as in Docker.
+	ExposedPorts map[string]struct{} `json:"ExposedPorts"`
+	HostConfig   hostConfig          `json:"HostConfig"`
+	// docker run --stop-signal and --stop-timeout
+	StopSignal  string `json:"StopSignal"`
+	StopTimeout *int   `json:"StopTimeout"`
+}
+
+type createResponse struct {
+	ID       string   `json:"Id"`
+	Warnings []string `json:"Warnings"`
+}
+
+type versionResponse struct {
+	Version    string `json:"Version"`
+	APIVersion string `json:"ApiVersion"`
+}
+
+func (s *Server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	ctx := namespaces.WithNamespace(r.Context(), s.ns)
+	path := strings.Trim(r.URL.Path, "/")
+	parts := strings.Split(path, "/")
+
+	switch {
+	case r.Method == http.MethodGet && path == "version":
+		writeJSON(w, versionResponse{Version: "tabernetes", APIVersion: "1.44"})
+
+	case r.Method == http.MethodGet && path == "containers/json":
+		s.list(ctx, w, r)
+
+	case r.Method == http.MethodPost && path == "containers/create":
+		s.create(ctx, w, r)
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "start":
+		s.start(ctx, w, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "stop":
+		s.stop(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "kill":
+		s.kill(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "wait":
+		s.wait(ctx, w, parts[1])
+
+	case r.Method == http.MethodGet && len(parts) == 3 && parts[0] == "containers" && parts[2] == "json":
+		s.inspect(ctx, w, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "restart":
+		s.restart(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodGet && len(parts) == 3 && parts[0] == "containers" && parts[2] == "logs":
+		s.logs(ctx, w, parts[1])
+
+	case r.Method == http.MethodGet && path == "images/json":
+		s.images(ctx, w)
+
+	case r.Method == http.MethodPost && path == "images/create":
+		s.pull(ctx, w, r)
+
+	// image names have slashes: /images/library/nginx:latest/json
+	case r.Method == http.MethodGet && strings.HasPrefix(path, "images/") && strings.HasSuffix(path, "/json"):
+		s.imageInspect(ctx, w, strings.TrimSuffix(strings.TrimPrefix(path, "images/"), "/json"))
+
+	case r.Method == http.MethodDelete && strings.HasPrefix(path, "images/"):
+		s.removeImage(ctx, w, r, strings.TrimPrefix(path, "images/"))
+
+	case r.Method == http.MethodDelete && len(parts) == 2 && parts[0] == "containers":
+		s.remove(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "attach":
+		s.attach(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "resize":
+		s.resize(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "containers" && parts[2] == "exec":
+		s.execCreate(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "exec" && parts[2] == "start":
+		s.execStart(ctx, w, r, parts[1])
+
+	case r.Method == http.MethodPost && len(parts) == 3 && parts[0] == "exec" && parts[2] == "resize":
+		s.execResize(w, r, parts[1])
+
+	case r.Method == http.MethodGet && len(parts) == 3 && parts[0] == "exec" && parts[2] == "json":
+		s.execInspect(w, parts[1])
+
+	default:
+		http.Error(w, "not implemented", http.StatusNotImplemented)
+	}
+}
+
+// create makes a containerd container for the image: POST
+// /containers/create?name=. The id is random like Docker's, and a container
+// without a name gets one like Docker's (adjective_surname). With an image
+// store, the image must be there (the CLI pulls it on "No such image"), and
+// its config goes into a label for ps and inspect. The VM worker reads the
+// image ref from the OCI spec annotations.
+func (s *Server) create(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	var req createRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	if req.Image == "" {
+		http.Error(w, "image is required", http.StatusBadRequest)
+		return
+	}
+	if req.StopSignal != "" {
+		if _, err := v86.ParseSignal(req.StopSignal); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+
+	ports, err := portBindings(req.HostConfig.PortBindings)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	name := r.URL.Query().Get("name")
+	if name != "" && !validName.MatchString(name) {
+		http.Error(w, fmt.Sprintf("Invalid container name (%s), only [a-zA-Z0-9][a-zA-Z0-9_.-] are allowed", name), http.StatusBadRequest)
+		return
+	}
+	name = strings.TrimPrefix(name, "/")
+
+	labels := map[string]string{}
+	for k, v := range req.Labels {
+		labels[k] = v
+	}
+	image := req.Image
+	if s.Images != nil {
+		imgs, err := s.Images.List(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		img, ok := findImage(imgs, req.Image)
+		if !ok {
+			http.Error(w, "No such image: "+parseImageRef(req.Image).Familiar(), http.StatusNotFound)
+			return
+		}
+		// by image ID: the VM pulls by name
+		image = img.Name
+		labels[LabelImageID] = img.ID
+		if cfg := configLabel(img.Config); cfg != "" {
+			labels[LabelConfig] = cfg
+		}
+	}
+	if req.HostConfig.AutoRemove {
+		labels[LabelAutoRemove] = "true"
+	}
+	// docker run -p: the bindings the ports open with at start (ports.go)
+	if len(ports) > 0 {
+		labels[v86.LabelPorts] = v86.PortsLabel(ports)
+	}
+
+	s.createMu.Lock()
+	defer s.createMu.Unlock()
+	all, err := s.client.Containers(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	taken := map[string]string{} // name -> id
+	for id, n := range s.names(ctx, all) {
+		taken[n] = id
+	}
+	if name == "" {
+		for retry := 0; ; retry++ {
+			if name = randomName(retry / 10); taken[name] == "" {
+				break
+			}
+		}
+	} else if id, ok := taken[name]; ok {
+		http.Error(w, fmt.Sprintf("Conflict. The container name \"/%s\" is already in use by container \"%s\". You have to remove (or rename) that container to be able to reuse that name.", name, id), http.StatusConflict)
+		return
+	}
+	labels[LabelName] = name
+	id := newID()
+
+	spec := req
+	spec.Image = image
+	opts := []client.NewContainerOpts{
+		client.WithNewSpec(
+			oci.WithAnnotations(annotations(spec)),
+			withDockerProcess(req),
+		),
+		// for docker ps: what the user asked for; the image is not in the
+		// content store (the VM worker pulls it), only its name
+		client.WithImageName(req.Image),
+		client.WithContainerLabels(labels),
+	}
+	if _, err := s.client.NewContainer(ctx, id, opts...); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	json.NewEncoder(w).Encode(createResponse{ID: id, Warnings: []string{}})
+}
+
+// start starts a container: POST /containers/{id}/start. dockerd answers
+// 304 for a container that runs already.
+func (s *Server) start(ctx context.Context, w http.ResponseWriter, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	if err := s.startContainer(ctx, c); err == errAlreadyStarted {
+		w.WriteHeader(http.StatusNotModified)
+		return
+	} else if _, ok := errors.AsType[networkError](err); ok {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	} else if err != nil {
+		http.Error(w, "failed to create task for container: "+err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// stop is docker stop: the stop signal, up to t seconds (?t=, else the
+// StopTimeout of the container, else 10) for the exit, then SIGKILL. The
+// signal is ?signal=, else the StopSignal of the container (docker run
+// --stop-signal), else the STOPSIGNAL of the image, else SIGTERM.
+func (s *Server) stop(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	sig, timeout, err := s.stopOptions(ctx, c, r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	task, err := c.Task(ctx, nil)
+	if errdefs.IsNotFound(err) {
+		// what dockerd answers for a container that is not running
+		w.WriteHeader(http.StatusNotModified)
+		return
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if st, err := task.Status(ctx); err == nil && st.Status == client.Stopped {
+		w.WriteHeader(http.StatusNotModified)
+		return
+	}
+	if err := stopTask(ctx, task, sig, timeout); err != nil {
+		http.Error(w, fmt.Sprintf("cannot stop container: %s: %v", id, err), http.StatusInternalServerError)
+		return
+	}
+	// The container has exited: free its ports before answering, so that
+	// docker run -p of the same port right after docker stop works, and
+	// let watch record the end, so the next docker ps shows it exited.
+	s.unpublish(c.ID())
+	s.waitRun(ctx, c.ID())
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// Annotations for what docker run --stop-signal and --stop-timeout set: the
+// OCI spec has no field for them.
+const (
+	AnnotationStopSignal  = "dev.tabernetes.v86.stop-signal"
+	AnnotationStopTimeout = "dev.tabernetes.v86.stop-timeout"
+)
+
+// The signals of the VM (Linux on x86). The syscall package of js/wasm has
+// its own numbers (its SIGKILL is 3 and its SIGTERM 6), which mean nothing
+// to the VM: never use them here.
+const (
+	sigKILL = syscall.Signal(v86.SIGKILL)
+	sigTERM = syscall.Signal(v86.SIGTERM)
+)
+
+// defaultStopTimeout is the grace period of docker stop, in seconds.
+const defaultStopTimeout = 10
+
+// stopSignaler is an optional part of the Streamer: the STOPSIGNAL of the
+// image of a task, which only the VM worker knows (it reads the image).
+type stopSignaler interface {
+	StopSignal(id string) string
+}
+
+// stopOptions returns the signal and the grace period of docker stop and
+// restart; a negative timeout waits for ever, as in Docker.
+func (s *Server) stopOptions(ctx context.Context, c client.Container, r *http.Request) (syscall.Signal, time.Duration, error) {
+	q := r.URL.Query()
+	var annotations map[string]string
+	if spec, err := c.Spec(ctx); err == nil {
+		annotations = spec.Annotations
+	}
+	name := q.Get("signal")
+	if name == "" {
+		name = annotations[AnnotationStopSignal]
+	}
+	if ss, ok := s.streams.(stopSignaler); ok && name == "" {
+		name = ss.StopSignal(c.ID())
+	}
+	sig := uint32(sigTERM)
+	if name != "" {
+		n, err := v86.ParseSignal(name)
+		if err != nil {
+			return 0, 0, err
+		}
+		sig = n
+	}
+	t := defaultStopTimeout
+	if v, ok := annotations[AnnotationStopTimeout]; ok {
+		if n, err := strconv.Atoi(v); err == nil {
+			t = n
+		}
+	}
+	if v := q.Get("t"); v != "" {
+		n, err := strconv.Atoi(v)
+		if err != nil {
+			return 0, 0, fmt.Errorf("invalid value for t: %s", v)
+		}
+		t = n
+	}
+	timeout := time.Duration(t) * time.Second
+	if t < 0 {
+		timeout = -1
+	}
+	return syscall.Signal(sig), timeout, nil
+}
+
+// stopTask stops a task as dockerd does: sig, then up to timeout for the
+// exit (for ever if negative), then SIGKILL, and it waits for the exit.
+// If sig cannot be sent, it waits 2 seconds before SIGKILL, as dockerd.
+func stopTask(ctx context.Context, task client.Task, sig syscall.Signal, timeout time.Duration) error {
+	exitC, err := task.Wait(ctx)
+	if errdefs.IsNotFound(err) {
+		return nil // it exited, and watch deleted its task already
+	}
+	if err != nil {
+		return err
+	}
+	if err := task.Kill(ctx, sig); err != nil {
+		if errdefs.IsNotFound(err) {
+			// it exited a moment ago
+			select {
+			case <-exitC:
+			case <-ctx.Done():
+				return ctx.Err()
+			}
+			return nil
+		}
+		timeout = 2 * time.Second
+	}
+	if timeout < 0 {
+		select {
+		case <-exitC:
+			return nil
+		case <-ctx.Done():
+			return ctx.Err()
+		}
+	}
+	t := time.NewTimer(timeout)
+	defer t.Stop()
+	select {
+	case <-exitC:
+		return nil
+	case <-t.C:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	// dockerd: "Container failed to exit within 10s of signal 15 - using the force"
+	if err := task.Kill(ctx, sigKILL); err != nil && !errdefs.IsNotFound(err) {
+		return err
+	}
+	select {
+	case <-exitC:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// kill is docker kill: it sends ?signal= (SIGKILL by default) to the main
+// process. The container stops only if the process exits; after SIGKILL
+// kill waits for that, as dockerd does.
+func (s *Server) kill(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	sig := uint32(sigKILL)
+	if name := r.URL.Query().Get("signal"); name != "" {
+		if sig, err = v86.ParseSignal(name); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+	notRunning := func() {
+		http.Error(w, fmt.Sprintf("cannot kill container: %s: container %s is not running", id, c.ID()), http.StatusConflict)
+	}
+	task, err := c.Task(ctx, nil)
+	if errdefs.IsNotFound(err) {
+		notRunning()
+		return
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if st, err := task.Status(ctx); err == nil && st.Status == client.Stopped {
+		notRunning()
+		return
+	}
+	if err := killTask(ctx, task, syscall.Signal(sig)); errdefs.IsNotFound(err) {
+		notRunning()
+		return
+	} else if err != nil {
+		http.Error(w, fmt.Sprintf("cannot kill container: %s: %v", id, err), http.StatusInternalServerError)
+		return
+	}
+	if syscall.Signal(sig) == sigKILL {
+		// the process is gone: free its ports at once (watch would too, a
+		// moment later), so a new docker run -p can take them, and let
+		// watch record the end for the next docker ps
+		s.unpublish(c.ID())
+		s.waitRun(ctx, c.ID())
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// killTask sends sig to a task; for SIGKILL it waits for the exit too.
+func killTask(ctx context.Context, task client.Task, sig syscall.Signal) error {
+	if sig != sigKILL {
+		return task.Kill(ctx, sig)
+	}
+	exitC, err := task.Wait(ctx)
+	if err != nil {
+		return err
+	}
+	if err := task.Kill(ctx, sig); err != nil && !errdefs.IsNotFound(err) {
+		return err
+	}
+	select {
+	case <-exitC:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+// wait blocks until the container stops and returns its exit code: POST
+// /containers/{id}/wait. watch writes the end of a run; a container that
+// does not run answers at once, as in Docker (condition not-running).
+func (s *Server) wait(ctx context.Context, w http.ResponseWriter, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	if r := s.running(c.ID()); r != nil {
+		select {
+		case <-r.done:
+			// read r.code: the container may be gone already (--rm)
+			writeJSON(w, map[string]any{"StatusCode": r.code})
+			return
+		case <-ctx.Done():
+			http.Error(w, ctx.Err().Error(), http.StatusRequestTimeout)
+			return
+		}
+	}
+	labels, err := c.Labels(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	writeJSON(w, map[string]any{"StatusCode": s.state(ctx, c, labels).ExitCode})
+}
+
+// restart stops a container and starts it again: POST
+// /containers/{id}/restart?t=. The stop is that of docker stop: SIGTERM,
+// and SIGKILL after t seconds (10 by default).
+func (s *Server) restart(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	if run := s.running(c.ID()); run != nil {
+		if task, err := c.Task(ctx, nil); err == nil {
+			// the stop of docker stop: its signal (?signal=, the
+			// container's, the image's, SIGTERM) and its grace period (?t=)
+			sig, timeout, err := s.stopOptions(ctx, c, r)
+			if err != nil {
+				http.Error(w, err.Error(), http.StatusBadRequest)
+				return
+			}
+			if err := stopTask(ctx, task, sig, timeout); err != nil {
+				http.Error(w, err.Error(), http.StatusInternalServerError)
+				return
+			}
+			select {
+			case <-run.done:
+			case <-ctx.Done():
+				http.Error(w, ctx.Err().Error(), http.StatusRequestTimeout)
+				return
+			}
+		}
+	}
+	if err := s.startContainer(ctx, c); err != nil && err != errAlreadyStarted {
+		http.Error(w, "Cannot restart container "+id+": "+err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// remove is docker rm. With ?force=1 (docker rm -f) a running container
+// gets SIGKILL first, as dockerd does; without, it stays.
+func (s *Server) remove(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	force, _ := strconv.ParseBool(r.URL.Query().Get("force"))
+	// Like Docker: a stopped container loses its task first, a running one
+	// stays.
+	if task, err := c.Task(ctx, nil); err == nil {
+		st, err := task.Status(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		if st.Status != client.Stopped && st.Status != client.Created {
+			if !force {
+				http.Error(w, fmt.Sprintf("cannot remove container \"/%s\": container is running: stop the container before removing or force remove", c.ID()), http.StatusConflict)
+				return
+			}
+			if err := killTask(ctx, task, sigKILL); err != nil && !errdefs.IsNotFound(err) {
+				http.Error(w, fmt.Sprintf("could not kill container: %v", err), http.StatusInternalServerError)
+				return
+			}
+		}
+		if _, err := task.Delete(ctx); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+	}
+	if err := c.Delete(ctx, client.WithSnapshotCleanup); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	s.unpublish(c.ID())
+	os.Remove(v86.LogPath(c.ID()))
+	s.mu.Lock()
+	for id, e := range s.execs {
+		if e.ContainerID == c.ID() {
+			delete(s.execs, id)
+		}
+	}
+	s.mu.Unlock()
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// logs writes the console of a container (v86.LogPath). Without a tty, the
+// Docker API multiplexes stdout and stderr: every frame starts with 8 bytes,
+// the stream (1 = stdout) and the size. The VM has one console, so all of it
+// is stdout.
+func (s *Server) logs(ctx context.Context, w http.ResponseWriter, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	b, err := os.ReadFile(v86.LogPath(c.ID()))
+	if err != nil && !os.IsNotExist(err) {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	tty := false
+	if spec, err := c.Spec(ctx); err == nil && spec.Process != nil {
+		tty = spec.Process.Terminal
+	}
+	if tty {
+		w.Header().Set("Content-Type", "application/vnd.docker.raw-stream")
+		w.Write(b)
+		return
+	}
+	w.Header().Set("Content-Type", "application/vnd.docker.multiplexed-stream")
+	for len(b) > 0 {
+		n := min(len(b), 1<<16)
+		hdr := [8]byte{1}
+		binary.BigEndian.PutUint32(hdr[4:], uint32(n))
+		w.Write(hdr[:])
+		w.Write(b[:n])
+		b = b[n:]
+	}
+}
+
+// load finds a container by its id, its name or a unique prefix of its id,
+// like dockerd (lookup).
+func (s *Server) load(ctx context.Context, ref string) (client.Container, error) {
+	if c, err := s.client.LoadContainer(ctx, ref); err == nil || !errdefs.IsNotFound(err) {
+		return c, err
+	}
+	all, err := s.client.Containers(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return lookup(all, s.names(ctx, all), ref)
+}
+
+func writeJSON(w http.ResponseWriter, v any) {
+	w.Header().Set("Content-Type", "application/json")
+	if err := json.NewEncoder(w).Encode(v); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+	}
+}
+
+// annotations carries what the OCI spec has no field for: the image ref,
+// read by the shim, and an open stdin (docker run -i).
+func annotations(req createRequest) map[string]string {
+	a := map[string]string{AnnotationImageName: req.Image}
+	if req.OpenStdin {
+		a[v86.AnnotationStdin] = "true"
+	}
+	if req.StdinOnce {
+		a[v86.AnnotationStdinOnce] = "true"
+	}
+	if req.StopSignal != "" {
+		a[AnnotationStopSignal] = req.StopSignal
+	}
+	if req.StopTimeout != nil {
+		a[AnnotationStopTimeout] = strconv.Itoa(*req.StopTimeout)
+	}
+	return a
+}
+
+// withDockerProcess sets only what the docker request sets. The VM worker
+// fills the rest from the image config, as Docker does: Cmd replaces the CMD
+// of the image and keeps its ENTRYPOINT, Env is added to the env of the image,
+// and an empty WorkingDir is the one of the image. containerd's defaults
+// (cwd "/", a PATH) would hide the values of the image.
+func withDockerProcess(req createRequest) oci.SpecOpts {
+	return func(_ context.Context, _ oci.Client, _ *containers.Container, s *oci.Spec) error {
+		if s.Process == nil {
+			s.Process = &specs.Process{}
+		}
+		s.Process.Args = req.Cmd
+		s.Process.Env = req.Env
+		s.Process.Cwd = req.WorkingDir
+		s.Process.Terminal = req.Tty
+		return nil
+	}
+}
