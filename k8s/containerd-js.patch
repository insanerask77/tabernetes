+*/
+
+package jsruntime
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPrepareRootfs(t *testing.T) {
+	dir := t.TempDir()
+	// dir/bin/hello, dir/etc/empty-dir, dir/link -> bin/hello
+	if err := os.MkdirAll(filepath.Join(dir, "bin"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Join(dir, "etc", "empty"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "bin", "hello"), []byte("hi"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink("bin/hello", filepath.Join(dir, "link")); err != nil {
+		t.Fatal(err)
+	}
+
+	files, err := PrepareRootfs(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	byPath := make(map[string]File)
+	for _, f := range files {
+		byPath[f.Path] = f
+	}
+
+	if f := byPath["bin/hello"]; f.Mode&sIFREG == 0 || string(f.Data) != "hi" {
+		t.Errorf("bin/hello = %+v", f)
+	}
+	if f := byPath["etc"]; f.Mode&sIFDIR == 0 {
+		t.Errorf("etc = %+v", f)
+	}
+	if f := byPath["etc/empty"]; f.Mode&sIFDIR == 0 {
+		t.Errorf("etc/empty = %+v", f)
+	}
+	if f := byPath["link"]; f.Mode&sIFLNK == 0 || f.Target != "bin/hello" {
+		t.Errorf("link = %+v", f)
+	}
+
+	// The root itself must not appear.
+	if _, ok := byPath["."]; ok {
+		t.Error("the root directory must not be serialized")
+	}
+}
diff --git a/core/runtime/v2/v86/jsruntime/translate.go b/core/runtime/v2/v86/jsruntime/translate.go
new file mode 100644
index 0000000..f201d37
--- /dev/null
+++ b/core/runtime/v2/v86/jsruntime/translate.go
@@ -0,0 +1,93 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+// Package jsruntime is the js/wasm implementation of the v86.Runtime seam: it
+// drives the tabernetes VM worker (web/src/vm.js) from containerd's shim. The
+// OCI-spec to VM-request translation (Translate) is pure Go and unit-tested;
+// the syscall/js glue is in js.go.
+package jsruntime
+
+import (
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// VMRequest is what the v86 VM worker needs to boot a single task. It is the
+// bridge between containerd's OCI runtime spec and the tabernetes VM.
+//
+// A task boots either from a prepared rootfs (the containerd snapshot, the
+// normal shim path) or by pulling an image ref (the tab-node path). The worker
+// supports the latter today; booting a prepared rootfs over 9p is the missing
+// piece in web/src/vmworker.js.
+type VMRequest struct {
+	// Rootfs is the prepared rootfs path (containerd snapshot). Empty when
+	// booting by Image.
+	Rootfs string
+	// Image is a ref to pull (linux/386). Empty when booting a Rootfs.
+	Image string
+
+	// Hostname, IP and Gateway are the networking identity of the VM inside
+	// the pod network. The js/wasm glue fills them in from the tab node.
+	Hostname string
+	IP       string
+	Gateway  string
+
+	// Command is the full resolved argv (the executable and its arguments).
+	Command []string
+	Env     []string // "k=v"
+	// WorkingDir is the working directory of the process.
+	WorkingDir string
+
+	Stdin     bool
+	StdinOnce bool
+	TTY       bool
+
+	// Memory is the RAM of the VM in bytes (0 means the default).
+	Memory int64
+	// Storage is the ephemeral-storage limit of the VM in bytes (0 default).
+	Storage int64
+}
+
+// AnnotationImageName is the annotation containerd writes with the full image
+// name ("io.containerd.image.name", see core/images). The shim uses it to boot
+// a task by pulling that ref in the VM worker, instead of a prepared rootfs.
+const AnnotationImageName = "io.containerd.image.name"
+
+// Translate maps an OCI runtime spec to a VMRequest. The js/wasm glue fills in
+// the networking identity (Hostname/IP/Gateway) that only the tab node knows.
+func Translate(spec *specs.Spec) VMRequest {
+	var req VMRequest
+	if spec.Annotations != nil {
+		req.Image = spec.Annotations[AnnotationImageName]
+		req.Stdin = spec.Annotations[v86.AnnotationStdin] == "true"
+		req.StdinOnce = spec.Annotations[v86.AnnotationStdinOnce] == "true"
+	}
+	if spec.Root != nil {
+		req.Rootfs = spec.Root.Path
+	}
+	req.Hostname = spec.Hostname
+	if spec.Process != nil {
+		req.Command = append([]string(nil), spec.Process.Args...)
+		req.Env = append([]string(nil), spec.Process.Env...)
+		req.WorkingDir = spec.Process.Cwd
+		req.TTY = spec.Process.Terminal
+	}
+	if spec.Linux != nil && spec.Linux.Resources != nil &&
+		spec.Linux.Resources.Memory != nil && spec.Linux.Resources.Memory.Limit != nil {
+		req.Memory = *spec.Linux.Resources.Memory.Limit
+	}
+	return req
+}
diff --git a/core/runtime/v2/v86/jsruntime/translate_test.go b/core/runtime/v2/v86/jsruntime/translate_test.go
