+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package jsruntime
+
+import (
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	specs "github.com/opencontainers/runtime-spec/specs-go"
+)
+
+func TestTranslate(t *testing.T) {
+	mem := int64(256 << 20)
+	spec := &specs.Spec{
+		Root: &specs.Root{Path: "/var/lib/containerd/snapshots/1/fs"},
+		Process: &specs.Process{
+			Args: []string{"/usr/sbin/nginx", "-g", "daemon off;"},
+			Env:  []string{"PATH=/usr/sbin:/usr/bin", "HOME=/root"},
+			Cwd:  "/",
+		},
+		Linux: &specs.Linux{
+			Resources: &specs.LinuxResources{
+				Memory: &specs.LinuxMemory{Limit: &mem},
+			},
+		},
+	}
+
+	req := Translate(spec)
+
+	if req.Rootfs != "/var/lib/containerd/snapshots/1/fs" {
+		t.Errorf("rootfs = %q", req.Rootfs)
+	}
+	if len(req.Command) != 3 || req.Command[0] != "/usr/sbin/nginx" {
+		t.Errorf("command = %v", req.Command)
+	}
+	if len(req.Env) != 2 || req.Env[1] != "HOME=/root" {
+		t.Errorf("env = %v", req.Env)
+	}
+	if req.WorkingDir != "/" {
+		t.Errorf("workingDir = %q", req.WorkingDir)
+	}
+	if req.Memory != 256<<20 {
+		t.Errorf("memory = %d", req.Memory)
+	}
+	if req.TTY {
+		t.Error("tty should be false")
+	}
+}
+
+func TestTranslateEmpty(t *testing.T) {
+	req := Translate(&specs.Spec{})
+	if req.Rootfs != "" || len(req.Command) != 0 || req.Memory != 0 {
+		t.Errorf("empty spec should produce an empty request: %+v", req)
+	}
+}
+
+func TestTranslateImageAnnotation(t *testing.T) {
+	spec := &specs.Spec{
+		Annotations: map[string]string{AnnotationImageName: "docker.io/library/nginx:latest"},
+		Process:     &specs.Process{Args: []string{"/docker-entrypoint.sh"}},
+	}
+	req := Translate(spec)
+	if req.Image != "docker.io/library/nginx:latest" {
+		t.Errorf("image = %q", req.Image)
+	}
+}
+
+// TestTranslateDockerOptions covers what docker run -u, -h, -w, -m and
+// --entrypoint put into the spec.
+func TestTranslateDockerOptions(t *testing.T) {
+	mem := int64(512 << 20)
+	spec := &specs.Spec{
+		Hostname: "web",
+		Annotations: map[string]string{
+			"dev.tabernetes.v86.user":       "nobody",
+			"dev.tabernetes.v86.entrypoint": `["sh","-c"]`,
+		},
+		Process: &specs.Process{Args: []string{"echo hi"}, Cwd: "/tmp"},
+		Linux:   &specs.Linux{Resources: &specs.LinuxResources{Memory: &specs.LinuxMemory{Limit: &mem}}},
+	}
+	req := Translate(spec)
+	if req.User != "nobody" || req.Hostname != "web" || req.WorkingDir != "/tmp" || req.Memory != 512<<20 {
+		t.Errorf("request: %+v", req)
+	}
+	if len(req.Entrypoint) != 2 || req.Entrypoint[1] != "-c" {
+		t.Errorf("entrypoint = %q", req.Entrypoint)
+	}
+	// --entrypoint "": an empty entrypoint, not the one of the image
+	spec.Annotations["dev.tabernetes.v86.entrypoint"] = `[]`
+	if req := Translate(spec); req.Entrypoint == nil || len(req.Entrypoint) != 0 {
+		t.Errorf("empty entrypoint = %#v", req.Entrypoint)
+	}
+	// no annotation: the entrypoint of the image
+	delete(spec.Annotations, "dev.tabernetes.v86.entrypoint")
+	if req := Translate(spec); req.Entrypoint != nil {
+		t.Errorf("no entrypoint = %#v", req.Entrypoint)
+	}
+}
+
+func TestTranslateMounts(t *testing.T) {
+	spec := &specs.Spec{Annotations: map[string]string{
+		v86.AnnotationMounts: v86.MountsLabel([]v86.Mount{{Type: "volume", Name: "data", Destination: "/d", RW: true}}),
+	}}
+	req := Translate(spec)
+	if len(req.Mounts) != 1 || req.Mounts[0].Name != "data" || req.Mounts[0].Destination != "/d" || !req.Mounts[0].RW {
+		t.Errorf("mounts = %+v", req.Mounts)
+	}
+}
diff --git a/core/runtime/v2/v86/logfile.go b/core/runtime/v2/v86/logfile.go
new file mode 100644
index 0000000..b6dd9fc
--- /dev/null
+++ b/core/runtime/v2/v86/logfile.go
@@ -0,0 +1,415 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// The console log of a container is written like the json-file log driver
+// of Docker: one JSON object per line, with the text, the stream and the
+// time. docker logs needs the time for --since, --until and -t. The VM has
+// one console for stdout and stderr, so the stream is always "stdout".
+//
+// The log lives in the in-memory file system of the page and is saved with
+// it, so it is rotated like json-file with max-size and max-file: the
+// current file is LogPath, the older ones LogPath.1, LogPath.2, and so on.
+// Docker's json-file does not rotate by default; here the default is
+// DefaultLogConfig, because every byte costs memory and IndexedDB.
+
+// LogRecord is one entry of the log, as json-file writes it. A record
+// whose text does not end with a newline is a part of a line: the rest of
+// the line follows in the next records.
+type LogRecord struct {
+	Log    string    `json:"log"`
+	Stream string    `json:"stream"`
+	Time   time.Time `json:"time"`
+}
+
+// LogConfig is the rotation of a log: MaxSize bytes per file (0: no limit)
+// and MaxFile files in all, the current one included.
+type LogConfig struct {
+	MaxSize int64
+	MaxFile int
+}
+
+// DefaultLogConfig keeps at most 3 files of 1 MiB per container, as
+// `--log-opt max-size=1m --log-opt max-file=3`.
+var DefaultLogConfig = LogConfig{MaxSize: 1 << 20, MaxFile: 3}
+
+// Annotations for docker run --log-opt max-size and max-file: the OCI spec
+// has no field for them, and the runtime writes the log.
+const (
+	AnnotationLogMaxSize = "dev.tabernetes.v86.log-max-size"
+	AnnotationLogMaxFile = "dev.tabernetes.v86.log-max-file"
+)
+
+// ParseLogConfig reads max-size and max-file of --log-opt, as the json-file
+// driver of dockerd does, on top of DefaultLogConfig. max-size is a size
+// with an optional unit (k, m, g: 1024-based), -1 for no limit.
+func ParseLogConfig(opts map[string]string) (LogConfig, error) {
+	c := DefaultLogConfig
+	if v, ok := opts["max-size"]; ok {
+		if v == "-1" {
+			c.MaxSize = 0
+		} else {
+			n, err := ramInBytes(v)
+			if err != nil {
+				return c, err
+			}
+			if n <= 0 {
+				return c, fmt.Errorf("max-size must be a positive number")
+			}
+			c.MaxSize = n
+		}
+	}
+	if v, ok := opts["max-file"]; ok {
+		n, err := strconv.Atoi(v)
+		if err != nil {
+			return c, err
+		}
+		if n < 1 {
+			return c, fmt.Errorf("max-file cannot be less than 1")
+		}
+		c.MaxFile = n
+	}
+	for k := range opts {
+		switch k {
+		case "max-size", "max-file", "compress", "labels", "labels-regex", "env", "env-regex", "tag", "mode", "max-buffer-size":
+		default:
+			return c, fmt.Errorf("unknown log opt '%s' for json-file log driver", k)
+		}
+	}
+	return c, nil
+}
+
+// ramInBytes parses a size like go-units RAMInBytes: "10m" is 10 MiB.
+func ramInBytes(s string) (int64, error) {
+	t := strings.ToLower(strings.TrimSpace(s))
+	mult := int64(1)
+	t = strings.TrimSuffix(strings.TrimSuffix(t, "b"), "i")
+	if t != "" {
+		switch t[len(t)-1] {
+		case 'k':
+			mult = 1 << 10
+		case 'm':
+			mult = 1 << 20
+		case 'g':
+			mult = 1 << 30
+		case 't':
+			mult = 1 << 40
+		}
+		if mult > 1 {
+			t = t[:len(t)-1]
+		}
+	}
+	f, err := strconv.ParseFloat(t, 64)
+	if err != nil || f < 0 {
+		return -1, fmt.Errorf("invalid size: '%s'", s)
+	}
+	return int64(f * float64(mult)), nil
+}
+
+// LogConfigOf returns the log rotation of a container from the annotations
+// of its spec.
+func LogConfigOf(annotations map[string]string) LogConfig {
+	opts := map[string]string{}
+	if v, ok := annotations[AnnotationLogMaxSize]; ok {
+		opts["max-size"] = v
+	}
+	if v, ok := annotations[AnnotationLogMaxFile]; ok {
+		opts["max-file"] = v
+	}
+	c, err := ParseLogConfig(opts)
+	if err != nil {
+		return DefaultLogConfig
+	}
+	return c
+}
+
+// maxPartial is the longest part of a line that waits for its end, like
+// the 16 KiB buffer of containerd's log copier.
+const maxPartial = 16 << 10
+
+// partialWait is how long a part of a line waits for the rest before it is
+// written as it is: a shell prompt has no newline, but docker logs should
+// show it.
+var partialWait = 200 * time.Millisecond
+
+// LogWriter writes the console of a task to its log, line by line, and
+// rotates the files. Followers get every record that is written.
+type LogWriter struct {
+	path string
+	cfg  LogConfig
+	now  func() time.Time
+
+	mu      sync.Mutex
+	f       *os.File
+	size    int64
+	partial []byte    // a line without its end yet
+	ptime   time.Time // when its first byte came
+	timer   *time.Timer
+	closed  bool
+	subs    map[*int]chan LogRecord
+}
+
+// OpenLog opens the log at path for appending.
+func OpenLog(path string, cfg LogConfig) (*LogWriter, error) {
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0o644)
+	if err != nil {
+		return nil, err
+	}
+	var size int64
+	if fi, err := f.Stat(); err == nil {
+		size = fi.Size()
+	}
+	return &LogWriter{path: path, cfg: cfg, now: time.Now, f: f, size: size, subs: map[*int]chan LogRecord{}}, nil
+}
+
+// Write takes console output. Whole lines are written at once; the rest
+// waits for its newline, at most partialWait or maxPartial bytes.
+func (l *LogWriter) Write(p []byte) (int, error) {
+	n := len(p)
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.closed {
+		return n, nil
+	}
+	now := l.now()
+	for len(p) > 0 {
+		i := bytes.IndexByte(p, '\n')
+		if i < 0 {
+			if len(l.partial) == 0 {
+				l.ptime = now
+			}
+			l.partial = append(l.partial, p...)
+			if len(l.partial) >= maxPartial {
+				l.flushLocked()
+			} else if l.timer == nil {
+				l.timer = time.AfterFunc(partialWait, l.Flush)
+			}
+			break
+		}
+		t := now
+		if len(l.partial) > 0 {
+			t = l.ptime
+		}
+		line := append(l.partial, p[:i+1]...)
+		l.partial = nil
+		l.write(LogRecord{Log: string(line), Stream: "stdout", Time: t})
+		p = p[i+1:]
+	}
+	if len(l.partial) == 0 && l.timer != nil {
+		l.timer.Stop()
+		l.timer = nil
+	}
+	return n, nil
+}
+
+// Flush writes the part of a line that waits for its end.
+func (l *LogWriter) Flush() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.flushLocked()
+}
+
+func (l *LogWriter) flushLocked() {
+	if l.timer != nil {
+		l.timer.Stop()
+		l.timer = nil
+	}
+	if len(l.partial) == 0 || l.closed {
+		return
+	}
+	l.write(LogRecord{Log: string(l.partial), Stream: "stdout", Time: l.ptime})
+	l.partial = nil
+}
+
+func (l *LogWriter) write(r LogRecord) {
+	b, err := json.Marshal(r)
+	if err != nil {
+		return
+	}
+	b = append(b, '\n')
+	if l.cfg.MaxSize > 0 && l.size > 0 && l.size+int64(len(b)) > l.cfg.MaxSize {
+		l.rotate()
+	}
+	if l.f != nil {
+		if n, err := l.f.Write(b); err == nil {
+			l.size += int64(n)
+		}
+	}
+	for _, ch := range l.subs {
+		select {
+		case ch <- r:
+		default: // a follower that does not read loses records
+		}
+	}
+}
+
+// rotate moves the current file to .1, .1 to .2 and so on, as json-file
+// does, and drops the oldest. With max-file 1 the file starts again empty.
+func (l *LogWriter) rotate() {
+	if l.f != nil {
+		l.f.Close()
+		l.f = nil
+	}
+	if l.cfg.MaxFile <= 1 {
+		os.Remove(l.path)
+	} else {
+		os.Remove(fmt.Sprintf("%s.%d", l.path, l.cfg.MaxFile-1))
+		for i := l.cfg.MaxFile - 2; i >= 1; i-- {
+			os.Rename(fmt.Sprintf("%s.%d", l.path, i), fmt.Sprintf("%s.%d", l.path, i+1))
+		}
+		os.Rename(l.path, l.path+".1")
+	}
+	f, err := os.OpenFile(l.path, os.O_WRONLY|os.O_CREATE|os.O_TRUNC, 0o644)
+	if err == nil {
+		l.f = f
+	}
+	l.size = 0
+}
+
+// Subscribe returns the records of the log so far and a channel with the
+// records that follow, read and added at once, so that none is lost or
+// sent twice. cancel ends the subscription.
+func (l *LogWriter) Subscribe() (old []LogRecord, ch <-chan LogRecord, cancel func()) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.flushLocked()
+	old, _ = ReadLog(l.path)
+	c := make(chan LogRecord, 16384)
+	key := new(int)
+	l.subs[key] = c
+	return old, c, func() {
+		l.mu.Lock()
+		delete(l.subs, key)
+		l.mu.Unlock()
+	}
+}
+
+// Close writes what waits and closes the file. Later writes are dropped.
+func (l *LogWriter) Close() error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.flushLocked()
+	l.closed = true
+	if l.f == nil {
+		return nil
+	}
+	err := l.f.Close()
+	l.f = nil
+	return err
+}
+
+// LogFiles lists the files of the log at path, the oldest first.
+func LogFiles(path string) []string {
+	var out []string
+	for i := 1; ; i++ {
+		p := fmt.Sprintf("%s.%d", path, i)
+		if _, err := os.Stat(p); err != nil {
+			break
+		}
+		out = append([]string{p}, out...)
+	}
+	return append(out, path)
+}
+
+// RemoveLog deletes the log at path with its rotated files.
+func RemoveLog(path string) {
+	for _, p := range LogFiles(path) {
+		os.Remove(p)
+	}
+}
+
+// ReadLog reads all records of the log at path, the oldest first. A line
+// that is no JSON is text of an older log, written before the records: it
+// has no time.
+func ReadLog(path string) ([]LogRecord, error) {
+	var out []LogRecord
+	for _, p := range LogFiles(path) {
+		f, err := os.Open(p)
+		if os.IsNotExist(err) {
+			continue
+		}
+		if err != nil {
+			return out, err
+		}
+		out = append(out, parseLog(f)...)
+		f.Close()
+	}
+	return out, nil
+}
+
+func parseLog(f *os.File) []LogRecord {
+	var out []LogRecord
+	br := bufio.NewReaderSize(f, 64<<10)
+	for {
+		line, err := br.ReadBytes('\n')
+		if len(line) > 0 {
+			var r LogRecord
+			if line[0] == '{' && json.Unmarshal(line, &r) == nil && r.Stream != "" {
+				out = append(out, r)
+			} else {
+				out = append(out, LogRecord{Log: string(line), Stream: "stdout"})
+			}
+		}
+		if err != nil {
+			return out
+		}
+	}
+}
+
+// LogText is the text of records.
+func LogText(rs []LogRecord) []byte {
+	var b bytes.Buffer
+	for _, r := range rs {
+		b.WriteString(r.Log)
+	}
+	return b.Bytes()
+}
+
+// LogLine is a line of the log: the text of its records, at the time of
+// the first.
+type LogLine struct {
+	Text string
+	Time time.Time
+}
+
+// LogLines joins the parts of lines, for docker logs: --tail counts lines,
+// and -t shows the time once per line.
+func LogLines(rs []LogRecord) []LogLine {
+	var out []LogLine
+	open := false
+	for _, r := range rs {
+		if open {
+			out[len(out)-1].Text += r.Log
+		} else {
+			out = append(out, LogLine{Text: r.Log, Time: r.Time})
+		}
+		open = !strings.HasSuffix(r.Log, "\n")
+	}
+	return out
+}
