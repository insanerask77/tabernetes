+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/dockerapi"
+)
+
+// fakeVolumeData records the volumes whose files were deleted.
+type fakeVolumeData struct {
+	mu      sync.Mutex
+	removed []string
+}
+
+func (f *fakeVolumeData) Remove(ctx context.Context, name string) (int64, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.removed = append(f.removed, name)
+	return 1000, nil
+}
+
+type mountPoint struct {
+	Type, Name, Source, Destination, Driver, Mode, Propagation string
+	RW                                                         bool
+}
+
+// TestDockerVolumes runs the volume commands and the mounts of a container
+// through the API, with the texts of dockerd.
+func TestDockerVolumes(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	imgs := newFakeImages()
+	imgs.imgs[1].Config.Volumes = map[string]struct{}{"/var/cache/nginx": {}}
+	server.Images = imgs
+	data := &fakeVolumeData{}
+	server.Volumes = data
+	server.VolumesRoot = t.TempDir()
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+
+	st, body := api(t, http.MethodPost, u+"/volumes/create", `{"Name":"data","Driver":"local","DriverOpts":{},"Labels":{}}`)
+	var vol struct {
+		CreatedAt, Driver, Mountpoint, Name, Scope string
+		Labels, Options                            map[string]string
+	}
+	json.Unmarshal([]byte(body), &vol)
+	if st != 201 || vol.Name != "data" || vol.Driver != "local" || vol.Mountpoint != "/var/lib/docker/volumes/data/_data" || vol.Scope != "local" || vol.Labels == nil || vol.CreatedAt == "" {
+		t.Errorf("create: %d %s", st, body)
+	}
+	// again: the same volume
+	if st, _ := api(t, http.MethodPost, u+"/volumes/create", `{"Name":"data"}`); st != 201 {
+		t.Errorf("create again: %d", st)
+	}
+	for name, want := range map[string]string{
+		"a":   "create a: volume name is too short, names should be at least two alphanumeric characters",
+		"a/b": `create a/b: "a/b" includes invalid characters for a local volume name, only "[a-zA-Z0-9][a-zA-Z0-9_.-]" are allowed. If you intended to pass a host directory, use absolute path`,
+	} {
+		if st, body := api(t, http.MethodPost, u+"/volumes/create", `{"Name":"`+name+`"}`); st != 400 || strings.TrimSpace(body) != want {
+			t.Errorf("create %s: %d %q", name, st, body)
+		}
+	}
+	if st, body := api(t, http.MethodGet, u+"/volumes/nope", ""); st != 404 || strings.TrimSpace(body) != "get nope: no such volume" {
+		t.Errorf("inspect nope: %d %q", st, body)
+	}
+	if st, body := api(t, http.MethodDelete, u+"/volumes/nope", ""); st != 404 || strings.TrimSpace(body) != "get nope: no such volume" {
+		t.Errorf("rm nope: %d %q", st, body)
+	}
+	if st, _ := api(t, http.MethodDelete, u+"/volumes/nope?force=1", ""); st != 204 {
+		t.Errorf("rm -f nope: %d", st)
+	}
+
+	// a container with a named volume, a bind mount, -v /path and the
+	// VOLUME of the image
+	site := filepath.Join(t.TempDir(), "site")
+	st, body = api(t, http.MethodPost, u+"/containers/create?name=vols", `{"Image":"nginx","Volumes":{"/anon":{}},"HostConfig":{"Binds":["data:/d","`+site+`:/usr/share/nginx/html:ro"]}}`)
+	var created struct{ Id string }
+	json.Unmarshal([]byte(body), &created)
+	if st != 201 {
+		t.Fatalf("create with mounts: %d %s", st, body)
+	}
+	if fi, err := os.Stat(site); err != nil || !fi.IsDir() {
+		t.Errorf("-v makes the source of a bind mount: %v", err)
+	}
+	_, body = api(t, http.MethodGet, u+"/containers/vols/json", "")
+	var ins struct {
+		Mounts []mountPoint
+		Config struct{ Volumes map[string]struct{} }
+	}
+	json.Unmarshal([]byte(body), &ins)
+	byDst := map[string]mountPoint{}
+	for _, m := range ins.Mounts {
+		byDst[m.Destination] = m
+	}
+	hex := regexp.MustCompile(`^[0-9a-f]{64}$`)
+	if m := byDst["/d"]; m != (mountPoint{Type: "volume", Name: "data", Source: "/var/lib/docker/volumes/data/_data", Destination: "/d", Driver: "local", Mode: "z", RW: true}) {
+		t.Errorf("volume mount: %+v", m)
+	}
+	if m := byDst["/usr/share/nginx/html"]; m != (mountPoint{Type: "bind", Source: site, Destination: "/usr/share/nginx/html", Mode: "ro", Propagation: "rprivate"}) {
+		t.Errorf("bind mount: %+v", m)
+	}
+	for _, dst := range []string{"/anon", "/var/cache/nginx"} {
+		if m := byDst[dst]; m.Type != "volume" || !hex.MatchString(m.Name) || m.Mode != "" || !m.RW || m.Driver != "local" {
+			t.Errorf("anonymous volume at %s: %+v", dst, m)
+		}
+	}
+	if len(ins.Mounts) != 4 || ins.Config.Volumes == nil {
+		t.Errorf("inspect: %s", body)
+	}
+	if c := ps(t, u, true)["/vols"]; c.Id != created.Id {
+		t.Errorf("ps: %+v", c)
+	}
+	_, body = api(t, http.MethodGet, u+"/containers/json?all=1", "")
+	if !strings.Contains(body, `"Destination":"/d"`) {
+		t.Errorf("ps has no Mounts: %s", body)
+	}
+	anon := byDst["/anon"].Name
+	_, body = api(t, http.MethodGet, u+"/volumes/"+anon, "")
+	if !strings.Contains(body, `"Labels":{"com.docker.volume.anonymous":""}`) {
+		t.Errorf("anonymous volume: %s", body)
+	}
+
+	// a file as the source of -v stays a file
+	conf := filepath.Join(t.TempDir(), "app.conf")
+	os.WriteFile(conf, []byte("x"), 0o644)
+	if st, body := api(t, http.MethodPost, u+"/containers/create?name=filebind", `{"Image":"alpine","HostConfig":{"Binds":["`+conf+`:/etc/app.conf:ro"]}}`); st != 201 {
+		t.Errorf("-v of a file: %d %s", st, body)
+	}
+	api(t, http.MethodDelete, u+"/containers/filebind", "")
+
+	// in use, also by a container that does not run
+	if st, body := api(t, http.MethodDelete, u+"/volumes/data", ""); st != 409 || strings.TrimSpace(body) != "remove data: volume is in use - ["+created.Id+"]" {
+		t.Errorf("rm in use: %d %q", st, body)
+	}
+	_, body = api(t, http.MethodGet, u+`/volumes?filters={"dangling":{"true":true}}`, "")
+	if strings.Contains(body, `"Name":"data"`) {
+		t.Errorf("dangling lists a used volume: %s", body)
+	}
+
+	// mistakes
+	for spec, want := range map[string]string{
+		`"HostConfig":{"Binds":["data:/x","/tmp:/x"]}`:                              "Duplicate mount point: /x",
+		`"HostConfig":{"Binds":["data:x"]}`:                                         "invalid volume specification: 'data:x': invalid mount config for type \"volume\": invalid mount path: 'x' mount path must be absolute",
+		`"HostConfig":{"Binds":["a:b:c:d"]}`:                                        "invalid volume specification: 'a:b:c:d'",
+		`"HostConfig":{"Binds":["data:/x:bad"]}`:                                    "invalid mode: bad",
+		`"HostConfig":{"Mounts":[{"Type":"bind","Source":"/nope","Target":"/x"}]}`:  `invalid mount config for type "bind": bind source path does not exist: /nope`,
+		`"HostConfig":{"Mounts":[{"Type":"volume","Target":"/x","ReadOnly":true}]}`: `invalid mount config for type "volume": must not set ReadOnly mode when using anonymous volumes`,
+		`"HostConfig":{"Mounts":[{"Type":"volume","Source":"data","Target":"/"}]}`:  `invalid mount config for type "volume": invalid specification: destination can't be '/'`,
+	} {
+		if st, body := api(t, http.MethodPost, u+"/containers/create", `{"Image":"alpine",`+spec+`}`); st != 400 || strings.TrimSpace(body) != want {
+			t.Errorf("%s: %d %q, want %q", spec, st, body, want)
+		}
+	}
+
+	// --mount: a volume with labels, nocopy, and a tmpfs
+	st, body = api(t, http.MethodPost, u+"/containers/create?name=mnt", `{"Image":"alpine","HostConfig":{"Mounts":[{"Type":"volume","Source":"cache","Target":"/c","VolumeOptions":{"NoCopy":true,"Labels":{"a":"b"}}},{"Type":"tmpfs","Target":"/t"}]}}`)
+	if st != 201 {
+		t.Fatalf("create with --mount: %d %s", st, body)
+	}
+	_, body = api(t, http.MethodGet, u+"/volumes/cache", "")
+	if !strings.Contains(body, `"Labels":{"a":"b"}`) {
+		t.Errorf("volume of --mount: %s", body)
+	}
+	c, err := d.Client.LoadContainer(ctx, ps(t, u, true)["/mnt"].Id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	spec, _ := c.Spec(ctx)
+	ms := v86.MountsOf(spec.Annotations)
+	if len(ms) != 2 || !ms[0].NoCopy || ms[0].Mode != "z" || ms[1].Type != "tmpfs" {
+		t.Errorf("mounts of --mount: %+v", ms)
+	}
+
+	// docker rm -v: the anonymous volumes go, the named one stays
+	if st, body := api(t, http.MethodDelete, u+"/containers/vols?v=1", ""); st != 204 {
+		t.Fatalf("rm -v: %d %s", st, body)
+	}
+	if st, _ := api(t, http.MethodGet, u+"/volumes/"+anon, ""); st != 404 {
+		t.Errorf("rm -v kept the anonymous volume: %d", st)
+	}
+	if st, _ := api(t, http.MethodGet, u+"/volumes/data", ""); st != 200 {
+		t.Errorf("rm -v removed the named volume: %d", st)
+	}
+	data.mu.Lock()
+	if len(data.removed) != 2 {
+		t.Errorf("files removed: %v", data.removed)
+	}
+	data.mu.Unlock()
+
+	// prune: anonymous only, then all of them with the filter all
+	api(t, http.MethodPost, u+"/volumes/create", `{}`)
+	_, body = api(t, http.MethodPost, u+"/volumes/prune", "")
+	var report struct {
+		VolumesDeleted []string
+		SpaceReclaimed int64
+	}
+	json.Unmarshal([]byte(body), &report)
+	if len(report.VolumesDeleted) != 1 || !hex.MatchString(report.VolumesDeleted[0]) || report.SpaceReclaimed != 1000 {
+		t.Errorf("prune: %s", body)
+	}
+	_, body = api(t, http.MethodPost, u+`/volumes/prune?filters={"all":{"true":true}}`, "")
+	json.Unmarshal([]byte(body), &report)
+	if strings.Join(report.VolumesDeleted, ",") != "data" {
+		t.Errorf("prune all: %s", body)
+	}
+	if st, body := api(t, http.MethodDelete, u+"/containers/mnt", ""); st != 204 {
+		t.Errorf("rm mnt: %d %s", st, body)
+	}
+	if st, _ := api(t, http.MethodDelete, u+"/volumes/cache", ""); st != 204 {
+		t.Errorf("rm cache: %d", st)
+	}
+	_, body = api(t, http.MethodGet, u+"/volumes", "")
+	if body != "{\"Volumes\":[],\"Warnings\":null}\n" {
+		t.Errorf("ls at the end: %q", body)
+	}
+}
