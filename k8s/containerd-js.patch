+)
+
+// js/wasm has no unix sockets: the client dials the in-process fake TCP
+// network (defaults.MapAddress), the same mapping the daemon uses.
+
+func DialAddress(address string) string {
+	return "passthrough:///" + defaults.MapAddress(address)
+}
+
+func isNoent(err error) bool {
+	return errors.Is(err, syscall.ENOENT)
+}
+
+func dialer(address string, timeout time.Duration) (net.Conn, error) {
+	address = strings.TrimPrefix(address, "passthrough:///")
+	address = strings.TrimPrefix(address, "unix://")
+	return net.DialTimeout("tcp", defaults.MapAddress(address), timeout)
+}
