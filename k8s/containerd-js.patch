+
+package v86_test
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// echoVMs is a fake network of VMs: every dial gets a server that answers
+// "<id>:<port> <line>" to each line.
+type echoVMs struct {
+	mu      sync.Mutex
+	refuse  bool
+	changes []string
+}
+
+func (e *echoVMs) dial(_ context.Context, id string, port int) (net.Conn, error) {
+	e.mu.Lock()
+	refuse := e.refuse
+	e.mu.Unlock()
+	if refuse {
+		return nil, errors.New("connection refused")
+	}
+	a, b := net.Pipe()
+	go func() {
+		defer b.Close()
+		s := bufio.NewScanner(b)
+		for s.Scan() {
+			fmt.Fprintf(b, "%s:%d %s\n", id, port, s.Text())
+		}
+	}()
+	return a, nil
+}
+
+func (e *echoVMs) changed(id, _ string, ports []v86.PortBinding) {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	var hp []string
+	for _, p := range ports {
+		hp = append(hp, p.HostPort+"->"+p.ContainerPort)
+	}
+	e.changes = append(e.changes, id+" "+strings.Join(hp, ","))
+}
+
+// ask sends one line to 127.0.0.1:port and returns the answer.
+func ask(t *testing.T, port, line string) (string, error) {
+	t.Helper()
+	c, err := net.DialTimeout("tcp", "127.0.0.1:"+port, 5*time.Second)
+	if err != nil {
+		return "", err
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(5 * time.Second))
+	fmt.Fprintln(c, line)
+	s, err := bufio.NewReader(c).ReadString('\n')
+	return strings.TrimSpace(s), err
+}
+
+func TestPorts(t *testing.T) {
+	e := &echoVMs{}
+	p := &v86.Ports{Dial: e.dial, Changed: e.changed}
+
+	got, err := p.Publish("web", "web", []v86.PortBinding{
+		{HostPort: "18080", ContainerPort: "80", Protocol: "tcp"},
+		{HostIp: "127.0.0.1", HostPort: "", ContainerPort: "443", Protocol: "tcp"},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []v86.PortBinding{
+		{HostIp: "0.0.0.0", HostPort: "18080", ContainerPort: "80", Protocol: "tcp"},
+		{HostIp: "127.0.0.1", HostPort: "32768", ContainerPort: "443", Protocol: "tcp"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("published %+v; want %+v", got, want)
+	}
+	if !p.Published("web") {
+		t.Error("web is not published")
+	}
+	for _, c := range []struct{ port, want string }{{"18080", "web:80 hi"}, {"32768", "web:443 hi"}} {
+		if s, err := ask(t, c.port, "hi"); err != nil || s != c.want {
+			t.Errorf("port %s answered %q, %v; want %q", c.port, s, err, c.want)
+		}
+	}
+
+	// Docker's messages for a port of another container, and for one that
+	// something else listens on; nothing of the failed publish stays open.
+	_, err = p.Publish("db", "db", []v86.PortBinding{
+		{HostPort: "15432", ContainerPort: "5432", Protocol: "tcp"},
+		{HostIp: "0.0.0.0", HostPort: "18080", ContainerPort: "80", Protocol: "tcp"},
+	})
+	if want := "Bind for 0.0.0.0:18080 failed: port is already allocated"; err == nil || err.Error() != want {
+		t.Errorf("publish of a taken port: %v; want %q", err, want)
+	}
+	if p.Published("db") {
+		t.Error("db is published after a failed publish")
+	}
+	if _, err := ask(t, "15432", "x"); err == nil {
+		t.Error("15432 still listens after the failed publish")
+	}
+	other, err := net.Listen("tcp", "127.0.0.1:18081")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = p.Publish("db", "db", []v86.PortBinding{{HostPort: "18081", ContainerPort: "80", Protocol: "tcp"}})
+	if want := "Error starting userland proxy: listen tcp4 0.0.0.0:18081: bind: address already in use"; err == nil || err.Error() != want {
+		t.Errorf("publish of a port in use: %v; want %q", err, want)
+	}
+	other.Close()
+
+	// The next free port goes on after the last one picked.
+	got, err = p.Publish("db", "db", []v86.PortBinding{{ContainerPort: "5432", Protocol: "tcp"}})
+	if err != nil || got[0].HostPort != "32769" {
+		t.Errorf("auto port %+v, %v; want 32769", got, err)
+	}
+
+	// A connection that is open when the container stops ends with it.
+	c, err := net.Dial("tcp", "127.0.0.1:18080")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Fprintln(c, "first")
+	br := bufio.NewReader(c)
+	if s, _ := br.ReadString('\n'); s != "web:80 first\n" {
+		t.Errorf("answer %q", s)
+	}
+	p.Unpublish("web")
+	p.Unpublish("web") // twice is fine
+	c.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := br.ReadString('\n'); err != io.EOF {
+		t.Errorf("open connection after unpublish: %v; want EOF", err)
+	}
+	c.Close()
+	if _, err := ask(t, "18080", "x"); err == nil {
+		t.Error("18080 still listens after unpublish")
+	}
+	// the port is free for the next container at once
+	if _, err := p.Publish("web2", "web2", []v86.PortBinding{{HostPort: "18080", ContainerPort: "80", Protocol: "tcp"}}); err != nil {
+		t.Errorf("publish after unpublish: %v", err)
+	}
+
+	// A VM that does not listen yet closes the connection, as docker-proxy
+	// does; the port keeps listening.
+	e.mu.Lock()
+	e.refuse = true
+	e.mu.Unlock()
+	if _, err := ask(t, "18080", "x"); err == nil {
+		t.Error("an answer from a VM that refuses")
+	}
+	e.mu.Lock()
+	e.refuse = false
+	e.mu.Unlock()
+	if s, err := ask(t, "18080", "again"); s != "web2:80 again" {
+		t.Errorf("after a refused connection: %q, %v", s, err)
+	}
+	p.Unpublish("web2")
+	p.Unpublish("db")
+
+	wantChanges := []string{"web 18080->80,32768->443", "db 32769->5432", "web ", "web2 18080->80", "web2 ", "db "}
+	if !reflect.DeepEqual(e.changes, wantChanges) {
+		t.Errorf("changes %q; want %q", e.changes, wantChanges)
+	}
+}
+
+func TestPortsRejected(t *testing.T) {
+	p := &v86.Ports{Dial: (&echoVMs{}).dial}
+	for _, c := range []struct {
+		b    v86.PortBinding
+		want string
+	}{
+		{v86.PortBinding{ContainerPort: "53", Protocol: "udp"}, "udp ports cannot be published: the network of the VM carries TCP connections only"},
+		{v86.PortBinding{HostIp: "10.0.0.1", HostPort: "8080", ContainerPort: "80", Protocol: "tcp"},
+			"Error starting userland proxy: listen tcp4 10.0.0.1:8080: bind: cannot assign requested address"},
+		{v86.PortBinding{HostPort: "x", ContainerPort: "80", Protocol: "tcp"}, "invalid hostPort: x"},
+		{v86.PortBinding{ContainerPort: "0", Protocol: "tcp"}, "invalid containerPort: 0"},
+	} {
+		if _, err := p.Publish("c", "c", []v86.PortBinding{c.b}); err == nil || err.Error() != c.want {
+			t.Errorf("publish %+v: %v; want %q", c.b, err, c.want)
+		}
+	}
+	// a host port range: the first free one in it
+	busy, err := net.Listen("tcp", "127.0.0.1:18090")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer busy.Close()
+	got, err := p.Publish("c", "c", []v86.PortBinding{{HostPort: "18090-18092", ContainerPort: "80", Protocol: "tcp"}})
+	if err != nil || got[0].HostPort != "18091" {
+		t.Errorf("range %+v, %v; want 18091", got, err)
+	}
+	p.Unpublish("c")
+}
+
+func TestParsePorts(t *testing.T) {
+	ports := []v86.PortBinding{{HostIp: "0.0.0.0", HostPort: "8080", ContainerPort: "80", Protocol: "tcp"}}
+	label := v86.PortsLabel(ports)
+	if want := `[{"HostIp":"0.0.0.0","HostPort":"8080","ContainerPort":"80","Protocol":"tcp"}]`; label != want {
+		t.Errorf("label %s; want %s", label, want)
+	}
+	got, err := v86.ParsePorts(map[string]string{v86.LabelPorts: label, "other": "x"})
+	if err != nil || !reflect.DeepEqual(got, ports) {
+		t.Errorf("parsed %+v, %v; want %+v", got, err, ports)
+	}
+	if got, err := v86.ParsePorts(nil); got != nil || err != nil {
+		t.Errorf("no label: %+v, %v", got, err)
+	}
+	if _, err := v86.ParsePorts(map[string]string{v86.LabelPorts: "{"}); err == nil {
+		t.Error("a broken label parsed")
+	}
+	if p := ports[0].Port(); p != "80/tcp" {
+		t.Errorf("Port() %q", p)
+	}
+}
