+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/pkg/cio"
+	"github.com/containerd/containerd/v2/pkg/namespaces"
+	"github.com/containerd/errdefs"
+	units "github.com/docker/go-units"
+)
+
+const (
+	// LabelName is the name of the container, without Docker's slash.
+	LabelName = "dev.tabernetes.docker.name"
+	// LabelConfig is the config of the image the container was created
+	// from (imageConfig as JSON): docker inspect and docker ps show the
+	// command, env and ports of the image.
+	LabelConfig = "dev.tabernetes.docker.config"
+	// LabelImageID is the image ID (the digest of the image config).
+	LabelImageID = "dev.tabernetes.docker.image-id"
+	// LabelAutoRemove marks a container of docker run --rm: it goes when
+	// it exits, also when no client waits for it (docker run -d --rm).
+	LabelAutoRemove = "dev.tabernetes.docker.auto-remove"
+	// LabelStartedAt, LabelFinishedAt and LabelExitCode are the state of
+	// the last run. A task ends with its VM, the state must stay.
+	LabelStartedAt  = "dev.tabernetes.docker.started-at"
+	LabelFinishedAt = "dev.tabernetes.docker.finished-at"
+	LabelExitCode   = "dev.tabernetes.docker.exit-code"
+
+	// labelPrefix marks the labels of Tabernetes; docker inspect shows the
+	// others as Config.Labels.
+	labelPrefix = "dev.tabernetes."
+)
+
+// validName is what Docker allows as a container name.
+var validName = regexp.MustCompile(`^/?[a-zA-Z0-9][a-zA-Z0-9_.-]+$`)
+
+// randomBytes reads from crypto/rand. Not math/rand: the binary of the page
+// starts from a heap snapshot, and every start would make the same names.
+func randomBytes(n int) []byte {
+	b := make([]byte, n)
+	rand.Read(b)
+	return b
+}
+
+func randomInt(n int) int {
+	v, err := rand.Int(rand.Reader, big.NewInt(int64(n)))
+	if err != nil {
+		return 0
+	}
+	return int(v.Int64())
+}
+
+// newID makes a container id as Docker does (stringid.GenerateRandomID): 64
+// hex characters whose short form is not a number, so that it cannot be
+// mistaken for one.
+func newID() string {
+	for {
+		id := hex.EncodeToString(randomBytes(32))
+		if _, err := strconv.ParseInt(id[:12], 10, 64); err == nil {
+			continue
+		}
+		return id
+	}
+}
+
+// randomName makes a name like Docker's namesgenerator: adjective_surname,
+// with a digit after it once a name was taken.
+func randomName(retry int) string {
+	for {
+		name := nameLeft[randomInt(len(nameLeft))] + "_" + nameRight[randomInt(len(nameRight))]
+		if name == "boring_wozniak" { // Steve Wozniak is not boring (Docker)
+			continue
+		}
+		if retry > 0 {
+			name += strconv.Itoa(randomInt(10))
+		}
+		return name
+	}
+}
+
+// errNotFound is a container or image that is not there: the API answers 404.
+type errNotFound struct{ msg string }
+
+func (e errNotFound) Error() string { return e.msg }
+
+// httpStatus is the status code for an error of load and friends.
+func httpStatus(err error) int {
+	var nf errNotFound
+	switch {
+	case errors.As(err, &nf), errdefs.IsNotFound(err):
+		return 404
+	case errdefs.IsInvalidArgument(err):
+		return 400
+	case errdefs.IsConflict(err), errdefs.IsAlreadyExists(err):
+		return 409
+	}
+	return 500
+}
+
+// lookup finds a container like dockerd does (daemon.GetContainer): by its
+// full id, then by its name, then by a unique prefix of its id.
+func lookup(all []client.Container, names map[string]string, ref string) (client.Container, error) {
+	ref = strings.TrimPrefix(ref, "/")
+	if ref == "" {
+		return nil, errNotFound{"No such container: "}
+	}
+	for _, c := range all {
+		if c.ID() == ref {
+			return c, nil
+		}
+	}
+	for _, c := range all {
+		if names[c.ID()] == ref {
+			return c, nil
+		}
+	}
+	var found client.Container
+	for _, c := range all {
+		if strings.HasPrefix(c.ID(), ref) {
+			if found != nil {
+				return nil, fmt.Errorf("Multiple IDs found with provided prefix: %s: %w", ref, errdefs.ErrInvalidArgument)
+			}
+			found = c
+		}
+	}
+	if found == nil {
+		return nil, errNotFound{"No such container: " + ref}
+	}
+	return found, nil
+}
+
+// containerName is the name of a container: its label, or its id for a
+// container made by an older Tabernetes, whose id was its name.
+func containerName(id string, labels map[string]string) string {
+	if n := labels[LabelName]; n != "" {
+		return n
+	}
+	return id
+}
+
+// names maps the ids of the containers to their names.
+func (s *Server) names(ctx context.Context, all []client.Container) map[string]string {
+	out := make(map[string]string, len(all))
+	for _, c := range all {
+		if info, err := c.Info(ctx, client.WithoutRefreshedMetadata); err == nil {
+			out[c.ID()] = containerName(c.ID(), info.Labels)
+		}
+	}
+	return out
+}
+
+// containerState is the State of docker inspect.
+type containerState struct {
+	Status  string // created, running, paused, restarting or exited
+	Running bool
+	Paused  bool // docker pause: Running too, as in Docker
+	// Restarting: the restart policy starts it again after a wait
+	// (restart.go). dockerd counts such a container as running too.
+	Restarting bool
+	Pid        int
+	ExitCode   int
+	StartedAt  time.Time
+	FinishedAt time.Time
+}
+
+// String is the STATUS of docker ps, the way dockerd says it
+// (container.State.String).
+func (st containerState) String(now time.Time) string {
+	switch {
+	case st.Restarting:
+		return fmt.Sprintf("Restarting (%d) %s ago", st.ExitCode, units.HumanDuration(now.Sub(st.FinishedAt)))
+	case st.Running && st.Paused:
+		return fmt.Sprintf("Up %s (Paused)", units.HumanDuration(now.Sub(st.StartedAt)))
+	case st.Running:
+		return "Up " + units.HumanDuration(now.Sub(st.StartedAt))
+	case st.StartedAt.IsZero():
+		return "Created"
+	case st.FinishedAt.IsZero():
+		return ""
+	}
+	return fmt.Sprintf("Exited (%d) %s ago", st.ExitCode, units.HumanDuration(now.Sub(st.FinishedAt)))
+}
+
+func parseTime(s string) time.Time {
+	t, _ := time.Parse(time.RFC3339Nano, s)
+	return t
+}
+
+func formatTime(t time.Time) string {
+	if t.IsZero() {
+		return "0001-01-01T00:00:00Z"
+	}
+	return t.UTC().Format(time.RFC3339Nano)
+}
+
+// state reads the state of a container from its task and its labels.
+func (s *Server) state(ctx context.Context, c client.Container, labels map[string]string) containerState {
+	st := containerState{
+		Status:     "created",
+		StartedAt:  parseTime(labels[LabelStartedAt]),
+		FinishedAt: parseTime(labels[LabelFinishedAt]),
+	}
+	st.ExitCode, _ = strconv.Atoi(labels[LabelExitCode])
+	if task, err := c.Task(ctx, nil); err == nil {
+		if ts, err := task.Status(ctx); err == nil {
+			switch ts.Status {
+			case client.Running, client.Paused, client.Pausing:
+				st.Status, st.Running, st.Pid = "running", true, int(task.Pid())
+				if st.Pid == 0 {
+					st.Pid = 1 // the process is PID 1 of its VM, there is no host pid
+				}
+				if ts.Status == client.Paused {
+					st.Status, st.Paused = "paused", true
+				}
+				return st
+			case client.Stopped:
+				// it ended a moment ago, watch has not written it yet
+				if st.FinishedAt.Before(st.StartedAt) {
+					st.ExitCode, st.FinishedAt = int(ts.ExitStatus), ts.ExitTime
+					if st.FinishedAt.IsZero() {
+						st.FinishedAt = time.Now()
+					}
+				}
+			}
+		}
+	}
+	switch {
+	case st.StartedAt.IsZero():
+	case st.FinishedAt.Before(st.StartedAt):
+		// It ran, but nobody saw it end: the VM went with its tab, or with
+		// the daemon. dockerd marks such containers exited with 255 when
+		// it starts again.
+		st.Status, st.ExitCode, st.FinishedAt = "exited", 255, time.Now()
+		c.SetLabels(ctx, map[string]string{LabelFinishedAt: formatTime(st.FinishedAt), LabelExitCode: "255"})
+	default:
+		st.Status = "exited"
+	}
+	if st.Status == "exited" && s.restarting(c.ID()) {
+		st.Status, st.Running, st.Restarting = "restarting", true, true
+	}
+	return st
+}
+
+// run is a container that runs. watch closes done once it ended, with its
+// exit code in code.
+type run struct {
+	done chan struct{}
+	code int
+	// started is when the run started: docker start -a shows the output
+	// of this run only (the records of the log from then on).
+	started time.Time
+}
+
+// startContainer starts a created or exited container: a new task, which
+// is a new VM. Docker keeps the container (its id, name, config and log)
+// and starts its process again.
+func (s *Server) startContainer(ctx context.Context, c client.Container) error {
+	// A start boots a VM, which takes seconds: one at a time per container.
+	s.mu.Lock()
+	if s.starting[c.ID()] {
+		s.mu.Unlock()
+		return errAlreadyStarted
+	}
+	s.starting[c.ID()] = true
+	s.mu.Unlock()
+	defer func() {
+		s.mu.Lock()
+		delete(s.starting, c.ID())
+		s.mu.Unlock()
+	}()
+	if task, err := c.Task(ctx, nil); err == nil {
+		ts, err := task.Status(ctx)
+		if err != nil {
+			return err
+		}
+		if ts.Status != client.Stopped {
+			return errAlreadyStarted
+		}
+		if _, err := task.Delete(ctx); err != nil && !errdefs.IsNotFound(err) {
+			return err
+		}
+	}
+	runStart := time.Now()
+	// docker run -p: the ports open before the VM boots, so a taken port
+	// fails at once, as in Docker (ports.go). watch closes them again.
+	undo, err := s.publish(ctx, c)
+	if err != nil {
+		return networkError{err}
+	}
+	// The task lives as long as the container, not as the request.
+	bg := namespaces.WithNamespace(context.WithoutCancel(ctx), s.ns)
+	task, err := c.NewTask(bg, cio.NullIO) // no stdio: the VM streams its console
+	if err != nil {
+		undo()
+		return err
+	}
+	exitCh, err := task.Wait(bg)
+	if err != nil {
+		undo()
+		task.Delete(bg)
+		return err
+	}
+	started := time.Now()
+	if err := task.Start(bg); err != nil {
+		undo()
+		task.Delete(bg)
+		return err
+	}
+	r := &run{done: make(chan struct{}), started: runStart}
+	s.mu.Lock()
+	s.runs[c.ID()] = r
+	s.mu.Unlock()
+	if _, err := c.SetLabels(bg, map[string]string{LabelStartedAt: formatTime(started)}); err != nil {
+		return err
+	}
+	s.containerEvent(bg, c, "start", nil)
+	go s.watch(bg, c, r, exitCh)
+	return nil
+}
+
+var errAlreadyStarted = errors.New("container already started")
+
+// networkError is a start that failed on its ports. dockerd sets up the
+// network before it creates the task, so its message has no "failed to
+// create task" in front.
+type networkError struct{ error }
+
+func (e networkError) Unwrap() error { return e.error }
+
+// watch records the end of a run in the labels of the container and frees
+// its VM: an exited container keeps no process in Docker either, and a VM
+// holds hundreds of MiB. A container of docker run --rm goes with it.
+func (s *Server) watch(ctx context.Context, c client.Container, r *run, exitCh <-chan client.ExitStatus) {
+	es := <-exitCh
+	// the process is gone: its published ports close (ports.go)
+	s.unpublish(c.ID())
+	at := es.ExitTime()
+	if at.IsZero() {
+		at = time.Now()
+	}
+	r.code = int(es.ExitCode())
+	c.SetLabels(ctx, map[string]string{LabelFinishedAt: formatTime(at), LabelExitCode: strconv.Itoa(r.code)})
+	s.containerEvent(ctx, c, "die", exitAttrs(r.code))
+	if task, err := c.Task(ctx, nil); err == nil {
+		task.Delete(ctx)
+	}
+	if labels, err := c.Labels(ctx); err == nil {
+		if labels[LabelAutoRemove] == "true" {
+			s.removeContainer(ctx, c)
+		} else {
+			// the restart policy (restart.go)
+			s.afterExit(ctx, c, labels, r.code, at.Sub(parseTime(labels[LabelStartedAt])))
+		}
+	}
+	close(r.done)
+}
+
+// waitRun waits until watch has recorded the end of the last run of a
+// container, if this server started one: the answer of docker stop or kill
+// must be seen by the next docker ps.
+func (s *Server) waitRun(ctx context.Context, id string) {
+	if r := s.running(id); r != nil {
+		select {
+		case <-r.done:
+		case <-ctx.Done():
+		}
+	}
+}
+
+// running returns the run of a container that this server started.
+func (s *Server) running(id string) *run {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.runs[id]
+}
+
+// removeContainer deletes a container that has no running task, its log
+// and what the server keeps about it.
+func (s *Server) removeContainer(ctx context.Context, c client.Container) error {
+	// --rm removes the anonymous volumes too, as docker rm -v
+	var mounts []v86.Mount
+	if spec, err := c.Spec(ctx); err == nil {
+		mounts = v86.MountsOf(spec.Annotations)
+	}
+	defer s.removeAnonymousVolumes(ctx, mounts)
+	if task, err := c.Task(ctx, nil); err == nil {
+		if _, err := task.Delete(ctx); err != nil && !errdefs.IsNotFound(err) {
+			return err
+		}
+	}
+	s.containerEvent(ctx, c, "destroy", nil)
+	if err := c.Delete(ctx, client.WithSnapshotCleanup); err != nil && !errdefs.IsNotFound(err) {
+		return err
+	}
+	v86.RemoveLog(v86.LogPath(c.ID()))
+	v86.RemoveCopied(c.ID())
+	s.mu.Lock()
+	for id, e := range s.execs {
+		if e.ContainerID == c.ID() {
+			delete(s.execs, id)
+		}
+	}
+	s.mu.Unlock()
+	return nil
+}
+
+// imageConfig is what a container takes from its image, the part of the
+// image config that docker inspect and docker ps show.
+type imageConfig struct {
+	User         string              `json:",omitempty"`
+	ExposedPorts map[string]struct{} `json:",omitempty"`
+	Env          []string            `json:",omitempty"`
+	Entrypoint   []string            `json:",omitempty"`
+	Cmd          []string            `json:",omitempty"`
+	WorkingDir   string              `json:",omitempty"`
+	Labels       map[string]string   `json:",omitempty"`
+	Volumes      map[string]struct{} `json:",omitempty"` // VOLUME
+}
+
+// configLabel encodes an image config for LabelConfig. containerd takes at
+// most 4096 bytes per label: without the labels and the env of the image if
+// it must be.
+func configLabel(cfg imageConfig) string {
+	for _, trim := range []func(*imageConfig){func(*imageConfig) {}, func(c *imageConfig) { c.Labels = nil }, func(c *imageConfig) { c.Env = nil }} {
+		trim(&cfg)
+		if b, err := json.Marshal(cfg); err == nil && len(b)+len(LabelConfig) < 4000 {
+			return string(b)
+		}
+	}
+	return ""
+}
+
+// command is what the container runs, as Docker shows it: the entrypoint of
+// the image, then the command of docker run or else the CMD of the image.
+func command(cfg imageConfig, cmd []string) []string {
+	if len(cmd) == 0 {
+		cmd = cfg.Cmd
+	}
+	return append(append([]string(nil), cfg.Entrypoint...), cmd...)
+}
+
+// mergeEnv adds env to the env of the image: a name in both takes the value
+// of env.
+func mergeEnv(image, env []string) []string {
+	out := append([]string(nil), image...)
+	for _, e := range env {
+		name, _, _ := strings.Cut(e, "=")
+		i := 0
+		for ; i < len(out); i++ {
+			if n, _, _ := strings.Cut(out[i], "="); n == name {
+				out[i] = e
+				break
+			}
+		}
+		if i == len(out) {
+			out = append(out, e)
+		}
+	}
+	return out
+}
diff --git a/core/runtime/v2/v86/dockerapi/stats.go b/core/runtime/v2/v86/dockerapi/stats.go
new file mode 100644
index 0000000..3154758
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/stats.go
@@ -0,0 +1,194 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// statser is an optional part of the Streamer: the numbers of docker stats
+// of a running task, read in its VM.
+type statser interface {
+	Stats(ctx context.Context, id string) (v86.Stats, error)
+}
+
+// statsInterval is how often dockerd collects stats.
+var statsInterval = time.Second
+
+// The answer of GET /containers/{id}/stats, in the shape of dockerd's
+// StatsResponse (the fields that a VM has).
+type statsJSON struct {
+	Read        string                 `json:"read"`
+	PreRead     string                 `json:"preread"`
+	PidsStats   pidsStats              `json:"pids_stats"`
+	BlkioStats  blkioStats             `json:"blkio_stats"`
+	NumProcs    uint32                 `json:"num_procs"`
+	CPUStats    cpuStats               `json:"cpu_stats"`
+	PreCPUStats cpuStats               `json:"precpu_stats"`
+	MemoryStats memoryStats            `json:"memory_stats"`
+	Name        string                 `json:"name"`
+	ID          string                 `json:"id"`
+	Networks    map[string]networkJSON `json:"networks,omitempty"`
+}
+
+type pidsStats struct {
+	Current uint64 `json:"current,omitempty"`
+}
+
+type blkioStats struct {
+	IoServiceBytesRecursive []struct{} `json:"io_service_bytes_recursive"`
+	IoServicedRecursive     []struct{} `json:"io_serviced_recursive"`
+}
+
+type cpuStats struct {
+	CPUUsage struct {
+		TotalUsage        uint64 `json:"total_usage"`
+		UsageInKernelmode uint64 `json:"usage_in_kernelmode"`
+		UsageInUsermode   uint64 `json:"usage_in_usermode"`
+	} `json:"cpu_usage"`
+	SystemUsage    uint64 `json:"system_cpu_usage,omitempty"`
+	OnlineCPUs     uint32 `json:"online_cpus,omitempty"`
+	ThrottlingData struct {
+		Periods          uint64 `json:"periods"`
+		ThrottledPeriods uint64 `json:"throttled_periods"`
+		ThrottledTime    uint64 `json:"throttled_time"`
+	} `json:"throttling_data"`
+}
+
+type memoryStats struct {
+	Usage uint64            `json:"usage,omitempty"`
+	Stats map[string]uint64 `json:"stats,omitempty"`
+	Limit uint64            `json:"limit,omitempty"`
+}
+
+type networkJSON struct {
+	RxBytes   uint64 `json:"rx_bytes"`
+	RxPackets uint64 `json:"rx_packets"`
+	RxErrors  uint64 `json:"rx_errors"`
+	RxDropped uint64 `json:"rx_dropped"`
+	TxBytes   uint64 `json:"tx_bytes"`
+	TxPackets uint64 `json:"tx_packets"`
+	TxErrors  uint64 `json:"tx_errors"`
+	TxDropped uint64 `json:"tx_dropped"`
+}
+
+// zeroTime is how dockerd writes a time it does not have.
+const zeroTime = "0001-01-01T00:00:00Z"
+
+func cpuOf(st v86.Stats) cpuStats {
+	var c cpuStats
+	if st.CPUTotal == 0 {
+		return c
+	}
+	c.CPUUsage.TotalUsage = st.CPUUser + st.CPUSystem
+	c.CPUUsage.UsageInUsermode = st.CPUUser
+	c.CPUUsage.UsageInKernelmode = st.CPUSystem
+	// the VM has one CPU: all its time is the time of the system
+	c.SystemUsage = st.CPUTotal
+	c.OnlineCPUs = 1
+	return c
+}
+
+// statsOf builds the answer from a sample and the one before (pre, with a
+// zero Read if there is none).
+func statsOf(id, name string, st, pre v86.Stats) statsJSON {
+	out := statsJSON{
+		Read: zeroTime, PreRead: zeroTime, Name: "/" + name, ID: id,
+		CPUStats: cpuOf(st), PreCPUStats: cpuOf(pre),
+	}
+	if !st.Read.IsZero() {
+		out.Read = st.Read.UTC().Format(time.RFC3339Nano)
+		out.PidsStats.Current = st.Pids
+		out.MemoryStats = memoryStats{Usage: st.MemUsage(), Limit: st.MemTotal, Stats: map[string]uint64{}}
+		out.Networks = map[string]networkJSON{"eth0": {
+			RxBytes: st.RxBytes, RxPackets: st.RxPackets, RxErrors: st.RxErrors, RxDropped: st.RxDropped,
+			TxBytes: st.TxBytes, TxPackets: st.TxPackets, TxErrors: st.TxErrors, TxDropped: st.TxDropped,
+		}}
+	}
+	if !pre.Read.IsZero() {
+		out.PreRead = pre.Read.UTC().Format(time.RFC3339Nano)
+	}
+	return out
+}
+
+// stats is docker stats: GET /containers/{id}/stats?stream=&one-shot=. A
+// stream sends a sample every second; without, dockerd waits for a second
+// sample, so that the CPU usage has a delta, unless one-shot is set. A
+// container that does not run has empty numbers.
+func (s *Server) stats(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	labels, _ := c.Labels(ctx)
+	name := containerName(c.ID(), labels)
+	stream := true
+	if v := r.URL.Query().Get("stream"); v != "" {
+		stream = queryBool(r, "stream")
+	}
+	oneShot := queryBool(r, "one-shot")
+	sample := func() v86.Stats {
+		st, ok := s.streams.(statser)
+		if !ok || s.running(c.ID()) == nil {
+			return v86.Stats{}
+		}
+		v, err := st.Stats(ctx, c.ID())
+		if err != nil {
+			return v86.Stats{}
+		}
+		return v
+	}
+	w.Header().Set("Content-Type", "application/json")
+	enc := json.NewEncoder(w)
+	cur := sample()
+	if !stream {
+		var pre v86.Stats
+		if !oneShot && !cur.Read.IsZero() {
+			select {
+			case <-time.After(statsInterval):
+			case <-ctx.Done():
+				return
+			}
+			pre, cur = cur, sample()
+		}
+		enc.Encode(statsOf(c.ID(), name, cur, pre))
+		return
+	}
+	var pre v86.Stats
+	t := time.NewTicker(statsInterval)
+	defer t.Stop()
+	for {
+		if err := enc.Encode(statsOf(c.ID(), name, cur, pre)); err != nil {
+			return
+		}
+		if f, ok := w.(http.Flusher); ok {
+			f.Flush()
+		}
+		select {
+		case <-t.C:
+		case <-ctx.Done():
+			return
+		}
+		pre, cur = cur, sample()
+	}
+}
diff --git a/core/runtime/v2/v86/dockerapi/stream.go b/core/runtime/v2/v86/dockerapi/stream.go
new file mode 100644
index 0000000..3440988
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/stream.go
@@ -0,0 +1,482 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// attach and exec. The Docker API takes over the HTTP connection for them
+// (hijack): the client asks for "Upgrade: tcp", the server answers
+// "101 UPGRADED" and both sides then use the connection as a stream. With a
+// tty the stream is raw; without one every frame of output starts with 8
+// bytes, the stream (1 stdout, 2 stderr) and the size.
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// execInstance is a docker exec: created by POST /containers/{id}/exec, run
+// by POST /exec/{id}/start.
+type execInstance struct {
+	ID          string
+	ContainerID string
+	Cmd         []string
+	Tty         bool
+	AttachStdin bool
+
+	mu       sync.Mutex
+	running  bool
+	exitCode int
+	resize   chan v86.TerminalSize
+}
+
+type execCreateRequest struct {
+	AttachStdin  bool     `json:"AttachStdin"`
+	AttachStdout bool     `json:"AttachStdout"`
+	AttachStderr bool     `json:"AttachStderr"`
+	Tty          bool     `json:"Tty"`
+	Cmd          []string `json:"Cmd"`
+}
+
+type execStartRequest struct {
+	Detach bool `json:"Detach"`
+	Tty    bool `json:"Tty"`
+}
+
+// hijack takes over the connection of r. It answers "101 UPGRADED" if the
+// client asked for an upgrade, else "200 OK", as dockerd does. The returned
+// reader is what the client sends next (stdin): the bytes the server has
+// buffered, then the connection itself. The buffered reader of Hijack still
+// reads through the server, which cancels the context of the request when it
+// reads EOF, that is when the client ends its stdin (docker exec -i < file).
+func hijack(w http.ResponseWriter, r *http.Request, tty bool) (net.Conn, io.Reader, error) {
+	hj, ok := w.(http.Hijacker)
+	if !ok {
+		return nil, nil, fmt.Errorf("the connection cannot be hijacked")
+	}
+	conn, rw, err := hj.Hijack()
+	if err != nil {
+		return nil, nil, err
+	}
+	ct := "application/vnd.docker.multiplexed-stream"
+	if tty {
+		ct = "application/vnd.docker.raw-stream"
+	}
+	if r.Header.Get("Upgrade") == "tcp" {
+		fmt.Fprintf(rw, "HTTP/1.1 101 UPGRADED\r\nContent-Type: %s\r\nConnection: Upgrade\r\nUpgrade: tcp\r\n\r\n", ct)
+	} else {
+		fmt.Fprintf(rw, "HTTP/1.1 200 OK\r\nContent-Type: %s\r\n\r\n", ct)
+	}
+	if err := rw.Flush(); err != nil {
+		conn.Close()
+		return nil, nil, err
+	}
+	buffered, _ := rw.Reader.Peek(rw.Reader.Buffered())
+	return conn, io.MultiReader(bytes.NewReader(bytes.Clone(buffered)), conn), nil
+}
+
+// muxWriter writes one stream of a multiplexed stream.
+type muxWriter struct {
+	mu     *sync.Mutex
+	w      io.Writer
+	stream byte
+}
+
+func (m muxWriter) Write(b []byte) (int, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	for off := 0; off < len(b); {
+		n := min(len(b)-off, 1<<16)
+		hdr := [8]byte{m.stream}
+		binary.BigEndian.PutUint32(hdr[4:], uint32(n))
+		if _, err := m.w.Write(hdr[:]); err != nil {
+			return off, err
+		}
+		if _, err := m.w.Write(b[off : off+n]); err != nil {
+			return off, err
+		}
+		off += n
+	}
+	return len(b), nil
+}
+
+// outputs returns stdout and stderr on conn, raw with a tty.
+func outputs(conn io.Writer, tty bool) (stdout, stderr io.Writer) {
+	if tty {
+		return conn, conn
+	}
+	mu := new(sync.Mutex)
+	return muxWriter{mu, conn, 1}, muxWriter{mu, conn, 2}
+}
+
+// cancelWriter cancels the stream when the client went away: writing to its
+// connection fails.
+type cancelWriter struct {
+	w      io.Writer
+	cancel context.CancelFunc
+}
+
+func (c cancelWriter) Write(b []byte) (int, error) {
+	n, err := c.w.Write(b)
+	if err != nil {
+		c.cancel()
+	}
+	return n, err
+}
+
+func queryBool(r *http.Request, key string) bool {
+	v, _ := strconv.ParseBool(r.URL.Query().Get(key))
+	return v
+}
+
+// attach streams the main process of a container: POST
+// /containers/{id}/attach?stream=1&stdin=1&stdout=1&stderr=1. The VM starts
+// the process at once, so docker run and docker start -a attach after the
+// start: with logs=1 the output starts at the start of the current run (in
+// dockerd, logs=1 sends the whole log). Without it, as docker attach does,
+// only what comes from now on.
+func (s *Server) attach(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	if s.streams == nil {
+		http.Error(w, "attach is not supported", http.StatusNotImplemented)
+		return
+	}
+	// The keys are the client's business with a tty (the CLI watches its
+	// input for them); dockerd checks them all the same.
+	if keys := r.URL.Query().Get("detachKeys"); keys != "" {
+		if _, err := detachKeys(keys); err != nil {
+			http.Error(w, fmt.Sprintf("Invalid detach keys (%s) provided", keys), http.StatusBadRequest)
+			return
+		}
+	}
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	if paused(ctx, c) {
+		http.Error(w, fmt.Sprintf("container %s is paused, unpause the container before attach", id), http.StatusConflict)
+		return
+	}
+	tty, openStdin := false, false
+	if spec, err := c.Spec(ctx); err == nil {
+		tty = spec.Process != nil && spec.Process.Terminal
+		openStdin = spec.Annotations[v86.AnnotationStdin] == "true"
+	}
+	// skip is the part of the log not to send. Attach sends the output of
+	// this run, from its start (v86.Streamer); without logs=1, only what
+	// comes from now on.
+	var skip int64
+	if !queryBool(r, "logs") {
+		if run := s.running(c.ID()); run != nil {
+			recs, _ := v86.ReadLog(v86.LogPath(c.ID()))
+			for _, rec := range recs {
+				if !rec.Time.Before(run.started) {
+					skip += int64(len(rec.Log))
+				}
+			}
+		}
+	}
+	conn, br, err := hijack(w, r, tty)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	defer conn.Close()
+	// The stream ends with its connection (cancelWriter), not with the
+	// request, see hijack.
+	ctx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	defer cancel()
+	stdout, _ := outputs(conn, tty)
+	stdout = &skipWriter{w: cancelWriter{stdout, cancel}, n: skip}
+	var stdin io.Reader
+	// a container without -i has no stdin to attach to
+	if queryBool(r, "stdin") && openStdin {
+		stdin = br
+	}
+	resize := s.addResize(c.ID())
+	defer s.removeResize(c.ID(), resize)
+	if err := s.streams.Attach(ctx, c.ID(), stdin, stdout, resize); err != nil {
+		// no task (never started, or deleted): what the log has
+		if recs, err := v86.ReadLog(v86.LogPath(c.ID())); err == nil {
+			stdout.Write(v86.LogText(recs))
+		}
+	}
+}
+
+// skipWriter drops the first n bytes written to it.
+type skipWriter struct {
+	w io.Writer
+	n int64
+}
+
+func (s *skipWriter) Write(b []byte) (int, error) {
+	if s.n >= int64(len(b)) {
+		s.n -= int64(len(b))
+		return len(b), nil
+	}
+	n := len(b)
+	b = b[s.n:]
+	s.n = 0
+	if _, err := s.w.Write(b); err != nil {
+		return 0, err
+	}
+	return n, nil
+}
+
+// addResize registers a channel for the terminal sizes that POST
+// /containers/{id}/resize sends to the attaches of the container.
+func (s *Server) addResize(id string) chan v86.TerminalSize {
+	ch := make(chan v86.TerminalSize, 4)
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.resizes[id] == nil {
+		s.resizes[id] = make(map[chan v86.TerminalSize]bool)
+	}
+	s.resizes[id][ch] = true
+	return ch
+}
+
+func (s *Server) removeResize(id string, ch chan v86.TerminalSize) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	delete(s.resizes[id], ch)
+	if len(s.resizes[id]) == 0 {
+		delete(s.resizes, id)
+	}
+}
+
+// terminalSize reads ?h=&w= of a resize request.
+func terminalSize(r *http.Request) (v86.TerminalSize, error) {
+	h, err := strconv.ParseUint(r.URL.Query().Get("h"), 10, 16)
+	if err != nil {
+		return v86.TerminalSize{}, fmt.Errorf("bad height: %w", err)
+	}
+	wd, err := strconv.ParseUint(r.URL.Query().Get("w"), 10, 16)
+	if err != nil {
+		return v86.TerminalSize{}, fmt.Errorf("bad width: %w", err)
+	}
+	return v86.TerminalSize{Rows: uint16(h), Cols: uint16(wd)}, nil
+}
+
+// sendSize sends a size without blocking; a full channel keeps its sizes.
+func sendSize(ch chan v86.TerminalSize, size v86.TerminalSize) {
+	select {
+	case ch <- size:
+	default:
+	}
+}
+
+// resize sets the tty size of a container: POST /containers/{id}/resize.
+func (s *Server) resize(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	size, err := terminalSize(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	s.mu.Lock()
+	for ch := range s.resizes[c.ID()] {
+		sendSize(ch, size)
+	}
+	s.mu.Unlock()
+	w.WriteHeader(http.StatusOK)
+}
+
+// execCreate makes an exec instance: POST /containers/{id}/exec.
+func (s *Server) execCreate(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	var req execCreateRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	if len(req.Cmd) == 0 {
+		http.Error(w, "No exec command specified", http.StatusBadRequest)
+		return
+	}
+	if _, st, err := taskStatus(ctx, c); err != nil || !isRunning(st) {
+		http.Error(w, fmt.Sprintf("container %s is not running", c.ID()), http.StatusConflict)
+		return
+	} else if st != client.Running {
+		// dockerd: errExecPaused, with the name as given
+		http.Error(w, fmt.Sprintf("Container %s is paused, unpause the container before exec", id), http.StatusConflict)
+		return
+	}
+	b := make([]byte, 32)
+	rand.Read(b)
+	e := &execInstance{
+		ID: hex.EncodeToString(b), ContainerID: c.ID(), Cmd: req.Cmd, Tty: req.Tty,
+		AttachStdin: req.AttachStdin, resize: make(chan v86.TerminalSize, 4),
+	}
+	s.mu.Lock()
+	s.execs[e.ID] = e
+	s.mu.Unlock()
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	json.NewEncoder(w).Encode(map[string]string{"Id": e.ID})
+}
+
+func (s *Server) exec(id string) (*execInstance, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	e, ok := s.execs[id]
+	return e, ok
+}
+
+// execStart runs an exec instance: POST /exec/{id}/start.
+func (s *Server) execStart(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	if s.streams == nil {
+		http.Error(w, "exec is not supported", http.StatusNotImplemented)
+		return
+	}
+	e, ok := s.exec(id)
+	if !ok {
+		http.Error(w, "No such exec instance: "+id, http.StatusNotFound)
+		return
+	}
+	var req execStartRequest
+	if r.ContentLength != 0 {
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			http.Error(w, err.Error(), http.StatusBadRequest)
+			return
+		}
+	}
+	e.mu.Lock()
+	if e.running {
+		e.mu.Unlock()
+		http.Error(w, "exec "+id+" is already running", http.StatusConflict)
+		return
+	}
+	e.running = true
+	e.mu.Unlock()
+	run := func(ctx context.Context, stdin io.Reader, stdout, stderr io.Writer) {
+		code, err := s.streams.Exec(ctx, e.ContainerID, e.Cmd, e.Tty, stdin, stdout, stderr, e.resize)
+		if err != nil {
+			fmt.Fprintln(stderr, err)
+			if code == 0 {
+				code = 126 // what docker exec reports when the command cannot run
+			}
+		}
+		e.mu.Lock()
+		e.running, e.exitCode = false, code
+		e.mu.Unlock()
+	}
+	if req.Detach {
+		go run(context.WithoutCancel(ctx), nil, io.Discard, io.Discard)
+		w.WriteHeader(http.StatusOK)
+		return
+	}
+	conn, br, err := hijack(w, r, e.Tty)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	defer conn.Close()
+	// The stream ends with its connection (cancelWriter), not with the
+	// request, see hijack.
+	ctx, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	defer cancel()
+	stdout, stderr := outputs(conn, e.Tty)
+	var stdin io.Reader
+	if e.AttachStdin {
+		stdin = br
+	}
+	run(ctx, stdin, cancelWriter{stdout, cancel}, cancelWriter{stderr, cancel})
+}
+
+// execResize sets the tty size of an exec: POST /exec/{id}/resize.
+func (s *Server) execResize(w http.ResponseWriter, r *http.Request, id string) {
+	e, ok := s.exec(id)
+	if !ok {
+		http.Error(w, "No such exec instance: "+id, http.StatusNotFound)
+		return
+	}
+	size, err := terminalSize(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	sendSize(e.resize, size)
+	w.WriteHeader(http.StatusOK)
+}
+
+// execInspect reports an exec instance: GET /exec/{id}/json.
+func (s *Server) execInspect(w http.ResponseWriter, id string) {
+	e, ok := s.exec(id)
+	if !ok {
+		http.Error(w, "No such exec instance: "+id, http.StatusNotFound)
+		return
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	writeJSON(w, map[string]any{
+		"ID": e.ID, "ContainerID": e.ContainerID, "Running": e.running, "ExitCode": e.exitCode,
+		"ProcessConfig": map[string]any{"tty": e.Tty, "entrypoint": e.Cmd[0], "arguments": e.Cmd[1:]},
+	})
+}
+
+// asciiKeys are the names of the control keys, by their code (moby/term).
+var asciiKeys = []string{
+	"ctrl-@", "ctrl-a", "ctrl-b", "ctrl-c", "ctrl-d", "ctrl-e", "ctrl-f", "ctrl-g", "ctrl-h", "ctrl-i", "ctrl-j",
+	"ctrl-k", "ctrl-l", "ctrl-m", "ctrl-n", "ctrl-o", "ctrl-p", "ctrl-q", "ctrl-r", "ctrl-s", "ctrl-t", "ctrl-u",
+	"ctrl-v", "ctrl-w", "ctrl-x", "ctrl-y", "ctrl-z", "ctrl-[", "ctrl-\\", "ctrl-]", "ctrl-^", "ctrl-_",
+}
+
+// detachKeys turns a key sequence of --detach-keys ("ctrl-p,ctrl-q") into
+// its bytes, as moby/term's ToBytes does: a single character, a control key
+// or DEL, separated by commas.
+func detachKeys(keys string) ([]byte, error) {
+	var codes []byte
+next:
+	for _, key := range strings.Split(keys, ",") {
+		if len(key) == 1 {
+			codes = append(codes, key[0])
+			continue
+		}
+		for code, name := range asciiKeys {
+			if name == key {
+				codes = append(codes, byte(code))
+				continue next
+			}
+		}
+		if key != "DEL" {
+			return nil, fmt.Errorf("Unknown character: '%s'", key)
+		}
+		codes = append(codes, 127)
+	}
+	return codes, nil
+}
diff --git a/core/runtime/v2/v86/dockerapi/timestamp.go b/core/runtime/v2/v86/dockerapi/timestamp.go
new file mode 100644
index 0000000..5b59975
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/timestamp.go
@@ -0,0 +1,151 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// The timestamps of the until filter of docker container prune and image
+// prune, parsed as dockerd parses them. Copied from moby
+// (api/types/time/timestamp.go, v28.5.2, Apache License 2.0).
+
+import (
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// These are additional predefined layouts for use in Time.Format and Time.Parse
+// with --since and --until parameters for `docker logs` and `docker events`
+const (
+	rFC3339Local     = "2006-01-02T15:04:05"           // RFC3339 with local timezone
+	rFC3339NanoLocal = "2006-01-02T15:04:05.999999999" // RFC3339Nano with local timezone
+	dateWithZone     = "2006-01-02Z07:00"              // RFC3339 with time at 00:00:00
+	dateLocal        = "2006-01-02"                    // RFC3339 with local timezone and time at 00:00:00
+)
+
+// getTimestamp tries to parse given string as golang duration,
+// then RFC3339 time and finally as a Unix timestamp. If
+// any of these were successful, it returns a Unix timestamp
+// as string otherwise returns the given value back.
+// In case of duration input, the returned timestamp is computed
+// as the given reference time minus the amount of the duration.
+func getTimestamp(value string, reference time.Time) (string, error) {
+	if d, err := time.ParseDuration(value); value != "0" && err == nil {
+		return strconv.FormatInt(reference.Add(-d).Unix(), 10), nil
+	}
+
+	var format string
+	// if the string has a Z or a + or three dashes use parse otherwise use parseinlocation
+	parseInLocation := !strings.ContainsAny(value, "zZ+") && strings.Count(value, "-") != 3
+
+	if strings.Contains(value, ".") {
+		if parseInLocation {
+			format = rFC3339NanoLocal
+		} else {
+			format = time.RFC3339Nano
+		}
+	} else if strings.Contains(value, "T") {
+		// we want the number of colons in the T portion of the timestamp
+		tcolons := strings.Count(value, ":")
+		// if parseInLocation is off and we have a +/- zone offset (not Z) then
+		// there will be an extra colon in the input for the tz offset subtract that
+		// colon from the tcolons count
+		if !parseInLocation && !strings.ContainsAny(value, "zZ") && tcolons > 0 {
+			tcolons--
+		}
+		if parseInLocation {
+			switch tcolons {
+			case 0:
+				format = "2006-01-02T15"
+			case 1:
+				format = "2006-01-02T15:04"
+			default:
+				format = rFC3339Local
+			}
+		} else {
+			switch tcolons {
+			case 0:
+				format = "2006-01-02T15Z07:00"
+			case 1:
+				format = "2006-01-02T15:04Z07:00"
+			default:
+				format = time.RFC3339
+			}
+		}
+	} else if parseInLocation {
+		format = dateLocal
+	} else {
+		format = dateWithZone
+	}
+
+	var t time.Time
+	var err error
+
+	if parseInLocation {
+		t, err = time.ParseInLocation(format, value, time.FixedZone(reference.Zone()))
+	} else {
+		t, err = time.Parse(format, value)
+	}
+
+	if err != nil {
+		// if there is a `-` then it's an RFC3339 like timestamp
+		if strings.Contains(value, "-") {
+			return "", err // was probably an RFC3339 like timestamp but the parser failed with an error
+		}
+		if _, _, err := parseUnixTimestamp(value); err != nil {
+			return "", fmt.Errorf("failed to parse value as time or duration: %q", value)
+		}
+		return value, nil // unix timestamp in and out case (meaning: the value passed at the command line is already in the right format for passing to the server)
+	}
+
+	return fmt.Sprintf("%d.%09d", t.Unix(), int64(t.Nanosecond())), nil
+}
+
+// parseTimestamps returns seconds and nanoseconds from a timestamp that has
+// the format ("%d.%09d", time.Unix(), int64(time.Nanosecond())).
+// If the incoming nanosecond portion is longer than 9 digits it is truncated.
+// The expectation is that the seconds and nanoseconds will be used to create a
+// time variable.  For example:
+//
+//	seconds, nanoseconds, _ := parseTimestamps("1136073600.000000001",0)
+//	since := time.Unix(seconds, nanoseconds)
+//
+// returns seconds as defaultSeconds if value == ""
+func parseTimestamps(value string, defaultSeconds int64) (seconds int64, nanoseconds int64, _ error) {
+	if value == "" {
+		return defaultSeconds, 0, nil
+	}
+	return parseUnixTimestamp(value)
+}
+
+func parseUnixTimestamp(value string) (seconds int64, nanoseconds int64, _ error) {
+	s, n, ok := strings.Cut(value, ".")
+	sec, err := strconv.ParseInt(s, 10, 64)
+	if err != nil {
+		return sec, 0, err
+	}
+	if !ok {
+		return sec, 0, nil
+	}
+	nsec, err := strconv.ParseInt(n, 10, 64)
+	if err != nil {
+		return sec, nsec, err
+	}
+	// should already be in nanoseconds but just in case convert n to nanoseconds
+	nsec = int64(float64(nsec) * math.Pow(float64(10), float64(9-len(n))))
+	return sec, nsec, nil
+}
diff --git a/core/runtime/v2/v86/dockerapi/volumes.go b/core/runtime/v2/v86/dockerapi/volumes.go
new file mode 100644
index 0000000..0ca8b34
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/volumes.go
@@ -0,0 +1,825 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// Volumes and mounts (docker volume, docker run -v and --mount), with the
+// semantics and the messages of dockerd (moby v28: volume/service,
+// volume/local, volume/mounts and daemon/volumes.go).
+//
+// The metadata of a volume is a file in the file system of the page,
+// VolumesRoot/<name>/volume.json, which the page keeps across a reload
+// (keptPaths of web/src/fs.js). The files of a volume are in the browser
+// (OPFS), where the VM worker reads and writes them (web/src/volumes.js);
+// VolumeData deletes them. A container keeps its resolved mounts in its
+// spec (v86.AnnotationMounts): the shim gives them to the VM, and ps,
+// inspect and the volume commands read them from there.
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"path"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// VolumeData deletes the files of a volume in the browser and returns
+// their size (docker volume rm and prune).
+type VolumeData interface {
+	Remove(ctx context.Context, name string) (int64, error)
+}
+
+// DefaultVolumesRoot is where the metadata of the volumes is, Docker's
+// /var/lib/docker/volumes.
+const DefaultVolumesRoot = "/var/lib/docker/volumes"
+
+// AnonymousLabel marks an anonymous volume (docker run -v /path, or a
+// VOLUME of the image): docker rm -v, --rm and docker volume prune remove
+// it.
+const AnonymousLabel = "com.docker.volume.anonymous"
+
+// volumeJSON is a volume as the API shows it (types/volume.Volume).
+type volumeJSON struct {
+	CreatedAt  string `json:",omitempty"`
+	Driver     string
+	Labels     map[string]string
+	Mountpoint string
+	Name       string
+	Options    map[string]string
+	Scope      string
+}
+
+// mountConfig is the part of HostConfig with the mounts: Binds (-v) and
+// Mounts (--mount).
+type mountConfig struct {
+	Binds  []string    `json:"Binds"`
+	Mounts []mountSpec `json:"Mounts"`
+}
+
+// mountSpec is a mount of --mount (types/mount.Mount).
+type mountSpec struct {
+	Type        string
+	Source      string
+	Target      string
+	ReadOnly    bool
+	Consistency string
+	BindOptions *struct {
+		Propagation      string
+		NonRecursive     bool
+		CreateMountpoint bool
+	}
+	VolumeOptions *struct {
+		NoCopy       bool
+		Labels       map[string]string
+		Subpath      string
+		DriverConfig *struct {
+			Name    string
+			Options map[string]string
+		}
+	}
+	TmpfsOptions *struct {
+		SizeBytes int64
+		Mode      uint32
+	}
+	ImageOptions *struct{ Subpath string }
+}
+
+// mountPointJSON is a mount as docker inspect and docker ps show it
+// (types.MountPoint).
+type mountPointJSON struct {
+	Type        string `json:",omitempty"`
+	Name        string `json:",omitempty"`
+	Source      string
+	Destination string
+	Driver      string `json:",omitempty"`
+	Mode        string
+	RW          bool
+	Propagation string
+}
+
+func mountPoints(mounts []v86.Mount) []mountPointJSON {
+	out := make([]mountPointJSON, 0, len(mounts))
+	for _, m := range mounts {
+		out = append(out, mountPointJSON{Type: m.Type, Name: m.Name, Source: m.Source, Destination: m.Destination,
+			Driver: m.Driver, Mode: m.Mode, RW: m.RW, Propagation: m.Propagation})
+	}
+	return out
+}
+
+// ---- errors, as dockerd words them ----
+
+const (
+	errVolumeInUse  = "volume is in use"
+	errNoSuchVolume = "no such volume"
+)
+
+// opError is moby's volume/service.OpErr: "<op> <name>: <err>[ - [refs]]".
+type opError struct {
+	op, name, err string
+	refs          []string
+	status        int
+}
+
+func (e *opError) Error() string {
+	s := e.op
+	if e.name != "" {
+		s += " " + e.name
+	}
+	s += ": " + e.err
+	if len(e.refs) > 0 {
+		s += " - [" + strings.Join(e.refs, ", ") + "]"
+	}
+	return s
+}
+
+// apiError is an error with the HTTP status of dockerd.
+type apiError struct {
+	msg    string
+	status int
+}
+
+func (e apiError) Error() string { return e.msg }
+
+func invalidParameter(format string, a ...any) error {
+	return apiError{fmt.Sprintf(format, a...), http.StatusBadRequest}
+}
+
+func errorStatus(err error) int {
+	if e, ok := errors.AsType[*opError](err); ok && e.status != 0 {
+		return e.status
+	}
+	if e, ok := errors.AsType[apiError](err); ok {
+		return e.status
+	}
+	return http.StatusInternalServerError
+}
+
+// ---- the store ----
+
+// volumeNameRegex is the rule of the local driver for volume names.
+var volumeNameRegex = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_.-]+$`)
+
+func validateVolumeName(name string) error {
+	if len(name) == 1 {
+		return errors.New("volume name is too short, names should be at least two alphanumeric characters")
+	}
+	if !volumeNameRegex.MatchString(name) {
+		return fmt.Errorf("%q includes invalid characters for a local volume name, only %q are allowed. If you intended to pass a host directory, use absolute path", name, "[a-zA-Z0-9][a-zA-Z0-9_.-]")
+	}
+	return nil
+}
+
+func (s *Server) volumeFile(name string) string {
+	return filepath.Join(s.VolumesRoot, name, "volume.json")
+}
+
+func (s *Server) readVolume(name string) (volumeJSON, error) {
+	var v volumeJSON
+	if validateVolumeName(name) != nil {
+		return v, &opError{op: "get", name: name, err: errNoSuchVolume, status: http.StatusNotFound}
+	}
+	b, err := os.ReadFile(s.volumeFile(name))
+	if errors.Is(err, os.ErrNotExist) {
+		return v, &opError{op: "get", name: name, err: errNoSuchVolume, status: http.StatusNotFound}
+	}
+	if err != nil {
+		return v, err
+	}
+	if err := json.Unmarshal(b, &v); err != nil {
+		return v, err
+	}
+	v.Mountpoint = v86.VolumeMountpoint(v.Name)
+	v.Scope = "local"
+	return v, nil
+}
+
+// createVolume creates a volume, or returns the one of that name, as
+// dockerd does. An empty name is a random one.
+func (s *Server) createVolume(name, driver string, labels, options map[string]string) (volumeJSON, error) {
+	s.volMu.Lock()
+	defer s.volMu.Unlock()
+	if name == "" {
+		// an anonymous volume (volume/service.Create)
+		name = newID()
+		l := map[string]string{AnonymousLabel: ""}
+		for k, v := range labels {
+			l[k] = v
+		}
+		labels = l
+	}
+	if driver == "" {
+		driver = "local"
+	}
+	if v, err := s.readVolume(name); err == nil {
+		if driver != v.Driver {
+			return v, &opError{op: "create", name: name, err: "volume name must be unique", status: http.StatusConflict}
+		}
+		return v, nil
+	}
+	if driver != "local" {
+		return volumeJSON{}, &opError{op: "create", name: name, err: fmt.Sprintf("error looking up volume plugin %s: plugin %q not found", driver, driver), status: http.StatusNotFound}
+	}
+	if err := validateVolumeName(name); err != nil {
+		return volumeJSON{}, &opError{op: "create", name: name, err: err.Error(), status: http.StatusBadRequest}
+	}
+	// The options of the local driver mount a device or a network file
+	// system (type, device, o): a VM in the tab has neither.
+	for k := range options {
+		return volumeJSON{}, &opError{op: "create", name: name, err: fmt.Sprintf("invalid option: %q (the tab has no devices or network file systems to mount)", k), status: http.StatusBadRequest}
+	}
+	v := volumeJSON{CreatedAt: time.Now().Format(time.RFC3339), Driver: driver, Labels: labels, Name: name, Options: options}
+	b, err := json.Marshal(v)
+	if err != nil {
+		return v, err
+	}
+	if err := os.MkdirAll(filepath.Dir(s.volumeFile(name)), 0o700); err != nil {
+		return v, err
+	}
+	if err := os.WriteFile(s.volumeFile(name), b, 0o600); err != nil {
+		return v, err
+	}
+	v.Mountpoint, v.Scope = v86.VolumeMountpoint(name), "local"
+	return v, nil
+}
+
+func (s *Server) listVolumes() ([]volumeJSON, error) {
+	entries, err := os.ReadDir(s.VolumesRoot)
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, err
+	}
+	out := []volumeJSON{}
+	for _, e := range entries {
+		if v, err := s.readVolume(e.Name()); err == nil {
+			out = append(out, v)
+		}
+	}
+	return out, nil
+}
+
+// volumeRefs returns the containers that use each volume, by name, in any
+// state: dockerd counts a stopped container as a user too.
+func (s *Server) volumeRefs(ctx context.Context) (map[string][]string, error) {
+	cs, err := s.client.Containers(ctx)
+	if err != nil {
+		return nil, err
+	}
+	refs := map[string][]string{}
+	for _, c := range cs {
+		spec, err := c.Spec(ctx)
+		if err != nil {
+			continue
+		}
+		for _, m := range v86.MountsOf(spec.Annotations) {
+			if m.Type == "volume" {
+				refs[m.Name] = append(refs[m.Name], c.ID())
+			}
+		}
+	}
+	return refs, nil
+}
+
+// removeVolume removes a volume that no container uses. With force, a
+// volume that is not there is no error (PurgeOnError).
+func (s *Server) removeVolume(ctx context.Context, name string, force bool) (int64, error) {
+	if _, err := s.readVolume(name); err != nil {
+		if force && errorStatus(err) == http.StatusNotFound {
+			return 0, nil
+		}
+		return 0, err
+	}
+	refs, err := s.volumeRefs(ctx)
+	if err != nil {
+		return 0, err
+	}
+	if ids := refs[name]; len(ids) > 0 {
+		return 0, &opError{op: "remove", name: name, err: errVolumeInUse, refs: ids, status: http.StatusConflict}
+	}
+	s.volMu.Lock()
+	defer s.volMu.Unlock()
+	var size int64
+	if s.Volumes != nil {
+		if size, err = s.Volumes.Remove(ctx, name); err != nil {
+			return 0, &opError{op: "remove", name: name, err: err.Error()}
+		}
+	}
+	if err := os.RemoveAll(filepath.Join(s.VolumesRoot, name)); err != nil {
+		return 0, err
+	}
+	return size, nil
+}
+
+// removeAnonymousVolumes removes the anonymous volumes of mounts that no
+// other container uses: docker rm -v, and --rm when the container exits.
+func (s *Server) removeAnonymousVolumes(ctx context.Context, mounts []v86.Mount) {
+	for _, m := range mounts {
+		if m.Type != "volume" {
+			continue
+		}
+		v, err := s.readVolume(m.Name)
+		if err != nil {
+			continue
+		}
+		if _, anon := v.Labels[AnonymousLabel]; anon {
+			s.removeVolume(ctx, m.Name, false)
+		}
+	}
+}
+
+// ---- the endpoints ----
+
+// volumeFilterArgs reads the filters of a request, in both encodings of the
+// Docker API: {"name":{"x":true}} and the old {"name":["x"]}.
+func volumeFilterArgs(r *http.Request) (map[string][]string, error) {
+	out := map[string][]string{}
+	raw := r.URL.Query().Get("filters")
+	if raw == "" {
+		return out, nil
+	}
+	var m map[string]map[string]bool
+	if err := json.Unmarshal([]byte(raw), &m); err == nil {
+		for k, vs := range m {
+			for v := range vs {
+				out[k] = append(out[k], v)
+			}
+		}
+		return out, nil
+	}
+	if err := json.Unmarshal([]byte(raw), &out); err != nil {
+		return nil, invalidParameter("invalid filter: %v", err)
+	}
+	return out, nil
+}
+
+func hasLabels(labels map[string]string, filters []string) bool {
+	for _, f := range filters {
+		k, v, withValue := strings.Cut(f, "=")
+		have, ok := labels[k]
+		if !ok || withValue && have != v {
+			return false
+		}
+	}
+	return true
+}
+
+func boolFilter(vs []string) (value, set bool, err error) {
+	for _, v := range vs {
+		switch strings.ToLower(v) {
+		case "true", "1":
+			value, set = true, true
+		case "false", "0":
+			value, set = false, true
+		default:
+			return false, false, invalidParameter("invalid filter 'dangling=%s'", v)
+		}
+	}
+	return value, set, nil
+}
+
+// volumeList is GET /volumes, with the filters dangling, name, driver and
+// label.
+func (s *Server) volumeList(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	filters, err := volumeFilterArgs(r)
+	if err != nil {
+		http.Error(w, err.Error(), errorStatus(err))
+		return
+	}
+	for k := range filters {
+		switch k {
+		case "dangling", "name", "driver", "label":
+		default:
+			http.Error(w, fmt.Sprintf("invalid filter '%s'", k), http.StatusBadRequest)
+			return
+		}
+	}
+	dangling, byDangling, err := boolFilter(filters["dangling"])
+	if err != nil {
+		http.Error(w, err.Error(), errorStatus(err))
+		return
+	}
+	vols, err := s.listVolumes()
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	refs := map[string][]string{}
+	if byDangling {
+		if refs, err = s.volumeRefs(ctx); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+	}
+	out := []volumeJSON{}
+	for _, v := range vols {
+		if byDangling && (len(refs[v.Name]) == 0) != dangling {
+			continue
+		}
+		if ns := filters["name"]; len(ns) > 0 && !containsAny(v.Name, ns) {
+			continue
+		}
+		if ds := filters["driver"]; len(ds) > 0 && !containsAny(v.Driver, ds) {
+			continue
+		}
+		if !hasLabels(v.Labels, filters["label"]) {
+			continue
+		}
+		out = append(out, v)
+	}
+	writeJSON(w, map[string]any{"Volumes": out, "Warnings": nil})
+}
+
+func containsAny(s string, subs []string) bool {
+	for _, x := range subs {
+		if strings.Contains(s, x) {
+			return true
+		}
+	}
+	return false
+}
+
+// volumeCreate is POST /volumes/create.
+func (s *Server) volumeCreate(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Name       string
+		Driver     string
+		DriverOpts map[string]string
+		Labels     map[string]string
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	v, err := s.createVolume(req.Name, req.Driver, req.Labels, req.DriverOpts)
+	if err != nil {
+		http.Error(w, err.Error(), errorStatus(err))
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	json.NewEncoder(w).Encode(v)
+}
+
+// volumeInspect is GET /volumes/{name}.
+func (s *Server) volumeInspect(w http.ResponseWriter, name string) {
+	v, err := s.readVolume(name)
+	if err != nil {
+		http.Error(w, err.Error(), errorStatus(err))
+		return
+	}
+	writeJSON(w, v)
+}
+
+// volumeRemove is DELETE /volumes/{name}?force=.
+func (s *Server) volumeRemove(ctx context.Context, w http.ResponseWriter, r *http.Request, name string) {
+	if _, err := s.removeVolume(ctx, name, queryBool(r, "force")); err != nil {
+		http.Error(w, err.Error(), errorStatus(err))
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// volumePrune is POST /volumes/prune: the volumes that no container uses,
+// only the anonymous ones unless the filter all is set (API 1.42), and
+// with the labels of the label filters.
+func (s *Server) volumePrune(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	filters, err := volumeFilterArgs(r)
+	if err != nil {
+		http.Error(w, err.Error(), errorStatus(err))
+		return
+	}
+	all, _, err := boolFilter(filters["all"])
+	if err != nil {
+		http.Error(w, strings.Replace(err.Error(), "dangling", "all", 1), errorStatus(err))
+		return
+	}
+	vols, err := s.listVolumes()
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	refs, err := s.volumeRefs(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	report := struct {
+		VolumesDeleted []string
+		SpaceReclaimed int64
+	}{VolumesDeleted: []string{}}
+	for _, v := range vols {
+		if _, anon := v.Labels[AnonymousLabel]; !all && !anon {
+			continue
+		}
+		if len(refs[v.Name]) > 0 || !hasLabels(v.Labels, filters["label"]) {
+			continue
+		}
+		size, err := s.removeVolume(ctx, v.Name, false)
+		if err != nil {
+			continue
+		}
+		report.VolumesDeleted = append(report.VolumesDeleted, v.Name)
+		report.SpaceReclaimed += size
+	}
+	writeJSON(w, report)
+}
+
+// serveVolumes routes /volumes; false if the path is not one of them.
+func (s *Server) serveVolumes(ctx context.Context, w http.ResponseWriter, r *http.Request, path string) bool {
+	if path != "volumes" && !strings.HasPrefix(path, "volumes/") {
+		return false
+	}
+	name, _ := url.PathUnescape(strings.TrimPrefix(path, "volumes/"))
+	switch {
+	case r.Method == http.MethodGet && path == "volumes":
+		s.volumeList(ctx, w, r)
+	case r.Method == http.MethodPost && path == "volumes/create":
+		s.volumeCreate(w, r)
+	case r.Method == http.MethodPost && path == "volumes/prune":
+		s.volumePrune(ctx, w, r)
+	case r.Method == http.MethodGet && name != "":
+		s.volumeInspect(w, name)
+	case r.Method == http.MethodDelete && name != "":
+		s.volumeRemove(ctx, w, r, name)
+	default:
+		http.Error(w, "not implemented", http.StatusNotImplemented)
+	}
+	return true
+}
+
+// ---- the mounts of a new container ----
+
+var rwModes = map[string]bool{"rw": true, "ro": true}
+var propagationModes = map[string]bool{"private": true, "rprivate": true, "slave": true, "rslave": true, "shared": true, "rshared": true}
+
+// validMountMode is linuxValidMountMode of moby.
+func validMountMode(mode string) bool {
+	if mode == "" {
+		return true
+	}
+	var rw, label, prop, cp, cons int
+	for _, o := range strings.Split(mode, ",") {
+		switch {
+		case rwModes[o]:
+			rw++
+		case o == "z" || o == "Z":
+			label++
+		case propagationModes[o]:
+			prop++
+		case o == "nocopy":
+			cp++
+		case o == "consistent" || o == "cached" || o == "delegated":
+			cons++
+		default:
+			return false
+		}
+	}
+	return rw <= 1 && label <= 1 && prop <= 1 && cp <= 1 && cons <= 1
+}
+
+func hasMode(mode, want string) bool {
+	for _, o := range strings.Split(mode, ",") {
+		if o == want {
+			return true
+		}
+	}
+	return false
+}
+
+func propagationOf(mode string) string {
+	for _, o := range strings.Split(mode, ",") {
+		if propagationModes[o] {
+			return o
+		}
+	}
+	return "rprivate"
+}
+
+// mountConfigError is moby's errMountConfig.
+func mountConfigError(typ, format string, a ...any) error {
+	return invalidParameter("invalid mount config for type %q: %s", typ, fmt.Sprintf(format, a...))
+}
+
+// validateTarget checks the target of a mount like linuxParser.
+func validateTarget(typ, target string) error {
+	if target == "" {
+		return mountConfigError(typ, "field Target must not be empty")
+	}
+	if path.Clean(strings.ReplaceAll(target, `\`, "/")) == "/" {
+		return mountConfigError(typ, "invalid specification: destination can't be '/'")
+	}
+	if !path.IsAbs(strings.ReplaceAll(target, `\`, "/")) {
+		return mountConfigError(typ, "invalid mount path: '%s' mount path must be absolute", target)
+	}
+	return nil
+}
+
+// parseBind parses an entry of Binds (-v) like ParseMountRaw of moby.
+func parseBind(raw string) (v86.Mount, error) {
+	invalid := func() error { return invalidParameter("invalid volume specification: '%s'", raw) }
+	arr := strings.SplitN(raw, ":", 4)
+	if arr[0] == "" {
+		return v86.Mount{}, invalid()
+	}
+	var src, dst, mode string
+	switch len(arr) {
+	case 1:
+		dst = arr[0]
+	case 2:
+		if validMountMode(arr[1]) {
+			return v86.Mount{}, invalid()
+		}
+		src, dst = arr[0], arr[1]
+	case 3:
+		src, dst, mode = arr[0], arr[1], arr[2]
+	default:
+		return v86.Mount{}, invalid()
+	}
+	if !validMountMode(mode) {
+		return v86.Mount{}, invalidParameter("invalid mode: %v", mode)
+	}
+	m := v86.Mount{Type: "volume", Name: src, Destination: dst, RW: !hasMode(mode, "ro"), Mode: mode, NoCopy: hasMode(mode, "nocopy")}
+	if path.IsAbs(src) {
+		m.Type, m.Name, m.Source = "bind", "", path.Clean(src)
+		m.Propagation = propagationOf(mode)
+	}
+	if err := validateTarget(m.Type, dst); err != nil {
+		return v86.Mount{}, invalidParameter("invalid volume specification: '%s': %v", raw, err)
+	}
+	m.Destination = path.Clean(dst)
+	return m, nil
+}
+
+// parseMountSpec checks a --mount like ParseMountSpec of moby.
+func parseMountSpec(cfg mountSpec) (v86.Mount, error) {
+	typ := cfg.Type
+	if err := validateTarget(typ, cfg.Target); err != nil {
+		return v86.Mount{}, err
+	}
+	m := v86.Mount{Type: typ, Destination: path.Clean(cfg.Target), RW: !cfg.ReadOnly}
+	switch typ {
+	case "bind":
+		if cfg.Source == "" {
+			return m, mountConfigError(typ, "field Source must not be empty")
+		}
+		if cfg.VolumeOptions != nil {
+			return m, mountConfigError(typ, "field VolumeOptions must not be specified")
+		}
+		if cfg.ImageOptions != nil {
+			return m, mountConfigError(typ, "field ImageOptions must not be specified")
+		}
+		if !path.IsAbs(cfg.Source) {
+			return m, mountConfigError(typ, "invalid mount path: '%s' mount path must be absolute", cfg.Source)
+		}
+		m.Source = path.Clean(cfg.Source)
+		m.Propagation = "rprivate"
+		if o := cfg.BindOptions; o != nil && o.Propagation != "" {
+			if !propagationModes[o.Propagation] {
+				return m, mountConfigError(typ, "invalid propagation mode: %s", o.Propagation)
+			}
+			m.Propagation = o.Propagation
+		}
+		if _, err := os.Stat(m.Source); err != nil {
+			if !errors.Is(err, os.ErrNotExist) {
+				return m, mountConfigError(typ, "%v", err)
+			}
+			if cfg.BindOptions == nil || !cfg.BindOptions.CreateMountpoint {
+				return m, mountConfigError(typ, "bind source path does not exist: %s", m.Source)
+			}
+			if err := os.MkdirAll(m.Source, 0o755); err != nil {
+				return m, mountConfigError(typ, "%v", err)
+			}
+		}
+	case "volume":
+		if cfg.BindOptions != nil {
+			return m, mountConfigError(typ, "field BindOptions must not be specified")
+		}
+		if cfg.ImageOptions != nil {
+			return m, mountConfigError(typ, "field ImageOptions must not be specified")
+		}
+		if o := cfg.VolumeOptions; o != nil && o.Subpath != "" {
+			if cfg.Source == "" {
+				return m, mountConfigError(typ, "must not set Subpath when using anonymous volumes")
+			}
+			return m, mountConfigError(typ, "the tab does not support volume subpaths")
+		}
+		if cfg.ReadOnly && cfg.Source == "" {
+			return m, mountConfigError(typ, "must not set ReadOnly mode when using anonymous volumes")
+		}
+		m.Name = cfg.Source
+		m.NoCopy = cfg.VolumeOptions != nil && cfg.VolumeOptions.NoCopy
+	case "tmpfs":
+		if cfg.BindOptions != nil {
+			return m, mountConfigError(typ, "field BindOptions must not be specified")
+		}
+		if cfg.Source != "" {
+			return m, mountConfigError(typ, "field Source must not be specified")
+		}
+		if o := cfg.TmpfsOptions; o != nil {
+			m.TmpfsMode = o.Mode & 0o7777
+		}
+	case "image":
+		return m, mountConfigError(typ, "the tab does not support image mounts")
+	default:
+		return m, mountConfigError(typ, "mount type unknown")
+	}
+	return m, nil
+}
+
+// createMounts resolves the mounts of a new container as
+// registerMountPoints and createContainerOSSpecificSettings of dockerd do:
+// Binds (-v), Mounts (--mount), then an anonymous volume for every path of
+// Volumes (docker run -v /path) and of the VOLUMEs of the image that has
+// no mount yet. It creates the volumes that are not there; a bind source
+// of -v that is not there becomes a directory, as dockerd makes it.
+func (s *Server) createMounts(hc mountConfig, volumes, imageVolumes map[string]struct{}) ([]v86.Mount, error) {
+	var out []v86.Mount
+	taken := map[string]bool{}
+	for _, b := range hc.Binds {
+		m, err := parseBind(b)
+		if err != nil {
+			return nil, err
+		}
+		if taken[m.Destination] {
+			return nil, invalidParameter("Duplicate mount point: %s", m.Destination)
+		}
+		out = append(out, m)
+		taken[m.Destination] = true
+	}
+	for _, cfg := range hc.Mounts {
+		m, err := parseMountSpec(cfg)
+		if err != nil {
+			return nil, err
+		}
+		if taken[m.Destination] {
+			return nil, invalidParameter("Duplicate mount point: %s", cfg.Target)
+		}
+		var labels, options map[string]string
+		if o := cfg.VolumeOptions; o != nil {
+			labels = o.Labels
+			if o.DriverConfig != nil {
+				options = o.DriverConfig.Options
+			}
+		}
+		m.Labels = labels
+		m.Options = options
+		out = append(out, m)
+		taken[m.Destination] = true
+	}
+	var anon []string
+	for _, vs := range []map[string]struct{}{volumes, imageVolumes} {
+		for dst := range vs {
+			if d := path.Clean(dst); !taken[d] && path.IsAbs(d) {
+				anon = append(anon, d)
+				taken[d] = true
+			}
+		}
+	}
+	sort.Strings(anon)
+	for _, d := range anon {
+		out = append(out, v86.Mount{Type: "volume", Destination: d, RW: true})
+	}
+	for i := range out {
+		m := &out[i]
+		switch m.Type {
+		case "volume":
+			v, err := s.createVolume(m.Name, "", m.Labels, m.Options)
+			if err != nil {
+				return nil, err
+			}
+			m.Name, m.Source, m.Driver = v.Name, v.Mountpoint, v.Driver
+			m.Labels, m.Options = nil, nil
+			if m.Mode == "" && i < len(hc.Binds)+len(hc.Mounts) {
+				m.Mode = "z" // setBindModeIfNull
+			}
+		case "bind":
+			if _, err := os.Stat(m.Source); i < len(hc.Binds) && errors.Is(err, os.ErrNotExist) {
+				if err := os.MkdirAll(m.Source, 0o755); err != nil {
+					return nil, invalidParameter("error while creating mount source path '%s': %v", m.Source, err)
+				}
+			}
+		}
+	}
+	return out, nil
+}
