+package dockerapi
+
+import (
+	"context"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+)
+
+// logFollower is an optional part of the Streamer: the records of the log
+// of a running task, then those that follow, for docker logs -f.
+type logFollower interface {
+	FollowLog(id string) (old []v86.LogRecord, records <-chan v86.LogRecord, exited <-chan struct{}, cancel func(), err error)
+}
+
+// timestampFormat is how docker logs -t shows the time
+// (jsonmessage.RFC3339NanoFixed of moby).
+const timestampFormat = "2006-01-02T15:04:05.000000000Z07:00"
+
+// logOptions are the query of GET /containers/{id}/logs.
+type logOptions struct {
+	follow, timestamps, stdout bool
+	since, until               time.Time
+	tail                       int // -1: all
+}
+
+func parseLogOptions(r *http.Request) (logOptions, error) {
+	q := r.URL.Query()
+	o := logOptions{
+		follow:     queryBool(r, "follow"),
+		timestamps: queryBool(r, "timestamps"),
+		stdout:     queryBool(r, "stdout"),
+		tail:       -1,
+	}
+	if !o.stdout && !queryBool(r, "stderr") {
+		// what dockerd answers
+		return o, fmt.Errorf("Bad parameters: you must choose at least one stream")
+	}
+	var err error
+	if v := q.Get("since"); v != "" {
+		if o.since, err = parseTimestamp(v); err != nil {
+			return o, err
+		}
+	}
+	if v := q.Get("until"); v != "" {
+		if o.until, err = parseTimestamp(v); err != nil {
+			return o, err
+		}
+	}
+	if v := q.Get("tail"); v != "" && v != "all" {
+		n, err := strconv.Atoi(v)
+		if err != nil || n < 0 {
+			o.tail = -1 // dockerd takes a bad tail as all
+		} else {
+			o.tail = n
+		}
+	}
+	return o, nil
+}
+
+// parseTimestamp reads the since and until of the API: Unix seconds, with
+// an optional fraction ("1700000000.000000001"), as the docker CLI sends
+// them (api/types/time of moby).
+func parseTimestamp(v string) (time.Time, error) {
+	sec, frac, _ := strings.Cut(v, ".")
+	s, err := strconv.ParseInt(sec, 10, 64)
+	if err != nil {
+		return time.Time{}, fmt.Errorf("invalid timestamp %q", v)
+	}
+	var ns int64
+	if frac != "" {
+		frac = (frac + "000000000")[:9]
+		if ns, err = strconv.ParseInt(frac, 10, 64); err != nil {
+			return time.Time{}, fmt.Errorf("invalid timestamp %q", v)
+		}
+	}
+	return time.Unix(s, ns), nil
+}
+
+// selectLines picks the lines that docker logs shows: those in the time
+// window, then the last tail of them.
+func selectLines(lines []v86.LogLine, o logOptions) []v86.LogLine {
+	out := lines[:0:0]
+	for _, l := range lines {
+		if !o.since.IsZero() && l.Time.Before(o.since) {
+			continue
+		}
+		if !o.until.IsZero() && !l.Time.Before(o.until) {
+			continue
+		}
+		out = append(out, l)
+	}
+	if o.tail >= 0 && len(out) > o.tail {
+		out = out[len(out)-o.tail:]
+	}
+	return out
+}
+
+// logWriter writes the text of a log to the response: raw for a tty, else
+// in the frames of the multiplexed stream (8 bytes: the stream, 1 for
+// stdout, and the size). The VM has one console, so all of it is stdout.
+type logWriter struct {
+	w          io.Writer
+	tty        bool
+	timestamps bool
+	lineStart  bool // the next text starts a line
+}
+
+func (l *logWriter) frame(b []byte) {
+	if l.tty {
+		l.w.Write(b)
+		return
+	}
+	for len(b) > 0 {
+		n := min(len(b), 1<<16)
+		hdr := [8]byte{1}
+		binary.BigEndian.PutUint32(hdr[4:], uint32(n))
+		l.w.Write(hdr[:])
+		l.w.Write(b[:n])
+		b = b[n:]
+	}
+}
+
+// text writes the text of a line or a part of one that came at t. With -t,
+// each line starts with its time.
+func (l *logWriter) text(s string, t time.Time) {
+	if l.timestamps && l.lineStart {
+		s = t.UTC().Format(timestampFormat) + " " + s
+	}
+	l.lineStart = strings.HasSuffix(s, "\n")
+	l.frame([]byte(s))
+}
+
+// logs is docker logs: GET /containers/{id}/logs with stdout, stderr,
+// since, until, timestamps, tail and follow. With follow, a running
+// container sends what it writes until it exits or the client goes.
+func (s *Server) logs(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	o, err := parseLogOptions(r)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	tty := false
+	if spec, err := c.Spec(ctx); err == nil && spec.Process != nil {
+		tty = spec.Process.Terminal
+	}
+
+	var (
+		old     []v86.LogRecord
+		records <-chan v86.LogRecord
+		exited  <-chan struct{}
+	)
+	if lf, ok := s.streams.(logFollower); ok && o.follow && s.running(c.ID()) != nil {
+		var cancel func()
+		if old, records, exited, cancel, err = lf.FollowLog(c.ID()); err == nil {
+			defer cancel()
+		} else {
+			records = nil
+		}
+	}
+	if records == nil {
+		if old, err = v86.ReadLog(v86.LogPath(c.ID())); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+	}
+
+	if tty {
+		w.Header().Set("Content-Type", "application/vnd.docker.raw-stream")
+	} else {
+		w.Header().Set("Content-Type", "application/vnd.docker.multiplexed-stream")
+	}
+	w.WriteHeader(http.StatusOK)
+	out := &logWriter{w: w, tty: tty, timestamps: o.timestamps, lineStart: true}
+	if o.stdout {
+		for _, l := range selectLines(v86.LogLines(old), o) {
+			out.text(l.Text, l.Time)
+		}
+	}
+	flush := func() {
+		if f, ok := w.(http.Flusher); ok {
+			f.Flush()
+		}
+	}
+	flush()
+	if records == nil {
+		return
+	}
+	for {
+		select {
+		case rec := <-records:
+			if !o.until.IsZero() && !rec.Time.Before(o.until) {
+				return
+			}
+			if o.stdout {
+				out.text(rec.Log, rec.Time)
+				flush()
+			}
+		case <-exited:
+			// the last records are queued before the exit
+			for {
+				select {
+				case rec := <-records:
+					if o.stdout {
+						out.text(rec.Log, rec.Time)
+					}
+				default:
+					flush()
+					return
+				}
+			}
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// logConfig is the LogConfig of a HostConfig: docker run --log-driver and
+// --log-opt. Only json-file is there; max-size and max-file rotate the log
+// (v86.LogWriter), the other options of json-file are taken and ignored.
+type logConfig struct {
+	Type   string            `json:"Type"`
+	Config map[string]string `json:"Config"`
+}
+
+// checkLogConfig refuses what dockerd refuses at create.
+func checkLogConfig(c logConfig) error {
+	if c.Type != "" && c.Type != "json-file" {
+		// what dockerd says for a driver it does not have
+		return fmt.Errorf("logger: no log driver named '%s' is registered", c.Type)
+	}
+	_, err := v86.ParseLogConfig(c.Config)
+	return err
+}
+
+// logAnnotations puts max-size and max-file where the runtime reads them.
+func logAnnotations(a map[string]string, c logConfig) {
+	if v, ok := c.Config["max-size"]; ok {
+		a[v86.AnnotationLogMaxSize] = v
+	}
+	if v, ok := c.Config["max-file"]; ok {
+		a[v86.AnnotationLogMaxFile] = v
+	}
+}
+
+// logConfigOf is the LogConfig of docker inspect.
+func logConfigOf(annotations map[string]string) logConfig {
+	c := logConfig{Type: "json-file", Config: map[string]string{}}
+	if v, ok := annotations[v86.AnnotationLogMaxSize]; ok {
+		c.Config["max-size"] = v
+	}
+	if v, ok := annotations[v86.AnnotationLogMaxFile]; ok {
+		c.Config["max-file"] = v
+	}
+	return c
+}
