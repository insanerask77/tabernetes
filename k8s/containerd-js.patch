+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package v86
+
+import "encoding/json"
+
+// Mount is a volume, a bind mount or a tmpfs of a container (docker run
+// -v, --mount). The Docker API resolves them at create time and keeps them
+// in the spec (AnnotationMounts); the runtime gives them to the VM worker,
+// which mounts them into the 9p tree of the VM (web/src/volumes.js). The
+// fields are those of Docker's MountPoint, as docker inspect shows them.
+type Mount struct {
+	Type        string `json:"Type"` // "volume", "bind" or "tmpfs"
+	Name        string `json:"Name,omitempty"`
+	Source      string `json:"Source"`
+	Destination string `json:"Destination"`
+	Driver      string `json:"Driver,omitempty"`
+	Mode        string `json:"Mode"`
+	RW          bool   `json:"RW"`
+	Propagation string `json:"Propagation"`
+
+	// NoCopy: a new volume stays empty (nocopy, volume-nocopy); else it
+	// gets the files that the image has at Destination on the first mount.
+	NoCopy bool `json:"NoCopy,omitempty"`
+	// TmpfsMode is the mode of the root of a tmpfs (tmpfs-mode), 0: 1777.
+	TmpfsMode uint32 `json:"TmpfsMode,omitempty"`
+
+	// Labels and Options of a volume that a --mount creates; not kept.
+	Labels  map[string]string `json:"-"`
+	Options map[string]string `json:"-"`
+}
+
+// AnnotationMounts holds the mounts of a container, as JSON.
+const AnnotationMounts = "dev.tabernetes.v86.mounts"
+
+// MountsLabel encodes mounts for AnnotationMounts.
+func MountsLabel(mounts []Mount) string {
+	b, _ := json.Marshal(mounts)
+	return string(b)
+}
+
+// MountsOf decodes AnnotationMounts of annotations; nil without mounts.
+func MountsOf(annotations map[string]string) []Mount {
+	s := annotations[AnnotationMounts]
+	if s == "" {
+		return nil
+	}
+	var mounts []Mount
+	if json.Unmarshal([]byte(s), &mounts) != nil {
+		return nil
+	}
+	return mounts
+}
+
+// VolumeMountpoint is where Docker keeps the files of a local volume, the
+// Mountpoint and the Source that docker inspect shows. In the tab the files
+// are in the browser (OPFS), not in the file system of the page.
+func VolumeMountpoint(name string) string {
+	return "/var/lib/docker/volumes/" + name + "/_data"
+}
