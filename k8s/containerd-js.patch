+package dockerapi
+
+// The commands besides the lifecycle: docker pause, unpause, rename, top,
+// container prune, image prune, tag and system df. The answers and the
+// error texts are dockerd's (moby v28, daemon/).
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/errdefs"
+)
+
+// ImageTagger is an optional part of an ImageStore: docker tag.
+type ImageTagger interface {
+	// Tag gives the image of the reference source (an Image.Name) the
+	// name target too (normalized).
+	Tag(ctx context.Context, source, target string) error
+}
+
+// LayerPruner is an optional part of an ImageStore: docker image prune.
+type LayerPruner interface {
+	// PruneLayers deletes the layers that no reference uses, what dockerd
+	// calls dangling images, and returns their digests and size.
+	PruneLayers(ctx context.Context) (deleted []string, reclaimed int64, err error)
+}
+
+// Topper is an optional part of the Streamer: docker top. It returns the
+// titles and the rows of the process table of task id, for the ps
+// options psArgs ("-ef" by default).
+type Topper interface {
+	Top(ctx context.Context, id, psArgs string) (titles []string, processes [][]string, err error)
+}
+
+// taskStatus returns the status of the task of a container; a container
+// without a task is stopped.
+func taskStatus(ctx context.Context, c client.Container) (client.Task, client.ProcessStatus, error) {
+	task, err := c.Task(ctx, nil)
+	if errdefs.IsNotFound(err) {
+		return nil, client.Stopped, nil
+	}
+	if err != nil {
+		return nil, "", err
+	}
+	st, err := task.Status(ctx)
+	if errdefs.IsNotFound(err) {
+		return nil, client.Stopped, nil
+	}
+	if err != nil {
+		return nil, "", err
+	}
+	return task, st.Status, nil
+}
+
+func isRunning(st client.ProcessStatus) bool {
+	return st == client.Running || st == client.Paused || st == client.Pausing
+}
+
+// pause is docker pause and unpause: POST /containers/{id}/pause and
+// /unpause. The VM of the container stops (jsruntime), so all of its
+// processes stand still, as under the freezer of runc.
+func (s *Server) pause(ctx context.Context, w http.ResponseWriter, id string, pause bool) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	task, st, err := taskStatus(ctx, c)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	switch {
+	case !isRunning(st):
+		http.Error(w, fmt.Sprintf("container %s is not running", c.ID()), http.StatusConflict)
+		return
+	case pause && st != client.Running:
+		http.Error(w, fmt.Sprintf("Container %s is already paused", c.ID()), http.StatusConflict)
+		return
+	case !pause && st != client.Paused:
+		http.Error(w, fmt.Sprintf("Container %s is not paused", c.ID()), http.StatusInternalServerError)
+		return
+	}
+	if pause {
+		if err := task.Pause(ctx); err != nil {
+			http.Error(w, fmt.Sprintf("cannot pause container %s: %s", c.ID(), err), http.StatusInternalServerError)
+			return
+		}
+	} else if err := task.Resume(ctx); err != nil {
+		http.Error(w, fmt.Sprintf("Cannot unpause container %s: %s", c.ID(), err), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// paused tells whether the task of a container is paused, for exec and
+// attach.
+func paused(ctx context.Context, c client.Container) bool {
+	_, st, err := taskStatus(ctx, c)
+	return err == nil && st == client.Paused
+}
+
+// rename is docker rename: POST /containers/{id}/rename?name=. The name is
+// a label (LabelName), so the container keeps its id, its VM and its log.
+// The links of published ports keep the old name until the next start.
+func (s *Server) rename(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	newName := r.URL.Query().Get("name")
+	if id == "" || newName == "" {
+		http.Error(w, "Neither old nor new names may be empty", http.StatusBadRequest)
+		return
+	}
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	s.createMu.Lock()
+	defer s.createMu.Unlock()
+	labels, err := c.Labels(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	newName = "/" + strings.TrimPrefix(newName, "/")
+	if "/"+containerName(c.ID(), labels) == newName {
+		http.Error(w, "Renaming a container with the same name as its current name", http.StatusBadRequest)
+		return
+	}
+	if !validName.MatchString(newName) {
+		http.Error(w, fmt.Sprintf("Error when allocating new name: Invalid container name (%s), only [a-zA-Z0-9][a-zA-Z0-9_.-] are allowed", newName), http.StatusBadRequest)
+		return
+	}
+	all, err := s.client.Containers(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	for other, n := range s.names(ctx, all) {
+		if "/"+n == newName && other != c.ID() {
+			http.Error(w, fmt.Sprintf("Error when allocating new name: Conflict. The container name %q is already in use by container %q. You have to remove (or rename) that container to be able to reuse that name.", newName, other), http.StatusConflict)
+			return
+		}
+	}
+	if _, err := c.SetLabels(ctx, map[string]string{LabelName: newName[1:]}); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+// top is docker top: GET /containers/{id}/top?ps_args=. dockerd runs ps on
+// the host; here init lists the processes of the VM (Topper).
+func (s *Server) top(ctx context.Context, w http.ResponseWriter, r *http.Request, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	_, st, err := taskStatus(ctx, c)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if !isRunning(st) {
+		http.Error(w, fmt.Sprintf("container %s is not running", c.ID()), http.StatusConflict)
+		return
+	}
+	if st == client.Paused {
+		// The processes of a stopped VM cannot be listed: init runs in it.
+		http.Error(w, fmt.Sprintf("container %s is paused, unpause the container before top", id), http.StatusConflict)
+		return
+	}
+	t, ok := s.streams.(Topper)
+	if !ok {
+		http.Error(w, "top is not supported", http.StatusNotImplemented)
+		return
+	}
+	psArgs := r.URL.Query().Get("ps_args")
+	if psArgs == "" {
+		psArgs = "-ef"
+	}
+	titles, procs, err := t.Top(ctx, c.ID(), psArgs)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	if procs == nil {
+		procs = [][]string{}
+	}
+	writeJSON(w, map[string]any{"Titles": titles, "Processes": procs})
+}
+
+// pruneRunning is moby's errPruneRunning: one prune at a time.
+var errPruneRunning = errors.New("a prune operation is already running")
+
+// containersPrune is docker container prune: POST /containers/prune. It
+// removes the containers that do not run; filters: until, label, label!.
+func (s *Server) containersPrune(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	if !s.pruning.CompareAndSwap(false, true) {
+		http.Error(w, errPruneRunning.Error(), http.StatusConflict)
+		return
+	}
+	defer s.pruning.Store(false)
+	f, err := parseFilters(r.URL.Query().Get("filters"))
+	if err == nil {
+		err = f.validate("label", "label!", "until")
+	}
+	var until time.Time
+	if err == nil {
+		until, err = f.until(time.Now())
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	cs, err := s.client.Containers(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	deleted := []string{}
+	for _, c := range cs {
+		ci, err := s.containerInfo(ctx, c)
+		if err != nil || ci.state.Running {
+			continue
+		}
+		if !until.IsZero() && ci.info.CreatedAt.After(until) {
+			continue
+		}
+		if !f.matchLabels(ci.labels()) {
+			continue
+		}
+		s.mu.Lock()
+		booting := s.starting[c.ID()]
+		s.mu.Unlock()
+		if booting {
+			continue // docker start boots its VM right now
+		}
+		if err := s.removeContainer(ctx, c); err != nil {
+			continue
+		}
+		s.unpublish(c.ID())
+		deleted = append(deleted, c.ID())
+	}
+	// The files a container wrote went with its VM: nothing is reclaimed.
+	writeJSON(w, map[string]any{"ContainersDeleted": deleted, "SpaceReclaimed": 0})
+}
+
+// imagesPrune is docker image prune: POST /images/prune. dangling=true
+// (the default) deletes the layers that no reference uses any more
+// (LayerPruner); dangling=false (docker image prune -a) removes the images
+// that no container uses, with all their tags. Filters: until, label,
+// label!.
+func (s *Server) imagesPrune(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	if !s.pruning.CompareAndSwap(false, true) {
+		http.Error(w, errPruneRunning.Error(), http.StatusConflict)
+		return
+	}
+	defer s.pruning.Store(false)
+	f, err := parseFilters(r.URL.Query().Get("filters"))
+	if err == nil {
+		err = f.validate("dangling", "label", "label!", "until")
+	}
+	dangling := true
+	if err == nil {
+		dangling, err = f.boolOrDefault("dangling", true)
+	}
+	var until time.Time
+	if err == nil {
+		until, err = f.until(time.Now())
+	}
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+	type deleteItem struct {
+		Untagged string `json:",omitempty"`
+		Deleted  string `json:",omitempty"`
+	}
+	report := struct {
+		ImagesDeleted  []deleteItem
+		SpaceReclaimed int64
+	}{ImagesDeleted: []deleteItem{}}
+	if s.Images == nil {
+		writeJSON(w, report)
+		return
+	}
+	if !dangling {
+		imgs, err := s.Images.List(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		cs, err := s.client.Containers(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		used := map[string]bool{}
+		for _, c := range cs {
+			if info, err := c.Info(ctx, client.WithoutRefreshedMetadata); err == nil {
+				for _, img := range imgs {
+					if usesImage(info.Labels, info.Image, img) {
+						used[img.ID] = true
+					}
+				}
+			}
+		}
+		// the layers that stay in use by images that stay
+		keep := map[string]bool{}
+		var gone []Image
+		for _, img := range imgs {
+			prune := !used[img.ID] && (until.IsZero() || !img.Created.After(until)) && f.matchLabels(img.Config.Labels)
+			if prune {
+				gone = append(gone, img)
+			}
+		}
+		for _, img := range imgs {
+			if !containsImage(gone, img.ID) {
+				for _, l := range img.Layers {
+					keep[l] = true
+				}
+			}
+		}
+		sizes := map[string]int64{}
+		for _, img := range gone {
+			for i, l := range img.Layers {
+				if i < len(img.LayerSizes) {
+					sizes[l] = img.LayerSizes[i]
+				}
+			}
+		}
+		for _, img := range gone {
+			deleted, err := s.Images.Remove(ctx, img.Name)
+			if err != nil {
+				continue
+			}
+			ir := parseImageRef(img.Name)
+			report.ImagesDeleted = append(report.ImagesDeleted, deleteItem{Untagged: ir.Familiar()})
+			if img.Digest != "" {
+				report.ImagesDeleted = append(report.ImagesDeleted, deleteItem{Untagged: ir.FamiliarRepo() + "@" + img.Digest})
+			}
+			for _, d := range deleted {
+				report.ImagesDeleted = append(report.ImagesDeleted, deleteItem{Deleted: d})
+				if !keep[d] {
+					report.SpaceReclaimed += sizes[d]
+				}
+			}
+		}
+	}
+	// what no reference uses: also what -a just untagged, if a pod held it
+	if p, ok := s.Images.(LayerPruner); ok {
+		deleted, reclaimed, err := p.PruneLayers(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		for _, d := range deleted {
+			report.ImagesDeleted = append(report.ImagesDeleted, deleteItem{Deleted: d})
+		}
+		report.SpaceReclaimed += reclaimed
+	}
+	writeJSON(w, report)
+}
+
+func containsImage(imgs []Image, id string) bool {
+	for _, img := range imgs {
+		if img.ID == id {
+			return true
+		}
+	}
+	return false
+}
+
+// tag is docker tag: POST /images/{name}/tag?repo=&tag=. The image keeps
+// its ID and gets one more reference (ImageTagger).
+func (s *Server) tag(ctx context.Context, w http.ResponseWriter, r *http.Request, name string) {
+	t, ok := s.Images.(ImageTagger)
+	if s.Images == nil || !ok {
+		http.Error(w, "tag is not supported", http.StatusNotImplemented)
+		return
+	}
+	q := r.URL.Query()
+	repo, tag := q.Get("repo"), q.Get("tag")
+	if repo == "" {
+		http.Error(w, "repository name must have at least one component", http.StatusBadRequest)
+		return
+	}
+	if strings.HasPrefix(tag, "sha256:") {
+		http.Error(w, "refusing to create a tag with a digest reference", http.StatusBadRequest)
+		return
+	}
+	target := repo
+	if tag != "" {
+		target += ":" + tag
+	}
+	imgs, err := s.Images.List(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	img, ok := findImage(imgs, name)
+	if !ok {
+		http.Error(w, "No such image: "+parseImageRef(name).Familiar(), http.StatusNotFound)
+		return
+	}
+	if err := t.Tag(ctx, img.Name, parseImageRef(target).String()); err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	w.WriteHeader(http.StatusCreated)
+}
+
+// diskUsage is docker system df: GET /system/df.
+func (s *Server) diskUsage(ctx context.Context, w http.ResponseWriter) {
+	cs, err := s.client.Containers(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	var imgs []Image
+	if s.Images != nil {
+		if imgs, err = s.Images.List(ctx); err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+	}
+	now := time.Now()
+	containers := []containerSummary{}
+	uses := map[string]int64{} // containers by image ID
+	for _, c := range cs {
+		ci, err := s.containerInfo(ctx, c)
+		if err != nil {
+			continue
+		}
+		sum := ci.summary(now)
+		for _, img := range imgs {
+			if img.ID == sum.ImageID {
+				sum.SizeRootFs = img.Size
+			}
+		}
+		uses[sum.ImageID]++
+		containers = append(containers, sum)
+	}
+	// a layer counts once, also when several images share it
+	layers := map[string]int64{}
+	count := map[string]int{} // images that use a layer
+	for _, sum := range summaries(imgs) {
+		for _, img := range imgs {
+			if img.ID != sum.ID {
+				continue
+			}
+			for i, l := range img.Layers {
+				if i < len(img.LayerSizes) {
+					layers[l] = img.LayerSizes[i]
+				}
+			}
+			for _, l := range uniq(img.Layers) {
+				count[l]++
+			}
+			break
+		}
+	}
+	var total int64
+	for _, size := range layers {
+		total += size
+	}
+	images := []imageSummary{}
+	for _, sum := range summaries(imgs) {
+		sum.Containers = uses[sum.ID]
+		sum.SharedSize = 0
+		for _, img := range imgs {
+			if img.ID == sum.ID {
+				for _, l := range uniq(img.Layers) {
+					if count[l] > 1 {
+						sum.SharedSize += layers[l]
+					}
+				}
+				break
+			}
+		}
+		images = append(images, sum)
+	}
+	// The volumes with the number of containers that use them. Their files
+	// are in the storage of the browser, which Go cannot measure: the size
+	// is -1, as dockerd reports a size it did not compute.
+	type volumeUsage struct {
+		volumeJSON
+		UsageData struct{ Size, RefCount int64 }
+	}
+	volumes := []volumeUsage{}
+	if s.VolumesRoot != "" {
+		vs, _ := s.listVolumes()
+		refs, _ := s.volumeRefs(ctx)
+		for _, v := range vs {
+			u := volumeUsage{volumeJSON: v}
+			u.UsageData.Size, u.UsageData.RefCount = -1, int64(len(refs[v.Name]))
+			volumes = append(volumes, u)
+		}
+	}
+	writeJSON(w, map[string]any{
+		"LayersSize": total, "Images": images, "Containers": containers,
+		"Volumes": volumes, "BuildCache": []any{},
+	})
+}
+
+func uniq(ss []string) []string {
+	var out []string
+	for _, s := range ss {
+		if !contains(out, s) {
+			out = append(out, s)
+		}
+	}
+	return out
+}
