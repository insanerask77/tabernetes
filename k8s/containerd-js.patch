+
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/dockerapi"
+)
+
+// Tag and PruneLayers make fakeImages a dockerapi.ImageTagger and
+// LayerPruner.
+func (f *fakeImages) Tag(ctx context.Context, source, target string) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	for _, img := range f.imgs {
+		if img.Name == source {
+			img.Name, img.Digest = target, ""
+			for i := range f.imgs {
+				if f.imgs[i].Name == target {
+					f.imgs[i] = img
+					return nil
+				}
+			}
+			f.imgs = append(f.imgs, img)
+			return nil
+		}
+	}
+	return fmt.Errorf("No such image: %s", source)
+}
+
+func (f *fakeImages) PruneLayers(ctx context.Context) ([]string, int64, error) {
+	return []string{"sha256:orphan"}, 42, nil
+}
+
+// TestDockerCommands runs pause, unpause, rename, top, the filters of ps,
+// container prune, tag, image prune and system df through the API.
+func TestDockerCommands(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
+	defer cancel()
+	v86.LogDir = t.TempDir()
+	d := startOnce(t, ctx)
+	server := dockerapi.NewServer(d.Client, nil)
+	images := newFakeImages()
+	server.Images = images
+	srv := httptest.NewServer(server)
+	defer srv.Close()
+	u := srv.URL
+	create := func(name, body string) string {
+		t.Helper()
+		st, b := api(t, http.MethodPost, u+"/containers/create?name="+name, body)
+		var c struct{ Id string }
+		json.Unmarshal([]byte(b), &c)
+		if st != 201 {
+			t.Fatalf("create %s: %d %s", name, st, b)
+		}
+		return c.Id
+	}
+	names := func(query string) string {
+		t.Helper()
+		st, b := api(t, http.MethodGet, u+"/containers/json?"+query, "")
+		if st != 200 {
+			return fmt.Sprintf("%d %s", st, strings.TrimSpace(b))
+		}
+		var list []psEntry
+		json.Unmarshal([]byte(b), &list)
+		var out []string
+		for _, c := range list {
+			if strings.HasPrefix(c.Names[0], "/cmd-") {
+				out = append(out, c.Names[0][5:])
+			}
+		}
+		sort.Strings(out)
+		return strings.Join(out, ",")
+	}
+	filter := func(f string) string {
+		k, v, _ := strings.Cut(f, "=")
+		b, _ := json.Marshal(map[string]map[string]bool{k: {v: true}})
+		return "filters=" + url.QueryEscape(string(b))
+	}
+
+	a := create("cmd-a", `{"Image":"alpine","Labels":{"tier":"db"}}`)
+	b := create("cmd-b", `{"Image":"nginx"}`)
+	c := create("cmd-c", `{"Image":"alpine"}`)
+	for _, id := range []string{a, b} {
+		if st, body := api(t, http.MethodPost, u+"/containers/"+id+"/start", ""); st != 204 {
+			t.Fatalf("start: %d %s", st, body)
+		}
+	}
+	// c ran and exited with 3
+	api(t, http.MethodPost, u+"/containers/"+c+"/start", "")
+	testRuntime.Created[c].ExitCode(3)
+	api(t, http.MethodPost, u+"/containers/"+c+"/wait", "")
+
+	// pause: ps, inspect, exec and attach see it
+	if st, body := api(t, http.MethodPost, u+"/containers/cmd-a/pause", ""); st != 204 {
+		t.Fatalf("pause: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/cmd-a/pause", ""); st != 409 || strings.TrimSpace(body) != "Container "+a+" is already paused" {
+		t.Errorf("pause again: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/cmd-c/pause", ""); st != 409 || strings.TrimSpace(body) != "container "+c+" is not running" {
+		t.Errorf("pause of an exited container: %d %s", st, body)
+	}
+	if e := ps(t, u, true)["/cmd-a"]; e.State != "paused" || e.Status != "Up Less than a second (Paused)" {
+		t.Errorf("ps of a paused container: %+v", e)
+	}
+	_, body := api(t, http.MethodGet, u+"/containers/cmd-a/json", "")
+	if !strings.Contains(body, `"Status":"paused","Running":true,"Paused":true`) {
+		t.Errorf("inspect of a paused container: %s", body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/cmd-a/exec", `{"Cmd":["ls"]}`); st != 409 || strings.TrimSpace(body) != "Container cmd-a is paused, unpause the container before exec" {
+		t.Errorf("exec in a paused container: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodGet, u+"/containers/cmd-a/top", ""); st != 409 || !strings.Contains(body, "is paused") {
+		t.Errorf("top of a paused container: %d %s", st, body)
+	}
+	if got := names(filter("status=paused")); got != "a" {
+		t.Errorf("status=paused: %q", got)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/cmd-b/unpause", ""); st != 500 || strings.TrimSpace(body) != "Container "+b+" is not paused" {
+		t.Errorf("unpause of a running container: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/cmd-a/unpause", ""); st != 204 {
+		t.Fatalf("unpause: %d %s", st, body)
+	}
+	if e := ps(t, u, false)["/cmd-a"]; e.State != "running" {
+		t.Errorf("ps after unpause: %+v", e)
+	}
+
+	// filters of ps
+	for _, tc := range []struct{ query, want string }{
+		{"", "a,b"},
+		{"all=1", "a,b,c"},
+		{filter("name=cmd-b"), "b"},
+		{filter("name=^/cmd-[ab]$"), "a,b"},
+		{filter("id=" + c[:10]), ""}, // exited: not without all=1
+		{"all=1&" + filter("id="+c[:10]), "c"},
+		{filter("status=exited"), "c"},
+		{filter("status=running"), "a,b"},
+		{"all=1&" + filter("exited=3"), "c"},
+		{"all=1&" + filter("exited=0"), ""},
+		{filter("label=tier"), "a"},
+		{filter("label=tier=db"), "a"},
+		{filter("label=tier=web"), ""},
+		{"all=1&" + filter("ancestor=alpine"), "a,c"},
+		{filter("ancestor=sha256:b2b2"), "b"},
+		{filter("expose=80"), "b"},
+		{filter("expose=80/udp"), ""},
+		{filter("expose=70-90/tcp"), "b"},
+		{filter("health=none"), "a,b"},
+		{filter("health=healthy"), ""},
+		{filter("network=bridge"), "a,b"},
+		{filter("is-task=false"), "a,b"},
+		{filter("is-task=true"), ""},
+		{"all=1&" + filter("before=cmd-c"), "a,b"},
+		{"all=1&" + filter("since=cmd-a"), "b,c"},
+		{filter("status=bogus"), "400 invalid filter 'status=bogus': invalid value for state (bogus): must be one of created, running, paused, restarting, removing, exited, dead"},
+		{filter("exited=x"), `400 invalid filter 'exited=x': strconv.Atoi: parsing "x": invalid syntax`},
+		{filter("color=red"), "400 invalid filter 'color'"},
+		{filter("before=nosuch"), "404 No such container: nosuch"},
+		{filter("expose=80:80"), "400 filter for 'expose' should not contain ':': 80:80"},
+	} {
+		if got := names(tc.query); got != tc.want {
+			t.Errorf("ps %s: %q; want %q", tc.query, got, tc.want)
+		}
+	}
+	// size=1: the image as the virtual size
+	_, body = api(t, http.MethodGet, u+"/containers/json?size=1&"+filter("name=cmd-b"), "")
+	if !strings.Contains(body, `"SizeRootFs":1000`) || !strings.Contains(body, `"Networks":{"bridge"`) {
+		t.Errorf("ps with size: %s", body)
+	}
+	// the labels of the image and of the container
+	_, body = api(t, http.MethodGet, u+"/containers/cmd-a/json", "")
+	if !strings.Contains(body, `"Labels":{"tier":"db"}`) {
+		t.Errorf("inspect labels: %s", body)
+	}
+
+	// rename
+	for _, tc := range []struct {
+		from, to string
+		code     int
+		msg      string
+	}{
+		{"cmd-c", "cmd-c", 400, "Renaming a container with the same name as its current name"},
+		{"cmd-c", "cmd-a", 409, `Error when allocating new name: Conflict. The container name "/cmd-a" is already in use by container "` + a + `". You have to remove (or rename) that container to be able to reuse that name.`},
+		{"cmd-c", "x", 400, "Error when allocating new name: Invalid container name (/x), only [a-zA-Z0-9][a-zA-Z0-9_.-] are allowed"},
+		{"cmd-c", "", 400, "Neither old nor new names may be empty"},
+		{"nosuch", "y", 404, "No such container: nosuch"},
+		{"cmd-c", "cmd-d", 204, ""},
+	} {
+		st, body := api(t, http.MethodPost, u+"/containers/"+tc.from+"/rename?name="+url.QueryEscape(tc.to), "")
+		if st != tc.code || strings.TrimSpace(body) != tc.msg {
+			t.Errorf("rename %s %s: %d %q", tc.from, tc.to, st, body)
+		}
+	}
+	if got := names("all=1"); got != "a,b,d" {
+		t.Errorf("after rename: %q", got)
+	}
+
+	// container prune: the exited one goes, with the until and label filters
+	if st, body := api(t, http.MethodPost, u+"/containers/prune?"+filter("until=24h"), ""); st != 200 || !strings.Contains(body, `"ContainersDeleted":[]`) {
+		t.Errorf("prune until 24h ago: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/prune?"+filter("label=tier"), ""); st != 200 || !strings.Contains(body, `"ContainersDeleted":[]`) {
+		t.Errorf("prune label=tier: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/prune?"+filter("color=red"), ""); st != 400 || strings.TrimSpace(body) != "invalid filter 'color'" {
+		t.Errorf("prune with a bad filter: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/containers/prune", ""); st != 200 || !strings.Contains(body, `"ContainersDeleted":["`+c+`"]`) {
+		t.Errorf("prune: %d %s", st, body)
+	}
+	if got := names("all=1"); got != "a,b" {
+		t.Errorf("after prune: %q", got)
+	}
+
+	// tag: one more name for the same image
+	if st, body := api(t, http.MethodPost, u+"/images/alpine/tag?repo=myapp&tag=v1", ""); st != 201 {
+		t.Errorf("tag: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/images/nosuch/tag?repo=x&tag=y", ""); st != 404 || strings.TrimSpace(body) != "No such image: nosuch:latest" {
+		t.Errorf("tag of a missing image: %d %s", st, body)
+	}
+	_, body = api(t, http.MethodGet, u+"/images/json", "")
+	if !strings.Contains(body, `"RepoTags":["alpine:latest","myapp:v1"],"RepoDigests":["alpine@sha256:d1a1a1a1a1a1a1a1"]`) {
+		t.Errorf("images after tag: %s", body)
+	}
+	// rmi of one tag only untags
+	if st, body := api(t, http.MethodDelete, u+"/images/myapp:v1", ""); st != 200 || strings.TrimSpace(body) != `[{"Untagged":"myapp:v1"}]` {
+		t.Errorf("rmi of a tag: %d %s", st, body)
+	}
+
+	// system df
+	_, body = api(t, http.MethodGet, u+"/system/df", "")
+	var df struct {
+		LayersSize int64
+		Images     []struct {
+			Id         string
+			Containers int64
+		}
+		Containers []struct{ Id string }
+	}
+	json.Unmarshal([]byte(body), &df)
+	if df.LayersSize != 0 || len(df.Images) != 2 || len(df.Containers) < 2 {
+		t.Errorf("df: %s", body)
+	}
+	for _, img := range df.Images {
+		if img.Id == "sha256:b2b2b2b2b2b2b2b2" && img.Containers < 1 {
+			t.Errorf("df: nginx has no container: %s", body)
+		}
+	}
+
+	// image prune -a: alpine and nginx are used, busybox is not there
+	if st, body := api(t, http.MethodPost, u+"/images/prune?"+filter("dangling=false"), ""); st != 200 ||
+		strings.TrimSpace(body) != `{"ImagesDeleted":[{"Deleted":"sha256:orphan"}],"SpaceReclaimed":42}` {
+		t.Errorf("image prune -a: %d %s", st, body)
+	}
+	if st, body := api(t, http.MethodPost, u+"/images/prune?"+filter("dangling=maybe"), ""); st != 400 || strings.TrimSpace(body) != "invalid filter 'dangling=maybe'" {
+		t.Errorf("image prune with a bad filter: %d %s", st, body)
+	}
+
+	// clean up: kill and remove what this test made
+	for _, id := range []string{a, b} {
+		api(t, http.MethodDelete, u+"/containers/"+id+"?force=1", "")
+	}
+}
diff --git a/core/runtime/v2/v86/daemon/daemon.go b/core/runtime/v2/v86/daemon/daemon.go
new file mode 100644
index 0000000..8f92247
--- /dev/null
+++ b/core/runtime/v2/v86/daemon/daemon.go
@@ -0,0 +1,125 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
