new file mode 100644
index 0000000..980cd88
--- /dev/null
+++ b/core/runtime/v2/v86/dockerapi/inspect.go
@@ -0,0 +1,424 @@
+/*
+   Copyright The containerd Authors.
+
+   Licensed under the Apache License, Version 2.0 (the "License");
+   you may not use this file except in compliance with the License.
+   You may obtain a copy of the License at
+
+       http://www.apache.org/licenses/LICENSE-2.0
+
+   Unless required by applicable law or agreed to in writing, software
+   distributed under the License is distributed on an "AS IS" BASIS,
+   WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+   See the License for the specific language governing permissions and
+   limitations under the License.
+*/
+
+package dockerapi
+
+// docker ps and docker inspect: GET /containers/json and
+// /containers/{id}/json, with the fields and the order of dockerd.
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/core/containers"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/pkg/oci"
+)
+
+// hostPort is a binding as the Docker API writes it.
+type hostPort struct {
+	HostIP   string `json:"HostIp"`
+	HostPort string `json:"HostPort"`
+}
+
+// publishedPorts are the ports of the label of docker run -p (v86.LabelPorts,
+// written by create and start, see ports.go).
+func publishedPorts(labels map[string]string) []v86.PortBinding {
+	ps, _ := v86.ParsePorts(labels)
+	for i := range ps {
+		if ps[i].Protocol == "" {
+			ps[i].Protocol = "tcp"
+		}
+	}
+	return ps
+}
+
+// portSummary is a port in docker ps (container.Port).
+type portSummary struct {
+	IP          string `json:"IP,omitempty"`
+	PrivatePort uint16
+	PublicPort  uint16 `json:",omitempty"`
+	Type        string
+}
+
+// containerSummary is an entry of GET /containers/json.
+type containerSummary struct {
+	ID         string `json:"Id"`
+	Names      []string
+	Image      string
+	ImageID    string
+	Command    string
+	Created    int64
+	Ports      []portSummary
+	Labels     map[string]string
+	State      string
+	Status     string
+	HostConfig struct{ NetworkMode string }
+	Mounts     []struct{}
+}
+
+// containerInfo is what ps and inspect read of a container.
+type containerInfo struct {
+	c      client.Container
+	info   containers.Container
+	spec   oci.Spec
+	config imageConfig // of the image
+	state  containerState
+}
+
+func (s *Server) containerInfo(ctx context.Context, c client.Container) (containerInfo, error) {
+	info, err := c.Info(ctx, client.WithoutRefreshedMetadata)
+	if err != nil {
+		return containerInfo{}, err
+	}
+	ci := containerInfo{c: c, info: info}
+	if info.Spec != nil {
+		json.Unmarshal(info.Spec.GetValue(), &ci.spec)
+	}
+	if s := info.Labels[LabelConfig]; s != "" {
+		json.Unmarshal([]byte(s), &ci.config)
+	}
+	ci.state = s.state(ctx, c, info.Labels)
+	return ci, nil
+}
+
+func (ci containerInfo) process() (args []string, env []string, cwd string, tty bool) {
+	if p := ci.spec.Process; p != nil {
+		return p.Args, p.Env, p.Cwd, p.Terminal
+	}
+	return nil, nil, "", false
+}
+
+// argv is the command of the container, Path and Args of docker inspect.
+func (ci containerInfo) argv() []string {
+	args, _, _, _ := ci.process()
+	return command(ci.config, args)
+}
+
+// ports are the ports of docker ps: the published ones, and those the
+// image exposes. A stopped container has none, as in Docker.
+func (ci containerInfo) ports() []portSummary {
+	if !ci.state.Running {
+		return []portSummary{}
+	}
+	out := []portSummary{}
+	published := map[string]bool{}
+	for _, p := range publishedPorts(ci.info.Labels) {
+		priv, _ := strconv.Atoi(p.ContainerPort)
+		pub, _ := strconv.Atoi(p.HostPort)
+		ip := p.HostIp
+		if ip == "" {
+			ip = "0.0.0.0"
+		}
+		out = append(out, portSummary{IP: ip, PrivatePort: uint16(priv), PublicPort: uint16(pub), Type: p.Protocol})
+		published[p.ContainerPort+"/"+p.Protocol] = true
+	}
+	for port := range ci.config.ExposedPorts {
+		if published[port] {
+			continue
+		}
+		n, proto, _ := strings.Cut(port, "/")
+		if proto == "" {
+			proto = "tcp"
+		}
+		priv, err := strconv.Atoi(n)
+		if err != nil {
+			continue
+		}
+		out = append(out, portSummary{PrivatePort: uint16(priv), Type: proto})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].PrivatePort != out[j].PrivatePort {
+			return out[i].PrivatePort < out[j].PrivatePort
+		}
+		return out[i].PublicPort < out[j].PublicPort
+	})
+	return out
+}
+
+// userLabels are the labels of the container without those of Tabernetes.
+func userLabels(labels map[string]string) map[string]string {
+	out := map[string]string{}
+	for k, v := range labels {
+		if !strings.HasPrefix(k, labelPrefix) {
+			out[k] = v
+		}
+	}
+	return out
+}
+
+// list answers GET /containers/json: the running containers, all of them
+// with all=1, newest first; limit=n the n newest of all.
+func (s *Server) list(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	all := queryBool(r, "all")
+	limit, _ := strconv.Atoi(r.URL.Query().Get("limit"))
+	if limit > 0 {
+		all = true
+	}
+	cs, err := s.client.Containers(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	now := time.Now()
+	out := []containerSummary{}
+	created := map[string]time.Time{}
+	for _, c := range cs {
+		ci, err := s.containerInfo(ctx, c)
+		if err != nil || (!all && !ci.state.Running) {
+			continue
+		}
+		cmd := ci.argv()
+		sum := containerSummary{
+			ID:      c.ID(),
+			Names:   []string{"/" + containerName(c.ID(), ci.info.Labels)},
+			Image:   ci.info.Image,
+			ImageID: ci.info.Labels[LabelImageID],
+			Command: strings.Join(cmd, " "),
+			Created: ci.info.CreatedAt.Unix(),
+			Ports:   ci.ports(),
+			Labels:  userLabels(ci.info.Labels),
+			State:   ci.state.Status,
+			Status:  ci.state.String(now),
+			Mounts:  []struct{}{},
+		}
+		sum.HostConfig.NetworkMode = "bridge"
+		created[c.ID()] = ci.info.CreatedAt
+		out = append(out, sum)
+	}
+	sort.SliceStable(out, func(i, j int) bool { return created[out[i].ID].After(created[out[j].ID]) })
+	if limit > 0 && len(out) > limit {
+		out = out[:limit]
+	}
+	writeJSON(w, out)
+}
+
+// The answer of docker inspect, in the order of dockerd's ContainerJSON.
+type containerJSON struct {
+	ID              string `json:"Id"`
+	Created         string
+	Path            string
+	Args            []string
+	State           stateJSON
+	Image           string
+	ResolvConfPath  string
+	HostnamePath    string
+	HostsPath       string
+	LogPath         string
+	Name            string
+	RestartCount    int
+	Driver          string
+	Platform        string
+	MountLabel      string
+	ProcessLabel    string
+	AppArmorProfile string
+	ExecIDs         []string
+	HostConfig      hostConfigJSON
+	Mounts          []struct{}
+	Config          configJSON
+	NetworkSettings networkSettingsJSON
+}
+
+type stateJSON struct {
+	Status     string
+	Running    bool
+	Paused     bool
+	Restarting bool
+	OOMKilled  bool
+	Dead       bool
+	Pid        int
+	ExitCode   int
+	Error      string
+	StartedAt  string
+	FinishedAt string
+}
+
+type hostConfigJSON struct {
+	NetworkMode   string
+	PortBindings  map[string][]hostPort
+	RestartPolicy struct {
+		Name              string
+		MaximumRetryCount int
+	}
+	AutoRemove bool
+	Runtime    string
+	Memory     int64
+}
+
+type configJSON struct {
+	Hostname     string
+	Domainname   string
+	User         string
+	AttachStdin  bool
+	AttachStdout bool
+	AttachStderr bool
+	ExposedPorts map[string]struct{} `json:",omitempty"`
+	Tty          bool
+	OpenStdin    bool
+	StdinOnce    bool
+	Env          []string
+	Cmd          []string
+	Image        string
+	Volumes      map[string]struct{}
+	WorkingDir   string
+	Entrypoint   []string
+	OnBuild      []string
+	Labels       map[string]string
+}
+
+type endpointJSON struct {
+	NetworkID   string
+	Gateway     string
+	IPAddress   string
+	IPPrefixLen int
+	MacAddress  string
+}
+
+type networkSettingsJSON struct {
+	Bridge      string
+	SandboxID   string
+	SandboxKey  string
+	Ports       map[string][]hostPort
+	Gateway     string
+	IPAddress   string
+	IPPrefixLen int
+	MacAddress  string
+	Networks    map[string]endpointJSON
+}
+
+// inspect answers GET /containers/{id}/json.
+func (s *Server) inspect(ctx context.Context, w http.ResponseWriter, id string) {
+	c, err := s.load(ctx, id)
+	if err != nil {
+		http.Error(w, err.Error(), httpStatus(err))
+		return
+	}
+	ci, err := s.containerInfo(ctx, c)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, s.inspectJSON(ci))
+}
+
+func (s *Server) inspectJSON(ci containerInfo) containerJSON {
+	id := ci.c.ID()
+	labels := ci.info.Labels
+	args, env, cwd, tty := ci.process()
+	argv := ci.argv()
+	var path string
+	var rest []string
+	if len(argv) > 0 {
+		path, rest = argv[0], argv[1:]
+	}
+	if rest == nil {
+		rest = []string{}
+	}
+	cmd := args
+	if len(cmd) == 0 {
+		cmd = ci.config.Cmd
+	}
+	if cwd == "" {
+		cwd = ci.config.WorkingDir
+	}
+	st := ci.state
+	out := containerJSON{
+		ID:      id,
+		Created: formatTime(ci.info.CreatedAt),
+		Path:    path,
+		Args:    rest,
+		State: stateJSON{
+			Status: st.Status, Running: st.Running, Pid: st.Pid, ExitCode: st.ExitCode,
+			StartedAt: formatTime(st.StartedAt), FinishedAt: formatTime(st.FinishedAt),
+		},
+		Image:    labels[LabelImageID],
+		LogPath:  v86.LogPath(id),
+		Name:     "/" + containerName(id, labels),
+		Driver:   "v86",
+		Platform: "linux",
+		Mounts:   []struct{}{},
+		Config: configJSON{
+			Hostname:     shortLayer(id),
+			User:         ci.config.User,
+			AttachStdout: true,
+			AttachStderr: true,
+			ExposedPorts: ci.config.ExposedPorts,
+			Tty:          tty,
+			OpenStdin:    ci.spec.Annotations[v86.AnnotationStdin] == "true",
+			StdinOnce:    ci.spec.Annotations[v86.AnnotationStdinOnce] == "true",
+			Env:          mergeEnv(ci.config.Env, env),
+			Cmd:          cmd,
+			Image:        ci.info.Image,
+			WorkingDir:   cwd,
+			Entrypoint:   ci.config.Entrypoint,
+			Labels:       userLabels(labels),
+		},
+	}
+	if out.Config.Env == nil {
+		out.Config.Env = []string{}
+	}
+	if ci.spec.Hostname != "" {
+		out.Config.Hostname = ci.spec.Hostname
+	}
+	out.Config.AttachStdin = out.Config.OpenStdin
+	hc := &out.HostConfig
+	hc.NetworkMode = "bridge"
+	hc.RestartPolicy.Name = "no"
+	hc.AutoRemove = labels[LabelAutoRemove] == "true"
+	hc.Runtime = ci.info.Runtime.Name
+	hc.PortBindings = map[string][]hostPort{}
+	ports := map[string][]hostPort{}
+	for _, p := range publishedPorts(labels) {
+		key := p.ContainerPort + "/" + p.Protocol
+		hostIP := p.HostIp
+		if hostIP == "0.0.0.0" {
+			hostIP = "" // what -p 8080:80 sends
+		}
+		hc.PortBindings[key] = append(hc.PortBindings[key], hostPort{HostIP: hostIP, HostPort: p.HostPort})
+		ip := p.HostIp
+		if ip == "" {
+			ip = "0.0.0.0"
+		}
+		ports[key] = append(ports[key], hostPort{HostIP: ip, HostPort: p.HostPort})
+	}
+	for port := range ci.config.ExposedPorts {
+		if _, ok := ports[port]; !ok {
+			ports[port] = nil
+		}
+	}
+	if ci.spec.Linux != nil && ci.spec.Linux.Resources != nil && ci.spec.Linux.Resources.Memory != nil && ci.spec.Linux.Resources.Memory.Limit != nil {
+		hc.Memory = *ci.spec.Linux.Resources.Memory.Limit
+	}
+	ns := &out.NetworkSettings
+	ns.Ports = map[string][]hostPort{}
+	ns.Networks = map[string]endpointJSON{}
+	if st.Running {
+		ns.Ports = ports
+		if s.Addresses != nil {
+			if ip, gw, ok := s.Addresses(id); ok {
+				ns.IPAddress, ns.Gateway, ns.IPPrefixLen = ip, gw, 16
+				ns.Networks["bridge"] = endpointJSON{NetworkID: "bridge", Gateway: gw, IPAddress: ip, IPPrefixLen: 16}
+			}
+		}
+	}
+	return out
+}
