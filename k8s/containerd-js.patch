+
+// Package daemon runs the containerd daemon in the same process as its
+// client, with the v86 shim in-process. wasm has no fork and no unix
+// sockets: the daemon serves grpc and ttrpc on the in-process network
+// (defaults.MapAddress), and every task runs in the v86 shim instead of a
+// forked shim binary.
+//
+// It loads only the plugins a v86 task needs: metadata, content, the native
+// snapshotter, the walking differ, events, leases, gc, the v2 runtime and the
+// grpc services the client uses. CRI, NRI, erofs, blockfile, the restart
+// monitor, the debug and metrics servers stay out.
+package daemon
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/containerd/containerd/v2/client"
+	"github.com/containerd/containerd/v2/cmd/containerd/server"
+	srvconfig "github.com/containerd/containerd/v2/cmd/containerd/server/config"
+	v2 "github.com/containerd/containerd/v2/core/runtime/v2"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86"
+	"github.com/containerd/containerd/v2/core/runtime/v2/v86/inprocess"
+	"github.com/containerd/containerd/v2/defaults"
+	"github.com/containerd/containerd/v2/version"
+
+	// The plugins, a subset of cmd/containerd/builtins.
+	_ "github.com/containerd/containerd/v2/core/runtime/v2"
+	_ "github.com/containerd/containerd/v2/plugins/content/local/plugin"
+	_ "github.com/containerd/containerd/v2/plugins/diff/walking/plugin"
+	_ "github.com/containerd/containerd/v2/plugins/events"
+	_ "github.com/containerd/containerd/v2/plugins/gc"
+	_ "github.com/containerd/containerd/v2/plugins/leases"
+	_ "github.com/containerd/containerd/v2/plugins/metadata"
+	_ "github.com/containerd/containerd/v2/plugins/mount"
+	_ "github.com/containerd/containerd/v2/plugins/server/grpc"
+	_ "github.com/containerd/containerd/v2/plugins/server/ttrpc"
+	_ "github.com/containerd/containerd/v2/plugins/services/containers"
+	_ "github.com/containerd/containerd/v2/plugins/services/content"
+	_ "github.com/containerd/containerd/v2/plugins/services/diff"
+	_ "github.com/containerd/containerd/v2/plugins/services/events"
+	_ "github.com/containerd/containerd/v2/plugins/services/images"
+	_ "github.com/containerd/containerd/v2/plugins/services/introspection"
+	_ "github.com/containerd/containerd/v2/plugins/services/leases"
+	_ "github.com/containerd/containerd/v2/plugins/services/namespaces"
+	_ "github.com/containerd/containerd/v2/plugins/services/snapshots"
+	_ "github.com/containerd/containerd/v2/plugins/services/tasks"
+	_ "github.com/containerd/containerd/v2/plugins/services/version"
+	_ "github.com/containerd/containerd/v2/plugins/services/warning"
+	_ "github.com/containerd/containerd/v2/plugins/snapshots/native/plugin"
+)
+
+// Daemon is a running containerd with its client.
+type Daemon struct {
+	srv    *server.Server
+	Client *client.Client
+}
+
+// Start starts containerd with its data under root and its state under
+// state, and connects a client in namespace ns. Every task runs in rt.
+// Start may be called once per process: the shim loader and the listen
+// addresses are process wide.
+func Start(ctx context.Context, root, state, ns string, rt v86.Runtime) (*Daemon, error) {
+	v2.InProcessShimLoader = func(ctx context.Context, id, namespace, bundle string) (v2.ShimInstance, error) {
+		return inprocess.New(ctx, id, namespace, bundle, rt)
+	}
+
+	config := &srvconfig.Config{
+		Version: version.ConfigVersion,
+		Root:    root,
+		State:   state,
+		// No TempDir: containerd would set TMPDIR for the whole process,
+		// which it shares with its client (and in tabernetes with kubectl).
+		Plugins: map[string]any{
+			"io.containerd.server.v1.grpc":  map[string]any{"address": defaults.DefaultAddress},
+			"io.containerd.server.v1.ttrpc": map[string]any{"address": defaults.DefaultAddress + ".ttrpc"},
+		},
+		// Fail early if the core is missing, not on the first container.
+		RequiredPlugins: []string{
+			"io.containerd.metadata.v1.bolt",
+			"io.containerd.runtime.v2.task",
+			"io.containerd.server.v1.grpc",
+		},
+	}
+	if err := server.CreateTopLevelDirectories(config); err != nil {
+		return nil, fmt.Errorf("containerd directories: %w", err)
+	}
+	srv, err := server.New(ctx, config)
+	if err != nil {
+		return nil, fmt.Errorf("containerd: %w", err)
+	}
+	if err := srv.Start(ctx); err != nil {
+		srv.Stop()
+		return nil, fmt.Errorf("containerd: %w", err)
+	}
+	srv.Wait()
+
+	c, err := client.New(defaults.DefaultAddress, client.WithDefaultNamespace(ns))
+	if err != nil {
+		srv.Stop()
+		return nil, fmt.Errorf("containerd client: %w", err)
+	}
+	return &Daemon{srv: srv, Client: c}, nil
+}
+
+// Stop closes the client and the plugins.
+func (d *Daemon) Stop() {
+	d.Client.Close()
+	d.srv.Stop()
+}
