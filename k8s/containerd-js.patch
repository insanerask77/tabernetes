+// loadInProcessShim loads the in-process shim of a bundle that a containerd
+// before this one left (wasm has no fork, see InProcessShimLoader). There is
+// no shim binary to resolve, to connect to or to call for the cleanup: the
+// shim answers for its bundle at once. A shim that knows no task (it was
+// started, but the task was never created) is removed, as a leaked shim
+// would be; the others stay, with their task running or stopped.
+func (m *ShimManager) loadInProcessShim(ctx context.Context, bundle *Bundle) error {
+	ctx, cancel := timeout.WithContext(ctx, loadTimeout)
+	defer cancel()
+
+	shim, err := startInProcessShim(ctx, bundle)
+	if err != nil {
+		return fmt.Errorf("unable to load shim %q: %w", bundle.ID, err)
+	}
+	s, err := newShimTask(shim)
+	if err == nil {
+		_, err = s.PID(ctx)
+	}
+	if err != nil {
+		if !errdefs.IsNotFound(err) {
+			log.G(ctx).WithField("id", bundle.ID).WithError(err).Warn("failed to load in-process shim")
+		}
+		// Delete removes the bundle too.
+		if derr := shim.Delete(context.WithoutCancel(ctx)); derr != nil {
+			log.G(ctx).WithField("id", bundle.ID).WithError(derr).Warn("failed to delete in-process shim")
+		}
+		return nil
+	}
+	return m.shims.Add(ctx, shim)
+}
