+   limitations under the License.
+*/
+
+package oci
+
+import (
+	"os"
+	"syscall"
+
+	"github.com/opencontainers/runtime-spec/specs-go"
+)
+
+// DeviceFromPath on js/wasm: there are no device nodes, so a real device is
+// never found. The fields are still derived from the FileMode so callers that
+// check errors.Is(err, ErrNotADevice) behave as usual.
+func DeviceFromPath(path string) (*specs.LinuxDevice, error) {
+	if overrideDeviceFromPath != nil {
+		if err := overrideDeviceFromPath(path); err != nil {
+			return nil, err
+		}
+	}
+
+	fi, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	stat, ok := fi.Sys().(*syscall.Stat_t)
+	if !ok {
+		return nil, ErrNotADevice
+	}
+
+	var devType string
+	mode := fi.Mode()
+	switch {
+	case mode&os.ModeDevice != 0 && mode&os.ModeCharDevice == 0:
+		devType = blockDevice
+	case mode&os.ModeCharDevice != 0:
+		devType = charDevice
+	case mode&os.ModeNamedPipe != 0:
+		devType = fifoDevice
+	default:
+		return nil, ErrNotADevice
+	}
+
+	// js/wasm has no Linux dev_t: major/minor are meaningless.
+	fm := mode.Perm()
+	return &specs.LinuxDevice{
+		Type:     devType,
+		Path:     path,
+		Major:    0,
+		Minor:    0,
+		FileMode: &fm,
+		UID:      &stat.Uid,
+		GID:      &stat.Gid,
+	}, nil
+}
