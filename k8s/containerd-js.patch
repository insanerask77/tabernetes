+
+package dockerapi
+
+// Images. The VM worker of the tab pulls them into the image store of the
+// browser (web/src/layers.js), not into containerd's content store, and
+// Kubernetes pods share that store. ImageStore is the seam to it; the glue
+// in k8s/tabernetes sets Server.Images.
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/containerd/containerd/v2/client"
+)
+
+// Image is an image in the store of the tab.
+type Image struct {
+	// Name is the normalized reference it was pulled by:
+	// docker.io/library/nginx:latest.
+	Name string `json:"name"`
+	// ID is the digest of the image config, Docker's image ID.
+	ID string `json:"id"`
+	// Digest is the digest of the manifest (or index) of Name, the repo
+	// digest.
+	Digest       string      `json:"digest"`
+	Created      time.Time   `json:"created"`
+	Size         int64       `json:"size"` // of the unpacked layers
+	Architecture string      `json:"architecture"`
+	Os           string      `json:"os"`
+	Layers       []string    `json:"layers"`  // digests of the layer blobs
+	DiffIDs      []string    `json:"diffIDs"` // of the unpacked layers
+	Config       imageConfig `json:"config"`
+}
+
+// PullProgress is a step of a pull, for one layer (Layer, a digest) or for
+// the whole image (Layer empty). Status is one of the Pull* constants.
+type PullProgress struct {
+	Layer   string `json:"layer"`
+	Status  string `json:"status"`
+	Current int64  `json:"current"`
+	Total   int64  `json:"total"`
+}
+
+// The steps of a layer, as the VM worker reports them.
+const (
+	PullFsLayer     = "fs"          // the layer is missing
+	PullWaiting     = "waiting"     // it waits for a free download slot
+	PullDownloading = "downloading" // Current of Total bytes are there
+	PullVerifying   = "verifying"   // the download ended, its digest is checked
+	PullDownloaded  = "downloaded"  // the digest was right
+	PullComplete    = "complete"    // the layer is unpacked
+	PullExists      = "exists"      // the layer was there before
+)
+
+// pullTexts are dockerd's words for the steps (distribution/pull_v2.go).
+var pullTexts = map[string]string{
+	PullFsLayer:     "Pulling fs layer",
+	PullWaiting:     "Waiting",
+	PullDownloading: "Downloading",
+	PullVerifying:   "Verifying Checksum",
+	PullDownloaded:  "Download complete",
+	PullComplete:    "Pull complete",
+	PullExists:      "Already exists",
+}
+
+// ImageStore lists, pulls and removes the images of the tab.
+type ImageStore interface {
+	List(ctx context.Context) ([]Image, error)
+	// Pull pulls ref (normalized) and reports its steps to progress. It
+	// tells whether something was downloaded.
+	Pull(ctx context.Context, ref string, progress func(PullProgress)) (img Image, downloaded bool, err error)
+	// Remove forgets the reference name (an Image.Name) and deletes the
+	// config and the layers that no other image uses. It returns the
+	// digests it deleted.
+	Remove(ctx context.Context, name string) ([]string, error)
+}
+
+// imageRef is a normalized image reference.
+type imageRef struct {
+	Domain, Path, Tag, Digest string
+}
+
+// parseImageRef normalizes a reference as Docker does (and parseRef in
+// web/src/vmworker.js): nginx is docker.io/library/nginx:latest.
+func parseImageRef(s string) imageRef {
+	var r imageRef
+	rest := s
+	r.Domain = "docker.io"
+	if i := strings.IndexByte(rest, '/'); i > 0 {
+		if first := rest[:i]; strings.ContainsAny(first, ".:") || first == "localhost" {
+			r.Domain, rest = first, rest[i+1:]
+		}
+	}
+	if i := strings.IndexByte(rest, '@'); i >= 0 {
+		r.Digest, rest = rest[i+1:], rest[:i]
+	}
+	if i := strings.LastIndexByte(rest, ':'); i > strings.LastIndexByte(rest, '/') {
+		r.Tag, rest = rest[i+1:], rest[:i]
+	}
+	if r.Domain == "index.docker.io" || r.Domain == "registry-1.docker.io" {
+		r.Domain = "docker.io"
+	}
+	if r.Domain == "docker.io" && !strings.Contains(rest, "/") {
+		rest = "library/" + rest
+	}
+	if r.Tag == "" && r.Digest == "" {
+		r.Tag = "latest"
+	}
+	r.Path = rest
+	return r
+}
+
+// Repo is the repository: docker.io/library/nginx.
+func (r imageRef) Repo() string { return r.Domain + "/" + r.Path }
+
+// String is the full reference: docker.io/library/nginx:latest.
+func (r imageRef) String() string {
+	s := r.Repo()
+	if r.Tag != "" {
+		s += ":" + r.Tag
+	}
+	if r.Digest != "" {
+		s += "@" + r.Digest
+	}
+	return s
+}
+
+// FamiliarRepo is the repository as Docker shows it: nginx, not
+// docker.io/library/nginx.
+func (r imageRef) FamiliarRepo() string {
+	if r.Domain != "docker.io" {
+		return r.Repo()
+	}
+	return strings.TrimPrefix(r.Path, "library/")
+}
+
+// Familiar is the reference as Docker shows it: nginx:latest.
+func (r imageRef) Familiar() string {
+	s := r.FamiliarRepo()
+	if r.Tag != "" {
+		s += ":" + r.Tag
+	}
+	if r.Digest != "" {
+		s += "@" + r.Digest
+	}
+	return s
+}
+
+// findImage finds an image by reference, image ID or a prefix of it, as
+// dockerd does.
+func findImage(imgs []Image, ref string) (Image, bool) {
+	full := parseImageRef(ref).String()
+	for _, img := range imgs {
+		if img.Name == full {
+			return img, true
+		}
+	}
+	id := strings.TrimPrefix(ref, "sha256:")
+	if len(id) >= 4 && strings.Trim(id, "0123456789abcdef") == "" {
+		for _, img := range imgs {
+			if strings.HasPrefix(strings.TrimPrefix(img.ID, "sha256:"), id) {
+				return img, true
+			}
+		}
+	}
+	return Image{}, false
+}
+
+// imageSummary is an entry of GET /images/json.
+type imageSummary struct {
+	ID          string `json:"Id"`
+	ParentID    string `json:"ParentId"`
+	RepoTags    []string
+	RepoDigests []string
+	Created     int64
+	Size        int64
+	SharedSize  int64
+	Labels      map[string]string
+	Containers  int64
+}
+
+// summaries groups the references of the store by image ID, as Docker lists
+// one image with all its tags.
+func summaries(imgs []Image) []imageSummary {
+	byID := map[string]*imageSummary{}
+	var out []*imageSummary
+	for _, img := range imgs {
+		s := byID[img.ID]
+		if s == nil {
+			s = &imageSummary{ID: img.ID, RepoTags: []string{}, RepoDigests: []string{}, Created: img.Created.Unix(),
+				Size: img.Size, SharedSize: -1, Labels: img.Config.Labels, Containers: -1}
+			byID[img.ID] = s
+			out = append(out, s)
+		}
+		r := parseImageRef(img.Name)
+		if r.Tag != "" {
+			s.RepoTags = append(s.RepoTags, r.FamiliarRepo()+":"+r.Tag)
+		}
+		if img.Digest != "" {
+			d := r.FamiliarRepo() + "@" + img.Digest
+			if !contains(s.RepoDigests, d) {
+				s.RepoDigests = append(s.RepoDigests, d)
+			}
+		}
+	}
+	sort.SliceStable(out, func(i, j int) bool { return out[i].Created > out[j].Created })
+	res := make([]imageSummary, len(out))
+	for i, s := range out {
+		sort.Strings(s.RepoTags)
+		res[i] = *s
+	}
+	return res
+}
+
+func contains(ss []string, s string) bool {
+	for _, x := range ss {
+		if x == s {
+			return true
+		}
+	}
+	return false
+}
+
+// images lists the images: GET /images/json.
+func (s *Server) images(ctx context.Context, w http.ResponseWriter) {
+	if s.Images == nil {
+		writeJSON(w, []imageSummary{})
+		return
+	}
+	imgs, err := s.Images.List(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, summaries(imgs))
+}
+
+// imageInspect is the answer of GET /images/{name}/json.
+type imageInspect struct {
+	ID            string `json:"Id"`
+	RepoTags      []string
+	RepoDigests   []string
+	Parent        string
+	Comment       string
+	Created       string
+	DockerVersion string
+	Author        string
+	Config        imageInspectConfig
+	Architecture  string
+	Os            string
+	Size          int64
+	RootFS        struct {
+		Type   string
+		Layers []string
+	}
+	Metadata struct{ LastTagTime string }
+}
+
+type imageInspectConfig struct {
+	User         string
+	ExposedPorts map[string]struct{} `json:",omitempty"`
+	Env          []string
+	Cmd          []string
+	WorkingDir   string
+	Entrypoint   []string
+	Labels       map[string]string
+}
+
+// imageInspectHandler answers GET /images/{name}/json.
+func (s *Server) imageInspect(ctx context.Context, w http.ResponseWriter, name string) {
+	if s.Images == nil {
+		http.Error(w, "No such image: "+name, http.StatusNotFound)
+		return
+	}
+	imgs, err := s.Images.List(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	img, ok := findImage(imgs, name)
+	if !ok {
+		http.Error(w, "No such image: "+parseImageRef(name).Familiar(), http.StatusNotFound)
+		return
+	}
+	var same []Image
+	for _, i := range imgs {
+		if i.ID == img.ID {
+			same = append(same, i)
+		}
+	}
+	sum := summaries(same)[0]
+	out := imageInspect{
+		ID: img.ID, RepoTags: sum.RepoTags, RepoDigests: sum.RepoDigests, Created: formatTime(img.Created),
+		Config: imageInspectConfig{
+			User: img.Config.User, ExposedPorts: img.Config.ExposedPorts, Env: img.Config.Env, Cmd: img.Config.Cmd,
+			WorkingDir: img.Config.WorkingDir, Entrypoint: img.Config.Entrypoint, Labels: img.Config.Labels,
+		},
+		Architecture: img.Architecture, Os: img.Os, Size: img.Size,
+	}
+	out.RootFS.Type = "layers"
+	out.RootFS.Layers = img.DiffIDs
+	writeJSON(w, out)
+}
+
+// jsonMessage is a line of the progress stream of a pull, as dockerd sends
+// it (jsonmessage.JSONMessage).
+type jsonMessage struct {
+	Status         string        `json:"status,omitempty"`
+	ProgressDetail *progressInfo `json:"progressDetail,omitempty"`
+	Progress       string        `json:"progress,omitempty"`
+	ID             string        `json:"id,omitempty"`
+	Error          string        `json:"error,omitempty"`
+	ErrorDetail    *struct {
+		Message string `json:"message"`
+	} `json:"errorDetail,omitempty"`
+}
+
+type progressInfo struct {
+	Current int64 `json:"current,omitempty"`
+	Total   int64 `json:"total,omitempty"`
+}
+
+// shortLayer is the id of a layer in a pull: the first 12 hex digits of its
+// digest.
+func shortLayer(digest string) string {
+	d := strings.TrimPrefix(digest, "sha256:")
+	if len(d) > 12 {
+		d = d[:12]
+	}
+	return d
+}
+
+// pull pulls an image: POST /images/create?fromImage=...&tag=..., answered
+// with a stream of JSON messages like dockerd's.
+func (s *Server) pull(ctx context.Context, w http.ResponseWriter, r *http.Request) {
+	if s.Images == nil {
+		http.Error(w, "this daemon cannot pull images", http.StatusNotImplemented)
+		return
+	}
+	q := r.URL.Query()
+	from := q.Get("fromImage")
+	if from == "" {
+		http.Error(w, "fromImage is required", http.StatusBadRequest)
+		return
+	}
+	if tag := q.Get("tag"); tag != "" {
+		if strings.HasPrefix(tag, "sha256:") {
+			from += "@" + tag
+		} else {
+			from += ":" + tag
+		}
+	}
+	ref := parseImageRef(from)
+	tag := ref.Tag
+	if tag == "" {
+		tag = ref.Digest
+	}
+	// Like dockerd, the stream starts with the first step: an error before
+	// it (an image that does not exist) is the answer of the request.
+	var mu sync.Mutex
+	started := false
+	send := func(m jsonMessage) {
+		mu.Lock()
+		defer mu.Unlock()
+		enc := json.NewEncoder(w)
+		if !started {
+			started = true
+			w.Header().Set("Content-Type", "application/json")
+			w.WriteHeader(http.StatusOK)
+			enc.Encode(jsonMessage{Status: "Pulling from " + ref.Path, ID: tag})
+		}
+		enc.Encode(m)
+		if f, ok := w.(http.Flusher); ok {
+			f.Flush()
+		}
+	}
+	img, downloaded, err := s.Images.Pull(ctx, ref.String(), func(p PullProgress) {
+		text, ok := pullTexts[p.Status]
+		if !ok || p.Layer == "" {
+			return
+		}
+		m := jsonMessage{Status: text, ID: shortLayer(p.Layer), ProgressDetail: &progressInfo{}}
+		if p.Status == PullDownloading {
+			m.ProgressDetail = &progressInfo{Current: p.Current, Total: p.Total}
+		}
+		send(m)
+	})
+	mu.Lock()
+	early := !started
+	mu.Unlock()
+	if err != nil && early {
+		http.Error(w, err.Error(), http.StatusNotFound)
+		return
+	}
+	if err != nil {
+		send(jsonMessage{Error: err.Error(), ErrorDetail: &struct {
+			Message string `json:"message"`
+		}{err.Error()}})
+		return
+	}
+	send(jsonMessage{Status: "Digest: " + img.Digest})
+	if downloaded {
+		send(jsonMessage{Status: "Status: Downloaded newer image for " + ref.Familiar()})
+	} else {
+		send(jsonMessage{Status: "Status: Image is up to date for " + ref.Familiar()})
+	}
+}
+
+// removeImage removes an image: DELETE /images/{name}?force=. Like
+// dockerd, it refuses an image that a container uses, unless forced, and
+// an image that a running container uses even then.
+func (s *Server) removeImage(ctx context.Context, w http.ResponseWriter, r *http.Request, name string) {
+	if s.Images == nil {
+		http.Error(w, "No such image: "+name, http.StatusNotFound)
+		return
+	}
+	force := queryBool(r, "force")
+	imgs, err := s.Images.List(ctx)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+	img, ok := findImage(imgs, name)
+	if !ok {
+		http.Error(w, "No such image: "+parseImageRef(name).Familiar(), http.StatusNotFound)
+		return
+	}
+	byID := !strings.Contains(name, ":") && !strings.Contains(name, "/") && strings.HasPrefix(strings.TrimPrefix(img.ID, "sha256:"), strings.TrimPrefix(name, "sha256:"))
+	if parseImageRef(name).String() == img.Name {
+		byID = false
+	}
+	shortImg := shortLayer(img.ID)
+	// the references to remove: the one named, or all of the image ID
+	var refs []Image
+	for _, i := range imgs {
+		if (byID && i.ID == img.ID) || i.Name == img.Name {
+			refs = append(refs, i)
+		}
+	}
+	if byID && len(refs) > 1 && !force {
+		http.Error(w, fmt.Sprintf("conflict: unable to delete %s (must be forced) - image is referenced in multiple repositories", shortImg), http.StatusConflict)
+		return
+	}
+	others := 0 // references to the same image that stay
+	for _, i := range imgs {
+		if i.ID == img.ID && !contains(names(refs), i.Name) {
+			others++
+		}
+	}
+	if others == 0 {
+		// the image goes: no container may use it
+		all, err := s.client.Containers(ctx)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusInternalServerError)
+			return
+		}
+		// dockerd's order: a running container is a conflict that force
+		// does not lift (for an image ID always, for a name with force),
+		// any other user one that it does.
+		type user struct {
+			id      string
+			running bool
+		}
+		var users []user
+		for _, c := range all {
+			info, err := c.Info(ctx, client.WithoutRefreshedMetadata)
+			if err != nil || !usesImage(info.Labels, info.Image, img) {
+				continue
+			}
+			users = append(users, user{c.ID(), s.state(ctx, c, info.Labels).Running})
+		}
+		for _, u := range users {
+			if u.running && (force || byID) {
+				http.Error(w, fmt.Sprintf("conflict: unable to delete %s (cannot be forced) - image is being used by running container %s", shortImg, shortLayer(u.id)), http.StatusConflict)
+				return
+			}
+		}
+		for _, u := range users {
+			switch {
+			case force:
+			case byID:
+				http.Error(w, fmt.Sprintf("conflict: unable to delete %s (must be forced) - image is being used by stopped container %s", shortImg, shortLayer(u.id)), http.StatusConflict)
+				return
+			default:
+				http.Error(w, fmt.Sprintf("conflict: unable to remove repository reference %q (must force) - container %s is using its referenced image %s", name, shortLayer(u.id), shortImg), http.StatusConflict)
+				return
+			}
+		}
+	}
+	type deleteItem struct {
+		Untagged string `json:",omitempty"`
+		Deleted  string `json:",omitempty"`
+	}
+	var out []deleteItem
+	seen := map[string]bool{}
+	for _, ref := range refs {
+		deleted, err := s.Images.Remove(ctx, ref.Name)
+		if err != nil {
+			http.Error(w, err.Error(), httpStatus(err))
+			return
+		}
+		ir := parseImageRef(ref.Name)
+		out = append(out, deleteItem{Untagged: ir.Familiar()})
+		if ref.Digest != "" {
+			d := ir.FamiliarRepo() + "@" + ref.Digest
+			if !seen[d] {
+				seen[d] = true
+				out = append(out, deleteItem{Untagged: d})
+			}
+		}
+		for _, d := range deleted {
+			out = append(out, deleteItem{Deleted: d})
+		}
+	}
+	writeJSON(w, out)
+}
+
+func names(imgs []Image) []string {
+	out := make([]string, len(imgs))
+	for i, img := range imgs {
+		out[i] = img.Name
+	}
+	return out
+}
+
+// usesImage tells whether a container (its labels and image name) was
+// created from img.
+func usesImage(labels map[string]string, image string, img Image) bool {
+	if id := labels[LabelImageID]; id != "" {
+		return id == img.ID
+	}
+	return parseImageRef(image).String() == img.Name
+}
