+
+package v86
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestCopied(t *testing.T) {
+	old := CopiedDir
+	CopiedDir = t.TempDir()
+	defer func() { CopiedDir = old }()
+	files := []CopiedFile{
+		{Path: "/usr/share/html", Mode: ModeDir | 0o755},
+		{Path: "/usr/share/html/index.html", Mode: ModeRegular | 0o644, Data: []byte("hi\n"), Mtime: 1700000000},
+		{Path: "/usr/share/html/link", Mode: ModeSymlink | 0o777, LinkTarget: "index.html"},
+	}
+	if err := AddCopied("c1", files[:2]); err != nil {
+		t.Fatal(err)
+	}
+	if err := AddCopied("c1", files[2:]); err != nil {
+		t.Fatal(err)
+	}
+	got, err := CopiedFiles("c1")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 3 || got[0].Path != "/usr/share/html" || got[0].Mode != ModeDir|0o755 ||
+		string(got[1].Data) != "hi\n" || got[1].Mtime != 1700000000 || got[2].LinkTarget != "index.html" {
+		t.Fatalf("got %+v", got)
+	}
+	RemoveCopied("c1")
+	if got, _ := CopiedFiles("c1"); len(got) != 0 {
+		t.Errorf("after remove: %+v", got)
+	}
+}
+
+func TestReadTarNames(t *testing.T) {
+	var b bytes.Buffer
+	WriteTar(&b, []CopiedFile{
+		{Path: "html", Mode: ModeDir | 0o755},
+		{Path: "html/../../etc/passwd", Mode: ModeRegular | 0o644, Data: []byte("x")},
+	})
+	got, err := ReadTar(&b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got) != 2 || got[0].Path != "html" || got[1].Path != "etc/passwd" {
+		t.Errorf("names %+v", got)
+	}
+}
